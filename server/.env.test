# AVALON 测试环境配置
NODE_ENV=test
PORT=0

# MySQL 连接（使用测试数据库）
DB_HOST=mysql
DB_PORT=3306
DB_USER=avalon_test_user
DB_PASS=avalon_test_pass_2024
DB_NAME=avalon_db_test
DB_POOL_MAX=10

# MySQL root 凭证（用于创建/删除测试数据库，由 globalSetup 使用）
# 通过 docker-compose 或环境变量注入
DB_ROOT_USER=root
# DB_ROOT_PASS 通过环境变量注入

# HTTPS 测试环境不启用
HTTPS=false

# 微信（测试环境不需要真实验证）
WX_APPID=test_appid
WX_SECRET=test_secret
