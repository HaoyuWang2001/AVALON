/* pages/records/records.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 0;
  box-sizing: border-box;
  color: var(--text-body);
  background: var(--bg-page);
}

.card {
  background: var(--bg-card);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-md);
}

.rc-loading { text-align: center; color: var(--text-muted); padding: 80rpx 0; font-size: 28rpx; }

.rc-card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.rc-card-title { font-size: 34rpx; font-weight: 800; color: var(--text-title); }
.rc-card-count { font-size: 24rpx; color: var(--text-muted); }
.rc-create {
  padding: 10rpx 24rpx; border-radius: 999rpx; font-size: 26rpx; font-weight: 700;
  background: var(--label-violet-bg); color: var(--label-violet);
}
.rc-create-hover { opacity: 0.75; }

.rc-empty {
  padding: 36rpx 0; text-align: center; font-size: 26rpx; color: var(--text-muted);
  line-height: 1.7; white-space: pre-line;
}

.rc-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 0; border-bottom: 1rpx solid var(--divider);
}
.rc-row:last-child { border-bottom: none; }
.rc-row-hover { opacity: 0.75; }
.rc-row-main { flex: 1; min-width: 0; }
.rc-row-title { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.rc-row-name { font-size: 30rpx; font-weight: 700; color: var(--text-title); }
.rc-tag {
  font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 999rpx;
  background: var(--label-grey-bg); color: var(--label-grey);
}
.rc-row-sub { display: block; margin-top: 6rpx; font-size: 24rpx; color: var(--text-muted); }
.rc-row-ops { display: flex; align-items: center; gap: 20rpx; flex-shrink: 0; }
.rc-op { font-size: 26rpx; font-weight: 600; }
.rc-op-primary { color: var(--label-violet); }
.rc-op-danger { color: var(--danger); }
