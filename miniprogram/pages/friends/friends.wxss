/* pages/friends/friends.wxss */
.page { padding: 24rpx 32rpx; box-sizing: border-box; }

/* ─── 首次设置ID遮罩 ─── */
.setup-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1200; background: var(--mask); display: flex; align-items: center; justify-content: center; }
.setup-box { width: 620rpx; background: var(--bg-card); border-radius: 28rpx; padding: 48rpx 40rpx; display: flex; flex-direction: column; align-items: center; }
.setup-title { font-size: 38rpx; font-weight: 800; color: var(--text-title); }
.setup-sub { font-size: 24rpx; color: var(--text-muted); margin: 16rpx 0 32rpx; line-height: 1.7; text-align: center; }
.setup-input { width: 100%; height: 88rpx; border: 2rpx solid var(--gray-200); border-radius: 16rpx; padding: 0 24rpx; font-size: 32rpx; box-sizing: border-box; text-align: center; }
.setup-btn { margin-top: 32rpx; }
.setup-tip { margin-top: 24rpx; font-size: 24rpx; color: var(--text-muted); }

/* ─── 我的ID条 ─── */
.my-card { padding: 0; overflow: hidden; }
.my-id-bar { display: flex; align-items: center; padding: 24rpx; }
.my-divider { height: 1rpx; background: var(--divider); margin: 0 24rpx; }
.my-avatar { width: 88rpx; height: 88rpx; border-radius: 50%; flex-shrink: 0; }
.my-info { margin-left: 20rpx; min-width: 0; flex: 1; }
.req-entry {
  flex-shrink: 0; display: flex; align-items: center; gap: 6rpx; margin-left: 16rpx;
  padding: 8rpx 22rpx; border-radius: 999rpx;
  color: var(--primary); background: var(--primary-bg); border: 2rpx solid var(--primary);
  font-size: 26rpx; font-weight: 700;
}
.req-entry-hover { transform: scale(0.95); opacity: 0.9; }
.req-badge {
  min-width: 30rpx; height: 30rpx; padding: 0 8rpx; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  border-radius: 999rpx; background: var(--danger); color: #FFFFFF; font-size: 20rpx; font-weight: 800;
}
.my-nick { font-size: 32rpx; font-weight: 700; color: var(--text-title); display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.my-id { font-size: 24rpx; color: var(--primary); margin-top: 6rpx; display: block; }

/* ─── 搜索 ─── */
.search-area { padding: 24rpx; }
.search-row { display: flex; align-items: center; }
.search-input { flex: 1; height: 72rpx; background: var(--gray-50); border-radius: 14rpx; padding: 0 20rpx; font-size: 28rpx; }
.search-btn {
  margin-left: 16rpx; height: 72rpx; line-height: 72rpx; padding: 0 30rpx;
  border-radius: 14rpx; font-size: 26rpx; font-weight: 700;
  background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
  color: var(--on-primary);
}
.search-btn::after { border: none; }
.search-btn[disabled] { opacity: 0.6; }
.search-error { font-size: 24rpx; color: var(--danger); margin-top: 16rpx; }
.search-result { display: flex; align-items: center; margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--divider); }
.sr-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; flex-shrink: 0; }
.sr-info { flex: 1; margin-left: 16rpx; min-width: 0; }
.sr-name { font-size: 28rpx; font-weight: 600; color: var(--text-title); display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sr-id { font-size: 24rpx; color: var(--text-muted); display: block; margin-top: 4rpx; }
.sr-btn { flex-shrink: 0; }
.sr-state { flex-shrink: 0; font-size: 26rpx; color: var(--text-muted); }
.sr-state-ok { color: var(--success); }


/* ─── 列表 ─── */
.list-card { padding: 12rpx 24rpx; }
.list-empty { text-align: center; color: var(--text-muted); font-size: 26rpx; padding: 48rpx 0; }
.friend-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid var(--divider); }
.friend-item:last-child { border-bottom: none; }
.f-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; flex-shrink: 0; background: var(--gray-100); }
.f-info { flex: 1; margin-left: 18rpx; min-width: 0; }
.f-name-row { display: flex; align-items: baseline; gap: 8rpx; min-width: 0; flex-wrap: wrap; }
.f-name { font-size: 34rpx; font-weight: 600; color: var(--text-title); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.f-rank { flex-shrink: 0; font-size: 24rpx; font-weight: 800; color: var(--primary); }
.f-status-row { display: flex; align-items: center; margin-top: 6rpx; }
.f-dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin-right: 8rpx; flex-shrink: 0; }
.f-status-text { font-size: 26rpx; }
.f-room-text { font-size: 26rpx; margin-left: 10rpx; }
.f-dot.st-online { background: var(--label-green); }
.f-dot.st-offline { background: var(--label-grey); }
.st-online { color: var(--label-green); }
.st-offline { color: var(--label-grey); }
.st-inroom { color: var(--label-blue); }
.st-ingame { color: var(--label-red); }
.f-sub { font-size: 24rpx; color: var(--text-muted); margin-top: 6rpx; display: block; }
.req-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid var(--divider); }
.req-item:last-child { border-bottom: none; }
.req-btn { flex-shrink: 0; margin-left: 12rpx; }
.req-ok { background: var(--success); color: var(--on-primary); }
.req-no { background: var(--gray-100); color: var(--text-body); }

/* 好友申请弹窗 */
.req-modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1300;
  background: var(--mask-light); display: flex; align-items: center; justify-content: center;
}
.req-modal {
  width: 92vw; max-width: 660rpx; max-height: 76vh; box-sizing: border-box;
  background: var(--bg-card); border-radius: 24rpx; display: flex; flex-direction: column;
  box-shadow: var(--shadow-lg); overflow: hidden;
}
.req-modal-head { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 32rpx 12rpx; }
.req-modal-title { font-size: 32rpx; font-weight: 800; color: var(--text-title); }
.req-modal-close { font-size: 30rpx; color: var(--text-muted); padding: 8rpx; }
.req-modal-scroll { flex: 1; padding: 0 24rpx 24rpx; box-sizing: border-box; }
.req-modal-scroll .req-item:last-child { border-bottom: none; }
