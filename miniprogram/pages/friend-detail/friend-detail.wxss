/* pages/friend-detail/friend-detail.wxss */
.page { padding: 24rpx 32rpx 0; box-sizing: border-box; position: relative; }
.page-loading { text-align: center; color: var(--text-muted); padding: 80rpx 0; }

/* 基本信息 + 数据（合并卡） */
.head-card { display: flex; flex-direction: column; align-items: stretch; padding: 28rpx 24rpx; }
.head-top { display: flex; align-items: center; }
.hd-stats-row { display: flex; align-items: flex-start; padding: 30rpx 0 0; }
.hd-stats-row-2 { padding-top: 8rpx; padding-bottom: 12rpx; }
.hd-stat { flex: 1; display: flex; flex-direction: column; align-items: center; }
.hd-stat-num { font-size: 34rpx; font-weight: 800; color: var(--text-title); }
.hd-stat-label { font-size: 22rpx; color: var(--text-muted); margin-top: 6rpx; }
.hd-stat-label-row { display: flex; align-items: center; gap: 6rpx; margin-top: 6rpx; }
.hd-stat-label-row .hd-stat-label { margin-top: 0; }
.hd-score { color: var(--primary); }
.hd-good { color: var(--good); }
.hd-evil { color: var(--evil); }
.hd-stat-div { width: 4rpx; height: 56rpx; background: var(--divider); align-self: center; flex-shrink: 0; }
.hd-avatar { width: 128rpx; height: 128rpx; border-radius: 50%; flex-shrink: 0; background: var(--gray-100); }
.hd-info { margin-left: 24rpx; min-width: 0; flex: 1; }
.hd-name-row { display: flex; align-items: baseline; min-width: 0; }
.hd-name { font-size: 40rpx; font-weight: 800; color: var(--text-title); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hd-id { font-size: 26rpx; color: var(--text-muted); margin-left: 14rpx; flex-shrink: 0; }
.hd-status-row { display: flex; align-items: center; margin-top: 12rpx; }
.hd-dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-right: 8rpx; flex-shrink: 0; }
.hd-status { font-size: 26rpx; }
.hd-dot.st-online { background: var(--label-green); }
.hd-dot.st-offline { background: var(--label-grey); }
.st-online { color: var(--label-green); }
.st-offline { color: var(--label-grey); }
.more-btn { margin-left: 12rpx; flex-shrink: 0; font-size: 40rpx; font-weight: 800; color: var(--text-muted); line-height: 1; padding: 8rpx 8rpx 16rpx 16rpx; }

/* 状态卡 */
.status-card { display: flex; align-items: center; justify-content: space-between; padding: 28rpx; }
.status-text { font-size: 30rpx; font-weight: 600; color: var(--text-title); }
.status-btns { display: flex; gap: 12rpx; }
.status-btn { flex-shrink: 0; }

/* 历史对局外层（内容由 history-card 组件渲染） */
.history-card { background: var(--bg-card); border-radius: 24rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); }

.score-help-btn {
  width: 30rpx; height: 30rpx; border-radius: 50%;
  border: 1rpx solid var(--text-muted); color: var(--text-muted);
  font-size: 20rpx; line-height: 1; display: flex; align-items: center; justify-content: center;
}
