<!--pages/friend-detail/friend-detail.wxml-->
<view class="page {{themeClass ? 'theme-' + themeClass : ''}}">

  <view wx:if="{{loading}}" class="page-loading">加载中...</view>

  <block wx:if="{{friend}}">
    <!-- 基本信息 -->
    <view class="card head-card">
      <image src="{{friend.avatarUrl || '/images/default-avatar.png'}}" class="hd-avatar"></image>
      <view class="hd-info">
        <view class="hd-name-row">
          <text class="hd-name">{{friend.nickName}}</text>
          <text class="hd-id">{{friend.uniqueId}}</text>
        </view>
        <view class="hd-status-row">
          <view class="hd-dot {{friend.online ? 'st-online' : 'st-offline'}}"></view>
          <text class="hd-status {{friend.online ? 'st-online' : 'st-offline'}}">{{friend.online ? '在线' : '离线'}}</text>
        </view>
      </view>
      <view class="more-btn" bindtap="moreActions">···</view>
    </view>

    <!-- 状态卡：空闲（可邀请） / 房间等待中(进房间) / 对局中(观战) -->
    <view class="card status-card">
      <block wx:if="{{!friend.room}}">
        <view class="status-text">当前空闲</view>
        <view class="status-btns">
          <button wx:if="{{myInvite === 'room'}}" size="mini" class="btn btn-primary status-btn" open-type="share" data-invite="room">邀请加入房间</button>
          <button wx:if="{{myInvite === 'game'}}" size="mini" class="btn btn-primary status-btn" open-type="share" data-invite="game">邀请观战</button>
        </view>
      </block>
      <block wx:elif="{{friend.room.gameStarted}}">
        <view class="status-text">正在对局中</view>
        <button size="mini" class="btn btn-primary status-btn" bindtap="spectate">观战TA的游戏</button>
      </block>
      <block wx:else>
        <view class="status-text">在房间等待中</view>
        <button size="mini" class="btn btn-primary status-btn" bindtap="enterRoom">进入TA的房间</button>
      </block>
    </view>

    <!-- 角色胜率（公共组件，角色卡可点开对局弹窗） -->
    <role-stats-card wx:if="{{roleStats.length > 0}}" roles="{{roleStats}}" summary="{{summary}}" games="{{historyList}}" />

    <!-- 历史对局（公共组件） -->
    <view class="card history-card" wx:if="{{historyList.length > 0}}">
      <history-card title="历史对局" games="{{historyList}}" />
    </view>

    <view style="height: 40rpx"></view>
  </block>
</view>
