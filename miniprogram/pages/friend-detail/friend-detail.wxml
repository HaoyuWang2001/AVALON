<!--pages/friend-detail/friend-detail.wxml-->
<view class="page {{themeClass ? 'theme-' + themeClass : ''}}">

  <view wx:if="{{loading}}" class="page-loading">加载中...</view>

  <block wx:if="{{friend}}">
    <!-- 基本信息 -->
    <view class="card head-card">
      <image src="{{friend.avatarUrl || '/images/default-avatar.png'}}" class="hd-avatar"></image>
      <view class="hd-info">
        <view class="hd-name-row">
          <text class="hd-name">{{friend.nickName}}</text>
          <text class="hd-id">{{friend.uniqueId}}</text>
        </view>
        <view class="hd-status-row">
          <view class="hd-dot {{friend.online ? 'st-online' : 'st-offline'}}"></view>
          <text class="hd-status {{friend.online ? 'st-online' : 'st-offline'}}">{{friend.online ? '在线' : '离线'}}</text>
        </view>
      </view>
      <view class="more-btn" bindtap="moreActions">···</view>
    </view>

    <!-- 状态卡：空闲（可邀请） / 房间等待中(进房间) / 对局中(观战) -->
    <view class="card status-card">
      <block wx:if="{{!friend.room}}">
        <view class="status-text">当前空闲</view>
        <view class="status-btns">
          <button wx:if="{{myInvite === 'room'}}" size="mini" class="btn btn-primary status-btn" open-type="share" data-invite="room">邀请加入房间</button>
          <button wx:if="{{myInvite === 'game'}}" size="mini" class="btn btn-primary status-btn" open-type="share" data-invite="game">邀请观战</button>
        </view>
      </block>
      <block wx:elif="{{friend.room.gameStarted}}">
        <view class="status-text">正在对局中</view>
        <button size="mini" class="btn btn-primary status-btn" bindtap="spectate">观战TA的游戏</button>
      </block>
      <block wx:else>
        <view class="status-text">在房间等待中</view>
        <button size="mini" class="btn btn-primary status-btn" bindtap="enterRoom">进入TA的房间</button>
      </block>
    </view>

    <!-- 角色胜率（主页同款：卡片 + 可滑动） -->
    <view class="card stats-card">
      <view class="card-title">角色胜率</view>
      <view class="stats-summary" wx:if="{{totalWinRate}}">{{totalRecord}}·胜率 {{totalWinRate}} · 蓝方 {{goodWinRate}} · 红方 {{evilWinRate}}</view>
      <view wx:if="{{roleStats.length === 0}}" class="list-empty">暂无对局数据</view>
      <swiper wx:else class="role-stats-swiper"
              indicator-dots="{{roleStats.length > 1}}"
              indicator-color="rgba(139,92,246,0.25)"
              indicator-active-color="#8B5CF6"
              duration="300">
        <swiper-item wx:for="{{roleStats}}" wx:key="role">
          <view class="stat-role-item">
            <view class="stat-role-card">
              <text class="stat-role-emoji">{{item.emoji}}</text>
              <view class="stat-role-name {{item.side === 'evil' ? 'stat-name-evil' : 'stat-name-good'}}">{{item.roleName}}</view>
              <view class="stat-role-meta">
                <text class="stat-role-rate">{{item.wins}}/{{item.games}} ({{item.winRate}})</text>
              </view>
            </view>
          </view>
        </swiper-item>
      </swiper>
    </view>

    <!-- 历史对局 -->
    <view class="card hist-card">
      <view class="card-title">历史对局（{{historyList.length}}）</view>
      <view wx:if="{{historyList.length === 0}}" class="list-empty">暂无对局记录</view>
      <scroll-view wx:else scroll-y class="hist-scroll" show-scrollbar="{{false}}">
        <view wx:for="{{historyList}}" wx:key="gameId" class="hist-item"
              bindtap="openHistoryGame" data-gameid="{{item.gameId}}">
          <text class="hist-role">{{item.roleName}}</text>
          <text class="hist-duration">{{item.durationText}}</text>
          <text class="hist-result {{item.isWin ? 'win' : 'lose'}}">{{item.isWin ? '胜' : '负'}}</text>
        </view>
      </scroll-view>
    </view>

    <view style="height: 40rpx"></view>
  </block>
</view>
