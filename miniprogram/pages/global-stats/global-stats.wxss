/* pages/global-stats/global-stats.wxss */
.page { padding: 24rpx 32rpx 0; box-sizing: border-box; }
.page-loading { text-align: center; color: var(--text-muted); padding: 80rpx 0; }
.card-title { font-size: 30rpx; font-weight: 700; color: var(--text-title); margin-bottom: 20rpx; }
.empty { text-align: center; color: var(--text-muted); font-size: 26rpx; padding: 30rpx 0; }

/* 基础统计网格（2×2） */
.grid { display: flex; flex-wrap: wrap; }
.grid-item { width: 50%; display: flex; flex-direction: column; align-items: center; padding: 20rpx 0; box-sizing: border-box; }
.gi-num { font-size: 44rpx; font-weight: 800; color: var(--primary); }
.gi-label { font-size: 22rpx; color: var(--text-muted); margin-top: 6rpx; }

/* 阵营胜率 */
.faction-row { display: flex; gap: 20rpx; }
.faction-box { flex: 1; border-radius: 18rpx; padding: 24rpx; display: flex; flex-direction: column; align-items: center; }
.faction-good { background: rgba(59, 130, 246, 0.14); }
.faction-evil { background: rgba(239, 68, 68, 0.14); }
.fb-rate { font-size: 48rpx; font-weight: 800; }
.faction-good .fb-rate { color: #3B82F6; }
.faction-evil .fb-rate { color: #EF4444; }
.fb-label { font-size: 22rpx; color: var(--text-muted); margin-top: 8rpx; }

/* 各人数胜率（阵营卡内） */
.count-stats { margin-top: 16rpx; border-top: 1rpx solid var(--gray-100); padding-top: 6rpx; }
.count-stat-row { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid var(--gray-100); }
.count-stat-row:last-child { border-bottom: none; }
.cs-name { font-size: 28rpx; font-weight: 600; color: var(--text-title); width: 140rpx; }
.cs-total { font-size: 24rpx; color: var(--text-muted); flex: 1; }
.cs-rate { font-size: 26rpx; font-weight: 700; display: flex; align-items: center; }
.rate-good { color: #3B82F6; }
.rate-sep { color: var(--text-muted); font-weight: 400; }
.rate-evil { color: #EF4444; }

/* 角色统计 */
.role-row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid var(--gray-100); }
.role-row:last-child { border-bottom: none; }
.role-emoji { font-size: 40rpx; margin-right: 16rpx; }
.role-name { font-size: 28rpx; font-weight: 600; flex: 1; }
.name-good { color: #3B82F6; }
.name-evil { color: #EF4444; }
.role-games { font-size: 24rpx; color: var(--text-muted); margin-right: 20rpx; }
.role-rate { font-size: 28rpx; font-weight: 800; color: var(--primary); min-width: 100rpx; text-align: right; }

/* 全量对局 */
.game-scroll { max-height: 1100rpx; }
.game-row { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid var(--gray-100); }
.game-row:last-child { border-bottom: none; }
.game-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.game-title { font-size: 28rpx; font-weight: 600; color: var(--text-title); }
.game-sub { font-size: 22rpx; color: var(--text-muted); margin-top: 4rpx; }
.game-winner-wrap { display: flex; flex-direction: column; align-items: flex-end; flex-shrink: 0; margin-left: 16rpx; }
.game-winner { font-size: 26rpx; font-weight: 700; }
.win-good { color: #3B82F6; }
.win-evil { color: #EF4444; }

/* 角色对局弹窗 */
.modal-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5); z-index: 100;
  display: flex; align-items: center; justify-content: center;
}
.modal-panel {
  width: 84%; max-height: 72vh; box-sizing: border-box;
  background: var(--bg-card); border-radius: 24rpx; padding: 28rpx;
  display: flex; flex-direction: column; box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}
.modal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.modal-title { font-size: 30rpx; font-weight: 700; color: var(--text-title); }
.modal-close { font-size: 34rpx; color: var(--text-muted); padding: 0 8rpx; }
.modal-scroll { max-height: 52vh; }
