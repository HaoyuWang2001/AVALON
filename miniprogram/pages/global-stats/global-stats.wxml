<!--pages/global-stats/global-stats.wxml-->
<view class="page {{themeClass ? 'theme-' + themeClass : ''}}">

  <view wx:if="{{loading}}" class="page-loading">加载中...</view>

  <block wx:if="{{stats}}">
    <!-- 基础统计（4 项，2×2） -->
    <view class="card">
      <view class="card-title">基础统计</view>
      <view class="grid">
        <view class="grid-item"><text class="gi-num">{{stats.games.completed}}</text><text class="gi-label">已完成对局</text></view>
        <view class="grid-item"><text class="gi-num">{{stats.games.active}}</text><text class="gi-label">进行中对局</text></view>
        <view class="grid-item"><text class="gi-num">{{stats.users.registered}}</text><text class="gi-label">总玩家数</text></view>
        <view class="grid-item"><text class="gi-num">{{stats.rooms.total}}</text><text class="gi-label">总房间数</text></view>
      </view>
    </view>

    <!-- 阵营胜率 + 各人数胜率（点击查看该人数全部对局） -->
    <view class="card">
      <view class="card-title">阵营胜率</view>
      <view class="faction-row">
        <view class="faction-box faction-good">
          <text class="fb-rate">{{stats.faction.goodWinRate}}%</text>
          <text class="fb-label">蓝方 · {{stats.faction.goodGames}} 场</text>
        </view>
        <view class="faction-box faction-evil">
          <text class="fb-rate">{{stats.faction.evilWinRate}}%</text>
          <text class="fb-label">红方 · {{stats.faction.evilGames}} 场</text>
        </view>
      </view>
      <view class="count-stats">
        <view wx:for="{{countStats}}" wx:key="count" class="count-stat-row"
          bindtap="openCountGames" data-count="{{item.count}}">
          <text class="cs-name">{{item.count}}人局</text>
          <text class="cs-total">{{item.total}} 场</text>
          <view class="cs-rate">
            <text class="rate-good">蓝 {{item.goodRate}}</text>
            <text class="rate-sep"> / </text>
            <text class="rate-evil">红 {{item.evilRate}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 角色统计（点击查看含该角色的全部对局） -->
    <view class="card">
      <view class="card-title">角色统计</view>
      <view wx:if="{{roleStats.length === 0}}" class="empty">暂无数据</view>
      <view wx:for="{{roleStats}}" wx:key="role" class="role-row"
        bindtap="openRoleGames" data-role="{{item.role}}" data-name="{{item.roleName}}" data-emoji="{{item.emoji}}">
        <text class="role-emoji">{{item.emoji}}</text>
        <text class="role-name {{item.side === 'evil' ? 'name-evil' : 'name-good'}}">{{item.roleName}}</text>
        <text class="role-games">{{item.games}} 场</text>
        <text class="role-rate">{{item.winRate}}</text>
      </view>
    </view>

    <!-- 全量对局（滚动框可见约10条，可滑动查看全部，不截断） -->
    <view class="card">
      <view class="card-title">全量对局（{{gameList.length}}）</view>
      <view wx:if="{{gameList.length === 0}}" class="empty">暂无对局</view>
      <scroll-view wx:else scroll-y class="game-scroll">
        <view wx:for="{{gameList}}" wx:key="id" class="game-row" bindtap="openGame" data-id="{{item.id}}">
          <view class="game-main">
            <text class="game-title">{{item.playerCount}}人局 · {{item.durationText}}</text>
            <text class="game-sub">{{item.dateText}}</text>
          </view>
          <view class="game-winner-wrap">
            <text class="game-winner {{item.winnerClass}}">{{item.winnerText}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </block>

  <view style="height: 40rpx"></view>

  <!-- 角色/人数对局弹窗 -->
  <view class="modal-overlay" wx:if="{{detailModal.show}}" bindtap="closeDetail" catchtouchmove="noop">
    <view class="modal-panel" catchtap="noop">
      <view class="modal-head">
        <text class="modal-title">{{detailModal.title}} · {{detailModal.games.length}} 局</text>
        <text class="modal-close" bindtap="closeDetail">✕</text>
      </view>
      <view wx:if="{{detailModalLoading}}" class="empty">加载中...</view>
      <block wx:else>
        <view wx:if="{{detailModal.games.length === 0}}" class="empty">暂无对局</view>
        <scroll-view wx:else scroll-y class="modal-scroll" show-scrollbar="{{false}}">
          <view wx:for="{{detailModal.games}}" wx:key="id" class="game-row" bindtap="openGame" data-id="{{item.id}}">
            <view class="game-main">
              <text class="game-title">{{item.playerCount}}人局 · {{item.durationText}}</text>
              <text class="game-sub">{{item.dateText}}</text>
            </view>
            <view class="game-winner-wrap">
              <text class="game-winner {{item.winnerClass}}">{{item.winnerText}}</text>
            </view>
          </view>
        </scroll-view>
      </block>
    </view>
  </view>
</view>
