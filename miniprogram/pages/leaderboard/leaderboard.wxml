<!--pages/leaderboard/leaderboard.wxml-->
<view class="page {{themeClass ? 'theme-' + themeClass : ''}}">
  <view class="lb-head">
    <text class="lb-head-title">总胜率排行榜</text>
    <text class="lb-head-sub">仅含达到最小局数且公开胜率的玩家（共 {{total}} 人）</text>
  </view>

  <view wx:if="{{loading}}" class="lb-loading">加载中...</view>
  <block wx:else>
    <view wx:if="{{players.length === 0}}" class="lb-empty">暂无达标玩家</view>
    <view wx:else class="lb-list">
      <view wx:for="{{players}}" wx:key="openId" class="lb-row {{item.isSelf ? 'lb-self' : ''}}"
        bindtap="onPlayerTap" data-id="{{item.openId}}" data-name="{{item.nickName}}"
        data-avatar="{{item.avatarUrl}}" data-friend="{{item.isFriend}}">
        <text class="lb-rank {{item.rank <= 3 ? 'r' + item.rank : ''}}">{{item.rank}}</text>
        <image class="lb-avatar" src="{{item.avatarUrl || '/images/default-avatar.png'}}"></image>
        <view class="lb-main">
          <view class="lb-name-row">
            <text class="lb-name">{{item.nickName}}</text>
            <text wx:if="{{item.isFriend}}" class="lb-tag lb-friend">好友</text>
            <text wx:if="{{item.isSelf}}" class="lb-tag lb-me">我</text>
          </view>
          <text class="lb-sub">{{item.games}} 场 · {{item.wins}} 胜</text>
        </view>
        <text class="lb-rate">{{item.winRate}}%</text>
      </view>
    </view>

    <view wx:if="{{totalPages > 1}}" class="lb-pager">
      <button size="mini" class="lb-pg-btn" disabled="{{page <= 1}}" bindtap="prevPage">上一页</button>
      <text class="lb-pg-info">{{page}} / {{totalPages}}</text>
      <button size="mini" class="lb-pg-btn" disabled="{{page >= totalPages}}" bindtap="nextPage">下一页</button>
      <view class="lb-jump">
        <input class="lb-jump-input" type="number" placeholder="页码" value="{{jumpTo}}" bindinput="onJumpInput"/>
        <button size="mini" class="lb-pg-btn" bindtap="jumpPage">跳转</button>
      </view>
    </view>
  </block>

  <view style="height: 40rpx"></view>
  <player-stats id="playerStats" />
</view>
