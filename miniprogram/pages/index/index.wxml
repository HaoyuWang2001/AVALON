<!--pages/index/index.wxml-->
<view class="page {{themeClass ? 'theme-' + themeClass : ''}}">
  <!-- 品牌栏（单行）：左圆徽+字标，最右为个人头像（点击进入个人页） -->
  <view class="brand-bar">
    <view class="brand-main">
      <view class="brand-emblem-tap" hover-class="brand-emblem-hover" hover-stay-time="60" bindtap="openBrandMenu"><brand-logo size="normal" theme="{{themeClass}}"/></view>
      <text class="brand-title">练秋湖的瓦协会</text>
    </view>
    <view class="brand-avatar" hover-class="brand-avatar-hover" hover-stay-time="60" bindtap="goToMe">
      <image class="brand-avatar-img" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" catchtap="goToMe"/>
    </view>
  </view>

  <!-- 个人卡：首行（我的排名 + 排行榜入口） + 胜率前三领奖台 -->
  <view class="card profile-card">
    <view class="profile-rank-row">
      <view class="profile-rank-left">
        <text class="profile-rank-label">我的排名</text>
        <text class="profile-rank">{{myRank ? '#' + myRank : '—'}}</text>
      </view>
      <view class="profile-rank-btn" hover-class="profile-rank-btn-hover" hover-stay-time="60" bindtap="goToLeaderboard">排行榜 ›</view>
    </view>
    <block wx:if="{{champions.length > 0}}">
      <view class="podium">
        <view wx:for="{{podium}}" wx:key="openId"
          class="podium-item rank-{{item.rank}}"
          bindtap="onChampionTap"
          data-openid="{{item.openId}}" data-name="{{item.nickName}}" data-avatar="{{item.avatarUrl}}"
          data-friend="{{item.isFriend}}">
          <view class="podium-avatar-wrap">
            <text wx:if="{{item.rank === 1}}" class="podium-crown">👑</text>
            <image src="{{item.avatarUrl || '/images/default-avatar.png'}}" class="podium-avatar"></image>
            <view class="podium-badge">{{item.rank}}</view>
          </view>
          <text class="podium-name">{{item.nickName}}</text>
          <title-badge wx:if="{{item.titles && item.titles.length > 0}}" titles="{{item.titles}}" size="mini"></title-badge>
          <view class="podium-rate">
            <text class="podium-score">{{item.score}}</text>
            <text class="podium-winrate">{{item.winRate}}%</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 召开会议 / 加入会议（合并按钮：(A) 对角全切；默认浅色，深色主题覆盖） -->
  <view class="meeting-btn {{meetingFillClass}}" style="--fill-ms:{{meetingFillMs}}ms;{{meetingPressStyle}}" wx:if="{{!currentRoom}}">
    <view class="meeting-fill"></view>
    <view class="meeting-zone lead" data-side="lead"
          bindtouchstart="onMeetingTouchStart" bindtouchmove="onMeetingTouchMove" bindtouchend="onMeetingTouchEnd" bindtouchcancel="onMeetingTouchCancel">
      <view class="meeting-content">
        <view class="meeting-icon-chip"><image class="meeting-icon" src="/images/sword.png" mode="aspectFit"/></view>
        <text class="meeting-label">召开会议</text>
      </view>
    </view>
    <view class="meeting-zone join" data-side="join"
          bindtouchstart="onMeetingTouchStart" bindtouchmove="onMeetingTouchMove" bindtouchend="onMeetingTouchEnd" bindtouchcancel="onMeetingTouchCancel">
      <view class="meeting-content">
        <view class="meeting-icon-chip"><image class="meeting-icon" src="/images/door.png" mode="aspectFit"/></view>
        <text class="meeting-label">加入会议</text>
      </view>
    </view>
  </view>


  <!-- 公开房间列表：等待中 / 游戏中 -->
  <view class="room-list-section">
    <view class="room-tabs">
      <view class="room-tab {{roomTab === 'waiting' ? 'room-tab-on' : ''}}" data-tab="waiting" bindtap="switchRoomTab">
        等待中<text class="room-tab-count">{{roomCounts.waiting}}</text>
      </view>
      <view class="room-tab {{roomTab === 'playing' ? 'room-tab-on' : ''}}" data-tab="playing" bindtap="switchRoomTab">
        游戏中<text class="room-tab-count">{{roomCounts.playing}}</text>
      </view>
    </view>
    <view wx:if="{{roomSwitchLoading}}" class="room-switch-loading">
      <view class="room-switch-dot d1"></view>
      <view class="room-switch-dot d2"></view>
      <view class="room-switch-dot d3"></view>
    </view>
    <block wx:else>
    <view wx:if="{{visibleRooms.length === 0}}" class="room-list-empty">{{roomListLoading ? '加载中...' : '没得玩，速开！'}}</view>
    <view wx:for="{{visibleRooms}}" wx:key="roomId"
      class="room-card {{item.isMine ? 'room-card-featured' : ''}}"
      bindtap="onPublicRoomTap" data-id="{{item.roomId}}">
      <view class="room-card-top">
        <view class="room-card-id-wrap">
          <brand-logo size="mini" theme="{{themeClass}}"/>
          <text class="room-card-id">{{item.roomId}}</text>
        </view>
        <view class="room-card-right">
          <text class="room-status-tag {{item.statusClass}}">{{item.statusText}}</text>
          <text wx:if="{{item.identityText}}" class="room-status-tag {{item.identityClass}}">{{item.identityText}}</text>
        </view>
      </view>
      <view class="room-tags-row" wx:if="{{item.tags.length > 0}}" catchtap="noop">
        <text wx:for="{{item.displayTags}}" wx:for-item="tg" wx:key="*this" class="room-tag">{{tg}}</text>
        <text wx:if="{{item.tags.length > 3}}" class="room-tag-more" data-id="{{item.roomId}}" catchtap="toggleRoomTags">{{item.showAllTags ? '收起' : '…'}}</text>
      </view>
      <view class="room-avatars-row">
        <view class="room-avatars-group">
          <block wx:for="{{item.players}}" wx:for-item="pl" wx:key="openId">
            <image class="room-avatar" src="{{pl.avatarUrl || '/images/default-avatar.png'}}"/>
          </block>
        </view>
        <text class="room-card-count">{{item.playerCount}}/{{item.maxPlayers}}</text>
      </view>
    </view>
    </block>
  </view>

  <view class="footer"><view class="footer-version">AVALON v2.0.0</view></view>


  <!-- 更改主题：与奇奇怪怪设置同款中部弹窗（选择后保持打开） -->
  <view class="weird-mask" wx:if="{{showThemePicker}}" bindtap="closeThemePicker" catchtouchmove="noop">
    <view class="weird-modal" catchtap="noop">
      <view class="weird-title">更改主题</view>
      <view wx:for="{{themeOptions}}" wx:key="name"
        class="theme-option {{item.key === themeClass ? 'theme-option-active' : ''}}"
        bindtap="selectTheme" data-index="{{index}}">
        <text class="theme-option-emoji">{{item.emoji}}</text>
        <text class="theme-option-name">{{item.name}}</text>
        <text wx:if="{{item.key === themeClass}}" class="theme-option-current">当前</text>
      </view>
    </view>
  </view>

  <!-- 奇奇怪怪的设置们：中部弹窗（点遮罩关闭） -->
  <view class="weird-mask" wx:if="{{showWeirdSettings}}" bindtap="closeWeirdSettings" catchtouchmove="noop">
    <view class="weird-modal" catchtap="noop">
      <view class="weird-title">奇奇怪怪的设置们</view>
      <view class="weird-row">
        <switch class="func-switch" checked="{{publicWinrate}}" bindchange="onPublicWinrateChange" color="{{switchColor}}"/>
        <text class="func-label">公开胜率</text>
      </view>
      <view class="weird-row">
        <switch class="func-switch" checked="{{compactGame}}" bindchange="onCompactGameChange" color="{{switchColor}}"/>
        <text class="func-label">松弛压缩版</text>
      </view>
    </view>
  </view>

  <!-- 品牌菜单（点击圆徽触发，无提示） -->
  <view class="brand-menu-mask" wx:if="{{showBrandMenu}}" bindtap="closeBrandMenu" catchtouchmove="noop">
    <view class="brand-menu" catchtap="noop">
      <view class="brand-menu-row" hover-class="brand-menu-row-hover" bindtap="onBrandMenuAction" data-action="goToGlobalStats">
        <view class="func-icon-box"><image src="/images/analysis.png" class="func-icon" mode="aspectFit"/></view>
        <text class="brand-menu-label">全局统计</text>
      </view>
      <view class="brand-menu-row" hover-class="brand-menu-row-hover" bindtap="onBrandMenuAction" data-action="goToFriends">
        <view class="func-icon-box"><image src="/images/fossa.png" class="func-icon" mode="aspectFit"/></view>
        <text class="brand-menu-label">牛马朋友</text>
      </view>
      <view class="brand-menu-row" hover-class="brand-menu-row-hover" bindtap="onBrandMenuAction" data-action="onChangeTheme">
        <view class="func-icon-box"><image src="/images/themes.png" class="func-icon" mode="aspectFit"/></view>
        <text class="brand-menu-label">更改主题</text>
      </view>
      <view class="brand-menu-row" hover-class="brand-menu-row-hover" bindtap="onBrandMenuAction" data-action="showWeirdSettings">
        <view class="func-icon-box"><image src="/images/strange.png" class="func-icon" mode="aspectFit"/></view>
        <text class="brand-menu-label">奇奇怪怪的设置们</text>
      </view>
      <view class="brand-menu-row" hover-class="brand-menu-row-hover" bindtap="onBrandMenuAction" data-action="goToRecords">
        <view class="func-icon-box"><image src="/images/record.png" class="func-icon" mode="aspectFit"/></view>
        <text class="brand-menu-label">线下记录</text>
      </view>
    </view>
  </view>

  <!-- 首登资料完善弹窗（头像 / 昵称缺失时自动弹出，可跳过） -->
  <view class="setup-mask" wx:if="{{showProfileSetup}}" bindtap="closeProfileSetup" catchtouchmove="noop">
    <view class="setup-modal" catchtap="noop">
      <view class="setup-title">完善资料</view>
      <view class="setup-row">
        <text class="setup-label">头像</text>
        <button class="setup-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onSetupChooseAvatar" bindtap="onSetupAvatarTap">
          <image class="setup-avatar" src="{{setupAvatarUrl || '/images/default-avatar.png'}}"/>
        </button>
      </view>
      <view class="setup-row">
        <text class="setup-label">昵称</text>
        <input class="setup-input" type="nickname" maxlength="10" value="{{setupNickName}}" bindinput="onSetupNickInput" placeholder="请输入昵称（≤10字）"/>
      </view>
      <view class="setup-ops">
        <button class="setup-btn setup-btn-plain" size="mini" bindtap="closeProfileSetup">跳过</button>
        <button class="setup-btn setup-btn-primary" size="mini" disabled="{{!setupAvatarUrl || !setupNickName}}" bindtap="saveProfileSetup">保存</button>
      </view>
    </view>
  </view>

  <!-- 玩家胜率信息弹窗（公共组件，领奖台点击） -->
  <player-stats id="playerStats" />
</view>
