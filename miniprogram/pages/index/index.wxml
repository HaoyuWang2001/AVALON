<!--pages/index/index.wxml-->
<view class="page">
  <view class="logo-section">
    <view class="logo-icon"><text>🏰</text></view>
    <view class="logo-title">AVALON</view>
    <view class="logo-subtitle">瓦协会之练秋湖分部</view>
  </view>

  <view class="card user-card">
    <view class="user-info-section">
      <view class="user-left">
        <button size="mini" class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" binderror="onAvatarError" bindtap="onAvatarTap">
          <image src="{{userInfo.avatarUrl}}" class="avatar-img"/>
        </button>
        <view class="user-details">
          <view class="user-name-text {{customNickName ? '' : 'name-placeholder'}}" bindtap="showNickNameModal">
            {{customNickName || '改名撒！'}}<text class="user-edit-emoji">✏️</text>
          </view>
          <view class="user-status {{userStatusClass}}">{{userStatusText}}</view>
        </view>
        <view class="user-emoji-btn" bindtap="showInfoModal">ℹ️</view>
      </view>
    </view>
  </view>

  <view class="card current-room-card" wx:if="{{currentRoom}}">
    <view class="current-room-top">
      <view class="current-room-label">您当前处于房间</view>
      <view class="current-room-tags">
        <text wx:if="{{currentRoom.gameStarted}}" class="current-room-tag current-room-tag-ingame">游戏中</text>
        <text wx:else class="current-room-tag current-room-tag-wait">准备中</text>
        <text wx:if="{{isCurrentRoomHost}}" class="current-room-tag current-room-tag-host">房主</text>
      </view>
    </view>
    <view class="current-room-id">{{currentRoom.roomId}}</view>
    <view class="current-room-btns">
      <button class="btn btn-sm btn-primary room-btn" bindtap="backToRoom">回到房间</button>
      <button wx:if="{{isCurrentRoomHost}}" class="btn btn-sm btn-danger room-btn {{currentRoom.gameStarted ? 'btn-disabled' : ''}}" disabled="{{currentRoom.gameStarted}}" bindtap="disbandCurrentRoom">解散房间</button>
      <button wx:else class="btn btn-sm btn-danger room-btn {{currentRoom.gameStarted ? 'btn-disabled' : ''}}" disabled="{{currentRoom.gameStarted}}" bindtap="exitCurrentRoom">退出房间</button>
    </view>
  </view>

  <view class="card action-card" wx:if="{{!currentRoom}}">
    <view class="action-title">开始游戏</view>
    <button class="action-btn action-btn-primary" bindtap="openConfigs">
      召开会议
    </button>
    <button class="action-btn action-btn-primary" bindtap="joinRoom">
      加入会议
    </button>
  </view>

  <view class="role-stats" wx:if="{{roleStats.length > 0}}">
    <view class="role-stats-title">角色胜率</view>
    <view class="role-stats-list">
      <view class="role-stat-item" wx:for="{{roleStats}}" wx:key="role">
        <text class="role-stat-name">{{item.roleName}}</text>
        <text class="role-stat-value">{{item.wins}}/{{item.games}} ({{item.winRate}})</text>
      </view>
    </view>
  </view>

  <view class="card history-card" wx:if="{{historyList.length > 0}}">
    <view class="history-title">历史对局</view>
    <view class="history-stats" wx:if="{{totalWinRate}}">
      总胜率 {{totalWinRate}} · 蓝方 {{goodWinRate}} · 红方 {{evilWinRate}}
    </view>
    <view class="history-item" wx:for="{{historyList}}" wx:key="gameId"
          bindtap="openHistoryGame" data-gameid="{{item.gameId}}">
      <text class="history-role">{{item.roleName}}</text>
      <text class="history-duration">{{item.durationText}}</text>
      <text class="history-result {{item.isWin ? 'win' : 'lose'}}">{{item.isWin ? '胜' : '负'}}</text>
    </view>
  </view>

  <view class="footer"><view class="footer-version">AVALON v1.0.0</view></view>
</view>

<!-- 游戏说明：全屏覆盖页 -->
<view class="rules-page" wx:if="{{showInfo}}">
  <view class="rules-page-header">
    <text class="rules-page-title">游戏说明</text>
    <view class="rules-page-close" bindtap="closeInfo">✕</view>
  </view>
  <scroll-view scroll-y class="rules-page-body">
    <view class="info-item">• 5-12 人，支持标准板与自定义板子</view>
    <view class="info-item">• 支持多样村规，可扩展性拉满</view>
    <view class="info-item">• 支持线上发牌与线下发牌+小程序发车两种模式</view>
    <view class="info-item">• 支持查看历史对局和胜率统计</view>
  </scroll-view>
</view>

<!-- ─────────── Config Modal ─────────── -->
<configs id="configs" mode="create" confirm-text="召开会议" user-info="{{configsUserInfo}}" bind:success="onCreated" />
