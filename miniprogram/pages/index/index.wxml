<!--pages/index/index.wxml-->
<view class="page {{themeClass ? 'theme-' + themeClass : ''}}">
  <!-- 1. 头部 -->
  <view class="brand-bar">
    <view class="brand-text"><view class="brand-1">瓦协会</view><view class="brand-2">之</view><view class="brand-3">练秋湖分部</view></view>
  </view>

  <!-- 2. 个人信息 + 胜率冠军（合并卡） -->
  <view class="card profile-card">
    <button size="mini" class="profile-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" binderror="onAvatarError" bindtap="onAvatarTap">
      <image src="{{userInfo.avatarUrl}}" class="profile-avatar-img"/>
    </button>
    <view class="profile-name {{customNickName ? '' : 'name-placeholder'}}" bindtap="showNickNameModal">{{customNickName || '改名撒！'}}</view>
    <view class="user-emoji-btn" hover-class="user-emoji-hover" hover-stay-time="60" bindtap="showInfoModal">ℹ️</view>
    <view class="pstats">
      <view class="pstat"><text class="pstat-num">{{summary ? summary.totalGames : 0}}</text><text class="pstat-label">对局数</text></view>
      <view class="pstat-div"></view>
      <view class="pstat"><text class="pstat-num">{{summary && summary.totalGames ? summary.totalWinRate + '%' : '-'}}</text><text class="pstat-label">总胜率</text></view>
      <view class="pstat-div"></view>
      <view class="pstat"><text class="pstat-num">-</text><text class="pstat-label">获赞数</text></view>
    </view>

    <block wx:if="{{champions.length > 0}}">
      <view class="pstats-longdiv"></view>
      <view class="podium">
        <view wx:for="{{podium}}" wx:key="openId"
          class="podium-item rank-{{item.rank}}"
          bindtap="onChampionTap"
          data-openid="{{item.openId}}" data-name="{{item.nickName}}" data-avatar="{{item.avatarUrl}}"
          data-friend="{{item.isFriend}}">
          <view class="podium-avatar-wrap">
            <text wx:if="{{item.rank === 1}}" class="podium-crown">👑</text>
            <image src="{{item.avatarUrl || '/images/default-avatar.png'}}" class="podium-avatar"></image>
            <view class="podium-badge">{{item.rank}}</view>
          </view>
          <text class="podium-name">{{item.nickName}}</text>
          <text class="podium-rate">{{item.winRate}}%</text>
          <view class="podium-stand">{{item.rank}}</view>
        </view>
      </view>
    </block>

    <!-- 最勤劳的小蜜蜂：全局完成局数最多 -->
    <block wx:if="{{hardworking}}">
      <view class="pstats-longdiv"></view>
      <view class="bee-award" bindtap="onChampionTap"
            data-openid="{{hardworking.openId}}" data-name="{{hardworking.nickName}}"
            data-avatar="{{hardworking.avatarUrl}}" data-friend="{{hardworking.isFriend}}">
        <view class="bee-avatar-wrap">
          <image class="bee-avatar" src="{{hardworking.avatarUrl || '/images/default-avatar.png'}}"/>
          <text class="bee-emoji">🐝</text>
        </view>
        <view class="bee-info">
          <view class="bee-badge">最勤劳的小蜜蜂</view>
          <text class="bee-name">{{hardworking.nickName}}</text>
        </view>
        <text class="bee-games">{{hardworking.games}} 场</text>
      </view>
    </block>
  </view>

  <!-- 4. 房间 / 开始游戏 -->
  <view class="card current-room-card" wx:if="{{currentRoom}}">
    <view class="current-room-top">
      <view class="current-room-label">您当前处于房间</view>
      <view class="current-room-tags">
        <text wx:if="{{currentRoom.gameStarted}}" class="current-room-tag current-room-tag-ingame">游戏中</text>
        <text wx:else class="current-room-tag current-room-tag-wait">准备中</text>
        <text wx:if="{{isCurrentRoomHost}}" class="current-room-tag current-room-tag-host">房主</text>
      </view>
    </view>
    <view class="current-room-id">{{currentRoom.roomId}}</view>
    <view class="current-room-btns">
      <button class="btn btn-sm btn-primary room-btn" bindtap="backToRoom">回到房间</button>
      <button wx:if="{{isCurrentRoomHost}}" class="btn btn-sm btn-danger room-btn {{currentRoom.gameStarted ? 'btn-disabled' : ''}}" disabled="{{currentRoom.gameStarted}}" bindtap="disbandCurrentRoom">解散房间</button>
      <button wx:else class="btn btn-sm btn-danger room-btn {{currentRoom.gameStarted && currentSeat >= 1 ? 'btn-disabled' : ''}}" disabled="{{currentRoom.gameStarted && currentSeat >= 1}}" bindtap="exitCurrentRoom">退出房间</button>
    </view>
  </view>

  <!-- 召开会议 / 加入会议（合并按钮：(A) 对角全切；左上靛青=召开，右下银=加入） -->
  <view class="meeting-btn" hover-class="meeting-press" hover-stay-time="80" wx:if="{{!currentRoom}}">
    <view class="meeting-zone lead" hover-class="zone-hover" bindtap="openConfigs">
      <view class="meeting-content">
        <image class="meeting-icon" src="/images/sword.png" mode="aspectFit"/>
        <text class="meeting-label">召开会议</text>
      </view>
    </view>
    <view class="meeting-zone join" hover-class="zone-hover" bindtap="joinRoom">
      <view class="meeting-content">
        <image class="meeting-icon" src="/images/door.png" mode="aspectFit"/>
        <text class="meeting-label">加入会议</text>
      </view>
    </view>
  </view>

  <!-- 功能格 2×2（直接放置；第一行彩蛋风 / 第二行玻璃质感） -->
  <view class="func-grid">
    <view class="func-item func-egg" hover-class="func-hover" hover-stay-time="80" bindtap="goToGlobalStats">
      <view class="func-icon-box"><image src="/images/medal.png" class="func-icon" mode="aspectFit"/></view>
      <text class="func-label">全局统计</text>
      <view class="func-badge">彩蛋</view>
    </view>
    <view class="func-item func-egg" hover-class="func-hover" hover-stay-time="80" bindtap="goToFriends">
      <view class="func-icon-box"><image src="/images/fossa.png" class="func-icon" mode="aspectFit"/></view>
      <text class="func-label">牛马朋友</text>
      <view class="func-badge">彩蛋</view>
    </view>
    <view class="func-item func-glass" hover-class="func-hover" hover-stay-time="80" bindtap="onChangeTheme">
      <view class="func-icon-box"><text class="func-emoji">🎨</text></view>
      <text class="func-label">更改主题</text>
    </view>
    <view class="func-item func-glass">
      <switch class="func-switch" checked="{{publicWinrate}}" bindchange="onPublicWinrateChange" color="#8B5CF6"/>
      <text class="func-label">公开胜率</text>
    </view>
  </view>

  <!-- 6. 角色胜率（公共组件，角色卡可点开对局弹窗） -->
  <role-stats-card wx:if="{{roleStats.length > 0}}" roles="{{roleStats}}" summary="{{summary}}" games="{{historyList}}" />

  <!-- 7. 历史对局（公共组件） -->
  <view class="card history-card" wx:if="{{historyList.length > 0}}">
    <history-card title="历史对局" games="{{historyList}}" />
  </view>

  <view class="footer"><view class="footer-version">AVALON v1.0.0</view></view>

  <!-- 游戏说明：全屏覆盖页 -->
  <view class="rules-page" wx:if="{{showInfo}}">
    <view class="rules-page-header">
      <text class="rules-page-title">游戏说明</text>
      <view class="rules-page-close" bindtap="closeInfo">✕</view>
    </view>
    <scroll-view scroll-y class="rules-page-body">
      <view class="info-item">• 5-12 人，支持标准局 / 专家局 / 自定义板子</view>
      <view class="info-item">• 支持多样村规，可扩展性拉满</view>
      <view class="info-item">• 线上发牌与线下发牌+小程序发车两种模式</view>
      <view class="info-item">• 好友系统、胜率统计、全服对局排行一应俱全</view>
    </scroll-view>
  </view>

  <!-- 玩家胜率信息弹窗（公共组件） -->
  <player-stats id="playerStats" />
</view>

<!-- ─────────── Config Modal ─────────── -->
<configs id="configs" mode="create" confirm-text="召开会议" user-info="{{configsUserInfo}}" bind:success="onCreated" />
