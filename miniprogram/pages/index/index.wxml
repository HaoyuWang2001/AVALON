<!--pages/index/index.wxml-->
<view class="page">
  <view class="logo-section">
    <view class="logo-icon"><text>🏰</text></view>
    <view class="logo-title">AVALON</view>
    <view class="logo-subtitle">瓦协会之练秋湖分部</view>
  </view>

  <view class="card user-card">
    <view class="user-info-section">
      <view class="user-left">
        <button wx:if="{{userInfo.avatarUrl}}" class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" size="mini">
          <image src="{{userInfo.avatarUrl}}" class="avatar-img"/>
        </button>
        <button wx:else class="avatar-btn avatar-placeholder" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" size="mini">
          <text class="placeholder-icon">👤</text>
        </button>
        <view class="user-details">
          <input type="nickname" class="user-name-input" value="{{userInfo.nickName}}" placeholder="点击设置微信昵称" bindinput="onNickInput"/>
          <view class="user-game-nick">游戏内昵称：{{customNickName || '未设置'}}</view>
          <view class="user-status">在线</view>
        </view>
        <view class="edit-nick-btn btn-round" bindtap="showNickNameModal">更改昵称</view>
      </view>
    </view>
  </view>

  <view class="card action-card">
    <view class="action-title">开始游戏</view>
    <button class="action-btn action-btn-primary" bindtap="showConfig">
      <text class="btn-icon">🎮</text>创建房间
    </button>
    <button class="action-btn action-btn-primary" bindtap="joinRoom">
      <text class="btn-icon">🚪</text>加入房间
    </button>
  </view>

  <view class="card info-card">
    <view class="info-title">游戏说明</view>
    <view class="info-item">• 支持5-12人同时游戏</view>
    <view class="info-item">• 根据线下座位设置玩家号码</view>
    <view class="info-item">• 自定义板子，由房主配置</view>
    <view class="info-item">• 首车头、发车顺序均可指定</view>
  </view>
  <view class="footer"><view class="footer-version">AVALON v1.0.0</view></view>
</view>

<!-- ─────────── Config Modal ─────────── -->
<view class="config-overlay" wx:if="{{showConfig}}">
  <view class="config-panel">

    <!-- Top bar -->
    <view class="top-bar">
      <view class="config-close" bindtap="closeConfig">
        <text class="close-text">✕</text>
      </view>
    </view>

    <!-- Swiper -->
    <swiper class="config-swiper" current="{{swiperPage}}" bindchange="onSwiperChange" duration="300">
      
      <!-- Page 0: 人数+角色+湖仙 -->
      <swiper-item>
        <scroll-view scroll-y class="config-scroll" show-scrollbar="{{false}}">
          <view class="config-section">
            <view class="section-title">🙋 玩家总数</view>
            <scroll-view class="count-row" scroll-x show-scrollbar="{{false}}">
              <view wx:for="{{[5,6,7,8,9,10,11,12]}}" wx:key="*this"
                class="count-item {{playerCount === item ? 'count-active' : ''}}"
                data-count="{{item}}" bindtap="onPlayerCountChange">{{item}}</view>
            </scroll-view>

            <view class="team-sizes">
              <text class="team-sizes-label">每轮发车人数（固定）</text>
              <view class="team-sizes-row">
                <view wx:for="{{teamSizes}}" wx:key="index" class="team-badge">
                  <text class="team-badge-note" style="color:transparent"> </text>
                  <text class="team-badge-count">{{item}}人</text>
                  <text class="team-badge-note">{{index === 3 && playerCount >= 7 ? '保护轮' : ' '}}</text>
                </view>
              </view>
            </view>
          </view>

          <view class="config-section">
            <view class="section-title">🛡️ 好人</view>
            <scroll-view class="role-scroll" scroll-x show-scrollbar="{{false}}">
            <view class="role-scroll-row">
              <view class="role-card role-loyal">
                <view class="role-img-placeholder">
                  <text class="role-img-text">🛡️</text>
                </view>
                <text class="role-name">忠臣</text>
                <text class="loyal-count">×{{loyalCount}}</text>
              </view>
              <view wx:for="{{['merlin','percival','lancelotBlue']}}" wx:key="*this"
                class="role-card role-good {{selectedRoles[item] ? 'role-selected' : ''}}"
                data-role="{{item}}" bindtap="onRoleToggle">
                <view class="role-img-placeholder">
                  <text class="role-img-text">🛡️</text>
                </view>
                <text class="role-name">{{item === 'merlin' ? '梅林' : item === 'percival' ? '派西' : '蓝兰'}}</text>
                <view class="role-check {{selectedRoles[item] ? 'check-on' : ''}}">
                  <text wx:if="{{selectedRoles[item]}}">✓</text>
                </view>
              </view>
            </view>
            </scroll-view>
          </view>

          <view class="config-section">
            <view class="section-title">⚔️ 坏人</view>
            <scroll-view class="role-scroll" scroll-x show-scrollbar="{{false}}">
            <view class="role-scroll-row">
              <view wx:for="{{['morgana','assassin','oberon','mordred','minion','lancelotRed']}}" wx:key="*this"
                class="role-card role-evil {{selectedRoles[item] ? 'role-selected' : ''}}"
                data-role="{{item}}" bindtap="onRoleToggle">
                <view class="role-img-placeholder">
                  <text class="role-img-text">⚔️</text>
                </view>
                <text class="role-name">{{item === 'morgana' ? '莫甘娜' : item === 'assassin' ? '刺客' : item === 'oberon' ? '奥伯伦' : item === 'mordred' ? '莫德雷德' : item === 'minion' ? '爪牙' : '红兰'}}</text>
                <view class="role-check {{selectedRoles[item] ? 'check-on' : ''}}">
                  <text wx:if="{{selectedRoles[item]}}">✓</text>
                </view>
              </view>
            </view>
            </scroll-view>
          </view>

          <view class="role-summary" wx:if="{{roleWarning}}">
            <text class="role-warning">⚠️ {{roleWarning}}</text>
          </view>

          <view class="config-section">
            <view class="section-title">🏞️ 湖中仙女</view>
            <view class="rule-row">
              <text class="rule-label">启用湖中仙女</text>
              <switch checked="{{ladyOfTheLake}}" bindchange="onLadyToggle" color="#8B5CF6"/>
            </view>
            <view class="rule-row" wx:if="{{ladyOfTheLake}}">
              <text class="rule-label">生效轮次</text>
              <picker class="rule-picker" mode="selector" range="{{[1,2,3,4,5]}}" value="{{ladyOfTheLakeRound - 1}}" bindchange="onLadyRoundChange">
                <text>第 {{ladyOfTheLakeRound}} 轮发车成功后可用</text>
              </picker>
            </view>
          </view>
          <view style="height:40rpx"></view>
        </scroll-view>
      </swiper-item>

      <!-- Page 1: 必须设置项 -->
      <swiper-item>
        <scroll-view scroll-y class="config-scroll" show-scrollbar="{{false}}">
          <view class="config-section">
            <view class="section-title">📋 基础规则</view>
            <view class="rule-row">
              <view class="rule-col">
                <text class="rule-label">流车上限</text>
                <text class="rule-desc">每轮最多流车 {{rules.maxFailedNominations}} 次，第 {{rules.maxFailedNominations + 1}} 辆车直接发出</text>
              </view>
              <picker class="rule-picker" mode="selector" range="{{[1,2,3,4,5]}}" value="{{rules.maxFailedNominations - 1}}" data-field="maxFailedNominations" bindchange="onRulePicker">
                <text>{{rules.maxFailedNominations}} 次</text>
              </picker>
            </view>
            <view class="rule-row">
              <view class="rule-col">
                <text class="rule-label">坏人互知身份</text>
                <text class="rule-desc">除奥伯伦外，坏人互相知道对方具体身份</text>
              </view>
              <switch checked="{{rules.evilKnowsEachOther}}" data-field="evilKnowsEachOther" bindchange="onRuleToggle" color="#8B5CF6"/>
            </view>
            <view class="rule-row">
              <view class="rule-col">
                <text class="rule-label">票型公开</text>
                <text class="rule-desc">组队投票时是否展示每个人的投票结果</text>
              </view>
              <view class="segment">
                <view class="segment-item {{rules.voteVisibility === 'public' ? 'segment-active' : ''}}" data-field="voteVisibility" data-val="public" bindtap="onRuleSegment">公开</view>
                <view class="segment-item {{rules.voteVisibility === 'anonymous' ? 'segment-active' : ''}}" data-field="voteVisibility" data-val="anonymous" bindtap="onRuleSegment">匿名</view>
              </view>
            </view>
            <view class="rule-row">
              <view class="rule-col">
                <text class="rule-label">失败详情</text>
                <text class="rule-desc">任务失败时显示几票失败 or 仅知成败</text>
              </view>
              <view class="segment">
                <view class="segment-item {{rules.missionFailDetail === 'count' ? 'segment-active' : ''}}" data-field="missionFailDetail" data-val="count" bindtap="onRuleSegment">票数</view>
                <view class="segment-item {{rules.missionFailDetail === 'binary' ? 'segment-active' : ''}}" data-field="missionFailDetail" data-val="binary" bindtap="onRuleSegment">成败</view>
              </view>
            </view>
          </view>

          <view class="config-section" hidden="{{!selectedRoles.oberon && !selectedRoles.lancelotRed}}">
            <view class="section-title">💣 坏人强制任务失败</view>
            <view class="rule-row" hidden="{{!selectedRoles.oberon}}">
              <view class="rule-col">
                <text class="rule-label">奥伯伦必须任务失败</text>
                <text class="rule-desc">若被选入任务队伍，必须投失败票</text>
              </view>
              <switch checked="{{rules.oberonMustFailMission}}" data-field="oberonMustFailMission" bindchange="onRuleToggle" color="#8B5CF6"/>
            </view>
            <view class="rule-row" hidden="{{!selectedRoles.lancelotRed}}">
              <view class="rule-col">
                <text class="rule-label">红兰必须任务失败</text>
                <text class="rule-desc">若被选入任务队伍，必须投失败票</text>
              </view>
              <switch checked="{{rules.redLancelotMustFailMission}}" data-field="redLancelotMustFailMission" bindchange="onRuleToggle" color="#8B5CF6"/>
            </view>
          </view>
        </scroll-view>
      </swiper-item>

      <!-- Page 2: 兰斯洛特配置 (conditional) -->
      <swiper-item hidden="{{!selectedRoles.lancelotBlue && !selectedRoles.lancelotRed}}">
        <scroll-view scroll-y class="config-scroll" show-scrollbar="{{false}}">
          <view class="config-section">
            <view class="section-title">⚔️ 兰斯洛特配置</view>
            <view class="rule-row" hidden="{{!selectedRoles.lancelotBlue || !selectedRoles.lancelotRed}}">
              <view class="rule-col">
                <text class="rule-label">兰斯互知身份</text>
                <text class="rule-desc">蓝兰与红兰在视野中知道对方身份</text>
              </view>
              <switch checked="{{rules.lancelotsKnowEachOther}}" data-field="lancelotsKnowEachOther" bindchange="onRuleToggle" color="#8B5CF6"/>
            </view>
            <view class="rule-row">
              <view class="rule-col">
                <text class="rule-label">兰斯换身轮次</text>
                <text class="rule-desc">第几轮起抽取身份转换卡（0=不转换）</text>
              </view>
              <picker class="rule-picker" mode="selector" range="{{[0,1,2,3,4,5]}}" value="{{rules.lancelotSwapRound}}" data-field="lancelotSwapRound" bindchange="onRulePicker">
                <text>{{rules.lancelotSwapRound === 0 ? '不转换' : '第 ' + rules.lancelotSwapRound + ' 轮'}}</text>
              </picker>
            </view>
          </view>
        </scroll-view>
      </swiper-item>

      <!-- Page 3: 保留位 -->
      <swiper-item hidden="{{true}}"></swiper-item>

      <!-- Page 4: 梅林视野 (conditional) -->
      <swiper-item hidden="{{!selectedRoles.merlin}}">
        <scroll-view scroll-y class="config-scroll" show-scrollbar="{{false}}">
          <view class="config-section">
            <view class="section-title">👁️ 梅林能看到的人</view>
            <scroll-view class="role-scroll" scroll-x show-scrollbar="{{false}}">
            <view class="role-scroll-row">
              <view wx:if="{{selectedRoles.assassin}}"
                class="role-card role-evil {{merlinCanSee.assassin ? 'role-selected' : ''}}"
                data-role="assassin" bindtap="onCanSeeToggle">
                <view class="role-img-placeholder"><text class="role-img-text">👤</text></view>
                <text class="role-name">刺客</text>
                <view class="role-check {{merlinCanSee.assassin ? 'check-on' : ''}}"><text wx:if="{{merlinCanSee.assassin}}">✓</text></view>
              </view>
              <view wx:if="{{selectedRoles.morgana}}"
                class="role-card role-evil {{merlinCanSee.morgana ? 'role-selected' : ''}}"
                data-role="morgana" bindtap="onCanSeeToggle">
                <view class="role-img-placeholder"><text class="role-img-text">👤</text></view>
                <text class="role-name">莫甘娜</text>
                <view class="role-check {{merlinCanSee.morgana ? 'check-on' : ''}}"><text wx:if="{{merlinCanSee.morgana}}">✓</text></view>
              </view>
              <view wx:if="{{selectedRoles.oberon}}"
                class="role-card role-evil {{merlinCanSee.oberon ? 'role-selected' : ''}}"
                data-role="oberon" bindtap="onCanSeeToggle">
                <view class="role-img-placeholder"><text class="role-img-text">👤</text></view>
                <text class="role-name">奥伯伦</text>
                <view class="role-check {{merlinCanSee.oberon ? 'check-on' : ''}}"><text wx:if="{{merlinCanSee.oberon}}">✓</text></view>
              </view>
              <view wx:if="{{selectedRoles.minion}}"
                class="role-card role-evil {{merlinCanSee.minion ? 'role-selected' : ''}}"
                data-role="minion" bindtap="onCanSeeToggle">
                <view class="role-img-placeholder"><text class="role-img-text">👤</text></view>
                <text class="role-name">爪牙</text>
                <view class="role-check {{merlinCanSee.minion ? 'check-on' : ''}}"><text wx:if="{{merlinCanSee.minion}}">✓</text></view>
              </view>
              <view wx:if="{{selectedRoles.lancelotRed}}"
                class="role-card role-evil {{merlinCanSee.lancelotRed ? 'role-selected' : ''}}"
                data-role="lancelotRed" bindtap="onCanSeeToggle">
                <view class="role-img-placeholder"><text class="role-img-text">👤</text></view>
                <text class="role-name">红兰</text>
                <view class="role-check {{merlinCanSee.lancelotRed ? 'check-on' : ''}}"><text wx:if="{{merlinCanSee.lancelotRed}}">✓</text></view>
              </view>
              <view wx:if="{{selectedRoles.lancelotBlue}}"
                class="role-card role-evil {{merlinCanSee.lancelotBlue ? 'role-selected' : ''}}"
                data-role="lancelotBlue" bindtap="onCanSeeToggle">
                <view class="role-img-placeholder"><text class="role-img-text">👤</text></view>
                <text class="role-name">蓝兰</text>
                <view class="role-check {{merlinCanSee.lancelotBlue ? 'check-on' : ''}}"><text wx:if="{{merlinCanSee.lancelotBlue}}">✓</text></view>
              </view>
            </view>
            </scroll-view>
          </view>

          <view class="config-section">
            <view class="section-title">🔍 梅林能分辨具体身份</view>
            <scroll-view class="role-scroll" scroll-x show-scrollbar="{{false}}">
            <view class="role-scroll-row">
              <view wx:if="{{merlinCanSee.assassin && selectedRoles.assassin}}"
                class="role-card role-evil {{merlinCanIdentify.assassin ? 'role-selected' : ''}}"
                data-role="assassin" bindtap="onCanIdentifyToggle">
                <view class="role-img-placeholder"><text class="role-img-text">🔍</text></view>
                <text class="role-name">刺客</text>
                <view class="role-check {{merlinCanIdentify.assassin ? 'check-on' : ''}}"><text wx:if="{{merlinCanIdentify.assassin}}">✓</text></view>
              </view>
              <view wx:if="{{merlinCanSee.morgana && selectedRoles.morgana}}"
                class="role-card role-evil {{merlinCanIdentify.morgana ? 'role-selected' : ''}}"
                data-role="morgana" bindtap="onCanIdentifyToggle">
                <view class="role-img-placeholder"><text class="role-img-text">🔍</text></view>
                <text class="role-name">莫甘娜</text>
                <view class="role-check {{merlinCanIdentify.morgana ? 'check-on' : ''}}"><text wx:if="{{merlinCanIdentify.morgana}}">✓</text></view>
              </view>
              <view wx:if="{{merlinCanSee.oberon && selectedRoles.oberon}}"
                class="role-card role-evil {{merlinCanIdentify.oberon ? 'role-selected' : ''}}"
                data-role="oberon" bindtap="onCanIdentifyToggle">
                <view class="role-img-placeholder"><text class="role-img-text">🔍</text></view>
                <text class="role-name">奥伯伦</text>
                <view class="role-check {{merlinCanIdentify.oberon ? 'check-on' : ''}}"><text wx:if="{{merlinCanIdentify.oberon}}">✓</text></view>
              </view>
              <view wx:if="{{merlinCanSee.minion && selectedRoles.minion}}"
                class="role-card role-evil {{merlinCanIdentify.minion ? 'role-selected' : ''}}"
                data-role="minion" bindtap="onCanIdentifyToggle">
                <view class="role-img-placeholder"><text class="role-img-text">🔍</text></view>
                <text class="role-name">爪牙</text>
                <view class="role-check {{merlinCanIdentify.minion ? 'check-on' : ''}}"><text wx:if="{{merlinCanIdentify.minion}}">✓</text></view>
              </view>
              <view wx:if="{{merlinCanSee.lancelotRed && selectedRoles.lancelotRed}}"
                class="role-card role-evil {{merlinCanIdentify.lancelotRed ? 'role-selected' : ''}}"
                data-role="lancelotRed" bindtap="onCanIdentifyToggle">
                <view class="role-img-placeholder"><text class="role-img-text">🔍</text></view>
                <text class="role-name">红兰</text>
                <view class="role-check {{merlinCanIdentify.lancelotRed ? 'check-on' : ''}}"><text wx:if="{{merlinCanIdentify.lancelotRed}}">✓</text></view>
              </view>
              <view wx:if="{{merlinCanSee.lancelotBlue && selectedRoles.lancelotBlue}}"
                class="role-card role-evil {{merlinCanIdentify.lancelotBlue ? 'role-selected' : ''}}"
                data-role="lancelotBlue" bindtap="onCanIdentifyToggle">
                <view class="role-img-placeholder"><text class="role-img-text">🔍</text></view>
                <text class="role-name">蓝兰</text>
                <view class="role-check {{merlinCanIdentify.lancelotBlue ? 'check-on' : ''}}"><text wx:if="{{merlinCanIdentify.lancelotBlue}}">✓</text></view>
              </view>
            </view>
            </scroll-view>
          </view>
          <view style="height:40rpx"></view>
        </scroll-view>
      </swiper-item>

      <!-- Page 5: 时间+信息+创建 -->
      <swiper-item>
        <scroll-view scroll-y class="config-scroll" show-scrollbar="{{false}}">
          <view class="config-section">
            <view class="section-title">⏱️ 时间限制</view>
            <view class="rule-row">
              <text class="rule-label">发言限时</text>
              <picker class="rule-picker" mode="selector" range="{{speechOptions}}" value="{{speechTimeoutIndex}}" data-field="speechTimeoutIndex" bindchange="onLimitChange">
                <text>{{speechOptions[speechTimeoutIndex]}}</text>
              </picker>
            </view>
            <view class="rule-row">
              <text class="rule-label">任务超时</text>
              <picker class="rule-picker" mode="selector" range="{{roundOptions}}" value="{{roundTimeoutIndex}}" data-field="roundTimeoutIndex" bindchange="onLimitChange">
                <text>{{roundOptions[roundTimeoutIndex]}}</text>
              </picker>
            </view>
            <view class="rule-row">
              <text class="rule-label">投票超时</text>
              <picker class="rule-picker" mode="selector" range="{{voteOptions}}" value="{{voteTimeoutIndex}}" data-field="voteTimeoutIndex" bindchange="onLimitChange">
                <text>{{voteOptions[voteTimeoutIndex]}}</text>
              </picker>
            </view>
            <view class="rule-hint">
              💡 若任务或投票超时，未行动视为投出成功票或赞成票（必须出失败票的角色仍会出失败票）。
            </view>
          </view>

          <view class="config-section">
            <view class="section-title">📝 房间信息</view>
            <view class="meta-row">
              <text class="rule-label">房间名</text>
              <input class="meta-input" placeholder="{{customNickName || '房主'}}的房间" value="{{roomName}}" data-field="roomName" bindinput="onMetaInput"/>
            </view>
            <view class="meta-row">
              <text class="rule-label">描述</text>
              <input class="meta-input" placeholder="欢迎所有玩家" value="{{roomDescription}}" data-field="roomDescription" bindinput="onMetaInput"/>
            </view>
          </view>

          <view class="create-section">
            <button class="create-btn" bindtap="createRoom" disabled="{{roleWarning !== ''}}">🎮 创建房间</button>
          </view>
          <view style="height:60rpx"></view>
        </scroll-view>
      </swiper-item>

    </swiper>

    <!-- Navigation bar -->
    <view class="nav-bar">
      <view class="nav-btn btn-square {{logicalPage === 0 ? 'nav-disabled' : ''}}" bindtap="prevPage">◀ 上一步</view>
      <view class="nav-dots">
        <view wx:for="{{visiblePages}}" wx:key="*this" class="nav-dot {{index === logicalPage ? 'dot-active' : ''}}"></view>
      </view>
      <view class="nav-btn btn-square {{logicalPage === visiblePages.length - 1 ? 'nav-disabled' : ''}}" bindtap="nextPage">下一步 ▶</view>
    </view>
  </view>
</view>
