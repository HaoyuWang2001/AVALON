<!--pages/index/index.wxml-->
<view class="page {{themeClass ? 'theme-' + themeClass : ''}}">
  <!-- 品牌栏（单行）：左圆徽+字标，最右为个人头像（点击进入个人页） -->
  <view class="brand-bar">
    <view class="brand-main">
      <view class="brand-emblem"><text class="brand-emblem-char">瓦</text></view>
      <text class="brand-title">练秋湖的瓦协会</text>
    </view>
    <view class="brand-avatar" hover-class="brand-avatar-hover" hover-stay-time="60" bindtap="goToMe">
      <image class="brand-avatar-img" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" catchtap="goToMe"/>
    </view>
  </view>

  <!-- 个人卡：我的排名 + 胜率前三领奖台 -->
  <view class="card profile-card" wx:if="{{myRank || champions.length > 0}}">
    <view class="profile-rank-row" wx:if="{{myRank}}">
      <text class="profile-rank-label">我的排名</text>
      <text class="profile-rank">#{{myRank}}</text>
    </view>
    <block wx:if="{{champions.length > 0}}">
      <view class="podium-title">胜率前三</view>
      <view class="podium">
        <view wx:for="{{podium}}" wx:key="openId"
          class="podium-item rank-{{item.rank}}"
          bindtap="onChampionTap"
          data-openid="{{item.openId}}" data-name="{{item.nickName}}" data-avatar="{{item.avatarUrl}}"
          data-friend="{{item.isFriend}}">
          <view class="podium-avatar-wrap">
            <text wx:if="{{item.rank === 1}}" class="podium-crown">👑</text>
            <image src="{{item.avatarUrl || '/images/default-avatar.png'}}" class="podium-avatar"></image>
            <view class="podium-badge">{{item.rank}}</view>
          </view>
          <text class="podium-name">{{item.nickName}}</text>
          <title-badge wx:if="{{item.titles && item.titles.length > 0}}" titles="{{item.titles}}" size="mini"></title-badge>
          <text class="podium-rate">{{item.winRate}}%</text>
          <view class="podium-stand">{{item.rank}}</view>
        </view>
      </view>
    </block>
  </view>

  <!-- 当前房间 -->
  <view class="card current-room-card" wx:if="{{currentRoom}}">
    <view class="current-room-top">
      <view class="current-room-label">您当前处于房间</view>
      <view class="current-room-tags">
        <text wx:if="{{currentRoom.gameStarted}}" class="current-room-tag current-room-tag-ingame">游戏中</text>
        <text wx:else class="current-room-tag current-room-tag-wait">准备中</text>
        <text wx:if="{{isCurrentRoomHost}}" class="current-room-tag current-room-tag-host">房主</text>
      </view>
    </view>
    <view class="current-room-id">{{currentRoom.roomId}}</view>
    <view class="current-room-btns">
      <button class="btn btn-sm btn-primary room-btn" bindtap="backToRoom">回到房间</button>
      <button wx:if="{{isCurrentRoomHost}}" class="btn btn-sm btn-danger room-btn {{currentRoom.gameStarted ? 'btn-disabled' : ''}}" disabled="{{currentRoom.gameStarted}}" bindtap="disbandCurrentRoom">解散房间</button>
      <button wx:else class="btn btn-sm btn-danger room-btn {{currentRoom.gameStarted && currentSeat >= 1 ? 'btn-disabled' : ''}}" disabled="{{currentRoom.gameStarted && currentSeat >= 1}}" bindtap="exitCurrentRoom">退出房间</button>
    </view>
  </view>

  <!-- 召开会议 / 加入会议（合并按钮：(A) 对角全切；左上靛青=召开，右下银=加入） -->
  <view class="meeting-btn {{meetingFillClass}}" style="--fill-ms:{{meetingFillMs}}ms;{{meetingPressStyle}}" wx:if="{{!currentRoom}}">
    <view class="meeting-fill"></view>
    <view class="meeting-zone lead" data-side="lead"
          bindtouchstart="onMeetingTouchStart" bindtouchmove="onMeetingTouchMove" bindtouchend="onMeetingTouchEnd" bindtouchcancel="onMeetingTouchCancel">
      <view class="meeting-content">
        <image class="meeting-icon" src="/images/sword.png" mode="aspectFit"/>
        <text class="meeting-label">召开会议</text>
      </view>
    </view>
    <view class="meeting-zone join" data-side="join"
          bindtouchstart="onMeetingTouchStart" bindtouchmove="onMeetingTouchMove" bindtouchend="onMeetingTouchEnd" bindtouchcancel="onMeetingTouchCancel">
      <view class="meeting-content">
        <image class="meeting-icon" src="/images/door.png" mode="aspectFit"/>
        <text class="meeting-label">加入会议</text>
      </view>
    </view>
  </view>

  <view class="footer"><view class="footer-version">AVALON v1.4.2</view></view>

  <!-- 首登资料完善弹窗（头像 / 昵称缺失时自动弹出，可跳过） -->
  <view class="setup-mask" wx:if="{{showProfileSetup}}" bindtap="closeProfileSetup" catchtouchmove="noop">
    <view class="setup-modal" catchtap="noop">
      <view class="setup-title">完善资料</view>
      <view class="setup-row">
        <text class="setup-label">头像</text>
        <button class="setup-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onSetupChooseAvatar" bindtap="onSetupAvatarTap">
          <image class="setup-avatar" src="{{setupAvatarUrl || '/images/default-avatar.png'}}"/>
        </button>
      </view>
      <view class="setup-row">
        <text class="setup-label">昵称</text>
        <input class="setup-input" type="nickname" maxlength="10" value="{{setupNickName}}" bindinput="onSetupNickInput" placeholder="请输入昵称（≤10字）"/>
      </view>
      <view class="setup-ops">
        <button class="setup-btn setup-btn-plain" size="mini" bindtap="closeProfileSetup">跳过</button>
        <button class="setup-btn setup-btn-primary" size="mini" disabled="{{!setupAvatarUrl || !setupNickName}}" bindtap="saveProfileSetup">保存</button>
      </view>
    </view>
  </view>

  <!-- 玩家胜率信息弹窗（公共组件，领奖台点击） -->
  <player-stats id="playerStats" />
</view>
