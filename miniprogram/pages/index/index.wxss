@import "../../styles/config.wxss";

/* pages/index/index.wxss */

.page {
  height: 100%;
  background: transparent;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}

/* ─────── 头部（三段差异化故障：霓虹流光 / 拉长 / 撕裂放大） ─────── */
.brand-bar { padding: 26rpx 0 44rpx; margin-left: -24rpx; margin-right: -24rpx; text-align: center; flex-shrink: 0; }
.brand-text {
  position: relative; display: inline-block; white-space: nowrap;
  font-size: 68rpx; font-weight: 900; letter-spacing: 4rpx; font-style: italic;
  font-family: 'ZCOOL QingKe HuangYou', 'Smiley Sans', 'PingFang SC', 'Heiti SC', 'Microsoft YaHei', sans-serif;
}
.brand-1, .brand-2, .brand-3 { position: relative; display: inline-block; -webkit-text-fill-color: currentColor; }
/* 头部文字仅亮色主题(黎明初现)显示，暗色主题隐藏 */
.theme-torch .brand-bar, .theme-aurora .brand-bar, .theme-steel .brand-bar { display: none; }

/* 瓦协会：原字体；慢速霓虹(无白) + 彩色流光滑过；故障带极小 */
.brand-1 { font-family: 'PingFang SC', 'Heiti SC', 'Microsoft YaHei', sans-serif; font-style: normal; color: var(--brand-1, #2E1065); animation: brand-neon-flicker 7s steps(1, end) infinite, brand-neon 2.4s ease-in-out infinite; }
.brand-1::after {
  content: '瓦协会'; position: absolute; left: 0; top: 0; width: 100%; pointer-events: none;
  background: linear-gradient(100deg, transparent 35%, #22D3EE 46%, #A855F7 50%, #F472B6 54%, transparent 65%);
  background-size: 250% 100%;
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: brand-sweep 3.6s linear infinite;
}
@keyframes brand-sweep { 0% { background-position: 170% 0; } 100% { background-position: -70% 0; } }
@keyframes brand-neon-flicker {
  0% { color: #FF3B30; }
  6% { color: #FF9500; }
  12% { color: #FFCC00; }
  18% { color: #34C759; }
  24% { color: #00C7BE; }
  30% { color: #30B0C7; }
  36% { color: #007AFF; }
  42% { color: #5856D6; }
  48% { color: #AF52DE; }
  54% { color: #FF2D55; }
  60% { color: #000000; }
  68% { color: #C4B5FD; }
  76% { color: #2E1065; }
  84% { color: #A855F7; }
  92% { color: #FF3B30; }
  100% { color: #FF3B30; }
}
@keyframes brand-neon {
  0%, 100% { text-shadow: 0 0 6rpx currentColor, 0 0 16rpx currentColor; }
  50% { text-shadow: 0 0 12rpx currentColor, 0 0 30rpx currentColor; }
}

/* 之：保持黑色、字号略小（无任何变化） */
.brand-2 { color: #000000; font-size: 0.86em; }

/* 练秋湖分部：主题紫实色 + 下划线 + 极短故障 burst(C) */
.brand-3 {
  color: var(--brand-3, #6D28D9);
  text-decoration: underline; text-underline-offset: 6rpx; text-decoration-color: var(--brand-3, #6D28D9);
  -webkit-text-fill-color: currentColor;
  animation: lianqiu-burst 12s steps(1, end) infinite;
}
/* C：每 5~10s 一次极短 burst（轻微错位 + 扭曲 + 细撕裂，~180ms 后复原） */
@keyframes lianqiu-burst {
  0%, 29%, 33%, 72%, 76%, 100% { transform: translate(0, 0) skewX(0deg); clip-path: inset(0 0 0 0); }
  30% { transform: translate(-3rpx, 0) skewX(4deg); clip-path: inset(38% 0 44% 0); }
  31% { transform: translate(3rpx, 0) skewX(-4deg); clip-path: inset(0 0 0 0); }
  73% { transform: translate(0, 0) skewX(0deg); clip-path: inset(0 0 0 0); }
  74% { transform: translate(3rpx, 0) skewX(-3deg); clip-path: inset(20% 0 62% 0); }
  75% { transform: translate(-3rpx, 0) skewX(3deg); clip-path: inset(0 0 0 0); }
}
/* C：故障时的 RGB 色差分离（青/红错位） */
.brand-3::before {
  content: '练秋湖分部'; position: absolute; left: 0; top: 0; width: 100%; pointer-events: none;
  color: #F43F5E; -webkit-text-fill-color: currentColor; opacity: 0;
  animation: lianqiu-chroma 12s steps(1, end) infinite;
}
@keyframes lianqiu-chroma {
  0%, 29%, 33%, 72%, 76%, 100% { opacity: 0; transform: translate(0, 0); }
  30% { opacity: 0.85; transform: translate(-4rpx, 1rpx); color: #22D3EE; }
  31% { opacity: 0.85; transform: translate(4rpx, -1rpx); color: #F43F5E; }
  74% { opacity: 0.85; transform: translate(4rpx, 1rpx); color: #22D3EE; }
  75% { opacity: 0.85; transform: translate(-4rpx, -1rpx); color: #F43F5E; }
}

/* 整串故障层：上下带极小 */
.brand-text::before, .brand-text::after {
  content: '瓦协会之练秋湖分部';
  position: absolute; left: 0; top: 0; width: 100%;
  line-height: 1;
  -webkit-text-fill-color: currentColor;
  pointer-events: none;
}
.brand-text::before { color: var(--brand-g1, #A855F7); animation: brand-tear-a 3s steps(1, end) infinite; }
.brand-text::after { color: var(--brand-g2, #000000); animation: brand-tear-b 3.4s steps(1, end) infinite; }
@keyframes brand-tear-a {
  0%, 90%, 100% { clip-path: inset(96% 0 0 0); transform: translate(0, 0); opacity: 0; }
  92% { clip-path: inset(40% 0 34% 0); transform: translate(-5rpx, -1rpx); opacity: 0.5; }
  96% { clip-path: inset(56% 0 22% 0); transform: translate(4rpx, 1rpx); opacity: 0.35; }
}
@keyframes brand-tear-b {
  0%, 90%, 100% { clip-path: inset(96% 0 0 0); transform: translate(0, 0); opacity: 0; }
  92% { clip-path: inset(30% 0 46% 0); transform: translate(5rpx, 1rpx); opacity: 0.5; }
  96% { clip-path: inset(48% 0 30% 0); transform: translate(-4rpx, -1rpx); opacity: 0.35; }
}

/* ─────── 个人信息卡（头像半嵌 + 三栏数据） ─────── */
.profile-card {
  position: relative;
  margin-top: 76rpx; margin-bottom: 20rpx;
  background: var(--profile-bg, var(--bg-card)); border-radius: 28rpx; padding: 84rpx 24rpx 26rpx;
  box-shadow: var(--shadow-sm); flex-shrink: 0;
}
.profile-avatar-btn { position: absolute; top: -70rpx; left: 36rpx; width: 140rpx !important; height: 140rpx !important; border: none; background: var(--bg-card); border-radius: 50%; overflow: hidden; padding: 0 !important; margin: 0 !important; box-sizing: border-box; z-index: 2; box-shadow: 0 0 0 8rpx rgba(196, 181, 253, 0.35), 0 8rpx 20rpx rgba(0, 0, 0, 0.15); }
.profile-avatar-btn::after { border: none; display: none; }
.profile-avatar-img { width: 100%; height: 100%; border-radius: 50%; display: block; }
.profile-name { position: absolute; top: 20rpx; left: 204rpx; right: 96rpx; height: 60rpx; line-height: 60rpx; font-size: 40rpx; font-weight: 800; color: var(--profile-fg, #FFFFFF); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.name-placeholder { color: var(--profile-fg, #FFFFFF); opacity: 0.7; font-weight: 400; }
.pstats { display: flex; align-items: center; margin: 28rpx 0; }
.pstat { flex: 1; display: flex; flex-direction: column; align-items: center; }
.pstat-num { font-size: 46rpx; font-weight: 800; color: var(--profile-fg, #FFFFFF); }
.pstat-label { font-size: 24rpx; color: var(--profile-fg, #FFFFFF); margin-top: 6rpx; }
.pstat-div { width: 6rpx; height: 60rpx; background: var(--profile-ring, #C4B5FD); border-radius: 3rpx; }
.pstats-longdiv { height: 6rpx; background: var(--profile-ring, #C4B5FD); border-radius: 3rpx; margin: 0 0 64rpx; }

/* ─────── 用户卡 emoji 按钮（游戏说明） ─────── */
.user-emoji-btn {
  margin-left: auto; flex-shrink: 0;
  width: 64rpx; height: 64rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx;
  background: var(--btn-emoji-bg, #F3F4F6);
  border: 2rpx solid var(--border-color, #E5E7EB);
  transition: transform 0.12s ease;
}
.profile-card .user-emoji-btn { position: absolute; margin: 0; top: 18rpx; right: 22rpx; z-index: 3; }
.user-emoji-hover { transform: scale(0.9); opacity: 0.8; }

.login-btn { width: 100%; background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end)); color: white; border-radius: 16rpx; font-size: 32rpx; font-weight: 600; padding: 24rpx; box-shadow: 0 6rpx 20rpx rgba(124,58,237,0.3); }

.current-room-card { background: linear-gradient(135deg, #FEF3C7, #FDE68A); border-radius: 28rpx; padding: 40rpx 36rpx; margin-bottom: 20rpx; border-left: 8rpx solid var(--warning); flex-shrink: 0; }
.current-room-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.current-room-label { font-size: 32rpx; color: #92400E; font-weight: 600; }
.current-room-id { display: block; text-align: center; font-size: 52rpx; font-weight: 800; color: #B45309; letter-spacing: 8rpx; padding: 16rpx 0; margin-bottom: 12rpx; }
.current-room-tags { display: flex; gap: 14rpx; flex-wrap: wrap; justify-content: flex-end; }
.current-room-tag { font-size: 24rpx; color: #fff; padding: 6rpx 18rpx; border-radius: 8rpx; }
.current-room-tag-ingame { background: #EF4444; }
.current-room-tag-wait { background: #3B82F6; }
.current-room-tag-host { background: #D97706; }
.current-room-btns { display: flex; gap: 20rpx; }
.room-btn { font-size: 30rpx !important; padding: 20rpx 16rpx !important; }

.action-card { background: var(--bg-card); border-radius: 24rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); flex-shrink: 0; }
.action-title { font-size: 30rpx; font-weight: 700; color: var(--gray-900); margin-bottom: 24rpx; display: flex; align-items: center; }
.action-title::before { content: ''; width: 6rpx; height: 28rpx; background: linear-gradient(180deg, var(--gradient-start), var(--gradient-end)); border-radius: 3rpx; margin-right: 14rpx; }

/* ─────── 卡牌大厅按钮 ─────── */
.gacha-card { position: relative; overflow: hidden; border-radius: 22rpx; color: #fff; box-sizing: border-box; transition: transform 0.15s ease, opacity 0.15s ease; }
.card-hover { transform: scale(0.96); opacity: 0.92; }
.gacha-card::after {
  content: ''; position: absolute; top: -20%; left: -160%; height: 140%; width: 45%;
  background: linear-gradient(105deg, transparent, rgba(255,255,255,0.32), transparent);
  transform: skewX(-20deg);
  animation: card-shimmer 3.4s ease-in-out infinite;
  pointer-events: none; z-index: 1;
}
.gacha-main {
  display: flex; align-items: center; height: 200rpx; padding: 0 30rpx; margin-bottom: 20rpx;
  background: linear-gradient(135deg, #6D28D9 0%, #5B21B6 45%, #3B0764 100%);
  border: 2rpx solid rgba(167,139,250,0.45);
  box-shadow: 0 12rpx 32rpx rgba(91,33,182,0.32), inset 0 1rpx 0 rgba(255,255,255,0.25);
}
.gacha-main-icon {
  width: 120rpx; height: 120rpx; border-radius: 26rpx; flex-shrink: 0; margin-right: 24rpx;
  background: rgba(255,255,255,0.14); display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.2);
}
.gacha-main-info { flex: 1; min-width: 0; }
.gacha-main-title { display: block; font-size: 38rpx; font-weight: 800; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3); }
.gacha-sub { width: 100%; box-sizing: border-box; padding: 20rpx 22rpx; min-height: 176rpx; display: flex; flex-direction: row; align-items: center; }
.gacha-epic {
  background: linear-gradient(135deg, #94A3B8, #475569);
  border: 2rpx solid rgba(226,232,240,0.6);
  box-shadow: 0 8rpx 20rpx rgba(100,116,139,0.35);
}
.gacha-epic::after { animation-delay: 1.1s; }
.gacha-sub-icon {
  width: 76rpx; height: 76rpx; border-radius: 16rpx; flex-shrink: 0;
  background: rgba(255,255,255,0.16); display: flex; align-items: center; justify-content: center;
  font-size: 38rpx; margin-right: 16rpx; box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.18);
}
.gacha-sub-info { flex: 1; min-width: 0; }
.gacha-sub-title { display: block; font-size: 30rpx; font-weight: 800; }
.gacha-icon-img-lg { width: 100rpx; height: 100rpx; }
.gacha-icon-img { width: 60rpx; height: 60rpx; }
@keyframes card-shimmer { 0% { left: -160%; } 60%, 100% { left: 160%; } }

/* ─────── 功能卡（2×2 宫格） ─────── */
.func-card { background: var(--bg-card); border-radius: 24rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); flex-shrink: 0; }
.func-grid { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20rpx; }
.func-item {
  width: 48%; box-sizing: border-box; min-height: 156rpx;
  border-radius: 20rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx;
  position: relative; overflow: hidden; color: #fff;
}
.func-hover { transform: scale(0.96); opacity: 0.92; }
.func-icon { width: 42rpx; height: 42rpx; }
.func-emoji { font-size: 36rpx; }
.func-row { flex-direction: row; gap: 16rpx; }
.func-icon-box { width: 64rpx; height: 64rpx; border-radius: 16rpx; background: rgba(255, 255, 255, 0.16); display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.18); }
.func-label { font-size: 28rpx; font-weight: 700; }
.func-switch { transform: scale(0.9); }

/* 右上角「彩蛋」标签（与旧版同款：彩虹流光 + 抖动） */
.func-badge {
  position: absolute; top: 12rpx; right: 14rpx; z-index: 3;
  font-size: 30rpx; font-weight: 800; letter-spacing: 2rpx;
  padding: 6rpx 20rpx; border-radius: 12rpx; color: #fff;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.25);
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
  background: linear-gradient(120deg, #ef4444, #f97316, #eab308, #22c55e, #06b6d4, #3b82f6, #a855f7, #ef4444);
  background-size: 300% 300%;
  animation: badge-shake 1.4s ease-in-out infinite, rainbow-flow 6s linear infinite;
}
@keyframes badge-shake {
  0%, 100% { transform: rotate(-8deg) translate(0, 0); }
  12% { transform: rotate(-5deg) translate(-2rpx, 1rpx); }
  24% { transform: rotate(-10deg) translate(2rpx, -2rpx); }
  36% { transform: rotate(-4deg) translate(-1rpx, 2rpx); }
  48% { transform: rotate(-9deg) translate(3rpx, -1rpx); }
  60% { transform: rotate(-6deg) translate(-2rpx, 1rpx); }
  72% { transform: rotate(-11deg) translate(1rpx, -2rpx); }
  84% { transform: rotate(-5deg) translate(-3rpx, 1rpx); }
}

/* 第一行：彩蛋风（流动彩虹描边加粗 + 主题卡面） */
.func-egg {
  background: linear-gradient(120deg, #ef4444, #f97316, #eab308, #22c55e, #06b6d4, #3b82f6, #a855f7, #ef4444);
  background-size: 400% 400%;
  animation: rainbow-flow 6s linear infinite;
  box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.32);
}
.func-egg::before {
  content: ''; position: absolute; top: 14rpx; left: 14rpx; right: 14rpx; bottom: 14rpx;
  border-radius: 12rpx; background: var(--func-face, #1F2937);
}
.func-egg .func-icon, .func-egg .func-emoji, .func-egg .func-label { position: relative; z-index: 1; }
@keyframes rainbow-flow { 0% { background-position: 0% 50%; } 100% { background-position: 400% 50%; } }

/* 第二行：玻璃色系（更强玻璃质感：多层渐变 + 顶部高光 + 对角光泽 + 内描边） */
.func-glass {
  background: var(--glass-bg);
  border: 3rpx solid var(--glass-border);
  box-shadow: 0 0 26rpx var(--glass-glow), inset 0 0 26rpx var(--glass-glow), inset 0 3rpx 0 var(--glass-sheen), inset 0 -8rpx 20rpx rgba(255, 255, 255, 0.10);
  backdrop-filter: blur(22rpx);
  -webkit-backdrop-filter: blur(22rpx);
}
.func-glass::after {
  content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none;
  background: linear-gradient(135deg, var(--glass-sheen) 0%, transparent 38%, transparent 62%, var(--glass-sheen) 100%), radial-gradient(circle at 22% 12%, rgba(255, 255, 255, 0.35), transparent 45%);
  opacity: 0.6;
}
.func-glass .func-icon, .func-glass .func-label, .func-glass .func-switch { position: relative; z-index: 1; }
.func-rate { flex-direction: row; gap: 14rpx; }
.func-glass .func-label { color: #F2F0FF; text-shadow: 0 0 10rpx var(--glass-glow); }

.info-card { background: var(--bg-card); border-radius: 24rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); flex-shrink: 0; }
.info-item { font-size: 26rpx; color: var(--gray-500); line-height: 1.8; }
.footer { text-align: center; padding: 16rpx 0; color: var(--text-muted); font-size: 22rpx; flex-shrink: 0; }

/* 历史对局（外层卡片；内容由 history-card 组件渲染） */
.history-card { background: var(--bg-card); border-radius: 24rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); flex-shrink: 0; }

/* ─────── 游戏说明：全屏覆盖页 ─────── */
.rules-page { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1100; background: var(--bg-card); display: flex; flex-direction: column; }
.rules-page-header { height: 100rpx; display: flex; align-items: center; justify-content: space-between; padding: 0 32rpx; border-bottom: 1rpx solid var(--gray-100); flex-shrink: 0; }
.rules-page-title { font-size: 34rpx; font-weight: 800; color: var(--gray-900); }
.rules-page-close { width: 56rpx; height: 56rpx; border-radius: 12rpx; background: var(--gray-100); display: flex; align-items: center; justify-content: center; font-size: 32rpx; color: var(--gray-600); }
.rules-page-body { flex: 1; padding: 32rpx; }
.rules-page-body .info-item { font-size: 28rpx; color: var(--gray-600); line-height: 1.9; margin-bottom: 12rpx; }

/* 按钮禁用态 */
.btn-disabled {
  background: #d1d5db !important;
  color: #9ca3af !important;
}

/* ─────── 胜率冠军（领奖台） ─────── */
.podium { display: flex; align-items: flex-end; justify-content: center; gap: 16rpx; padding-top: 0; }
.podium-item { flex: 1; max-width: 190rpx; display: flex; flex-direction: column; align-items: center; }
.podium-avatar-wrap { position: relative; margin-bottom: 10rpx; }
.podium-avatar { width: 112rpx; height: 112rpx; border-radius: 50%; border: 4rpx solid var(--gray-300); background: var(--gray-100); }
.rank-1 .podium-avatar { width: 148rpx; height: 148rpx; border-color: #FFD700; animation: champ-glow 2.2s ease-in-out infinite; }
.rank-2 .podium-avatar { border-color: #B8C0C9; }
.rank-3 .podium-avatar { border-color: #CD7F32; }
.podium-crown { position: absolute; top: -62rpx; left: 50%; font-size: 66rpx; animation: crown-float 1.8s ease-in-out infinite; }
.podium-badge { position: absolute; bottom: -8rpx; left: 50%; transform: translateX(-50%); width: 40rpx; height: 40rpx; border-radius: 50%; background: #333; color: #FFD700; font-size: 24rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; border: 2rpx solid #FFD700; }
.rank-2 .podium-badge { color: #CDD5DD; border-color: #B8C0C9; }
.rank-3 .podium-badge { color: #E8A56A; border-color: #CD7F32; }
.podium-name { font-size: 28rpx; color: var(--champion-fg, #FFFFFF); max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 6rpx; }
.podium-rate { display: block; margin: 14rpx 0; font-size: 38rpx; font-weight: 800; color: #FFD700; }
.rank-2 .podium-rate { color: #CDD5DD; }
.rank-3 .podium-rate { color: #E8A56A; }
.podium-stand { width: 100%; margin-top: 10rpx; border-radius: 14rpx 14rpx 0 0; display: flex; align-items: center; justify-content: center; font-size: 40rpx; font-weight: 800; color: rgba(255, 255, 255, 0.85); }
.rank-1 .podium-stand { height: 96rpx; background: linear-gradient(180deg, #FFD700, #B8860B); }
.rank-2 .podium-stand { height: 66rpx; background: linear-gradient(180deg, #C9D1D8, #8E99A4); }
.rank-3 .podium-stand { height: 48rpx; background: linear-gradient(180deg, #CD7F32, #8B4513); }
@keyframes crown-float { 0%, 100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(-10rpx); } }
@keyframes champ-glow { 0%, 100% { box-shadow: 0 0 18rpx rgba(255, 215, 0, 0.55); } 50% { box-shadow: 0 0 34rpx rgba(255, 215, 0, 0.95); } }
