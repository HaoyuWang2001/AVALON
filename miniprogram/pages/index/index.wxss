@import "../../styles/config.wxss";

/* pages/index/index.wxss */

.page {
  height: 100%;
  background: transparent;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}

/* ─────── 品牌栏（单行：圆徽 + 字标 + 右侧个人头像） ─────── */
.brand-bar {
  display: flex; align-items: center; justify-content: space-between; gap: 20rpx;
  padding: 22rpx 0 28rpx; flex-shrink: 0;
}
.brand-main { display: flex; align-items: center; gap: 16rpx; flex: 1; min-width: 0; }
.brand-emblem {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  border: 4rpx solid var(--gold); flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 0 18rpx rgba(212, 160, 82, 0.38);
}
.brand-emblem-char { font-size: 50rpx; font-weight: 900; color: var(--gold); line-height: 1; }
.brand-title {
  font-size: 50rpx; font-weight: 900; letter-spacing: 4rpx;
  color: var(--brand-1, var(--gold));
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.brand-avatar {
  position: relative; z-index: 5;
  width: 104rpx; height: 104rpx; border-radius: 50%; flex-shrink: 0;
  overflow: hidden; border: 4rpx solid var(--gold); background: var(--bg-page);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.18);
}
.brand-avatar-img { width: 100%; height: 100%; display: block; }
.brand-avatar-hover { transform: scale(0.94); opacity: 0.9; }

/* ─────── 个人卡（我的排名 + 胜率前三领奖台） ─────── */
.profile-card {
  position: relative;
  margin-top: 4rpx; margin-bottom: 20rpx;
  background: var(--profile-bg, var(--bg-card)); border-radius: 28rpx; padding: 24rpx;
  background-size: 170% 170%;
  animation: profile-breathe 7s ease-in-out infinite;
  box-shadow: var(--shadow-sm); flex-shrink: 0;
}
@keyframes profile-breathe {
  0%, 100% { background-position: 15% 15%; }
  50%      { background-position: 85% 85%; }
}
.profile-rank-row { display: flex; align-items: center; justify-content: space-between; padding: 2rpx 6rpx 14rpx; }
.profile-rank-left { display: flex; align-items: baseline; gap: 12rpx; min-width: 0; }
.profile-rank-label { font-size: 28rpx; font-weight: 600; color: var(--text-muted); }
.profile-rank { font-size: 44rpx; font-weight: 800; color: var(--primary); }
.profile-rank-btn {
  flex-shrink: 0; font-size: 26rpx; font-weight: 700;
  padding: 10rpx 24rpx; border-radius: 999rpx;
  color: var(--primary); background: var(--primary-bg);
  border: 2rpx solid var(--primary);
}
.profile-rank-btn-hover { transform: scale(0.94); opacity: 0.88; }

.current-room-card { background: var(--gold-bg); border-radius: 28rpx; padding: 40rpx 36rpx; margin-bottom: 20rpx; border-left: 8rpx solid var(--gold); flex-shrink: 0; }
.current-room-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.current-room-label { font-size: 32rpx; color: var(--gold); font-weight: 600; }
.current-room-id { display: block; text-align: center; font-size: 52rpx; font-weight: 800; color: var(--gold); letter-spacing: 8rpx; padding: 16rpx 0; margin-bottom: 12rpx; }
.current-room-tags { display: flex; gap: 14rpx; flex-wrap: wrap; justify-content: flex-end; }
.current-room-tag { font-size: 24rpx; padding: 6rpx 18rpx; border-radius: 8rpx; }
.current-room-tag-ingame { background: var(--label-red-bg); color: var(--label-red); }
.current-room-tag-wait { background: var(--label-blue-bg); color: var(--label-blue); }
.current-room-tag-host { background: var(--label-orange-bg); color: var(--label-orange); }
.current-room-btns { display: flex; gap: 20rpx; }
.room-btn { font-size: 30rpx !important; padding: 20rpx 16rpx !important; }

/* ─────── 召开/加入会议（合并按钮·对角全切） ─────── */
.meeting-btn {
  position: relative; width: 100%; height: 220rpx; margin-bottom: 20rpx;
  border-radius: 24rpx; overflow: hidden; box-sizing: border-box;
  background: linear-gradient(135deg, #3730A3 0%, #312E81 40%, #64748B 60%, #475569 100%);
  box-shadow: 0 12rpx 32rpx rgba(30,41,59,0.35), inset 0 2rpx 0 rgba(255,255,255,0.35);
  transition: transform 0.2s ease;
}
/* 点击后该半区颜色软边铺满（对角线渐变扫过，无硬边界） */
.meeting-fill { position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none; background-repeat: no-repeat; background-size: 260% 260%; }
.meeting-btn.filling-lead .meeting-fill {
  background-image: linear-gradient(135deg, #3730A3 0%, #312E81 40%, rgba(49,46,129,0) 68%, rgba(49,46,129,0) 100%);
  animation: meeting-fill-lead var(--fill-ms, 700ms) ease-out forwards;
}
.meeting-btn.filling-join .meeting-fill {
  background-image: linear-gradient(135deg, rgba(71,85,105,0) 0%, rgba(71,85,105,0) 32%, #64748B 60%, #475569 100%);
  animation: meeting-fill-join var(--fill-ms, 700ms) ease-out forwards;
}
@keyframes meeting-fill-lead { from { background-position: 100% 100%; } to { background-position: 0% 0%; } }
@keyframes meeting-fill-join { from { background-position: 0% 0%; } to { background-position: 100% 100%; } }
.meeting-zone { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
.meeting-zone.lead { clip-path: polygon(0 0, 100% 0, 0 100%); }
.meeting-zone.join { clip-path: polygon(100% 0, 100% 100%, 0 100%); }
.meeting-content { position: absolute; display: flex; flex-direction: row; align-items: center; gap: 14rpx; white-space: nowrap; }
.meeting-zone.lead .meeting-content { left: 25%; top: 33%; transform: translate(-50%, -50%); }
.meeting-zone.join .meeting-content { right: 25%; top: 67%; transform: translate(50%, -50%); }
.meeting-icon { width: 56rpx; height: 56rpx; flex-shrink: 0; }
.meeting-label { font-size: 34rpx; font-weight: 800; color: var(--on-primary); white-space: nowrap; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.35); }

.footer { text-align: center; padding: 16rpx 0; color: var(--text-muted); font-size: 22rpx; flex-shrink: 0; }

/* ─────── 首登资料完善弹窗 ─────── */
.setup-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1300;
  background: var(--mask-light); display: flex; align-items: center; justify-content: center;
}
.setup-modal {
  width: 600rpx; box-sizing: border-box; background: var(--bg-card);
  border-radius: 28rpx; padding: 40rpx 36rpx 28rpx; box-shadow: var(--shadow-lg);
}
.setup-title { font-size: 34rpx; font-weight: 800; color: var(--text-title); text-align: center; margin-bottom: 28rpx; }
.setup-row { display: flex; align-items: center; gap: 24rpx; padding: 18rpx 0; }
.setup-label { width: 90rpx; flex-shrink: 0; font-size: 28rpx; color: var(--text-muted); }
.setup-avatar-btn {
  width: 120rpx !important; height: 120rpx !important; padding: 0 !important; margin: 0 !important;
  border: none; background: transparent; border-radius: 50%; overflow: hidden; line-height: 1;
}
.setup-avatar-btn::after { border: none; display: none; }
.setup-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; display: block; background: var(--gray-100); }
.setup-input {
  flex: 1; min-width: 0; font-size: 30rpx; color: var(--text-title);
  background: var(--bg-page); border-radius: 14rpx; padding: 16rpx 20rpx; box-sizing: border-box;
}
.setup-ops { display: flex; gap: 16rpx; margin-top: 28rpx; }
.setup-btn { flex: 1; border-radius: 999rpx; font-size: 28rpx; font-weight: 700; }
.setup-btn-plain { background: var(--bg-page); color: var(--text-muted); }
.setup-btn-primary { background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end)); color: var(--on-primary); }
.setup-btn[disabled] { opacity: 0.45; color: var(--on-primary); background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end)); }

/* ─────── 胜率冠军（领奖台） ─────── */
.podium { display: flex; align-items: flex-start; justify-content: center; gap: 16rpx; padding-top: 0; margin-bottom: 4rpx; }
.podium-item { flex: 1; max-width: 190rpx; display: flex; flex-direction: column; align-items: center; }
.podium-avatar-wrap { position: relative; width: 100%; height: 156rpx; display: flex; align-items: flex-end; justify-content: center; margin-bottom: 8rpx; }
.podium-avatar { width: 112rpx; height: 112rpx; border-radius: 50%; border: 4rpx solid var(--gray-300); background: var(--gray-100); }
.rank-1 .podium-avatar { width: 148rpx; height: 148rpx; border-color: var(--medal-gold); animation: champ-glow 2.2s ease-in-out infinite; }
.rank-2 .podium-avatar { border-color: var(--medal-silver); }
.rank-3 .podium-avatar { border-color: var(--medal-bronze); }
.podium-crown { position: absolute; top: -62rpx; left: 50%; font-size: 66rpx; animation: crown-float 1.8s ease-in-out infinite; }
.podium-badge { position: absolute; bottom: -8rpx; left: 50%; transform: translateX(-50%); width: 40rpx; height: 40rpx; border-radius: 50%; background: var(--medal-badge-bg); color: var(--medal-gold); font-size: 24rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; border: 2rpx solid var(--medal-gold); }
.rank-2 .podium-badge { color: var(--medal-silver-text); border-color: var(--medal-silver); }
.rank-3 .podium-badge { color: var(--medal-bronze-light); border-color: var(--medal-bronze); }
.podium-name { font-size: 28rpx; color: var(--champion-fg); max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 6rpx; }
.podium-rate { display: block; margin: 10rpx 0 0; font-size: 36rpx; font-weight: 800; color: var(--medal-gold); }
.rank-2 .podium-rate { color: var(--medal-silver-text); }
.rank-3 .podium-rate { color: var(--medal-bronze-light); }
.rank-1 .rank-2 .rank-3 
@keyframes crown-float { 0%, 100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(-10rpx); } }
@keyframes champ-glow { 0%, 100% { box-shadow: 0 0 18rpx rgba(255, 215, 0, 0.55); } 50% { box-shadow: 0 0 34rpx rgba(255, 215, 0, 0.95); } }

/* ─────────────────────────────────────────────────────────
 * 有意保留的硬编码（豁免，不做 token 化）：
 *   - 召开会议按钮对角渐变（装饰性）
 * 这些颜色属于一次性装饰/固定深色组件，不参与主题与语义体系。
 * ───────────────────────────────────────────────────────── */

/* ─────── 功能卡（2×3 宫格，房间卡下方） ─────── */
.func-grid { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20rpx; margin-bottom: 20rpx; }
.func-item {
  width: 48%; box-sizing: border-box; min-height: 156rpx;
  border-radius: 20rpx; display: flex; flex-direction: row; align-items: center; justify-content: flex-start; gap: 18rpx;
  padding: 0 22rpx; position: relative; overflow: hidden; color: var(--on-primary);
}
.func-hover { transform: scale(0.96); opacity: 0.92; }
.func-disabled { opacity: 0.45; pointer-events: none; }
.func-icon { width: 48rpx; height: 48rpx; }
.func-emoji { font-size: 48rpx; }
.func-icon-box { width: 72rpx; height: 72rpx; border-radius: 16rpx; background: rgba(255, 255, 255, 0.16); display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.18); }
.func-label { font-size: 30rpx; font-weight: 800; }
.func-switch { transform: scale(0.9); }

/* 右上角「彩蛋」标签（彩虹流光 + 抖动） */
.func-badge {
  position: absolute; top: 12rpx; right: 14rpx; z-index: 3;
  font-size: 32rpx; font-weight: 800; letter-spacing: 2rpx;
  padding: 6rpx 20rpx; border-radius: 12rpx; color: var(--on-primary);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.25);
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
  background: linear-gradient(120deg, #ef4444, #f97316, #eab308, #22c55e, #06b6d4, #3b82f6, #a855f7, #ef4444);
  background-size: 300% 300%;
  animation: badge-shake 1.4s ease-in-out infinite, rainbow-flow 6s linear infinite;
}
@keyframes badge-shake {
  0%, 100% { transform: rotate(-8deg) translate(0, 0); }
  12% { transform: rotate(-5deg) translate(-2rpx, 1rpx); }
  24% { transform: rotate(-10deg) translate(2rpx, -2rpx); }
  36% { transform: rotate(-4deg) translate(-1rpx, 2rpx); }
  48% { transform: rotate(-9deg) translate(3rpx, -1rpx); }
  60% { transform: rotate(-6deg) translate(-2rpx, 1rpx); }
  72% { transform: rotate(-11deg) translate(1rpx, -2rpx); }
  84% { transform: rotate(-5deg) translate(-3rpx, 1rpx); }
}

/* 第一行：彩蛋风（流动彩虹描边加粗 + 主题卡面） */
.func-egg {
  background: linear-gradient(120deg, #ef4444, #f97316, #eab308, #22c55e, #06b6d4, #3b82f6, #a855f7, #ef4444);
  background-size: 400% 400%;
  animation: rainbow-flow 6s linear infinite;
  box-shadow: 0 8rpx 24rpx var(--egg-glow);
}
.func-egg::before {
  content: ''; position: absolute; top: 7rpx; left: 7rpx; right: 7rpx; bottom: 7rpx;
  border-radius: 15rpx; background: var(--func-face);
}
.func-egg .func-icon-box, .func-egg .func-icon, .func-egg .func-emoji, .func-egg .func-label { position: relative; z-index: 1; }
@keyframes rainbow-flow { 0% { background-position: 0% 50%; } 100% { background-position: 400% 50%; } }

/* 第二行：玻璃色系 */
.func-glass {
  background: var(--func-face);
  border: 2rpx solid rgba(255, 255, 255, 0.30);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.32), inset 0 0 26rpx rgba(255, 255, 255, 0.10), 0 4rpx 14rpx rgba(0, 0, 0, 0.28);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}
.func-glass::after {
  content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.22) 0%, transparent 44%, transparent 58%, rgba(255, 255, 255, 0.10) 100%);
}
.func-glass .func-icon-box, .func-glass .func-icon, .func-glass .func-emoji, .func-glass .func-label, .func-glass .func-switch { position: relative; z-index: 1; }

/* 奇奇怪怪的设置们：中部弹窗（点遮罩关闭） */
.weird-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1150; background: var(--mask-light); display: flex; align-items: center; justify-content: center; }
.weird-modal { width: 560rpx; box-sizing: border-box; background: var(--bg-card); border-radius: 24rpx; padding: 36rpx 32rpx 24rpx; box-shadow: var(--shadow-lg); }
.weird-title { font-size: 32rpx; font-weight: 800; color: var(--text-title); text-align: center; margin-bottom: 20rpx; }
.weird-row { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 4rpx; }
.weird-row + .weird-row { border-top: 1rpx solid var(--divider); }
.weird-row .func-label { color: var(--text-body); }

/* ─────── 公开房间列表（等待中 / 游戏中） ─────── */
.room-list-section { margin-bottom: 20rpx; flex-shrink: 0; }
.room-tabs { display: flex; gap: 44rpx; padding: 2rpx 10rpx 16rpx; }
.room-tab {
  position: relative; font-size: 32rpx; font-weight: 700;
  color: var(--text-muted); padding-bottom: 12rpx;
}
.room-tab-on { color: var(--text-title); }
.room-tab-on::after {
  content: ''; position: absolute; left: 50%; bottom: 0; transform: translateX(-50%);
  width: 48rpx; height: 6rpx; border-radius: 3rpx; background: var(--primary);
}
.room-tab-count {
  margin-left: 8rpx; font-size: 22rpx; font-weight: 700;
  color: var(--text-muted); background: var(--gray-100);
  border-radius: 999rpx; padding: 2rpx 12rpx;
}
.room-list-empty { text-align: center; color: var(--text-muted); font-size: 28rpx; padding: 48rpx 0; }
.room-card {
  background: var(--bg-card); border-radius: 24rpx; padding: 24rpx;
  margin-bottom: 16rpx; box-shadow: var(--shadow-sm);
  border: 3rpx solid transparent;
}
.room-card-is-mine { border-color: var(--primary); }
.room-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.room-card-id-wrap { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.room-card-id { font-size: 40rpx; font-weight: 800; color: var(--gold); letter-spacing: 4rpx; }
.room-card-mine-tag {
  flex-shrink: 0; font-size: 20rpx; font-weight: 700;
  color: var(--primary); background: var(--primary-bg);
  border-radius: 8rpx; padding: 4rpx 12rpx;
}
.room-card-count { flex-shrink: 0; font-size: 30rpx; font-weight: 800; color: var(--text-title); }
.room-tags-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; margin-bottom: 14rpx; }
.room-tag {
  font-size: 22rpx; color: var(--text-body);
  background: var(--gray-100); border-radius: 999rpx; padding: 6rpx 16rpx;
}
.room-tag-more { font-size: 22rpx; font-weight: 700; color: var(--primary); padding: 6rpx 12rpx; }
.room-avatars-row { display: flex; align-items: center; }
.room-avatar {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  border: 3rpx solid var(--bg-page); background: var(--gray-100);
  margin-left: -14rpx;
}
.room-avatar:first-child { margin-left: 0; }
.current-room-tag-count { background: var(--gray-100); color: var(--text-body); }
