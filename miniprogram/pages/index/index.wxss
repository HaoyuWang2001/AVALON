@import "../../styles/config.wxss";

/* pages/index/index.wxss */

.page {
  height: 100%;
  background: transparent;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}

.logo-section { padding: 32rpx 0 20rpx; text-align: center; flex-shrink: 0; }
.logo-icon { width: 120rpx; height: 120rpx; margin: 0 auto 24rpx; background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end)); border-radius: 32rpx; display: flex; align-items: center; justify-content: center; box-shadow: 0 12rpx 32rpx rgba(124,58,237,0.25); }
.logo-icon text { font-size: 60rpx; }
.logo-title { font-size: 48rpx; font-weight: 800; background: linear-gradient(135deg, var(--primary-deep), var(--primary-deeper)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; letter-spacing: 6rpx; }
.logo-subtitle { font-size: 26rpx; color: var(--gray-400); margin-top: 8rpx; letter-spacing: 4rpx; }

.user-card { background: #FFFFFF; border-radius: 24rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); display: flex; align-items: center; flex-shrink: 0; }
.user-info-section { width: 100%; }
.user-left { display: flex; align-items: center; width: 100%; }
.avatar-wrap { position: relative; width: 100rpx; height: 100rpx; border-radius: 50%; border: 6rpx solid #C4B5FD; background: #FFFFFF; flex-shrink: 0; overflow: hidden; }
.avatar-img { position: absolute; top: -6rpx; left: -6rpx; right: -6rpx; bottom: -6rpx; border-radius: 50%; width: auto; height: auto; }
.avatar-tap { position: absolute; top: 0; left: 0; right: 0; bottom: 0; opacity: 0; padding: 0; margin: 0; background: transparent; }
.avatar-tap::after { border: none; display: none; }
.user-details { margin-left: 24rpx; flex: 1; min-width: 0; }
.wx-nick-wrap { position: relative; }
.user-name-text { font-size: 34rpx; font-weight: 700; color: var(--gray-900); height: 50rpx; line-height: 50rpx; }
.name-placeholder { color: var(--gray-400); font-weight: 400; }
/* 隐藏的微信昵称授权 input：label 点击聚焦触发微信昵称弹窗，移出可视区不可见不拦截 */
.wx-nick-input-hidden { position: fixed; left: -9999px; width: 1rpx; height: 1rpx; opacity: 0; }
.user-game-nick-row { display: flex; align-items: center; justify-content: space-between; }
.user-game-nick { font-size: 34rpx; color: var(--primary); font-weight: 600; }
.user-status { font-size: 28rpx; color: var(--success); margin-top: 4rpx; display: flex; align-items: center; }
.user-status::before { content: ''; width: 12rpx; height: 12rpx; background: var(--success); border-radius: 50%; margin-right: 10rpx; }
.user-status.status-ingame { color: var(--danger); }
.user-status.status-ingame::before { background: var(--danger); }
.user-status.status-inroom { color: #3B82F6; }
.user-status.status-inroom::before { background: #3B82F6; }
.user-divider { height: 1rpx; background: #E5E7EB; margin: 24rpx 0; }
.edit-nick-btn { font-size: 24rpx; flex-shrink: 0; }

.login-btn { width: 100%; background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end)); color: white; border-radius: 16rpx; font-size: 32rpx; font-weight: 600; padding: 24rpx; box-shadow: 0 6rpx 20rpx rgba(124,58,237,0.3); }

.current-room-card { background: linear-gradient(135deg, #FEF3C7, #FDE68A); border-radius: 28rpx; padding: 40rpx 36rpx; margin-bottom: 20rpx; border-left: 8rpx solid var(--warning); flex-shrink: 0; }
.current-room-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.current-room-label { font-size: 32rpx; color: #92400E; font-weight: 600; }
.current-room-id { display: block; text-align: center; font-size: 52rpx; font-weight: 800; color: #B45309; letter-spacing: 8rpx; padding: 16rpx 0; margin-bottom: 12rpx; }
.current-room-tags { display: flex; gap: 14rpx; flex-wrap: wrap; justify-content: flex-end; }
.current-room-tag { font-size: 24rpx; color: #fff; padding: 6rpx 18rpx; border-radius: 8rpx; }
.current-room-tag-ingame { background: #EF4444; }
.current-room-tag-wait { background: #3B82F6; }
.current-room-tag-host { background: #D97706; }
.current-room-btns { display: flex; gap: 20rpx; }
.room-btn { font-size: 30rpx !important; padding: 20rpx 16rpx !important; }

.action-card { background: #FFFFFF; border-radius: 24rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); flex-shrink: 0; }
.action-title { font-size: 30rpx; font-weight: 700; color: var(--gray-900); margin-bottom: 24rpx; display: flex; align-items: center; }
.action-title::before { content: ''; width: 6rpx; height: 28rpx; background: linear-gradient(180deg, var(--gradient-start), var(--gradient-end)); border-radius: 3rpx; margin-right: 14rpx; }
.action-btn { width: 100%; padding: 22rpx; border-radius: 16rpx; font-size: 32rpx; font-weight: 600; margin-bottom: 28rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.action-btn:last-child { margin-bottom: 0; }
.action-btn-primary { background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end)); color: white; box-shadow: 0 6rpx 20rpx rgba(124,58,237,0.3); }
.action-btn-primary::after { border: none; }
.action-btn-secondary { background: var(--gray-50); color: var(--gray-700); border: 2rpx solid var(--gray-200); }
.action-btn-secondary::after { border: none; }
.btn-icon { font-size: 36rpx; margin-right: 14rpx; }

.info-card { background: #FFFFFF; border-radius: 24rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); flex-shrink: 0; }
.info-title { font-size: 28rpx; font-weight: 600; color: var(--gray-900); margin-bottom: 16rpx; }
.info-item { font-size: 26rpx; color: var(--gray-500); line-height: 1.8; }
.footer { text-align: center; padding: 16rpx 0; color: var(--gray-300); font-size: 22rpx; flex-shrink: 0; }

/* ─────── 历史对局 ─────── */
.history-card { background: #FFFFFF; border-radius: 24rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); flex-shrink: 0; }
.history-title { font-size: 30rpx; font-weight: 700; color: var(--gray-900); margin-bottom: 12rpx; display: flex; align-items: center; }
.history-title::before { content: ''; width: 6rpx; height: 28rpx; background: linear-gradient(180deg, var(--gradient-start), var(--gradient-end)); border-radius: 3rpx; margin-right: 14rpx; }
.history-stats { font-size: 24rpx; color: var(--gray-600); margin-bottom: 16rpx; }
.history-item { display: flex; align-items: center; padding: 18rpx 8rpx; border-bottom: 1rpx solid var(--gray-100); }
.history-item:last-child { border-bottom: none; }
.history-item:active { opacity: 0.7; }
.history-role { font-size: 30rpx; font-weight: 600; color: var(--gray-900); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.history-result { font-size: 26rpx; font-weight: 700; padding: 4rpx 18rpx; border-radius: 8rpx; margin: 0 20rpx; flex-shrink: 0; }
.history-result.win { color: var(--success); background: #DCFCE7; }
.history-result.lose { color: var(--danger); background: #FEE2E2; }
.history-duration { font-size: 24rpx; color: var(--gray-600); flex-shrink: 0; }

/* ─────── 角色胜率 ─────── */
.role-stats { background: #FFFFFF; border-radius: 24rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); flex-shrink: 0; }
.role-stats-title { font-size: 30rpx; font-weight: 700; color: var(--gray-900); margin-bottom: 16rpx; display: flex; align-items: center; }
.role-stats-title::before { content: ''; width: 6rpx; height: 28rpx; background: linear-gradient(180deg, var(--gradient-start), var(--gradient-end)); border-radius: 3rpx; margin-right: 14rpx; }
.role-stats-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.role-stat-item { display: flex; align-items: center; background: var(--gray-50); border-radius: 12rpx; padding: 12rpx 18rpx; }
.role-stat-name { font-size: 26rpx; font-weight: 600; color: var(--gray-800); margin-right: 12rpx; }
.role-stat-value { font-size: 24rpx; color: var(--gray-500); }

/* ─────── 游戏说明按钮 ─────── */
.gameinfo-btn { background: #FFFFFF; border-radius: 24rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 600; color: var(--gray-700); flex-shrink: 0; }

/* ─────── 说明弹窗 ─────── */
.info-modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; }
.info-modal-body { position: relative; z-index: 999; width: 600rpx; background: #FFFFFF; border-radius: 28rpx; padding: 40rpx 36rpx; display: flex; flex-direction: column; align-items: center; }
.info-modal-body .info-title { font-size: 34rpx; font-weight: 800; margin-bottom: 24rpx; text-align: center; }
.info-modal-body .info-item { font-size: 28rpx; color: var(--gray-600); line-height: 1.9; margin-bottom: 12rpx; align-self: flex-start; }
.info-modal-body .btn { margin-top: 24rpx; width: 100%; }

/* 按钮禁用态：游戏中退出/解散置灰不可点 */
.btn-disabled {
  background: #d1d5db !important;
  color: #9ca3af !important;
}
