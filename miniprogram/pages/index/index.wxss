@import "../../styles/config.wxss";

/* pages/index/index.wxss */

.page {
  height: 100%;
  background: transparent;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}

/* ─────── 头部（黑暗潮流：霓虹辉光 + 故障抖动） ─────── */
.brand-bar { padding: 24rpx 4rpx 20rpx; text-align: center; flex-shrink: 0; }
.brand-text {
  position: relative; display: inline-block;
  font-size: 44rpx; font-weight: 900; letter-spacing: 8rpx; color: #ECE9FF;
  animation: brand-glow 2.6s ease-in-out infinite, brand-shake 3.6s steps(3, end) infinite;
}
.brand-text::before, .brand-text::after {
  content: '瓦协会之练秋湖分部';
  position: absolute; left: 0; top: 0; width: 100%;
  pointer-events: none;
}
.brand-text::before { color: #22D3EE; clip-path: inset(0 0 58% 0); animation: brand-glitch-a 2.8s infinite; }
.brand-text::after { color: #F43F5E; clip-path: inset(58% 0 0 0); animation: brand-glitch-b 3.2s infinite; }
@keyframes brand-glow {
  0%, 100% { text-shadow: 0 0 6rpx rgba(139, 92, 246, 0.9), 0 0 18rpx rgba(139, 92, 246, 0.6), 0 0 34rpx rgba(59, 130, 246, 0.45); }
  50% { text-shadow: 0 0 10rpx rgba(139, 92, 246, 1), 0 0 28rpx rgba(139, 92, 246, 0.85), 0 0 52rpx rgba(59, 130, 246, 0.7); }
}
@keyframes brand-shake {
  0%, 90%, 100% { transform: translate(0, 0); }
  92% { transform: translate(-2rpx, 1rpx); }
  94% { transform: translate(2rpx, -1rpx); }
  96% { transform: translate(-1rpx, -1rpx); }
  98% { transform: translate(1rpx, 1rpx); }
}
@keyframes brand-glitch-a { 0%, 88%, 100% { transform: translate(0, 0); opacity: 0.9; } 90% { transform: translate(-3rpx, -1rpx); opacity: 1; } 93% { transform: translate(2rpx, 1rpx); } }
@keyframes brand-glitch-b { 0%, 86%, 100% { transform: translate(0, 0); opacity: 0.9; } 89% { transform: translate(3rpx, 1rpx); opacity: 1; } 92% { transform: translate(-2rpx, -1rpx); } }

/* ─────── 个人信息卡（放大） ─────── */
.profile-card {
  position: relative;
  background: var(--bg-card); border-radius: 28rpx; padding: 44rpx 32rpx; margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm); display: flex; align-items: center; flex-shrink: 0;
}
.avatar-btn { width: 160rpx !important; height: 160rpx !important; border: 6rpx solid var(--primary-light); background: var(--bg-card); border-radius: 50%; overflow: hidden; padding: 0 !important; margin: 0 !important; flex-shrink: 0; box-sizing: border-box; display: flex !important; align-items: center; justify-content: center; line-height: normal; }
.avatar-btn::after { border: none; display: none; }
.avatar-img { width: 148rpx; height: 148rpx; border-radius: 50%; display: block; }
.profile-info { margin-left: 32rpx; flex: 1; min-width: 0; }
.user-name-text { font-size: 46rpx; font-weight: 800; color: var(--text-title); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.name-placeholder { color: var(--text-muted); font-weight: 400; }

/* ─────── 用户卡 emoji 按钮（游戏说明） ─────── */
.user-emoji-btn {
  margin-left: auto; flex-shrink: 0;
  width: 64rpx; height: 64rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx;
  background: var(--btn-emoji-bg, #F3F4F6);
  border: 2rpx solid var(--border-color, #E5E7EB);
  transition: transform 0.12s ease;
}
.user-emoji-hover { transform: scale(0.9); opacity: 0.8; }

.login-btn { width: 100%; background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end)); color: white; border-radius: 16rpx; font-size: 32rpx; font-weight: 600; padding: 24rpx; box-shadow: 0 6rpx 20rpx rgba(124,58,237,0.3); }

.current-room-card { background: linear-gradient(135deg, #FEF3C7, #FDE68A); border-radius: 28rpx; padding: 40rpx 36rpx; margin-bottom: 20rpx; border-left: 8rpx solid var(--warning); flex-shrink: 0; }
.current-room-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.current-room-label { font-size: 32rpx; color: #92400E; font-weight: 600; }
.current-room-id { display: block; text-align: center; font-size: 52rpx; font-weight: 800; color: #B45309; letter-spacing: 8rpx; padding: 16rpx 0; margin-bottom: 12rpx; }
.current-room-tags { display: flex; gap: 14rpx; flex-wrap: wrap; justify-content: flex-end; }
.current-room-tag { font-size: 24rpx; color: #fff; padding: 6rpx 18rpx; border-radius: 8rpx; }
.current-room-tag-ingame { background: #EF4444; }
.current-room-tag-wait { background: #3B82F6; }
.current-room-tag-host { background: #D97706; }
.current-room-btns { display: flex; gap: 20rpx; }
.room-btn { font-size: 30rpx !important; padding: 20rpx 16rpx !important; }

.action-card { background: var(--bg-card); border-radius: 24rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); flex-shrink: 0; }
.action-title { font-size: 30rpx; font-weight: 700; color: var(--gray-900); margin-bottom: 24rpx; display: flex; align-items: center; }
.action-title::before { content: ''; width: 6rpx; height: 28rpx; background: linear-gradient(180deg, var(--gradient-start), var(--gradient-end)); border-radius: 3rpx; margin-right: 14rpx; }

/* ─────── 卡牌大厅按钮 ─────── */
.gacha-card { position: relative; overflow: hidden; border-radius: 22rpx; color: #fff; box-sizing: border-box; transition: transform 0.15s ease, opacity 0.15s ease; }
.card-hover { transform: scale(0.96); opacity: 0.92; }
.gacha-card::after {
  content: ''; position: absolute; top: -20%; left: -160%; height: 140%; width: 45%;
  background: linear-gradient(105deg, transparent, rgba(255,255,255,0.32), transparent);
  transform: skewX(-20deg);
  animation: card-shimmer 3.4s ease-in-out infinite;
  pointer-events: none; z-index: 1;
}
.gacha-main {
  display: flex; align-items: center; height: 200rpx; padding: 0 30rpx; margin-bottom: 20rpx;
  background: linear-gradient(135deg, #6D28D9 0%, #5B21B6 45%, #3B0764 100%);
  border: 2rpx solid rgba(167,139,250,0.45);
  box-shadow: 0 12rpx 32rpx rgba(91,33,182,0.32), inset 0 1rpx 0 rgba(255,255,255,0.25);
}
.gacha-main-icon {
  width: 120rpx; height: 120rpx; border-radius: 26rpx; flex-shrink: 0; margin-right: 24rpx;
  background: rgba(255,255,255,0.14); display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.2);
}
.gacha-main-info { flex: 1; min-width: 0; }
.gacha-main-title { display: block; font-size: 38rpx; font-weight: 800; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3); }
.gacha-sub { width: 100%; box-sizing: border-box; padding: 20rpx 22rpx; min-height: 176rpx; display: flex; flex-direction: row; align-items: center; }
.gacha-epic {
  background: linear-gradient(135deg, #94A3B8, #475569);
  border: 2rpx solid rgba(226,232,240,0.6);
  box-shadow: 0 8rpx 20rpx rgba(100,116,139,0.35);
}
.gacha-epic::after { animation-delay: 1.1s; }
.gacha-sub-icon {
  width: 76rpx; height: 76rpx; border-radius: 16rpx; flex-shrink: 0;
  background: rgba(255,255,255,0.16); display: flex; align-items: center; justify-content: center;
  font-size: 38rpx; margin-right: 16rpx; box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.18);
}
.gacha-sub-info { flex: 1; min-width: 0; }
.gacha-sub-title { display: block; font-size: 30rpx; font-weight: 800; }
.gacha-icon-img-lg { width: 100rpx; height: 100rpx; }
.gacha-icon-img { width: 60rpx; height: 60rpx; }
@keyframes card-shimmer { 0% { left: -160%; } 60%, 100% { left: 160%; } }

/* ─────── 功能卡（2×2 宫格） ─────── */
.func-card { background: var(--bg-card); border-radius: 24rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); flex-shrink: 0; }
.func-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.func-item {
  width: calc(50% - 10rpx); box-sizing: border-box; min-height: 156rpx;
  border-radius: 20rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx;
  position: relative; overflow: hidden; color: #fff;
}
.func-hover { transform: scale(0.96); opacity: 0.92; }
.func-icon { width: 58rpx; height: 58rpx; }
.func-emoji { font-size: 54rpx; }
.func-label { font-size: 28rpx; font-weight: 700; }
.func-switch { transform: scale(0.9); }

/* 第一行：彩蛋风（动态彩虹描边 + 深色卡面） */
.func-egg {
  background: linear-gradient(120deg, #ef4444, #f97316, #eab308, #22c55e, #06b6d4, #3b82f6, #a855f7, #ef4444);
  background-size: 400% 400%;
  animation: rainbow-flow 6s linear infinite;
  box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.32);
}
.func-egg::before {
  content: ''; position: absolute; top: 7rpx; left: 7rpx; right: 7rpx; bottom: 7rpx;
  border-radius: 15rpx; background: #1F2937;
}
.func-egg .func-icon, .func-egg .func-emoji, .func-egg .func-label { position: relative; z-index: 1; }
@keyframes rainbow-flow { 0% { background-position: 0% 50%; } 100% { background-position: 400% 50%; } }

/* 第二行：深色玻璃拟态 + 霓虹描边 */
.func-glass {
  background: linear-gradient(135deg, rgba(30, 27, 75, 0.92), rgba(15, 23, 42, 0.92));
  border: 2rpx solid rgba(139, 92, 246, 0.55);
  box-shadow: 0 0 22rpx rgba(139, 92, 246, 0.28), inset 0 0 22rpx rgba(139, 92, 246, 0.12);
}
.func-glass .func-label { color: #E9E6FF; text-shadow: 0 0 10rpx rgba(139, 92, 246, 0.6); }

.info-card { background: var(--bg-card); border-radius: 24rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); flex-shrink: 0; }
.info-item { font-size: 26rpx; color: var(--gray-500); line-height: 1.8; }
.footer { text-align: center; padding: 16rpx 0; color: var(--text-muted); font-size: 22rpx; flex-shrink: 0; }

/* 历史对局（外层卡片；内容由 history-card 组件渲染） */
.history-card { background: var(--bg-card); border-radius: 24rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); flex-shrink: 0; }

/* ─────── 游戏说明：全屏覆盖页 ─────── */
.rules-page { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1100; background: var(--bg-card); display: flex; flex-direction: column; }
.rules-page-header { height: 100rpx; display: flex; align-items: center; justify-content: space-between; padding: 0 32rpx; border-bottom: 1rpx solid var(--gray-100); flex-shrink: 0; }
.rules-page-title { font-size: 34rpx; font-weight: 800; color: var(--gray-900); }
.rules-page-close { width: 56rpx; height: 56rpx; border-radius: 12rpx; background: var(--gray-100); display: flex; align-items: center; justify-content: center; font-size: 32rpx; color: var(--gray-600); }
.rules-page-body { flex: 1; padding: 32rpx; }
.rules-page-body .info-item { font-size: 28rpx; color: var(--gray-600); line-height: 1.9; margin-bottom: 12rpx; }

/* 按钮禁用态 */
.btn-disabled {
  background: #d1d5db !important;
  color: #9ca3af !important;
}

/* ─────── 胜率冠军（领奖台） ─────── */
.champion-card { position: relative; overflow: hidden; background: linear-gradient(160deg, #1F1B2E 0%, #2A2340 60%, #3B2E5A 100%); }
.champion-title { font-size: 30rpx; font-weight: 800; color: #FFE9A8; text-shadow: 0 2rpx 10rpx rgba(255, 200, 0, 0.4); }
.podium { display: flex; align-items: flex-end; justify-content: center; gap: 16rpx; padding-top: 34rpx; }
.podium-item { flex: 1; max-width: 190rpx; display: flex; flex-direction: column; align-items: center; }
.podium-avatar-wrap { position: relative; margin-bottom: 10rpx; }
.podium-avatar { width: 112rpx; height: 112rpx; border-radius: 50%; border: 4rpx solid var(--gray-300); background: #222; }
.rank-1 .podium-avatar { width: 148rpx; height: 148rpx; border-color: #FFD700; animation: champ-glow 2.2s ease-in-out infinite; }
.rank-2 .podium-avatar { border-color: #C0C0C0; }
.rank-3 .podium-avatar { border-color: #CD7F32; }
.podium-crown { position: absolute; top: -44rpx; left: 50%; font-size: 46rpx; animation: crown-float 1.8s ease-in-out infinite; }
.podium-badge { position: absolute; bottom: -8rpx; left: 50%; transform: translateX(-50%); width: 40rpx; height: 40rpx; border-radius: 50%; background: #333; color: #FFD700; font-size: 24rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; border: 2rpx solid #FFD700; }
.rank-2 .podium-badge { color: #ddd; border-color: #C0C0C0; }
.rank-3 .podium-badge { color: #E8A56A; border-color: #CD7F32; }
.podium-name { font-size: 24rpx; color: #EDE7FF; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 6rpx; }
.podium-rate { font-size: 38rpx; font-weight: 800; color: #FFD700; }
.rank-2 .podium-rate { color: #D8D8D8; }
.rank-3 .podium-rate { color: #E8A56A; }
.podium-games { font-size: 20rpx; color: rgba(255, 255, 255, 0.55); }
.podium-stand { width: 100%; margin-top: 10rpx; border-radius: 14rpx 14rpx 0 0; display: flex; align-items: center; justify-content: center; font-size: 40rpx; font-weight: 800; color: rgba(255, 255, 255, 0.85); }
.rank-1 .podium-stand { height: 96rpx; background: linear-gradient(180deg, #FFD700, #B8860B); }
.rank-2 .podium-stand { height: 66rpx; background: linear-gradient(180deg, #D8D8D8, #9A9A9A); }
.rank-3 .podium-stand { height: 48rpx; background: linear-gradient(180deg, #CD7F32, #8B4513); }
@keyframes crown-float { 0%, 100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(-10rpx); } }
@keyframes champ-glow { 0%, 100% { box-shadow: 0 0 18rpx rgba(255, 215, 0, 0.55); } 50% { box-shadow: 0 0 34rpx rgba(255, 215, 0, 0.95); } }
