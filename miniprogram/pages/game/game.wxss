/* ─────── 任务投票弹窗（仅任务队成员，不可关闭） ─────── */
.mission-modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1300;
  display: flex;
}
.mission-mask {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: #FFFFFF;
}
.mission-split {
  position: relative; z-index: 1;
  flex: 1; display: flex;
}
.mission-half {
  flex: 1;
  display: flex; align-items: center; justify-content: center;
}
.mission-half-success {
  background: linear-gradient(180deg, #8398A1 0%, #99A4BC 50%, #8398A1 100%);
}
.mission-half-fail {
  background: linear-gradient(180deg, #A0605B 0%, #986460 50%, #A0605B 100%);
}
.mission-half-success:active { background: #556B76; }
.mission-half-fail:active { background: #7A403C; }
.mission-half-emoji { font-size: 120rpx; line-height: 1; }
.mission-waiting {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  background: #FFFFFF;
  position: relative; z-index: 1;
}
.mission-waiting-spinner {
  width: 72rpx; height: 72rpx;
  border: 8rpx solid rgba(139, 92, 246, 0.2);
  border-top-color: #8B5CF6;
  border-radius: 50%;
  animation: vote-spin 1s linear infinite;
}
.mission-waiting-text {
  font-size: 32rpx; color: #8B5CF6; margin-top: 24rpx;
}

/* ─────── socket 断链重连遮罩 ─────── */
.reconnect-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 2000; display: flex; align-items: center; justify-content: center; }
.reconnect-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.55); }
.reconnect-box { position: relative; z-index: 1; background: #FFFFFF; border-radius: 28rpx; padding: 56rpx 64rpx; display: flex; flex-direction: column; align-items: center; }
.reconnect-spinner {
  width: 80rpx; height: 80rpx;
  border: 8rpx solid rgba(139, 92, 246, 0.2);
  border-top-color: #8B5CF6;
  border-radius: 50%;
  animation: vote-spin 1s linear infinite;
}
.reconnect-text { font-size: 30rpx; color: #6B7280; margin-top: 28rpx; }

/* ─────── 刺杀结算全屏动画 ─────── */
.assassin-anim {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  z-index: 3000;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.assassin-anim-bg { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
.assassin-anim-bg.anim-success { background: radial-gradient(circle, rgba(220,38,38,0.92), rgba(0,0,0,0.85)); }
.assassin-anim-bg.anim-fail { background: radial-gradient(circle, rgba(37,99,235,0.92), rgba(0,0,0,0.85)); }
.assassin-anim-scene {
  position: relative; width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
}

/* 阶段1：刀落下 */
.assassin-knife { font-size: 240rpx; animation: knife-stab 1.1s ease-out forwards; }
@keyframes knife-stab {
  0% { transform: scale(0.2) rotate(-45deg); opacity: 0; }
  55% { transform: scale(1.25) rotate(8deg); opacity: 1; }
  70% { transform: scale(1.1) rotate(-4deg); }
  85% { transform: scale(1.2) rotate(3deg); }
  100% { transform: scale(1.15) rotate(0deg); opacity: 1; }
}

/* 阶段2：结果（圆环扩散 + 中心弹入） */
.assassin-anim-ring {
  position: absolute;
  width: 200rpx; height: 200rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255,255,255,0.65);
  animation: ring-expand 1.2s ease-out infinite;
}
.assassin-anim-ring.r2 { animation-delay: 0.4s; }
.assassin-anim-ring.r3 { animation-delay: 0.8s; }
@keyframes ring-expand {
  0% { transform: scale(0.3); opacity: 0.9; }
  100% { transform: scale(3); opacity: 0; }
}
.assassin-anim-center {
  position: relative;
  display: flex; flex-direction: column; align-items: center;
  animation: center-pop 0.5s ease-out;
}
.assassin-anim-emoji { font-size: 220rpx; line-height: 1; }
.assassin-anim-text {
  font-size: 76rpx; font-weight: 900; color: #fff;
  margin-top: 24rpx;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.5);
}
@keyframes center-pop {
  0% { transform: scale(0.3); opacity: 0; }
  60% { transform: scale(1.12); }
  100% { transform: scale(1); opacity: 1; }
}

/* ─────── 任务结果全屏动画（全员） ─────── */
.mission-anim {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  z-index: 2500;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.mission-anim-bg { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
.mission-anim-bg.anim-mission-success { background: radial-gradient(circle, #FFFFFF 0%, rgba(125,211,252,0.95) 30%, rgba(0,0,0,0.92) 100%); }
.mission-anim-bg.anim-mission-fail { background: radial-gradient(circle, #FFFFFF 0%, rgba(220,38,38,0.92) 30%, rgba(0,0,0,0.92) 100%); }
.mission-anim-ring {
  position: absolute;
  width: 200rpx; height: 200rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255,255,255,0.65);
  animation: ring-expand 1.2s ease-out infinite;
}
.mission-anim-ring.r2 { animation-delay: 0.4s; }
.mission-anim-ring.r3 { animation-delay: 0.8s; }
.mission-anim-center {
  position: relative;
  display: flex; flex-direction: column; align-items: center;
  animation: center-pop 0.5s ease-out;
}
.mission-anim-img { width: 360rpx; height: 360rpx; margin-bottom: 24rpx; }
.mission-anim-text { font-size: 76rpx; font-weight: 900; color: #fff; text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.5); }
.mission-anim-failcount { font-size: 40rpx; font-weight: 700; color: #FECACA; margin-top: 16rpx; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.4); }

