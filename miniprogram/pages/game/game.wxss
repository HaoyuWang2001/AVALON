/* pages/game/game.wxss */

/* ─────── 任务进度卡 ─────── */
.mission-card { margin-top: 8rpx; }
.mission-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.mission-head-info { display: flex; align-items: center; gap: 16rpx; }
.mission-phase { font-size: 32rpx; color: #6B7280; font-weight: 600; }
.mission-lake { font-size: 24rpx; color: #0EA5E9; }

/* 顶栏图标按钮（方形）样式已移至 styles/buttons.wxss 共享 */
.top-mini-actions { display: flex; align-items: center; gap: 12rpx; }

/* 分享按钮（button open-type=share）：重置默认样式，与其他 top-mini-icon 视觉一致 */
.top-mini-share {
  width: 60rpx; height: 60rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  padding: 0 !important; margin: 0 !important; background: transparent; line-height: normal;
}
.top-mini-share::after { border: none; }

/* 5 轮圆圈 */
.rounds { display: flex; align-items: center; justify-content: center; margin: 40rpx 10rpx; }
.round-connector { width: 48rpx; height: 10rpx; background: #D1D5DB; border-radius: 5rpx; }
.round-circle {
  width: 81rpx; height: 81rpx; border-radius: 50%;
  background: #D1D5DB; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.round-size {
  font-size: 30rpx; font-weight: 800; color: #8B5CF6;
  line-height: 1;
}
.round-circle.succ { background: #1E50A2; }
.round-circle.fail { background: #AB3B3A; }
.round-circle.succ .round-size,
.round-circle.fail .round-size { color: #FFFFFF; }
.round-circle.current {
  width: 96rpx; height: 96rpx;
  border: 6rpx solid #8B5CF6;
}

/* 流车图（置于卡片左侧，上边距加大，灰实线分隔） */
.flow-area { margin: 40rpx 40rpx 0 20rpx; padding: 32rpx 32rpx 10rpx; border-top: 2rpx solid #E5E7EB; }
.flow-cars { display: flex; align-items: flex-end; justify-content: flex-start; gap: 28rpx; }
/* 游戏结束：原因显示框（刺杀链路 + 胜负原因），替代流车指示 */
.flow-reason {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding-bottom: 20rpx;
}
.flow-reason-chain { font-size: 30rpx; font-weight: 600; color: #DC2626; }
.flow-reason-result { font-size: 28rpx; font-weight: 600; color: #374151; text-align: center; }
.flow-car {
  position: relative;
  width: 48rpx; height: 72rpx; border-radius: 14rpx;
  background: #E5E7EB;
  display: flex; align-items: center; justify-content: center;
}
.flow-car-icon { font-size: 34rpx; line-height: 1; }
.flow-car.failed { background: #FEE2E2; border: 2rpx solid #EF4444; }
.flow-car.failed .flow-car-icon { color: #EF4444; }
.flow-car.current { border: 5rpx solid #8B5CF6; }
.flow-car.is-forced { border-color: #EF4444; box-shadow: 0 0 0 6rpx rgba(239, 68, 68, 0.2); }
.flow-car.last { width: 64rpx; height: 96rpx; flex-direction: column; }
.flow-car.last .flow-car-icon { font-size: 44rpx; }
.flow-car-label {
  position: absolute; bottom: -30rpx; left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx; color: #EF4444; font-weight: 600;
  white-space: nowrap;
}

/* ─────── 讨论阶段 ─────── */
.disc-setup { background: #F8F9FA; border-radius: 12rpx; padding: 20rpx; margin-bottom: 20rpx; }
.rule-label { font-size: 28rpx; font-weight: 600; color: #374151; }
.picker-value { font-size: 28rpx; color: #8B5CF6; font-weight: 600; }
.pick-confirmed { font-size: 28rpx; color: #10B981; font-weight: 600; }
.segment { display: flex; background: var(--gray-100); border-radius: 12rpx; overflow: hidden; }
.segment-item {
  padding: 12rpx 28rpx; font-size: 26rpx; color: #6B7280; font-weight: 600;
}
.segment-item.segment-active { background: #8B5CF6; color: #fff; }
.nominate-hint { font-size: 24rpx; margin-top: 12rpx; }
.disc-btns { display: flex; gap: 16rpx; margin-top: 20rpx; }
.disc-btns button { flex: 1; font-size: 26rpx; padding: 18rpx 0; }
.info-line {
  font-size: 28rpx; color: #4B5563; margin-bottom: 8rpx;
  background: #F8F9FA; border-radius: 8rpx; padding: 12rpx 16rpx;
}

/* 玩家列表（预选车型 / 队长 / 选中 标记） */
.player-item { position: relative; }
.player-item.pre-selected { background: #FEF3C7; border: 2rpx solid #F59E0B; }
.player-item.selected { background: #D1ECF1; border: 2rpx solid #17A2B8; }
.badge {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 4rpx 14rpx; border-radius: 20rpx;
  font-size: 22rpx; font-weight: 700; color: #fff; margin-right: 8rpx;
}
.badge-pre { background: #F59E0B; }
.badge-final { background: #17A2B8; }
.badge-leader { background: #F59E0B; }

/* 讨论阶段：队长标识 + 两步流程 */
.leader-badge {
  display: inline-flex; align-items: center;
  font-size: 30rpx; font-weight: 800; color: #92400E;
  background: #FEF3C7; border: 2rpx solid #F59E0B;
  padding: 10rpx 28rpx; border-radius: 30rpx;
}
.disc-step { margin-bottom: 24rpx; }
.disc-step-title { font-size: 28rpx; font-weight: 700; color: #374151; margin-bottom: 12rpx; }
.disc-step-done { display: flex; align-items: center; gap: 12rpx; margin-top: 14rpx; }
.step-undo { font-size: 24rpx; color: #8B5CF6; text-decoration: underline; padding: 4rpx 8rpx; }
.disc-final { margin-top: 24rpx; }

/* ─────── 玩家列表（全宽大卡片） ─────── */
.player-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 8rpx 0 calc(260rpx + env(safe-area-inset-bottom)); /* 底部留白，避免被 fixed 底部框遮挡 */
}

/* 玩家大卡片（每行全宽）：座位号左上角 + 左头像 + 右信息 */
.table-player {
  position: relative;
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 2rpx solid #E5E7EB;
  transition: all 0.2s ease;
  min-height: 130rpx;
}
.table-player:active { opacity: 0.7; }

/* 车队成员（teamVote/missionVote）：右半金色渐变 → 中间50%纯白 */
.table-player.state-team {
  background: linear-gradient(to left, #FEF3C7 0%, #FFFFFF 50%);
}
/* 已投票（仅 teamVote）：左半紫色渐变 → 中间50%纯白 */
.table-player.state-voted {
  background: linear-gradient(to right, #DDD6FE 0%, #FFFFFF 50%);
}
/* 湖仙/兰斯确认阶段：已确认玩家卡片左半紫色渐变（与投票阶段"已投"同款） */
.table-player.state-confirmed {
  background: linear-gradient(to right, #DDD6FE 0%, #FFFFFF 50%);
}
/* 车队成员+已投票：左紫渐变 + 右金渐变，中间纯白 */
.table-player.state-team-voted {
  background: linear-gradient(to right, #DDD6FE 0%, #FFFFFF 50%, #FEF3C7 100%);
}
/* missionVote：左半绿=赞成 / 红=反对（队伍投票结果），车队右半金色保留 */
.table-player.state-approved {
  background: linear-gradient(to right, #D1FAE5 0%, #FFFFFF 50%);
}
.table-player.state-rejected {
  background: linear-gradient(to right, #FEE2E2 0%, #FFFFFF 50%);
}
.table-player.state-team-approved {
  background: linear-gradient(to right, #D1FAE5 0%, #FFFFFF 50%, #FEF3C7 100%);
}
.table-player.state-team-rejected {
  background: linear-gradient(to right, #FEE2E2 0%, #FFFFFF 50%, #FEF3C7 100%);
}
/* 刺杀阶段：睁眼狼淡红背景 */
.table-player.state-evil {
  background: #FEE2E2;
}

/* 游戏结束：全员按阵营着色（好人蓝/坏人红，坏人红同刺杀阶段） */
.table-player.state-gameend-good { background: #DBEAFE; }
.table-player.state-gameend-evil { background: #FEE2E2; }

/* 游戏结束身份徽标（卡片右侧）：白底深字加粗，蓝/红底上都清晰 */
.tplayer-gameend-role {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 22rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  color: #111827;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

/* 刺杀阶段睁眼狼角色名（卡片右侧）：深红底、浅红字、加粗放大 */
.tplayer-evil-role {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 12rpx 24rpx;
  border-radius: 14rpx;
  background: #DC2626;
  color: #FEE2E2;
  font-size: 34rpx;
  font-weight: 700;
}

/* 右侧选人复选框（仅车主选人期显示）：未选=空心灰圈，选中=紫底白勾 */
.table-check {
  flex-shrink: 0;
  width: 44rpx; height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #D1D5DB;
  background: #FFFFFF;
  margin-left: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 800; color: #FFFFFF;
}
.table-check.checked {
  background: #8B5CF6;
  border-color: #8B5CF6;
}
.table-check.disabled {
  background: #F3F4F6;
  border-color: #E5E7EB;
}

/* 湖仙验人单选圈：未选=白底灰圈，选中=紫圈+紫点（仅湖仙持有者显示） */
.table-radio {
  flex-shrink: 0;
  width: 44rpx; height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #D1D5DB;
  background: #FFFFFF;
  margin-left: 20rpx;
  display: flex; align-items: center; justify-content: center;
}
.table-radio-dot { width: 24rpx; height: 24rpx; border-radius: 50%; background: transparent; }
.table-radio.radio-on { border-color: #8B5CF6; }
.table-radio.radio-on .table-radio-dot { background: #8B5CF6; }

/* 座位号徽章：内联，位于头像左侧并排 */
.seat-no {
  flex-shrink: 0;
  font-size: 30rpx; font-weight: 800; color: #fff;
  background: #8B5CF6;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  margin: 0 16rpx 0 8rpx;
}
.tplayer-avatar-wrap { position: relative; flex-shrink: 0; }
.tplayer-avatar {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: #F3F4F6;
}
.tplayer-crown {
  position: absolute;
  top: -40rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 56rpx;
  z-index: 3;
}
.tplayer-info {
  flex: 1;
  display: flex; flex-direction: column; align-items: flex-start;
  min-width: 0;
  margin-left: 24rpx;
}
.tplayer-name {
  font-size: 32rpx; color: #111827; font-weight: 700;
  max-width: 300rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.tplayer-tags {
  display: flex; flex-wrap: wrap; align-items: flex-start;
  gap: 8rpx; margin-top: 12rpx;
}

/* 标准标签体系：浅底深字 */
.ptag {
  font-size: 22rpx; font-weight: 700;
  padding: 4rpx 16rpx; border-radius: 20rpx;
  line-height: 1.5;
}
.ptag-purple { background: #EDE9FE; color: #6D28D9; }
.ptag-blue { background: #DBEAFE; color: #1D4ED8; }
.ptag-pink { background: #FCE7F3; color: #BE185D; }
.ptag-gold { background: #FEF3C7; color: #B45309; }
.ptag-orange { background: #FFEDD5; color: #C2410C; }
.ptag-red { background: #FEE2E2; color: #EF4444; }
.ptag-grey { background: #E5E7EB; color: #6B7280; }
/* 老湖仙：与湖仙同粉色系，略深以区分 */
.ptag-pink-deep { background: #FBCFE8; color: #9D174D; }
/* 游戏记录中自己的座位号：紫色加粗 */
.seat-me { color: #8B5CF6; font-weight: 700; }

/* 发言方向指示：箭头图片 */
.dir-pill-img {
  width: 36rpx; height: 36rpx;
  vertical-align: middle; margin-left: 20rpx;
}

/* ─────── 底部按钮框（fixed 常驻） ─────── */
.bottom-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 900;
  background: #FFFFFF;
  border-top: 2rpx solid #E5E7EB;
  box-shadow: 0 -6rpx 20rpx rgba(0,0,0,0.06);
  padding: 28rpx 32rpx 44rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
  min-height: 100rpx;
}
.bar-info { font-size: 32rpx; color: #6B7280; text-align: center; }
/* 票型倒计时一行：同意/反对并排（绿/红），用于队伍投票结果展示（倒计时期间 + missionVote 持续） */
.vote-reveal-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}
.txt-approve { color: #10B981; font-weight: 700; }
.txt-reject { color: #EF4444; font-weight: 700; }
.vote-line-sep { color: #6B7280; }
/* 预选车信息行：紫色加粗，文字与箭头垂直居中 */
.bar-preteam {
  color: #8B5CF6;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 等待动画下方文字：紫色 */
.bar-waiting { color: #8B5CF6; }
.bar-row { display: flex; align-items: center; justify-content: center; gap: 16rpx; }
.bar-row button { flex: 1; }
/* 队伍投票：同意/反对 深色实底、白字、更明显圆角 */
.bar-row .vote-approve,
.bar-row .vote-reject {
  flex: none;
  width: 220rpx;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.vote-approve {
  background: #34C78A;
}
.vote-reject {
  background: #F0686B;
}
/* 队伍投票：已投后隐藏按钮，显示紫色循环等待动画 */
.vote-waiting {
  display: flex; align-items: center; justify-content: center;
  padding: 20rpx 0;
}
/* 队伍投票已投：纵向布局（spinner 上、文字下），仅 teamVote 使用 */
.vote-waiting-col {
  flex-direction: column;
  gap: 20rpx;
}
.vote-waiting-text {
  font-size: 32rpx; color: #8B5CF6;
}
.vote-waiting-spinner {
  width: 72rpx; height: 72rpx;
  border: 8rpx solid rgba(139, 92, 246, 0.2);
  border-top-color: #8B5CF6;
  border-radius: 50%;
  animation: vote-spin 1s linear infinite;
}
/* 刺杀阶段等待动画：红色 */
.assassin-waiting-spinner {
  border-color: rgba(239, 68, 68, 0.2);
  border-top-color: #EF4444;
}
.assassin-waiting-text, .bar-assassin-wait { color: #EF4444; }
/* 睁眼狼提问文字：红色加粗强调 */
.bar-assassin-q { color: #DC2626; font-weight: 700; }
@keyframes vote-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 计时器卡片（轮次卡下方，仅 discussion）：纵向布局，背景与其他卡片一致 */
.timer-card {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 16rpx;
  padding: 36rpx 24rpx;
}
.timer-icon { width: 96rpx; height: 96rpx; }
.timer-num { font-size: 56rpx; font-weight: 800; color: #8B5CF6; line-height: 1; }
.timer-btns { display: flex; gap: 16rpx; margin-top: 8rpx; }
/* 票型展示倒计时：stopwatch 在左、x s 在右 */
.vote-countdown { display: flex; align-items: center; justify-content: center; gap: 16rpx; }
.vote-countdown-num { font-size: 56rpx; font-weight: 800; color: #8B5CF6; line-height: 1; }
.timer-btn {
  font-size: 26rpx; font-weight: 700; color: #fff;
  background: #8B5CF6; border-radius: 12rpx;
  padding: 10rpx 40rpx;
}

/* 任务结果全屏弹窗 */
.result-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1500;
  background: rgba(17, 24, 39, 0.82);
  display: flex; align-items: center; justify-content: center;
}
.result-card {
  background: #FFFFFF; border-radius: 32rpx;
  padding: 60rpx 80rpx;
  display: flex; flex-direction: column; align-items: center;
}
.result-emoji { font-size: 120rpx; margin-bottom: 24rpx; }
.result-title { font-size: 48rpx; font-weight: 800; color: #111827; }
.result-sub { font-size: 30rpx; color: #6B7280; margin-top: 12rpx; }

/* gameEnd 结果（底部框） */
.gameend-img { width: 160rpx; height: 160rpx; }
.gameend-title { font-size: 44rpx; font-weight: 800; color: #111827; margin-left: 20rpx; }
/* 游戏已放弃 emoji */
.gameend-emoji { font-size: 120rpx; line-height: 1; }

/* 队伍成员样式 */
.team-member { display: flex; flex-direction: column; align-items: center; margin: 20rpx; }
.team-member-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; margin-bottom: 12rpx; border: 4rpx solid #3498db; }
.team-member-name { font-size: 28rpx; text-align: center; }

/* 投票按钮样式 */
.vote-buttons { display: flex; justify-content: space-between; margin-top: 40rpx; }

/* 玩家揭示样式 */
.players-reveal { display: flex; flex-direction: column; gap: 20rpx; }
.player-reveal-item { display: flex; align-items: center; padding: 20rpx; border-radius: 12rpx; }
.player-reveal-item.good { background-color: rgba(59, 130, 246, 0.1); border-left: 6rpx solid #3B82F6; }
.player-reveal-item.evil { background-color: rgba(231, 76, 60, 0.1); border-left: 6rpx solid #e74c3c; }
.player-reveal-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; margin-right: 20rpx; }
.player-reveal-name { font-size: 28rpx; font-weight: 600; margin-bottom: 4rpx; }
.player-reveal-role { font-size: 24rpx; color: #6c757d; }

/* ─────── 蒙版 ─────── */
.role-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1001;
  background: rgba(45, 45, 52, 0.92);
  display: flex; align-items: center; justify-content: center;
}
.role-mask-inner {
  display: flex; flex-direction: column; align-items: center;
  padding: 0 60rpx; text-align: center;
}
.role-mask-title { font-size: 44rpx; font-weight: 700; color: #FFFFFF; letter-spacing: 4rpx; margin-bottom: 24rpx; }
.role-mask-sub { font-size: 44rpx; font-weight: 700; color: #C4B5FD; margin-bottom: 72rpx; line-height: 1.4; }
.role-mask-btn { min-width: 320rpx; }

/* ─────── 弹窗通用 ─────── */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55); z-index: 998;
}

/* ─────── 标准查看身份弹窗 ─────── */
.role-modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1000;
  display: flex; align-items: center; justify-content: center;
}
.role-modal-body {
  position: relative; z-index: 999;
  width: 560rpx; max-height: 80vh;
  background: #FFFFFF; border-radius: 28rpx;
  display: flex; flex-direction: column; align-items: center;
  padding: 40rpx 36rpx;
  overflow-y: auto;
}

/* ─────── 身份页（全屏覆盖） ─────── */
.role-page {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1000;
  background: #F3F4F6;
  display: flex; align-items: center; justify-content: center;
  overflow-y: auto;
}
.role-page-inner {
  width: 100%; min-height: 100%;
  background: #F3F4F6;
  display: flex; flex-direction: column; align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx 80rpx;
  box-sizing: border-box;
}
.role-card-badge {
  width: 320rpx; height: 420rpx; border-radius: 24rpx;
  background: linear-gradient(160deg, #1E1B4B, #312E81);
  box-shadow: 0 12rpx 32rpx rgba(49, 46, 129, 0.35);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 28rpx;
}
.role-card-img { width: 100%; height: 100%; }
.role-card-emoji { font-size: 160rpx; }
.role-tags { display: flex; gap: 16rpx; margin-bottom: 20rpx; flex-wrap: wrap; justify-content: center; }
.role-tag { font-size: 32rpx; font-weight: 800; padding: 12rpx 32rpx; border-radius: 28rpx; }
.role-tag-name { background: #EDE9FE; color: #6D28D9; }
.role-tag.tag-good { background: rgba(59, 130, 246, 0.12); color: #3B82F6; }
.role-tag.tag-evil { background: rgba(231, 76, 60, 0.12); color: #EF4444; }
.role-card-desc { font-size: 30rpx; color: #6B7280; text-align: center; line-height: 1.6; margin-bottom: 28rpx; padding: 0 12rpx; }
.role-card-btn { min-width: 360rpx; font-size: 30rpx; }

/* 固定占位高度，切换按钮/等待动画时不发生内容平移 */
