/* pages/game/game.wxss */

/* ─────── 任务进度卡 ─────── */
.mission-card { margin-top: 8rpx; }
.mission-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.mission-head-info { display: flex; align-items: center; gap: 16rpx; }
.mission-phase { font-size: 32rpx; color: var(--gray-500); font-weight: 600; }
.mission-lake { font-size: 24rpx; color: var(--label-pink); }

/* 顶栏图标按钮（方形）样式已移至 styles/buttons.wxss 共享 */
.top-mini-actions { display: flex; align-items: center; gap: 12rpx; }

/* 分享按钮（button open-type=share）：重置默认样式，与其他 top-mini-icon 视觉一致 */
.top-mini-share {
  width: 60rpx; height: 60rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  padding: 0 !important; margin: 0 !important; background: transparent; line-height: normal;
}
.top-mini-share::after { border: none; }

/* 5 轮圆圈 */
.rounds { display: flex; align-items: center; justify-content: center; margin: 40rpx 10rpx; }
.round-connector { width: 48rpx; height: 10rpx; background: var(--gray-300); border-radius: 5rpx; }
.round-circle {
  width: 81rpx; height: 81rpx; border-radius: 50%;
  background: var(--gray-300); flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.round-size {
  font-size: 30rpx; font-weight: 800; color: var(--primary);
  line-height: 1;
}
.round-circle.succ { background: var(--success); }
.round-circle.fail { background: var(--fail); }
.round-circle.succ .round-size,
.round-circle.fail .round-size { color: #FFFFFF; }
.round-circle.current {
  width: 96rpx; height: 96rpx;
  border: 6rpx solid var(--primary);
}

/* 流车图（置于卡片左侧，上边距加大，灰实线分隔） */
.flow-area { margin: 40rpx 40rpx 0 20rpx; padding: 32rpx 32rpx 10rpx; border-top: 2rpx solid var(--divider-strong); }
.flow-cars { display: flex; align-items: flex-end; justify-content: flex-start; gap: 28rpx; }
/* 游戏结束：原因显示框（刺杀链路 + 胜负原因），替代流车指示 */
.flow-reason {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding-bottom: 20rpx;
}
.flow-reason-chain { font-size: 30rpx; font-weight: 600; color: var(--label-evil); }
.flow-reason-result { font-size: 28rpx; font-weight: 600; color: var(--text-body); text-align: center; }
.flow-car {
  position: relative;
  width: 48rpx; height: 72rpx; border-radius: 14rpx;
  background: var(--gray-200);
  display: flex; align-items: center; justify-content: center;
}
.flow-car-icon { font-size: 34rpx; line-height: 1; }
.flow-car.failed { background: var(--state-reject); border: 2rpx solid var(--label-evil); }
.flow-car.failed .flow-car-icon { color: var(--label-evil); }
.flow-car.current { border: 5rpx solid var(--primary); }
.flow-car.is-forced { border-color: var(--label-evil); box-shadow: 0 0 0 6rpx rgba(239, 68, 68, 0.2); }
.flow-car.last { width: 64rpx; height: 96rpx; flex-direction: column; }
.flow-car.last .flow-car-icon { font-size: 44rpx; }
.flow-car-label {
  position: absolute; bottom: -30rpx; left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx; color: var(--label-evil); font-weight: 600;
  white-space: nowrap;
}

/* ─────── 讨论阶段 ─────── */
.disc-setup { background: var(--gray-100); border-radius: 12rpx; padding: 20rpx; margin-bottom: 20rpx; }
.rule-label { font-size: 28rpx; font-weight: 600; color: var(--text-body); }
.picker-value { font-size: 28rpx; color: var(--primary); font-weight: 600; }
.pick-confirmed { font-size: 28rpx; color: var(--success); font-weight: 600; }
.segment { display: flex; background: var(--gray-100); border-radius: 12rpx; overflow: hidden; }
.segment-item {
  padding: 12rpx 28rpx; font-size: 26rpx; color: var(--gray-500); font-weight: 600;
}
.segment-item.segment-active { background: var(--primary); color: #fff; }
.nominate-hint { font-size: 24rpx; margin-top: 12rpx; }
.disc-btns { display: flex; gap: 16rpx; margin-top: 20rpx; }
.disc-btns button { flex: 1; font-size: 26rpx; padding: 18rpx 0; }
.info-line {
  font-size: 28rpx; color: var(--text-body); margin-bottom: 8rpx;
  background: var(--gray-100); border-radius: 8rpx; padding: 12rpx 16rpx;
}

/* 玩家列表（预选车型 / 队长 / 选中 标记） */
.player-item { position: relative; }
.player-item.pre-selected { background: var(--label-orange-bg); border: 2rpx solid var(--label-orange); }
.player-item.selected { background: var(--label-blue-bg); border: 2rpx solid var(--label-blue); }
.badge {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 4rpx 14rpx; border-radius: 20rpx;
  font-size: 22rpx; font-weight: 700; color: #fff; margin-right: 8rpx;
}
.badge-pre { background: var(--label-orange); }
.badge-final { background: var(--label-blue); }
.badge-leader { background: var(--label-gold); }

/* 讨论阶段：队长标识 + 两步流程 */
.leader-badge {
  display: inline-flex; align-items: center;
  font-size: 30rpx; font-weight: 800; color: var(--label-gold);
  background: var(--label-gold-bg); border: 2rpx solid var(--label-gold);
  padding: 10rpx 28rpx; border-radius: 30rpx;
}
.disc-step { margin-bottom: 24rpx; }
.disc-step-title { font-size: 28rpx; font-weight: 700; color: var(--text-body); margin-bottom: 12rpx; }
.disc-step-done { display: flex; align-items: center; gap: 12rpx; margin-top: 14rpx; }
.step-undo { font-size: 24rpx; color: var(--primary); text-decoration: underline; padding: 4rpx 8rpx; }
.disc-final { margin-top: 24rpx; }

/* ─────── 玩家列表（全宽大卡片） ─────── */
.player-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
/* 玩家区（列表+观众席）：底部留白避免被 fixed 底部框遮挡（内联 bottomBarHeight 动态覆盖此兜底值） */
.player-area {
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
}

/* 玩家大卡片（每行全宽）：座位号左上角 + 左头像 + 右信息 */
.table-player {
  position: relative;
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--card-border);
  transition: all 0.2s ease;
  min-height: 130rpx;
}
.table-player:active { opacity: 0.7; }

/* 车队成员（teamVote/missionVote）：右半金渐变 → 中间50%卡片色 */
.table-player.state-team {
  background: linear-gradient(to left, var(--state-team) 0%, var(--bg-card-solid) 50%);
}
/* 湖仙验人本地选中：右半粉渐变（同款结构，色取自 --state-lake） */
.table-player.state-lake {
  background: linear-gradient(to left, var(--state-lake) 0%, var(--bg-card-solid) 50%);
}
/* 刺客开刀本地选中：右半红渐变（同款结构，色取自 --state-evil） */
.table-player.state-assassin-target {
  background: linear-gradient(to left, var(--state-evil) 0%, var(--bg-card-solid) 50%);
}
/* 已投票（仅 teamVote）：左半紫渐变 → 中间50%卡片色 */
.table-player.state-voted {
  background: linear-gradient(to right, var(--state-voted) 0%, var(--bg-card-solid) 50%);
}
/* 湖仙/兰斯确认阶段：已确认玩家卡片左半紫渐变（与投票阶段"已投"同款） */
.table-player.state-confirmed {
  background: linear-gradient(to right, var(--state-voted) 0%, var(--bg-card-solid) 50%);
}
/* 车队成员+已投票：左紫渐变 + 右金渐变，中间卡片色 */
.table-player.state-team-voted {
  background: linear-gradient(to right, var(--state-voted) 0%, var(--bg-card-solid) 50%, var(--state-team) 100%);
}
/* missionVote：左半绿=赞成 / 红=反对（队伍投票结果），车队右半金保留 */
.table-player.state-approved {
  background: linear-gradient(to right, var(--state-approve) 0%, var(--bg-card-solid) 50%);
}
.table-player.state-rejected {
  background: linear-gradient(to right, var(--state-reject) 0%, var(--bg-card-solid) 50%);
}
.table-player.state-team-approved {
  background: linear-gradient(to right, var(--state-approve) 0%, var(--bg-card-solid) 50%, var(--state-team) 100%);
}
.table-player.state-team-rejected {
  background: linear-gradient(to right, var(--state-reject) 0%, var(--bg-card-solid) 50%, var(--state-team) 100%);
}
/* 刺杀阶段：睁眼狼淡红背景 */
.table-player.state-evil {
  background: var(--state-evil);
}

/* 游戏结束：全员按阵营着色（好人蓝/坏人红，坏人红同刺杀阶段） */
.table-player.state-gameend-good { background: var(--state-good); }
.table-player.state-gameend-evil { background: var(--state-evil); }

/* 游戏结束身份徽标（卡片右侧）：白底深字加粗，蓝/红底上都清晰 */
.tplayer-gameend-role {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 22rpx;
  border-radius: 14rpx;
  background: var(--bg-card);
  color: var(--text-title);
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

/* 座位号徽章：内联，位于头像左侧并排 */
.seat-no {
  flex-shrink: 0;
  font-size: 30rpx; font-weight: 800; color: #fff;
  background: var(--primary);
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  margin: 0 16rpx 0 8rpx;
}
.tplayer-avatar-wrap { position: relative; flex-shrink: 0; }
.tplayer-avatar {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: var(--gray-100);
}
.tplayer-crown {
  position: absolute;
  top: -40rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 56rpx;
  z-index: 3;
}
.tplayer-info {
  flex: 1;
  display: flex; flex-direction: column; align-items: flex-start;
  min-width: 0;
  margin-left: 24rpx;
}
.tplayer-name {
  font-size: 32rpx; color: var(--text-title); font-weight: 700;
  max-width: 300rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.tplayer-tags {
  display: flex; flex-wrap: wrap; align-items: flex-start;
  gap: 8rpx; margin-top: 12rpx;
}

/* 标准标签体系：浅底深字 */
.ptag {
  font-size: 22rpx; font-weight: 700;
  padding: 4rpx 16rpx; border-radius: 20rpx;
  line-height: 1.5;
}
.ptag-purple { background: var(--label-violet-bg); color: var(--label-violet); }
.ptag-blue { background: var(--label-good-bg); color: var(--label-good); }
.ptag-pink { background: var(--label-pink-bg); color: var(--label-pink); }
.ptag-gold { background: var(--label-gold-bg); color: var(--label-gold); }
.ptag-orange { background: var(--label-orange-bg); color: var(--label-orange); }
.ptag-red { background: var(--label-evil-bg); color: var(--label-evil); }
.ptag-grey { background: var(--label-grey-bg); color: var(--label-grey); }
/* 老湖仙：与湖仙同粉色系 */
.ptag-pink-deep { background: var(--label-pink-bg); color: var(--label-pink); }
/* 游戏记录中自己的座位号：紫色加粗 */
.seat-me { color: var(--c-violet); font-weight: 700; }


/* ─────── 观众席（游戏中观战者） ─────── */
.spectators { margin: 20rpx 0; }
.spectators-title { font-size: 24rpx; color: var(--text-muted); margin-bottom: 12rpx; padding: 0 4rpx; }
.spectators-scroll { width: 100%; white-space: nowrap; }
.spectators-row { display: inline-flex; gap: 24rpx; padding: 0 4rpx 8rpx; }
.spectator-item { flex-shrink: 0; display: flex; flex-direction: column; align-items: center; width: 88rpx; }
.spectator-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--gray-100); border: 2rpx solid var(--gray-200); }
.spectator-name { font-size: 20rpx; color: var(--text-muted); margin-top: 6rpx; max-width: 88rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ─────── 底部按钮框（fixed 常驻） ─────── */
.bottom-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 900;
  background: var(--bg-card);
  border-top: 2rpx solid var(--card-border);
  box-shadow: 0 -6rpx 20rpx rgba(0,0,0,0.06);
  padding: 28rpx 32rpx 44rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
  min-height: 100rpx;
}
.bar-info { font-size: 32rpx; color: var(--gray-500); text-align: center; }
/* 票型倒计时一行：同意/反对并排（绿/红），用于队伍投票结果展示（倒计时期间 + missionVote 持续） */
.vote-reveal-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}
.txt-approve { color: var(--agree); font-weight: 700; }
.txt-reject { color: var(--disagree); font-weight: 700; }
.vote-line-sep { color: var(--gray-500); }
/* 预选车信息行：紫色加粗，文字与箭头垂直居中 */
.bar-preteam {
  color: var(--primary);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 等待动画下方文字：紫色 */
.bar-waiting { color: var(--primary); }
.bar-lake-hint { color: var(--c-violet); font-weight: 700; }
.bar-row { display: flex; align-items: center; justify-content: center; gap: 16rpx; }
.bar-row button { flex: 1; }
/* 队伍投票：同意/反对 深色实底、白字、更明显圆角 */
.bar-row .vote-approve,
.bar-row .vote-reject {
  flex: none;
  width: 220rpx;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.vote-approve {
  background: var(--agree);
}
.vote-reject {
  background: var(--disagree);
}
/* 队伍投票：已投后隐藏按钮，显示紫色循环等待动画 */
.vote-waiting {
  display: flex; align-items: center; justify-content: center;
  padding: 20rpx 0;
}
/* 队伍投票已投：纵向布局（spinner 上、文字下），仅 teamVote 使用 */
.vote-waiting-col {
  flex-direction: column;
  gap: 20rpx;
}
.vote-waiting-text {
  font-size: 32rpx; color: var(--primary);
}
.vote-waiting-spinner {
  width: 72rpx; height: 72rpx;
  border: 8rpx solid rgba(139, 92, 246, 0.2);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: vote-spin 1s linear infinite;
}
/* 刺杀阶段等待动画：红色 */
.assassin-waiting-spinner {
  border-color: rgba(239, 68, 68, 0.2);
  border-top-color: var(--label-evil);
}
.assassin-waiting-text, .bar-assassin-wait { color: var(--label-evil); }
/* 睁眼狼提问文字：红色加粗强调 */
.bar-assassin-q { color: var(--label-evil); font-weight: 700; }
@keyframes vote-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 计时器卡片（轮次卡下方，仅 discussion）：纵向布局，背景与其他卡片一致 */
.timer-card {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 16rpx;
  padding: 36rpx 24rpx;
}
.timer-icon { width: 96rpx; height: 96rpx; }
.timer-num { font-size: 56rpx; font-weight: 800; color: var(--primary); line-height: 1; }
.timer-btns { display: flex; gap: 16rpx; margin-top: 8rpx; }
/* 票型展示倒计时：stopwatch 在左、x s 在右 */
.vote-countdown { display: flex; align-items: center; justify-content: center; gap: 16rpx; }
.vote-countdown-num { font-size: 56rpx; font-weight: 800; color: var(--primary); line-height: 1; }
.timer-btn {
  font-size: 26rpx; font-weight: 700; color: #fff;
  background: var(--primary); border-radius: 12rpx;
  padding: 10rpx 40rpx;
}

/* 任务结果全屏弹窗 */
.result-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1500;
  background: rgba(17, 24, 39, 0.82);
  display: flex; align-items: center; justify-content: center;
}
.result-card {
  background: var(--bg-card); border-radius: 32rpx;
  padding: 60rpx 80rpx;
  display: flex; flex-direction: column; align-items: center;
}
.result-emoji { font-size: 120rpx; margin-bottom: 24rpx; }
.result-title { font-size: 48rpx; font-weight: 800; color: var(--text-title); }
.result-sub { font-size: 30rpx; color: var(--gray-500); margin-top: 12rpx; }

/* gameEnd 结果（底部框） */
.gameend-img { width: 160rpx; height: 160rpx; }
.gameend-title { font-size: 44rpx; font-weight: 800; color: var(--text-title); margin-left: 20rpx; }
/* 游戏已放弃 emoji */
.gameend-emoji { font-size: 120rpx; line-height: 1; }

/* 队伍成员样式 */
.team-member { display: flex; flex-direction: column; align-items: center; margin: 20rpx; }
.team-member-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; margin-bottom: 12rpx; border: 4rpx solid var(--label-good); }
.team-member-name { font-size: 28rpx; text-align: center; }

/* 投票按钮样式 */
.vote-buttons { display: flex; justify-content: space-between; margin-top: 40rpx; }

/* 玩家揭示样式 */
.players-reveal { display: flex; flex-direction: column; gap: 20rpx; }
.player-reveal-item { display: flex; align-items: center; padding: 20rpx; border-radius: 12rpx; }
.player-reveal-item.good { background-color: var(--state-good); border-left: 6rpx solid var(--state-good); }
.player-reveal-item.evil { background-color: var(--state-evil); border-left: 6rpx solid var(--state-evil); }
.player-reveal-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; margin-right: 20rpx; }
.player-reveal-name { font-size: 28rpx; font-weight: 600; margin-bottom: 4rpx; }
.player-reveal-role { font-size: 24rpx; color: var(--text-muted); }

/* ─────── 蒙版 ─────── */
.role-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1001;
  background: rgba(45, 45, 52, 0.92);
  display: flex; align-items: center; justify-content: center;
}
.role-mask-inner {
  display: flex; flex-direction: column; align-items: center;
  padding: 0 60rpx; text-align: center;
}
.role-mask-title { font-size: 44rpx; font-weight: 700; color: #FFFFFF; letter-spacing: 4rpx; margin-bottom: 24rpx; }
.role-mask-sub { font-size: 44rpx; font-weight: 700; color: #C4B5FD; margin-bottom: 72rpx; line-height: 1.4; }
.role-mask-btn { min-width: 320rpx; }

/* ─────── 弹窗通用 ─────── */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55); z-index: 998;
}

/* ─────── 标准查看身份弹窗 ─────── */
.role-modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1000;
  display: flex; align-items: center; justify-content: center;
}
.role-modal-body {
  position: relative; z-index: 999;
  width: 560rpx; max-height: 80vh;
  background: var(--bg-card); border-radius: 28rpx;
  display: flex; flex-direction: column; align-items: center;
  padding: 40rpx 36rpx;
  overflow-y: auto;
}

/* ─────── 身份页（全屏覆盖） ─────── */
.role-page {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1000;
  background: var(--gray-100);
  display: flex; align-items: center; justify-content: center;
  overflow-y: auto;
}
.role-page-inner {
  width: 100%; min-height: 100%;
  background: var(--gray-100);
  display: flex; flex-direction: column; align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx 80rpx;
  box-sizing: border-box;
}
.role-card-badge {
  width: 320rpx; height: 420rpx; border-radius: 24rpx;
  background: linear-gradient(160deg, #1E1B4B, #312E81);
  box-shadow: 0 12rpx 32rpx rgba(49, 46, 129, 0.35);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 28rpx;
}
.role-card-img { width: 100%; height: 100%; }
.role-card-emoji { font-size: 160rpx; }
.role-tags { display: flex; gap: 16rpx; margin-bottom: 20rpx; flex-wrap: wrap; justify-content: center; }
.role-tag { font-size: 32rpx; font-weight: 800; padding: 12rpx 32rpx; border-radius: 28rpx; }
.role-tag-name { background: var(--label-violet-bg); color: var(--label-violet); }
.role-tag.tag-good { background: var(--label-good-bg); color: var(--label-good); }
.role-tag.tag-evil { background: var(--label-evil-bg); color: var(--label-evil); }
.role-card-desc { font-size: 30rpx; color: var(--gray-500); text-align: center; line-height: 1.6; margin-bottom: 28rpx; padding: 0 12rpx; }
.role-card-btn { min-width: 360rpx; font-size: 30rpx; }

/* 固定占位高度，切换按钮/等待动画时不发生内容平移 */
.role-cta {
  min-height: 152rpx;
  display: flex; align-items: center; justify-content: center;
  width: 100%;
}

/* 等待其他玩家确认 */
.role-waiting {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.role-waiting-spinner {
  width: 64rpx; height: 64rpx;
  border: 8rpx solid rgba(139, 92, 246, 0.2);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: role-spin 1s linear infinite;
}
.role-waiting-text { font-size: 32rpx; color: var(--primary); margin-top: 20rpx; }
@keyframes role-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 视野列表 */
.role-vision { width: 100%; border-top: 1rpx solid var(--divider-strong); padding-top: 24rpx; margin-bottom: 28rpx; }
.role-vision-item { display: flex; align-items: center; padding: 14rpx 64rpx; }
/* 弹性填充：将座位号与标签推到两端 */
.role-vision-spacer { flex: 1; }
.role-vision-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; margin-right: 20rpx; background: var(--gray-100); }
.role-vision-seat {
  width: 48rpx; height: 48rpx; border-radius: 8rpx;
  background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
  color: #fff; font-size: 26rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  margin-right: 32rpx; flex-shrink: 0;
}
.role-vision-name { flex: 1; font-size: 30rpx; color: var(--text-title); font-weight: 600; }
.role-vision-tags { display: flex; gap: 10rpx; flex-wrap: wrap; align-items: center; }
.role-vision-tag { font-size: 26rpx; font-weight: 700; padding: 6rpx 20rpx; border-radius: 22rpx; background: var(--label-violet-bg); color: var(--label-violet); }
.role-vision-tag-role { background: var(--label-violet-bg); color: var(--label-violet); }
.role-vision-tag.tag-good { background: var(--label-good-bg); color: var(--label-good); }
.role-vision-tag.tag-evil { background: var(--label-evil-bg); color: var(--label-evil); }
.role-vision-tag.tag-unknown { background: var(--label-grey-bg); color: var(--label-grey); }
/* 开刀：行布局与上方 role-vision-item 完全一致(左右64rpx/上下14rpx，无额外margin)；左侧座位牌+浅红底红字开刀块填满剩余 */
.role-vision-knife-row {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  padding: 14rpx 64rpx;
}
.role-vision-knife {
  flex: 1;
  position: relative;
  overflow: hidden;
  padding: 12rpx 0;
  border-radius: 22rpx;
  background: var(--label-evil-bg);
  display: flex; align-items: center; justify-content: center;
}
.role-vision-knife-progress {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  background: var(--label-evil);
  z-index: 1;
}
.role-vision-knife-text {
  position: relative; z-index: 2;
  color: var(--label-evil); font-size: 28rpx; font-weight: 700; letter-spacing: 6rpx;
}

/* ─────── 历史弹窗 ─────── */
.info-modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1000;
  display: flex; align-items: center; justify-content: center;
}
.info-modal-body {
  position: relative; z-index: 999;
  width: 640rpx; max-height: 82vh;
  background: var(--bg-card); border-radius: 24rpx;
  display: flex; flex-direction: column;
  padding: 32rpx 28rpx 24rpx;
}
.info-modal-title { font-size: 34rpx; font-weight: 800; color: var(--text-title); text-align: center; margin-bottom: 16rpx; }
.info-modal-scroll { flex: 1; min-height: 0; height: 100%; max-height: 60vh; }
.info-empty {
  padding: 160rpx 0;
  text-align: center;
  font-size: 30rpx;
  color: var(--text-body);
}
.info-section { margin-bottom: 24rpx; }
.info-section-title { font-size: 28rpx; font-weight: 700; color: var(--c-violet); margin-bottom: 12rpx; }
.info-section-title.rec-red { color: var(--label-evil); }
.info-round { margin-bottom: 16rpx; }
.info-round-title { font-size: 26rpx; font-weight: 700; color: var(--text-body); margin-bottom: 8rpx; }
.info-car { background: var(--gray-100); border-radius: 10rpx; padding: 14rpx 16rpx; margin-bottom: 8rpx; }
.info-car-line { font-size: 26rpx; color: var(--text-body); line-height: 1.5; }
.info-car-result { font-weight: 600; }
.oc-good { color: var(--label-good); font-weight: 700; }
.oc-evil { color: var(--label-evil); font-weight: 700; }
.info-fail-count { color: var(--label-evil); font-weight: 700; }
.info-row {
  display: flex; justify-content: space-between; align-items: center;
  font-size: 26rpx; color: var(--text-body);
  background: var(--gray-100); border-radius: 8rpx; padding: 12rpx 16rpx; margin-bottom: 8rpx;
}
.txt-good { color: var(--label-good); font-weight: 700; }
.txt-evil { color: var(--label-evil); font-weight: 700; }
.txt-muted { color: var(--text-muted); }
.info-modal-close { margin-top: 16rpx; }

/* ─────── 湖仙查验结果弹窗 ─────── */
.lake-result-modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1100;
  display: flex; align-items: center; justify-content: center;
}
.lake-result-body {
  position: relative; z-index: 999;
  width: 520rpx;
  background: var(--bg-card); border-radius: 28rpx;
  display: flex; flex-direction: column; align-items: center;
  padding: 48rpx 36rpx;
}
.lake-result-img { width: 360rpx; height: 360rpx; margin-bottom: 40rpx; }
.lake-result-body .btn { width: 100%; }

/* ─────── 湖仙查验信息弹窗 ─────── */
.lake-info-modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1000;
  display: flex; align-items: center; justify-content: center;
}
.lake-info-body {
  position: relative; z-index: 999;
  width: 520rpx;
  background: var(--bg-card); border-radius: 28rpx;
  display: flex; flex-direction: column; align-items: center;
  padding: 48rpx 36rpx;
}
.lake-info-title {
  font-size: 36rpx; font-weight: 700; color: var(--text-title);
  margin-bottom: 24rpx;
}
.lake-info-text {
  font-size: 30rpx; color: var(--text-body); text-align: center;
  line-height: 1.5; margin-bottom: 40rpx;
}
.lake-info-body .btn { width: 100%; }

/* ─────── 兰斯洛特抽卡弹窗 ─────── */
.lancelot-modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1000;
  display: flex; align-items: center; justify-content: center;
}
.lancelot-body {
  position: relative; z-index: 999;
  width: 520rpx;
  background: var(--bg-card); border-radius: 28rpx;
  display: flex; flex-direction: column; align-items: center;
  padding: 48rpx 36rpx;
}
.lancelot-title {
  font-size: 36rpx; font-weight: 700; color: var(--text-title);
  margin-bottom: 24rpx;
}
.lancelot-result {
  font-size: 44rpx; font-weight: 800; color: var(--text-body);
  margin-bottom: 40rpx;
}
/* 兰斯转换图示：左蓝图 + 中间紫色弧形双箭头 + 右红图 */
.lancelot-swap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  margin-bottom: 40rpx;
}
.lancelot-swap-img { width: 130rpx; height: 130rpx; }
.lancelot-swap-arrows {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 28rpx;
  gap: 10rpx;
}
.lancelot-arrow { position: relative; width: 96rpx; height: 48rpx; }
/* 上箭头：上凸弧，方向 蓝→红（箭头尖朝右） */
.lancelot-arrow-up {
  border-top: 6rpx solid var(--primary);
  border-radius: 48rpx 48rpx 0 0;
}
/* 下箭头：下凹弧，方向 红→蓝（箭头尖朝左） */
.lancelot-arrow-down {
  border-bottom: 6rpx solid var(--primary);
  border-radius: 0 0 48rpx 48rpx;
}
.lancelot-arrow-up::after,
.lancelot-arrow-down::after {
  content: '';
  position: absolute;
  width: 16rpx; height: 16rpx;
  border-top: 6rpx solid var(--primary);
  border-right: 6rpx solid var(--primary);
}
.lancelot-arrow-up::after {
  right: -2rpx; top: -4rpx;
  transform: rotate(45deg);
}
.lancelot-arrow-down::after {
  left: -2rpx; bottom: -4rpx;
  transform: rotate(-135deg);
}
.lancelot-body .btn { width: 100%; }

/* 工具函数样式 */
progress { border-radius: 12rpx; }

/* 响应式调整 */
@media (max-width: 600rpx) {
  .vote-buttons { flex-direction: column; gap: 20rpx; }
  .vote-buttons button { width: 100% !important; }
  .team-member { margin: 10rpx; }
}

/* ─────── 发言顺序弹窗（仅车主，不可关闭） ─────── */
.order-modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1300;
  display: flex; align-items: center; justify-content: center;
}
.order-mask {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(17, 24, 39, 0.6);
}
.order-body {
  position: relative; z-index: 1;
  background: var(--bg-card); border-radius: 28rpx;
  padding: 56rpx 48rpx;
  display: flex; flex-direction: column; align-items: center;
  gap: 56rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.2);
}
.order-arrow {
  width: 140rpx; height: 140rpx;
}

/* ─────── 任务投票弹窗（仅任务队成员，不可关闭） ─────── */
.mission-modal {
  position: fixed; top: 100rpx; left: 0; right: 0; bottom: 0;
  z-index: 800;
  display: flex;
}
/* 任务投票：左上蓝图 / 右下红图；对角渐变底 + 长按读条填充 */
.mv {
  position: relative; flex: 1; overflow: hidden;
  background: linear-gradient(135deg, #99A4BC 0%, var(--mission-mid) 50%, #986460 100%);
}
.mv-fill { position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none; }
.mv-corner {
  position: absolute; width: 340rpx; height: 340rpx;
  display: flex; align-items: center; justify-content: center;
  transition: transform 0.15s ease;
}
.mv-corner-blue { left: 16rpx; top: 16rpx; }
.mv-corner-red { right: 16rpx; bottom: 16rpx; }
.mv-corner-on { transform: scale(1.12); }
.mv-img { width: 240rpx; height: 240rpx; transition: filter 0.15s ease; }
.mv-corner-on .mv-img { filter: drop-shadow(0 0 28rpx rgba(255, 255, 255, 0.9)) brightness(1.08); }
.mission-waiting {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  background: var(--bg-card);
  position: relative; z-index: 1;
}
.mission-waiting-spinner {
  width: 72rpx; height: 72rpx;
  border: 8rpx solid rgba(139, 92, 246, 0.2);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: vote-spin 1s linear infinite;
}
.mission-waiting-text {
  font-size: 32rpx; color: var(--primary); margin-top: 24rpx;
}

/* ─────── socket 断链重连遮罩 ─────── */
.reconnect-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 2000; display: flex; align-items: center; justify-content: center; }
.reconnect-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.55); }
.reconnect-box { position: relative; z-index: 1; background: var(--bg-card); border-radius: 28rpx; padding: 56rpx 64rpx; display: flex; flex-direction: column; align-items: center; }
.reconnect-spinner {
  width: 80rpx; height: 80rpx;
  border: 8rpx solid rgba(139, 92, 246, 0.2);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: vote-spin 1s linear infinite;
}
.reconnect-text { font-size: 30rpx; color: var(--gray-500); margin-top: 28rpx; }

/* ─────── 刺杀结算全屏动画 ─────── */
.assassin-anim {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  z-index: 3000;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.assassin-anim-bg { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
.assassin-anim-bg.anim-success { background: radial-gradient(circle, rgba(220,38,38,0.92), rgba(0,0,0,0.85)); }
.assassin-anim-bg.anim-fail { background: radial-gradient(circle, rgba(37,99,235,0.92), rgba(0,0,0,0.85)); }
.assassin-anim-scene {
  position: relative; width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
}

/* 阶段1：刀落下 */
.assassin-knife { font-size: 240rpx; animation: knife-stab 1.1s ease-out forwards; }
@keyframes knife-stab {
  0% { transform: scale(0.2) rotate(-45deg); opacity: 0; }
  55% { transform: scale(1.25) rotate(8deg); opacity: 1; }
  70% { transform: scale(1.1) rotate(-4deg); }
  85% { transform: scale(1.2) rotate(3deg); }
  100% { transform: scale(1.15) rotate(0deg); opacity: 1; }
}

/* 阶段2：结果（圆环扩散 + 中心弹入） */
.assassin-anim-ring {
  position: absolute;
  width: 200rpx; height: 200rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255,255,255,0.65);
  animation: ring-expand 1.2s ease-out infinite;
}
.assassin-anim-ring.r2 { animation-delay: 0.4s; }
.assassin-anim-ring.r3 { animation-delay: 0.8s; }
@keyframes ring-expand {
  0% { transform: scale(0.3); opacity: 0.9; }
  100% { transform: scale(3); opacity: 0; }
}
.assassin-anim-center {
  position: relative;
  display: flex; flex-direction: column; align-items: center;
  animation: center-pop 0.5s ease-out;
}
.assassin-anim-emoji { font-size: 220rpx; line-height: 1; }
.assassin-anim-text {
  font-size: 76rpx; font-weight: 900; color: #fff;
  margin-top: 24rpx;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.5);
}
@keyframes center-pop {
  0% { transform: scale(0.3); opacity: 0; }
  60% { transform: scale(1.12); }
  100% { transform: scale(1); opacity: 1; }
}

/* ─────── 任务结果全屏动画（全员） ─────── */
.mission-anim {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  z-index: 3500;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.mission-anim-bg { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
.mission-anim-bg.anim-mission-success { background: radial-gradient(circle, var(--mission-ok) 0%, var(--mission-ok) 30%, rgba(0,0,0,0.92) 100%); }
.mission-anim-bg.anim-mission-fail { background: radial-gradient(circle, var(--mission-fail) 0%, var(--mission-fail) 30%, rgba(0,0,0,0.92) 100%); }
.mission-anim-center {
  position: relative;
  display: flex; flex-direction: column; align-items: center;
  animation: center-pop 0.5s ease-out;
}
.mission-anim-img { width: 360rpx; height: 360rpx; margin-bottom: 24rpx; }
.mission-anim-failcount { font-size: 40rpx; font-weight: 700; color: #991B1B; margin-top: 16rpx; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.4); }
.mission-anim-failcount.is-success { color: #fff; }

/* 身份标记面板（长按卡片弹出） */
.mark-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.55);
  z-index: 999;
  display: flex; align-items: center; justify-content: center;
}
.mark-panel {
  width: 640rpx;
  max-height: 80vh;
  overflow-y: auto;
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 36rpx 40rpx;
  box-sizing: border-box;
}
.mark-panel-title {
  font-size: 36rpx; font-weight: 800; color: var(--text-title);
  margin-bottom: 28rpx; text-align: center;
}
.mark-sec-title {
  font-size: 28rpx; font-weight: 700; color: var(--gray-500);
  margin: 24rpx 0 16rpx;
}
.mark-side-row { display: flex; gap: 20rpx; }
.mark-opt {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-body);
  background: var(--gray-100);
  border: 2rpx solid transparent;
}
.mark-opt-good.mark-on { background: var(--label-good-bg); border-color: var(--label-good); color: var(--label-good); }
.mark-opt-evil.mark-on { background: var(--label-evil-bg); border-color: var(--label-evil); color: var(--label-evil); }
.mark-opt-unknown.mark-on { background: var(--gray-200); border-color: var(--gray-500); color: var(--text-body); }
.mark-role-wrap { display: flex; flex-wrap: wrap; gap: 16rpx; }
.mark-opt-role {
  flex: 0 0 auto;
  min-width: 120rpx;
  padding: 14rpx 22rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.mark-opt-role.mark-on { background: var(--label-violet-bg); border-color: var(--label-violet); color: var(--label-violet); }
.mark-role-on-good { background: var(--label-good-bg); border-color: var(--label-good); color: var(--label-good); }
.mark-role-on-evil { background: var(--label-evil-bg); border-color: var(--label-evil); color: var(--label-evil); }
.mark-clear-row {
  display: flex;
  justify-content: center;
  margin-top: 32rpx;
}
.mark-confirm-btn {
  background: var(--confirm);
  color: #fff;
  font-size: 30rpx;
  width: 100%;
  max-width: 360rpx;
  border-radius: 12rpx;
}

/* 只读配置缩略弹窗 */
.config-view-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 999;
  display: flex; align-items: center; justify-content: center;
}
.config-view-panel {
  width: 640rpx;
  max-height: 82vh;
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 36rpx 40rpx;
  box-sizing: border-box;
  display: flex; flex-direction: column;
}
.config-view-scroll {
  flex: 1; min-height: 0; max-height: 60vh;
}
.config-view-title {
  font-size: 36rpx; font-weight: 800; color: var(--text-title);
  text-align: center; margin-bottom: 24rpx;
}
.config-view-sec {
  font-size: 28rpx; font-weight: 700; color: var(--text-body);
  margin: 24rpx 0 12rpx;
}
.config-view-line {
  font-size: 28rpx; color: var(--text-body);
  line-height: 1.7;
}
.cv-strong { font-weight: 700; color: var(--text-title); }

/* ─── 预选车悬浮按钮（discussion 阶段，仅车主，未预选时显示） ─── */
.preteam-fab {
  position: fixed; right: 40rpx; z-index: 950;
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
  color: #fff; font-size: 28rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(124,58,237,0.4);
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  transition: transform 0.12s ease;
}
.preteam-fab:active { transform: scale(0.94); }

/* ─── 预选车面板（底部弹层，仅车主） ─── */
.preteam-panel-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1000; }
.preteam-panel {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 1001;
  background: var(--bg-card); border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box; max-height: 80vh; overflow-y: auto;
  display: flex; flex-direction: column;
}
.preteam-panel-title { font-size: 32rpx; font-weight: 700; color: var(--text-title); margin-bottom: 24rpx; text-align: center; }
.preteam-panel-actions { display: flex; flex-direction: column; gap: 20rpx; margin-top: 32rpx; }
.preteam-skip-btn { background: transparent; color: var(--text-muted); border: 2rpx solid var(--card-border); font-size: 30rpx; }

/* 预选人选择（面板内，复用 guide-pick 结构；token 化适配明暗主题） */
.guide-pick-wrap { width: 100%; display: flex; flex-wrap: wrap; gap: 20rpx; justify-content: space-between; align-content: flex-start; }
.guide-pick {
  width: 48%; height: 120rpx; padding: 0 20rpx; border-radius: 20rpx;
  background: var(--gray-100); border: 3rpx solid transparent;
  display: flex; flex-direction: row; align-items: center; box-sizing: border-box;
}
.guide-pick-on { background: rgba(139,92,246,0.22); border-color: var(--primary); }
.guide-pick-dis { opacity: 0.4; }
.guide-pick-badge {
  width: 56rpx; height: 56rpx; border-radius: 8rpx;
  background: rgba(139,92,246,0.3); border: 2rpx solid var(--primary);
  color: var(--text-title); font-size: 28rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-right: 20rpx;
}
.guide-pick-name {
  flex: 1; font-size: 28rpx; color: var(--text-title); font-weight: 600;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* ─────── 底部栏：车型文字（投票/展示/任务投票全程） ─────── */
.bar-car { color: var(--label-gold); font-weight: 700; }

/* ─────── 松弛压缩版（游戏页）：无需滚动即可查看全部玩家 ─────── */
.compact {
  position: relative;
  height: calc(100vh - 100rpx - 200rpx);
  display: flex; flex-direction: column;
  padding: 12rpx 12rpx 0; box-sizing: border-box; z-index: 1;
}
/* 压缩版下取消 .container 的 24rpx padding（避免叠加） */
.container-compact { padding: 0; }
/* 讨论阶段 60s 计时（并入阶段文字右侧） */
.c-head-timer { display: flex; align-items: center; gap: 8rpx; }
.c-head-timer-icon { width: 40rpx; height: 40rpx; }
.c-head-timer-num { font-size: 32rpx; font-weight: 800; color: var(--text-title); }
.c-head-timer-btn { font-size: 22rpx; color: var(--primary); padding: 2rpx 12rpx; border: 2rpx solid var(--primary); border-radius: 10rpx; }

/* 顶部卡片组（与标准版一致：卡片样式来自 .card/.mission-card/.timer-card） */
.c-topinfo { flex-shrink: 0; }
/* 顶部信息卡整体收缩（仅压缩版；标准版不动） */
.c-topinfo .card { padding: 16rpx; margin: 0 0 10rpx; }
.c-topinfo .mission-card { margin-top: 0; }
.c-topinfo .mission-head { margin-bottom: 4rpx; }
.c-topinfo .rounds { margin: 12rpx 10rpx; }
.c-topinfo .round-circle { width: 64rpx; height: 64rpx; }
.c-topinfo .round-circle.current { width: 76rpx; height: 76rpx; border-width: 4rpx; }
.c-topinfo .round-size { font-size: 26rpx; }
.c-topinfo .round-connector { width: 32rpx; height: 8rpx; }
.c-topinfo .flow-area { margin: 12rpx 20rpx 0 10rpx; padding: 12rpx 12rpx 4rpx; }
.c-topinfo .flow-car { width: 36rpx; height: 54rpx; border-radius: 10rpx; }
.c-topinfo .flow-car.last { width: 48rpx; height: 72rpx; }
.c-topinfo .flow-car.is-forced { box-shadow: 0 0 0 4rpx rgba(239, 68, 68, 0.2); }
.c-topinfo .flow-car-icon { font-size: 26rpx; }
.c-main { flex: 1; display: flex; flex-direction: row; gap: 10rpx; min-height: 0; }
.c-col { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }

/* 压缩版玩家小卡：仅座位号 + 角标；状态底色沿用 .table-player.state-* */
.c-player { flex: 1; min-height: 0; padding: 14rpx; border-radius: 16rpx; row-gap: 6rpx; column-gap: 8rpx; flex-wrap: wrap; align-items: center; align-content: center; justify-content: flex-start; }
/* 右列：内容靠右、座位号贴最右（row-reverse 下 flex-start 主起点在右） */
.c-col-right .c-player { flex-direction: row-reverse; }
.c-seat { flex-shrink: 0; width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center; border-radius: 10rpx; background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end)); font-size: 28rpx; font-weight: 800; color: #fff; }
.c-crown-mini { font-size: 26rpx; line-height: 1; }
.c-tag { font-size: 22rpx; line-height: 1.5; padding: 2rpx 10rpx; border-radius: 8rpx; white-space: nowrap; }
.c-role { font-size: 22rpx; font-weight: 800; color: var(--c-violet); }

/* 观战区底部弹窗 */
.c-spec-fab { position: absolute; right: 16rpx; bottom: 16rpx; z-index: 5; font-size: 24rpx; font-weight: 700; color: #fff; background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end)); padding: 10rpx 20rpx; border-radius: 999rpx; box-shadow: var(--shadow-md); }
.c-spec-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0, 0, 0, 0.45); z-index: 950; }
.c-spec-popup { position: fixed; left: 0; right: 0; bottom: 0; z-index: 960; background: var(--bg-card); border-radius: 26rpx 26rpx 0 0; padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.18); }
.c-spec-title { font-size: 28rpx; font-weight: 700; color: var(--text-title); margin-bottom: 14rpx; }
.c-spec-scroll { width: 100%; white-space: nowrap; }
.c-spec-row { display: inline-flex; gap: 24rpx; padding: 0 4rpx 8rpx; }
.c-spec-item { display: flex; flex-direction: column; align-items: center; width: 96rpx; }
.c-spec-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--gray-100); }
.c-spec-name { font-size: 20rpx; color: var(--text-muted); margin-top: 6rpx; max-width: 92rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
