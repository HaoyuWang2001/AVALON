  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.guide-actions {
  width: 100%;
  margin-top: 40rpx;
  display: flex; flex-direction: column; gap: 20rpx;
}
.guide-skip-btn {
  background: transparent;
  color: #c4b5fd;
  border: 1rpx solid #7c6bce;
  font-size: 30rpx;
}
.guide-arrow-row {
  display: flex; gap: 40rpx; margin: 24rpx 0 48rpx;
}
.guide-arrow {
  width: 240rpx;
  padding: 30rpx 0;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.12);
  border: 3rpx solid transparent;
  display: flex; flex-direction: column; align-items: center;
}
.guide-arrow-on { background: rgba(167,139,250,0.35); border-color: #a78bfa; }
.guide-arrow-img { width: 120rpx; height: 120rpx; }
.guide-arrow text { font-size: 26rpx; color: #fff; }

