/* ─────── 兰斯洛特抽卡弹窗 ─────── */
.lancelot-modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1000;
  display: flex; align-items: center; justify-content: center;
}
.lancelot-body {
  position: relative; z-index: 999;
  width: 520rpx;
  background: #FFFFFF; border-radius: 28rpx;
  display: flex; flex-direction: column; align-items: center;
  padding: 48rpx 36rpx;
}
.lancelot-title {
  font-size: 36rpx; font-weight: 700; color: #1F2937;
  margin-bottom: 24rpx;
}
.lancelot-result {
  font-size: 44rpx; font-weight: 800; color: #8B5CF6;
  margin-bottom: 40rpx;
}
/* 兰斯转换图示：左蓝图 + 中间紫色弧形双箭头 + 右红图 */
.lancelot-swap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  margin-bottom: 40rpx;
}
.lancelot-swap-img { width: 130rpx; height: 130rpx; }
.lancelot-swap-arrows {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 28rpx;
  gap: 10rpx;
}
.lancelot-arrow { position: relative; width: 96rpx; height: 48rpx; }
/* 上箭头：上凸弧，方向 蓝→红（箭头尖朝右） */
.lancelot-arrow-up {
  border-top: 6rpx solid #8B5CF6;
  border-radius: 48rpx 48rpx 0 0;
}
/* 下箭头：下凹弧，方向 红→蓝（箭头尖朝左） */
.lancelot-arrow-down {
  border-bottom: 6rpx solid #8B5CF6;
  border-radius: 0 0 48rpx 48rpx;
}
.lancelot-arrow-up::after,
.lancelot-arrow-down::after {
  content: '';
  position: absolute;
  width: 16rpx; height: 16rpx;
  border-top: 6rpx solid #8B5CF6;
  border-right: 6rpx solid #8B5CF6;
}
.lancelot-arrow-up::after {
  right: -2rpx; top: -4rpx;
  transform: rotate(45deg);
}
.lancelot-arrow-down::after {
  left: -2rpx; bottom: -4rpx;
  transform: rotate(-135deg);
}
.lancelot-body .btn { width: 100%; }

/* 工具函数样式 */
progress { border-radius: 12rpx; }

/* 响应式调整 */
@media (max-width: 600rpx) {
  .vote-buttons { flex-direction: column; gap: 20rpx; }
  .vote-buttons button { width: 100% !important; }
  .team-member { margin: 10rpx; }
}

