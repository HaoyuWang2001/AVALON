}
.role-waiting-spinner {
  width: 64rpx; height: 64rpx;
  border: 8rpx solid rgba(139, 92, 246, 0.2);
  border-top-color: #8B5CF6;
  border-radius: 50%;
  animation: role-spin 1s linear infinite;
}
.role-waiting-text { font-size: 32rpx; color: #8B5CF6; margin-top: 20rpx; }
@keyframes role-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 视野列表 */
.role-vision { width: 100%; border-top: 1rpx solid #E5E7EB; padding-top: 24rpx; margin-bottom: 28rpx; }
.role-vision-item { display: flex; align-items: center; padding: 14rpx 64rpx; }
/* 弹性填充：将座位号与标签推到两端 */
.role-vision-spacer { flex: 1; }
.role-vision-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; margin-right: 20rpx; background: #F3F4F6; }
.role-vision-seat {
  width: 48rpx; height: 48rpx; border-radius: 8rpx;
  background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
  color: #fff; font-size: 26rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  margin-right: 32rpx; flex-shrink: 0;
}
.role-vision-name { flex: 1; font-size: 30rpx; color: #111827; font-weight: 600; }
.role-vision-tags { display: flex; gap: 10rpx; flex-wrap: wrap; align-items: center; }
.role-vision-tag { font-size: 26rpx; font-weight: 700; padding: 6rpx 20rpx; border-radius: 22rpx; background: #EDE9FE; color: #6D28D9; }
.role-vision-tag-role { background: #EDE9FE; color: #6D28D9; }
.role-vision-tag.tag-good { background: rgba(59, 130, 246, 0.14); color: #3B82F6; }
.role-vision-tag.tag-evil { background: rgba(231, 76, 60, 0.14); color: #EF4444; }
.role-vision-tag.tag-unknown { background: rgba(107, 114, 128, 0.14); color: #6B7280; }
/* 开刀：行布局与上方 role-vision-item 完全一致(左右64rpx/上下14rpx，无额外margin)；左侧座位牌+浅红底红字开刀块填满剩余 */
.role-vision-knife-row {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  padding: 14rpx 64rpx;
}
.role-vision-knife {
  flex: 1;
  position: relative;
  overflow: hidden;
  padding: 12rpx 0;
  border-radius: 22rpx;
  background: rgba(231, 76, 60, 0.14);
  display: flex; align-items: center; justify-content: center;
}
.role-vision-knife-progress {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  background: #EF4444;
  z-index: 1;
}
.role-vision-knife-text {
  position: relative; z-index: 2;
  color: #EF4444; font-size: 28rpx; font-weight: 700; letter-spacing: 6rpx;
}

/* ─────── 历史弹窗 ─────── */
