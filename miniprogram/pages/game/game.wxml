<!--pages/game/game.wxml-->
<view class="game-page">
  <!-- 顶部操作栏（公共组件：左=暂回首页 右=炸掉会议）；历史对局入口不展示 -->
  <top-bar wx:if="{{!fromHistory}}">
    <text slot="left" class="btn-round btn-purple" bindtap="backToHome">暂回首页</text>
    <text slot="right" class="btn-round btn-danger" bindtap="abandonGame" wx:if="{{isHost}}">炸掉会议</text>
  </top-bar>

  <view class="container">
  <!-- 角色揭示提示蒙版（一次性） -->
  <view class="role-mask" wx:if="{{showRoleMask}}">
    <view class="role-mask-inner">
      <view class="role-mask-sub">确保您的周围没有坏坏</view>
      <button class="btn btn-primary role-mask-btn" bindtap="dismissRoleMask">查看身份</button>
    </view>
  </view>

  <!-- 任务进度卡 -->
  <view class="card mission-card">
    <view class="mission-head">
      <view class="mission-head-info">
        <text class="mission-phase">{{phaseText}}</text>
      </view>
      <view class="mission-actions">
        <text class="mini-btn" wx:if="{{playerRole}}" bindtap="openRoleModal">身份</text>
        <text class="mini-btn" bindtap="openInfoModal">历史</text>
      </view>
    </view>

    <view class="rounds">
      <block wx:for="{{roundList}}" wx:key="round">
        <view class="round-connector" wx:if="{{index > 0}}"></view>
        <view class="round-circle {{item.status}} {{item.isCurrent ? 'current' : ''}}">
          <text class="round-size">{{item.size}}</text>
        </view>
      </block>
    </view>

    <view class="flow-area">
      <view class="flow-cars">
        <block wx:for="{{flowCars}}" wx:key="index">
          <view class="flow-car {{item.state}} {{item.isLast ? 'last' : ''}} {{item.isForced ? 'is-forced' : ''}}">
            <text class="flow-car-icon">{{item.state === 'failed' ? '🚫' : (item.isLast ? '⚡' : '')}}</text>
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- 计时器卡片（仅 discussion 且已设置发言时限时显示） -->
  <view class="card timer-card" wx:if="{{currentPhase === 'discussion' && hasSpeechTimeout}}">
    <image src="/images/stopwatch.png" class="timer-icon"></image>
    <text class="timer-num">{{timerSeconds}}s</text>
    <view wx:if="{{isHost}}" class="timer-btns">
      <text wx:if="{{!timerRunning}}" class="timer-btn" bindtap="startTimer">启动</text>
      <text wx:else class="timer-btn" bindtap="pauseTimer">暂停</text>
      <text class="timer-btn" bindtap="resetTimer">重置</text>
    </view>
  </view>

  <!-- 玩家列表（全宽大卡片，每玩家一行）；padding-bottom 动态对齐底部栏，避免遮挡 -->
  <view class="player-list" style="{{bottomBarHeight ? 'padding-bottom:' + bottomBarHeight + 'px' : ''}}">
    <view wx:for="{{tablePlayers}}" wx:key="openId" class="table-player {{item.cardState}}"
      bindtap="onTablePlayerTap" data-id="{{item.openId}}">
      <text class="seat-no">{{item.seatNumber}}</text>
      <view class="tplayer-avatar-wrap">
        <image src="{{item.avatarUrl || '/images/default-avatar.png'}}" class="tplayer-avatar"></image>
      </view>
      <view class="tplayer-info">
        <text class="tplayer-name">{{item.nickName}}</text>
        <view class="tplayer-tags">
          <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="text" class="ptag {{tag.cls}}">{{tag.text}}</text>
        </view>
      </view>
      <view wx:if="{{showSelectCheck}}" class="table-check {{item.checked ? 'checked' : ''}} {{item.disabled ? 'disabled' : ''}}"
        catchtap="onTablePlayerTap" data-id="{{item.openId}}">
        <text wx:if="{{item.checked}}">✓</text>
      </view>
    </view>
  </view>

  <!-- 底部按钮框（fixed 常驻） -->
  <view class="bottom-bar">
    <!-- roleReveal：确认进度 -->
    <block wx:if="{{currentPhase === 'roleReveal'}}">
      <view class="bar-info">已确认 {{revealConfirmedCount}}/{{revealTotalCount}}</view>
    </block>

    <!-- preNominate：车主预选车型（提交预选） -->
    <block wx:if="{{currentPhase === 'preNominate'}}">
      <block wx:if="{{isTeamLeader}}">
        <view class="bar-row">
          <button size="mini" class="btn btn-primary" bindtap="submitPreNomination">提交预选（{{localSelected.length}}人）</button>
        </view>
      </block>
      <view wx:else class="bar-waiting">
        <view class="vote-waiting">
          <view class="vote-waiting-spinner"></view>
        </view>
        <view class="bar-info bar-waiting">等待队长预选...</view>
      </view>
    </block>

    <!-- speakingOrder：车主确定发言顺序 -->
    <block wx:if="{{currentPhase === 'speakingOrder'}}">
      <view class="bar-info bar-preteam">预选车：{{preTeamSeats || '无'}}</view>
      <block wx:if="{{!isTeamLeader}}">
        <view class="vote-waiting">
          <view class="vote-waiting-spinner"></view>
        </view>
        <view class="bar-info bar-waiting">等待队长确定发言顺序...</view>
      </block>
    </block>

    <!-- discussion：车主确认发车 -->
    <block wx:if="{{currentPhase === 'discussion'}}">
      <!-- 预选车+方向：仅非强制车时显示 -->
      <view wx:if="{{!forcedSend}}" class="bar-info bar-preteam">预选车：{{preTeamSeats || '无'}}<image src="/images/{{speakingOrder === 'desc' ? 'down-arrow.png' : 'up-arrow.png'}}" class="dir-pill-img" mode="aspectFit"></image></view>
      <!-- 车长：强制发车/确认发车按钮 -->
      <block wx:if="{{isTeamLeader}}">
        <view class="bar-row">
          <button size="mini" class="btn btn-primary" bindtap="confirmNomination">{{forcedSend ? '强制发车' : '确认发车'}} {{localSelected.length}}/{{requiredTeamSize}}</button>
        </view>
      </block>
      <!-- 非车长 + 强制车：等待动画 + 提示 -->
      <block wx:if="{{!isTeamLeader && forcedSend}}">
        <view class="vote-waiting">
          <view class="vote-waiting-spinner"></view>
        </view>
        <view class="bar-info bar-waiting">等待车长发出强制车...</view>
      </block>
    </block>

    <!-- lake：湖仙验人（必验） -->
    <block wx:if="{{currentPhase === 'lake'}}">
      <view class="bar-info">湖仙持有者点击玩家卡牌查验阵营（结果仅你可见）</view>
    </block>

    <!-- lancelot：兰斯抽卡结果展示 + 全员确认 -->
    <block wx:if="{{currentPhase === 'lancelot'}}">
      <view class="bar-info">兰斯洛特抽卡{{lancelotResult && lancelotResult.switched ? '：身份转换！' : '：未转换'}}</view>
      <view class="bar-row">
        <button size="mini" class="btn btn-primary" bindtap="confirmLancelot">确认（{{lancelotConfirmedCount}}/{{lancelotTotalCount}}）</button>
      </view>
    </block>

    <!-- teamVote -->
    <block wx:if="{{currentPhase === 'teamVote'}}">
      <block wx:if="{{!hasTeamVoted}}">
        <view class="bar-row">
          <button class="btn vote-approve" bindtap="castVote" data-vote="approve">同意</button>
          <button class="btn vote-reject" bindtap="castVote" data-vote="reject">反对</button>
        </view>
      </block>
      <view wx:else class="vote-waiting vote-waiting-col">
        <view class="vote-waiting-spinner"></view>
        <text class="vote-waiting-text">等待全部玩家投票...</text>
      </view>
    </block>

    <!-- missionVote -->
    <block wx:if="{{currentPhase === 'missionVote'}}">
      <block wx:if="{{!isMissionTeamMember}}">
        <view class="vote-waiting">
          <view class="vote-waiting-spinner"></view>
        </view>
      </block>
      <view class="bar-info" wx:if="{{approveSeats}}" style="color:#10B981;">赞成：{{approveSeats}}</view>
      <view class="bar-info" wx:if="{{rejectSeats}}" style="color:#EF4444;">反对：{{rejectSeats}}</view>
    </block>

    <!-- assassination -->
    <block wx:if="{{currentPhase === 'assassination'}}">
      <view class="bar-info">{{canAssassinateVar ? '选择刺杀目标' : '等待刺客行动'}}</view>
    </block>

    <!-- gameEnd -->
    <block wx:if="{{currentPhase === 'gameEnd'}}">
      <view class="bar-row">
        <image src="/images/{{gameWinner === 'good' ? 'avalon-blue.png' : 'avalon-red.png'}}" class="gameend-img" mode="aspectFit"></image>
        <view class="gameend-title">{{gameWinner === 'good' ? '蓝方获胜' : '红方获胜'}}</view>
      </view>
      <!-- 历史对局入口：返回首页 -->
      <view class="bar-row" wx:if="{{fromHistory}}">
        <button size="mini" class="btn btn-primary" bindtap="goHome">返回首页</button>
      </view>
      <!-- 房主：返回房间；非房主：离开房间 -->
      <block wx:else>
        <view class="bar-row" wx:if="{{isHost}}">
          <button size="mini" class="btn btn-primary" bindtap="endGame">返回房间</button>
        </view>
        <view class="bar-row" wx:else>
          <button size="mini" class="btn btn-secondary" bindtap="leaveRoom">离开房间</button>
        </view>
      </block>
    </block>
  </view>

  <!-- 任务结果全屏弹窗 -->
  <view class="result-overlay" wx:if="{{currentPhase === 'missionResult'}}">
    <view class="result-card">
      <view class="result-emoji">{{lastMissionResult ? '✅' : '❌'}}</view>
      <view class="result-title">{{lastMissionResult ? '任务成功' : '任务失败'}}</view>
      <view class="result-sub">{{lastMissionResult ? '好人获得1分' : '坏人获得1分'}}</view>
    </view>
  </view>

  <!-- 全屏 confirmReveal 页（roleReveal 阶段确认身份） -->
  <view class="role-page" wx:if="{{showRolePage}}">
    <view class="role-page-inner">
      <view class="role-card-badge">
        <image wx:if="{{roleCardImg}}" src="{{roleCardImg}}" class="role-card-img" mode="aspectFit"/>
        <text wx:else class="role-card-emoji">{{roleEmoji}}</text>
      </view>
      <view class="role-tags">
        <text class="role-tag role-tag-name">{{roleName}}</text>
        <text class="role-tag role-tag-side {{playerSide === 'evil' ? 'tag-evil' : 'tag-good'}}">{{playerSide === 'evil' ? '坏人阵营' : '好人阵营'}}</text>
      </view>
      <view class="role-card-desc">{{roleDesc}}</view>
      <view class="role-vision" wx:if="{{visionList.length > 0}}">
        <view wx:for="{{visionList}}" wx:key="openId" class="role-vision-item">
          <image src="{{item.avatar}}" class="role-vision-avatar"></image>
          <text class="role-vision-name">{{item.name}}</text>
          <view class="role-vision-tags">
            <text wx:if="{{item.roleText}}" class="role-vision-tag role-vision-tag-role">{{item.roleText}}</text>
            <text wx:if="{{item.campText}}" class="role-vision-tag {{item.side === 'evil' ? 'tag-evil' : 'tag-good'}}">{{item.campText}}</text>
          </view>
        </view>
      </view>
      <view class="role-cta">
        <block wx:if="{{roleWaiting}}">
          <view class="role-waiting">
            <view class="role-waiting-spinner"></view>
            <view class="role-waiting-text">等待其他玩家确认身份...</view>
          </view>
        </block>
        <button wx:else class="btn btn-primary role-card-btn" bindtap="closeRolePage">确认身份</button>
      </view>
    </view>
  </view>

  <!-- 标准查看身份弹窗（非 roleReveal，点"隐藏身份"关闭，不自动消失） -->
  <view class="role-modal" wx:if="{{showRoleModal}}">
    <view class="modal-mask" bindtap="closeRoleModal"></view>
    <view class="role-modal-body">
      <view class="role-card-badge">
        <image wx:if="{{roleCardImg}}" src="{{roleCardImg}}" class="role-card-img" mode="aspectFit"/>
        <text wx:else class="role-card-emoji">{{roleEmoji}}</text>
      </view>
      <view class="role-tags">
        <text class="role-tag role-tag-name">{{roleName}}</text>
        <text class="role-tag role-tag-side {{playerSide === 'evil' ? 'tag-evil' : 'tag-good'}}">{{playerSide === 'evil' ? '坏人阵营' : '好人阵营'}}</text>
      </view>
      <view class="role-vision" wx:if="{{visionList.length > 0}}">
        <view wx:for="{{visionList}}" wx:key="openId" class="role-vision-item">
          <image src="{{item.avatar}}" class="role-vision-avatar"></image>
          <text class="role-vision-name">{{item.name}}</text>
          <view class="role-vision-tags">
            <text wx:if="{{item.roleText}}" class="role-vision-tag role-vision-tag-role">{{item.roleText}}</text>
            <text wx:if="{{item.campText}}" class="role-vision-tag {{item.side === 'evil' ? 'tag-evil' : 'tag-good'}}">{{item.campText}}</text>
          </view>
        </view>
      </view>
      <button wx:if="{{canAssassinateVar}}" class="btn btn-danger role-card-btn" bindtap="startAssassination">开始刺杀</button>
      <button class="btn btn-primary role-card-btn" bindtap="closeRoleModal">隐藏身份</button>
    </view>
  </view>

  <!-- 历史弹窗 -->
  <view class="info-modal" wx:if="{{showInfoModal}}">
    <view class="modal-mask" bindtap="closeInfoModal"></view>
    <view class="info-modal-body">
      <view class="info-modal-title">游戏记录</view>
      <scroll-view scroll-y enable-flex class="info-modal-scroll">
        <view class="info-section" wx:if="{{carsHistory.length > 0}}">
          <view class="info-section-title">车次记录</view>
          <view wx:for="{{carsHistory}}" wx:key="round" class="info-round">
            <view class="info-round-title">第{{item.round}}轮</view>
            <view wx:for="{{item.details}}" wx:for-item="car" wx:key="index" class="info-car">
              <view class="info-car-line">第{{car.index}}车 · 车主 {{car.leaderSeat}}号</view>
              <view class="info-car-line">发车：{{car.sendSeats}}</view>
              <view class="info-car-line">同意：{{car.approveSeats}}</view>
              <view class="info-car-line">反对：{{car.rejectSeats}}</view>
              <view class="info-car-line info-car-result">结果：{{car.outcomeText}}</view>
            </view>
          </view>
        </view>
        <view class="info-section" wx:if="{{lakeHistory.length > 0}}">
          <view class="info-section-title">湖仙验人</view>
          <view wx:for="{{lakeHistory}}" wx:key="round" class="info-row">
            <text>第{{item.round}}轮 {{item.inspectorSeat}}号 → {{item.targetSeat}}号</text>
            <text wx:if="{{item.result}}" class="{{item.result === 'good' ? 'txt-good' : 'txt-evil'}}">{{item.result === 'good' ? '好人' : '坏人'}}</text>
            <text wx:else class="txt-muted">保密</text>
          </view>
        </view>
        <view class="info-section" wx:if="{{lancelotSwaps.length > 0}}">
          <view class="info-section-title">兰斯洛特</view>
          <view wx:for="{{lancelotSwaps}}" wx:key="round" class="info-row">
            第{{item.round}}轮 {{item.switched ? '身份转换' : '身份保持'}}
          </view>
        </view>
      </scroll-view>
      <button class="btn btn-primary info-modal-close" bindtap="closeInfoModal">关闭</button>
    </view>
  </view>

  <!-- 发言顺序弹窗（仅车主，不可关闭，期间阻断其他操作） -->
  <view class="order-modal" wx:if="{{currentPhase === 'speakingOrder' && isTeamLeader}}">
    <view class="order-mask" catchtap="noop" catchtouchmove="noop"></view>
    <view class="order-body">
      <image src="/images/up-arrow.png" class="order-arrow" data-order="asc" bindtap="selectSpeakingDirection" mode="aspectFit"></image>
      <image src="/images/down-arrow.png" class="order-arrow" data-order="desc" bindtap="selectSpeakingDirection" mode="aspectFit"></image>
    </view>
  </view>

  <!-- 任务投票弹窗（仅任务队成员，不可关闭） -->
  <view class="mission-modal" wx:if="{{currentPhase === 'missionVote' && isMissionTeamMember}}">
    <view class="mission-mask" catchtap="noop" catchtouchmove="noop"></view>
    <block wx:if="{{!hasMissionVoted}}">
      <view class="mission-split">
        <view class="mission-half mission-half-success" data-vote="success" bindtap="confirmMissionVote">
          <text class="mission-half-emoji">✨</text>
        </view>
        <view class="mission-half mission-half-fail" data-vote="fail" bindtap="confirmMissionVote">
          <text class="mission-half-emoji">💣</text>
        </view>
      </view>
    </block>
    <view wx:else class="mission-waiting">
      <view class="mission-waiting-spinner"></view>
      <text class="mission-waiting-text">等待其他队员完成任务...</text>
    </view>
  </view>
</view>
</view>
