<!--pages/game/game.wxml-->
<view class="game-page">
  <!-- 顶部操作栏（公共组件：左=暂回首页 右=炸掉会议） -->
  <top-bar>
    <text slot="left" class="btn-round btn-purple" bindtap="backToHome">暂回首页</text>
    <text slot="right" class="btn-round btn-danger" bindtap="abandonGame" wx:if="{{isHost}}">炸掉会议</text>
  </top-bar>

  <view class="container">
  <!-- 角色揭示提示蒙版（一次性） -->
  <view class="role-mask" wx:if="{{showRoleMask}}">
    <view class="role-mask-inner">
      <view class="role-mask-sub">确保您的周围没有坏坏</view>
      <button class="btn btn-primary role-mask-btn" bindtap="dismissRoleMask">查看身份</button>
    </view>
  </view>

  <!-- 任务进度卡 -->
  <view class="card mission-card">
    <view class="mission-head">
      <view class="mission-head-info">
        <text class="mission-phase">{{getPhaseText(currentPhase)}}</text>
        <text class="mission-lake" wx:if="{{lakeHolderOpenId}}">🏝️ {{getLakeHolderName()}}</text>
      </view>
      <view class="mission-actions">
        <text class="mini-btn" wx:if="{{playerRole}}" bindtap="openRoleModal">查看身份</text>
        <text class="mini-btn" bindtap="openInfoModal">历史</text>
      </view>
    </view>

    <view class="rounds">
      <block wx:for="{{roundList}}" wx:key="round">
        <view class="round-connector" wx:if="{{index > 0}}"></view>
        <view class="round-circle {{item.status}} {{item.isCurrent ? 'current' : ''}}"></view>
      </block>
    </view>

    <view class="flow-cars">
      <block wx:for="{{flowCars}}" wx:key="index">
        <view class="flow-car {{item.state}} {{item.isLast ? 'last' : ''}} {{item.isForced ? 'is-forced' : ''}}">
          <text class="flow-car-icon">{{item.state === 'failed' ? '✕' : '🚗'}}</text>
          <text wx:if="{{item.isLast}}" class="flow-car-label">强制车</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 根据游戏阶段显示不同内容 -->
  <!-- 角色揭示阶段 -->
  <view wx:if="{{currentPhase === 'roleReveal'}}" class="card">
    <view class="text-center" style="padding: 30rpx 0 10rpx;">
      <view style="font-size: 44rpx; margin-bottom: 16rpx;">🎭</view>
      <view wx:if="{{playerRole && !revealConfirmed}}" class="text-muted">点击「查看身份」确认你的角色</view>
      <view wx:if="{{playerRole && revealConfirmed}}" class="text-muted" style="color: #2ecc71;">你已确认身份</view>
      <view wx:if="{{!playerRole}}" class="text-muted">等待分配角色...</view>
      <view class="text-muted" style="margin-top: 12rpx;">已确认 {{revealConfirmedCount}}/{{revealTotalCount}} 人</view>
    </view>
  </view>

  <!-- 讨论阶段 -->
  <view wx:if="{{currentPhase === 'discussion'}}" class="card">
    <view class="subtitle text-center">讨论 · 发车准备</view>
    <view class="text-center text-muted mb-3" style="color: #e74c3c;" wx:if="{{forcedSend}}">本轮强制发车</view>

    <block wx:if="{{checkIfTeamLeader()}}">
      <view class="disc-setup">
        <view class="flex-between" wx:if="{{!speakingOrderConfirmed}}">
          <text class="rule-label">发车方向</text>
          <picker range="{{speakingOrderOptions}}" range-key="label" value="{{speakingOrderIndex}}" bindchange="onSpeakingOrderChange">
            <view class="picker-value">{{speakingOrderOptions[speakingOrderIndex].label}}</view>
          </picker>
        </view>
        <view class="flex-between" wx:else>
          <text class="rule-label">发车方向</text>
          <text class="pick-confirmed">{{speakingOrder === 'desc' ? '从队长开始逆序' : '按座位号'}}</text>
        </view>

        <view class="flex-between mt-2">
          <text class="rule-label">提名模式</text>
          <view class="segment">
            <view class="segment-item {{nominateMode === 'pre' ? 'segment-active' : ''}}" data-mode="pre" bindtap="onNominateModeChange">预提名</view>
            <view class="segment-item {{nominateMode === 'final' ? 'segment-active' : ''}}" data-mode="final" bindtap="onNominateModeChange">最终提名</view>
          </view>
        </view>
        <view class="text-muted nominate-hint">
          {{nominateMode === 'pre' ? '点击玩家标记预提名队伍（可留空）' : '点击玩家标记最终发车队伍'}}
        </view>

        <view class="disc-btns">
          <button size="mini" class="btn btn-secondary" bindtap="saveDiscussionSettings" disabled="{{speakingOrderConfirmed}}">保存发言设置{{preNominatedTeam.length > 0 ? ' · 预提名' + preNominatedTeam.length + '人' : ''}}</button>
          <button size="mini" class="btn btn-primary" bindtap="confirmNomination">确认提名 {{nominatedTeam.length}}/{{getRequiredTeamSize()}}</button>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="text-center text-muted mb-3">等待队长 {{getTeamLeaderName()}} 准备发车...</view>
      <view class="info-line" wx:if="{{speakingOrderConfirmed}}">发车方向：{{speakingOrder === 'desc' ? '从队长开始逆序' : '按座位号'}}</view>
      <view class="info-line" wx:if="{{preNominatedTeam.length > 0}}">预提名：{{getNamesByIds(preNominatedTeam)}}</view>
      <view class="info-line" wx:if="{{nominatedTeam.length > 0}}">发车队伍：{{getNamesByIds(nominatedTeam)}}</view>
    </block>

    <view class="players-list">
      <view wx:for="{{allPlayers}}" wx:key="openId"
        class="player-item {{preNominatedTeam.includes(item.openId) ? 'pre-selected' : ''}} {{nominatedTeam.includes(item.openId) ? 'selected' : ''}} {{checkIfTeamLeader() ? 'selectable' : ''}}"
        bindtap="nominatePlayer" data-id="{{item.openId}}">
        <image src="{{item.avatarUrl || '/images/default-avatar.png'}}" class="player-avatar"></image>
        <view class="player-info">
          <view class="player-name">{{item.nickName}}</view>
          <view class="player-status">
            <text wx:if="{{preNominatedTeam.includes(item.openId)}}" class="badge badge-pre">预</text>
            <text wx:if="{{nominatedTeam.includes(item.openId)}}" class="badge badge-final">选</text>
            {{item.openId === userInfo.openId ? '(自己)' : ''}}
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 队伍投票阶段 -->
  <view wx:if="{{currentPhase === 'teamVote'}}" class="card">
    <view class="subtitle text-center">投票是否同意该队伍</view>

    <view class="nominated-team">
      <view class="text-center mb-4">被提名执行任务的队伍:</view>
      <view class="flex-center" style="flex-wrap: wrap;">
        <view wx:for="{{getNominatedPlayers()}}" wx:key="openId" class="team-member">
          <image src="{{item.avatarUrl}}" class="team-member-avatar"></image>
          <view class="team-member-name">{{item.nickName}}</view>
        </view>
      </view>
    </view>

    <view class="vote-buttons">
      <button class="btn btn-success" style="width: 45%;" bindtap="castVote" data-vote="approve">同意</button>
      <button class="btn btn-danger" style="width: 45%;" bindtap="castVote" data-vote="reject">反对</button>
    </view>

    <view class="text-center text-muted mt-4">
      投票进度: {{getVoteCount()}}/{{allPlayers.length || 0}}
    </view>
  </view>

  <!-- 任务投票阶段 -->
  <view wx:if="{{currentPhase === 'missionVote'}}" class="card">
    <view class="subtitle text-center">执行任务投票</view>

    <view class="nominated-team" wx:if="{{nominatedTeam.length > 0}}">
      <view class="flex-center" style="flex-wrap: wrap;">
        <view wx:for="{{getNominatedPlayers()}}" wx:key="openId" class="team-member">
          <image src="{{item.avatarUrl}}" class="team-member-avatar"></image>
          <view class="team-member-name">{{item.nickName}}</view>
        </view>
      </view>
    </view>

    <block wx:if="{{isOnMissionTeam()}}">
      <block wx:if="{{!hasMissionVoted()}}">
        <view class="text-center mb-4">
          <view>你被选中执行第{{currentRound}}个任务</view>
          <view class="text-muted">请选择任务结果:</view>
        </view>
        <view class="vote-buttons">
          <button class="btn btn-success" style="width: 45%;" bindtap="castMissionVote" data-vote="success">任务成功</button>
          <button class="btn btn-danger" style="width: 45%;" bindtap="castMissionVote" data-vote="fail">破坏任务</button>
        </view>
        <view class="text-center text-muted mt-4">
          注意: 只有坏人才能选择"破坏任务"
        </view>
      </block>
      <view wx:else class="text-center text-muted mt-4" style="color: #2ecc71;">
        你已提交任务投票，等待其他队员...
      </view>
    </block>
    <view wx:else class="text-center text-muted mt-4">
      你不是任务队员，等待他们执行任务...
    </view>
  </view>

  <!-- 刺杀阶段 -->
  <view wx:if="{{currentPhase === 'assassination'}}" class="card">
    <view class="subtitle text-center">刺杀梅林</view>
    <view class="text-center mb-4">
      <view class="text-muted">好人已完成3个任务，坏人阵营需刺杀梅林翻盘</view>
      <view wx:if="{{!canAssassinate()}}" class="text-muted" style="margin-top: 10rpx;">等待刺客选择目标...</view>
      <view wx:else class="text-muted" style="margin-top: 10rpx;">你是坏人，选择你认为的梅林</view>
    </view>
    <view class="players-list">
      <view wx:for="{{allPlayers}}" wx:key="openId" wx:if="{{item.openId !== playerId}}" class="player-item selectable" bindtap="assassinate" data-id="{{item.openId}}">
        <image src="{{item.avatarUrl}}" class="player-avatar"></image>
        <view class="player-info">
          <view class="player-name">{{item.nickName}}</view>
          <view class="player-status">{{item.openId === userInfo.openId ? '(自己)' : ''}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 任务结果阶段 -->
  <view wx:if="{{currentPhase === 'missionResult'}}" class="card">
    <view class="subtitle text-center">第{{currentRound}}回合结果</view>

    <view class="text-center" style="padding: 40rpx 0;">
      <view style="font-size: 72rpx; margin-bottom: 30rpx;">
        {{getLastMissionResult() ? '✅' : '❌'}}
      </view>
      <view style="font-size: 48rpx; font-weight: 600; margin-bottom: 20rpx;">
        {{getLastMissionResult() ? '任务成功' : '任务失败'}}
      </view>
      <view class="text-muted">
        {{getLastMissionResult() ? '好人阵营获得1分' : '坏人阵营获得1分'}}
      </view>
    </view>

    <view class="text-center">
      <view class="text-muted">下一回合即将开始...</view>
    </view>
  </view>

  <!-- 游戏结束阶段 -->
  <view wx:if="{{currentPhase === 'gameEnd'}}" class="card">
    <view class="subtitle text-center">游戏结束</view>

    <view class="text-center" style="padding: 40rpx 0;">
      <view style="font-size: 72rpx; margin-bottom: 30rpx;">
        {{getGameWinner() === 'good' ? '🎉' : '💀'}}
      </view>
      <view style="font-size: 48rpx; font-weight: 600; margin-bottom: 20rpx;">
        {{getGameWinner() === 'good' ? '好人阵营胜利' : '坏人阵营胜利'}}
      </view>
      <view class="text-muted">
        {{gameResult ? gameResult.reason : (getGameWinner() === 'good' ? '成功完成了3个任务' : '任务失败或梅林被刺杀')}}
      </view>
    </view>

    <view class="players-reveal">
      <view class="text-center mb-4">玩家角色:</view>
      <view wx:for="{{allPlayers}}" wx:key="openId" class="player-reveal-item {{getPlayerSide(item.role)}}">
        <image src="{{item.avatarUrl}}" class="player-reveal-avatar"></image>
        <view class="player-reveal-info">
          <view class="player-reveal-name">{{item.nickName}}</view>
          <view class="player-reveal-role">{{getRoleName(item.role)}}</view>
        </view>
      </view>
    </view>

    <view class="text-center mt-4">
      <button class="btn btn-primary" bindtap="endGame">返回房间</button>
    </view>
  </view>

  <!-- 身份页（全屏覆盖） -->
  <view class="role-page" wx:if="{{showRoleModal}}">
    <view class="role-page-inner">
      <view class="role-card-badge">
        <image wx:if="{{roleCardImg}}" src="{{roleCardImg}}" class="role-card-img" mode="aspectFit"/>
        <text wx:else class="role-card-emoji">{{roleEmoji}}</text>
      </view>
      <view class="role-tags">
        <text class="role-tag role-tag-name">{{roleName}}</text>
        <text class="role-tag role-tag-side {{playerSide === 'evil' ? 'tag-evil' : 'tag-good'}}">{{playerSide === 'evil' ? '坏人阵营' : '好人阵营'}}</text>
      </view>
      <view class="role-card-desc">{{roleDesc}}</view>
      <view class="role-vision" wx:if="{{visionList.length > 0}}">
        <view wx:for="{{visionList}}" wx:key="openId" class="role-vision-item">
          <image src="{{item.avatar}}" class="role-vision-avatar"></image>
          <text class="role-vision-name">{{item.name}}</text>
          <view class="role-vision-tags">
            <text wx:if="{{item.roleText}}" class="role-vision-tag role-vision-tag-role">{{item.roleText}}</text>
            <text wx:if="{{item.campText}}" class="role-vision-tag {{item.side === 'evil' ? 'tag-evil' : 'tag-good'}}">{{item.campText}}</text>
          </view>
        </view>
      </view>
      <view class="role-cta">
        <block wx:if="{{roleWaiting}}">
          <view class="role-waiting">
            <view class="role-waiting-spinner"></view>
            <view class="role-waiting-text">等待其他玩家确认身份...</view>
          </view>
        </block>
        <button wx:else class="btn btn-primary role-card-btn" bindtap="closeRoleModal" disabled="{{currentPhase !== 'roleReveal' && revealConfirmed}}">
          {{currentPhase === 'roleReveal' && !revealConfirmed ? '确认身份' : '隐藏身份'}}
        </button>
      </view>
    </view>
  </view>

  <!-- 历史弹窗 -->
  <view class="info-modal" wx:if="{{showInfoModal}}">
    <view class="modal-mask" bindtap="closeInfoModal"></view>
    <view class="info-modal-body">
      <view class="info-modal-title">游戏记录</view>
      <scroll-view scroll-y class="info-modal-scroll">
        <view class="info-section" wx:if="{{carsHistory.length > 0}}">
          <view class="info-section-title">车次记录</view>
          <view wx:for="{{carsHistory}}" wx:key="round" class="info-round">
            <view class="info-round-title">第{{item.round}}轮</view>
            <view wx:for="{{item.details}}" wx:for-item="car" wx:key="index" class="info-car">
              <view class="info-car-line">第{{car.index}}车 · 车主 {{getLeaderName(car.teamLeaderOpenId)}}</view>
              <view class="info-car-line">票型：同意 {{getApproveCount(car.teamVotes)}} · 反对 {{getRejectCount(car.teamVotes)}}</view>
              <view class="info-car-line info-car-result">结果：{{getCarOutcome(car)}}</view>
            </view>
          </view>
        </view>
        <view class="info-section" wx:if="{{lakeHistory.length > 0}}">
          <view class="info-section-title">湖仙验人</view>
          <view wx:for="{{lakeHistory}}" wx:key="round" class="info-row">
            <text>第{{item.round}}轮 {{getLeaderName(item.inspectorOpenId)}} → {{getLeaderName(item.targetOpenId)}}</text>
            <text wx:if="{{item.result}}" class="{{item.result === 'good' ? 'txt-good' : 'txt-evil'}}">{{item.result === 'good' ? '好人' : '坏人'}}</text>
            <text wx:else class="txt-muted">保密</text>
          </view>
        </view>
        <view class="info-section" wx:if="{{lancelotSwaps.length > 0}}">
          <view class="info-section-title">兰斯洛特</view>
          <view wx:for="{{lancelotSwaps}}" wx:key="round" class="info-row">
            第{{item.round}}轮 {{item.switched ? '身份转换' : '身份保持'}}
          </view>
        </view>
      </scroll-view>
      <button class="btn btn-primary info-modal-close" bindtap="closeInfoModal">关闭</button>
    </view>
  </view>
</view>
</view>
