<!--pages/game/game.wxml-->
<view class="game-page">
  <!-- 顶部操作栏（公共组件：左=暂回首页 右=炸掉会议）；游戏结束阶段不展示（同历史对局） -->
  <top-bar wx:if="{{currentPhase !== 'gameEnd'}}">
    <text slot="left" class="btn-round btn-purple" bindtap="backToHome">暂回首页</text>
    <text slot="right" class="btn-round btn-danger" bindtap="abandonGame" wx:if="{{isHost}}">炸房</text>
  </top-bar>

  <view class="container">
  <!-- 角色揭示提示蒙版（一次性） -->
  <view class="role-mask" wx:if="{{showRoleMask}}">
    <view class="role-mask-inner">
      <view class="role-mask-sub">确保您的周围没有坏坏</view>
      <button class="btn btn-primary role-mask-btn" bindtap="dismissRoleMask">查看身份</button>
    </view>
  </view>

  <!-- 任务进度卡 -->
  <view class="card mission-card">
    <view class="mission-head">
      <view class="mission-head-info">
        <text class="mission-phase">{{phaseText}}</text>
      </view>
      <view class="mission-actions">
        <text class="mini-btn" wx:if="{{playerRole}}" bindtap="openRoleModal">身份</text>
        <text class="mini-btn" bindtap="openInfoModal">历史</text>
      </view>
    </view>

    <view class="rounds">
      <block wx:for="{{roundList}}" wx:key="round">
        <view class="round-connector" wx:if="{{index > 0}}"></view>
        <view class="round-circle {{item.status}} {{item.isCurrent ? 'current' : ''}}">
          <text class="round-size">{{item.size}}</text>
        </view>
      </block>
    </view>

    <view class="flow-area">
      <!-- gameEnd：原因显示框（刺杀链路 + 胜负原因）替代流车指示 -->
      <view class="flow-reason" wx:if="{{currentPhase === 'gameEnd'}}">
        <view class="flow-reason-chain" wx:if="{{gameAssassination}}">刺客刺杀 {{gameAssassination.targetSeat}}号 · {{gameAssassination.correct ? '刺杀成功' : '刺杀失败'}}</view>
        <view class="flow-reason-result" wx:if="{{!gameAssassination}}">{{gameResult && gameResult.abandoned ? '游戏已放弃：' : (gameWinner === 'good' ? '蓝方获胜：' : '红方获胜：')}}{{gameResult && gameResult.reason}}</view>
      </view>
      <view class="flow-cars" wx:else>
        <block wx:for="{{flowCars}}" wx:key="index">
          <view class="flow-car {{item.state}} {{item.isLast ? 'last' : ''}} {{item.isForced ? 'is-forced' : ''}}">
            <text class="flow-car-icon">{{item.state === 'failed' ? '🚫' : (item.isLast ? '⚡' : '')}}</text>
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- 计时器卡片（仅 discussion 且已设置发言时限时显示） -->
  <view class="card timer-card" wx:if="{{currentPhase === 'discussion' && hasSpeechTimeout}}">
    <image src="/images/stopwatch.png" class="timer-icon"></image>
    <text class="timer-num">{{timerSeconds}}s</text>
    <view wx:if="{{isHost}}" class="timer-btns">
      <text wx:if="{{!timerRunning}}" class="timer-btn" bindtap="startTimer">启动</text>
      <text wx:else class="timer-btn" bindtap="pauseTimer">暂停</text>
      <text class="timer-btn" bindtap="resetTimer">重置</text>
    </view>
  </view>

  <!-- 玩家列表（全宽大卡片，每玩家一行）；padding-bottom 动态对齐底部栏，避免遮挡 -->
  <view class="player-list" style="{{bottomBarHeight ? 'padding-bottom:' + bottomBarHeight + 'px' : ''}}">
    <view wx:for="{{tablePlayers}}" wx:key="openId" class="table-player {{item.cardState}}"
      bindtap="onTablePlayerTap" data-id="{{item.openId}}">
      <text class="seat-no">{{item.seatNumber}}</text>
      <view class="tplayer-avatar-wrap">
        <image src="{{item.avatarUrl || '/images/default-avatar.png'}}" class="tplayer-avatar"></image>
      </view>
      <view class="tplayer-info">
        <text class="tplayer-name">{{item.nickName}}</text>
        <view class="tplayer-tags">
          <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="text" class="ptag {{tag.cls}}">{{tag.text}}</text>
        </view>
      </view>
      <view wx:if="{{currentPhase === 'gameEnd' && item.roleName}}" class="tplayer-gameend-role">{{item.roleName}}</view>
      <view wx:if="{{showSelectCheck}}" class="table-check {{item.checked ? 'checked' : ''}} {{item.disabled ? 'disabled' : ''}}"
        catchtap="onTablePlayerTap" data-id="{{item.openId}}">
        <text wx:if="{{item.checked}}">✓</text>
      </view>
      <view wx:if="{{currentPhase === 'lake' && isLakeHolder && item.openId !== playerId && !item.isOldLake}}"
        class="table-radio {{item.openId === lakeTargetOpenId ? 'radio-on' : ''}}">
        <view class="table-radio-dot"></view>
      </view>
    </view>
  </view>

  <!-- 底部按钮框（fixed 常驻） -->
  <view class="bottom-bar">
    <!-- roleReveal：确认进度 -->
    <block wx:if="{{currentPhase === 'roleReveal'}}">
      <view class="bar-info">已确认 {{revealConfirmedCount}}/{{revealTotalCount}}</view>
    </block>

    <!-- preNominate：车主预选车型（提交预选） -->
    <block wx:if="{{currentPhase === 'preNominate'}}">
      <block wx:if="{{isTeamLeader}}">
        <view class="bar-row">
          <button size="mini" class="btn btn-primary" bindtap="submitPreNomination">提交预选（{{localSelected.length}}人）</button>
        </view>
      </block>
      <view wx:else class="bar-waiting">
        <view class="vote-waiting">
          <view class="vote-waiting-spinner"></view>
        </view>
        <view class="bar-info bar-waiting">等待队长预选...</view>
      </view>
    </block>

    <!-- speakingOrder：车主确定发言顺序 -->
    <block wx:if="{{currentPhase === 'speakingOrder'}}">
      <view class="bar-info bar-preteam">预选车：{{preTeamSeats || '无'}}</view>
      <block wx:if="{{!isTeamLeader}}">
        <view class="vote-waiting">
          <view class="vote-waiting-spinner"></view>
        </view>
        <view class="bar-info bar-waiting">等待队长确定发言顺序...</view>
      </block>
    </block>

    <!-- discussion：车主确认发车 -->
    <block wx:if="{{currentPhase === 'discussion'}}">
      <!-- 预选车+方向：仅非强制车时显示 -->
      <view wx:if="{{!forcedSend}}" class="bar-info bar-preteam">预选车：{{preTeamSeats || '无'}}<image src="/images/{{speakingOrder === 'desc' ? 'down-arrow.png' : 'up-arrow.png'}}" class="dir-pill-img" mode="aspectFit"></image></view>
      <!-- 车长：强制发车/确认发车按钮 -->
      <block wx:if="{{isTeamLeader}}">
        <view class="bar-row">
          <button size="mini" class="btn btn-primary" bindtap="confirmNomination">{{forcedSend ? '强制发车' : '确认发车'}} {{localSelected.length}}/{{requiredTeamSize}}</button>
        </view>
      </block>
      <!-- 非车长 + 强制车：等待动画 + 提示 -->
      <block wx:if="{{!isTeamLeader && forcedSend}}">
        <view class="vote-waiting">
          <view class="vote-waiting-spinner"></view>
        </view>
        <view class="bar-info bar-waiting">等待车长发出强制车...</view>
      </block>
    </block>

    <!-- lake：湖仙验人（必验，单选目标后底部确认） -->
    <block wx:if="{{currentPhase === 'lake'}}">
      <block wx:if="{{isLakeHolder}}">
        <view class="bar-row">
          <button size="mini" class="btn btn-primary" bindtap="confirmLakeInspect" disabled="{{!lakeTargetOpenId}}">确认查验</button>
        </view>
      </block>
      <block wx:else>
        <view class="vote-waiting">
          <view class="vote-waiting-spinner"></view>
        </view>
        <view class="bar-info bar-waiting">等待湖仙查验...</view>
      </block>
    </block>

    <!-- lakeConfirm：湖仙查验全员确认（确认按钮在弹窗，底部仅等待文案） -->
    <block wx:if="{{currentPhase === 'lakeConfirm'}}">
      <view class="bar-waiting">
        <view class="vote-waiting">
          <view class="vote-waiting-spinner"></view>
        </view>
        <view class="bar-info bar-waiting">等待所有玩家确认湖仙验人结果</view>
      </view>
    </block>

    <!-- lancelot：兰斯抽卡结果展示 + 全员确认 -->
    <block wx:if="{{currentPhase === 'lancelot'}}">
      <view class="bar-waiting">
        <view class="vote-waiting">
          <view class="vote-waiting-spinner"></view>
        </view>
        <view class="bar-info bar-waiting">等待所有玩家确认兰斯洛特转换结果</view>
      </view>
    </block>

    <!-- teamVote -->
    <block wx:if="{{currentPhase === 'teamVote'}}">
      <block wx:if="{{!hasTeamVoted}}">
        <view class="bar-row">
          <button class="btn vote-approve" bindtap="castVote" data-vote="approve">同意</button>
          <button class="btn vote-reject" bindtap="castVote" data-vote="reject">反对</button>
        </view>
      </block>
      <view wx:else class="vote-waiting vote-waiting-col">
        <view class="vote-waiting-spinner"></view>
        <text class="vote-waiting-text">等待全部玩家投票...</text>
      </view>
    </block>

    <!-- missionVote -->
    <block wx:if="{{currentPhase === 'missionVote'}}">
      <!-- 倒计时：stopwatch 在左、x s 在右，替代等待 span -->
      <view wx:if="{{!missionVoteReady && voteCountdown > 0}}" class="vote-waiting">
        <view class="vote-countdown">
          <image src="/images/stopwatch.png" class="timer-icon"></image>
          <text class="vote-countdown-num">{{voteCountdown}}s</text>
        </view>
      </view>
      <view wx:elif="{{!isMissionTeamMember}}" class="vote-waiting">
        <view class="vote-waiting-spinner"></view>
      </view>
      <view class="bar-info" wx:if="{{approveSeats}}" style="color:#10B981;font-weight:700;">赞成：{{approveSeats}}</view>
      <view class="bar-info" wx:if="{{rejectSeats}}" style="color:#EF4444;font-weight:700;">反对：{{rejectSeats}}</view>
    </block>

    <!-- assassination -->
    <block wx:if="{{currentPhase === 'assassination'}}">
      <!-- 睁眼狼：提问 -->
      <view wx:if="{{isEvilEyesUser}}" class="bar-info bar-assassin-q">问：谁是梅林？</view>
      <!-- 非睁眼狼：红色等待动画 + 开刀文字 -->
      <block wx:else>
        <view class="vote-waiting">
          <view class="vote-waiting-spinner assassin-waiting-spinner"></view>
        </view>
        <view class="bar-info bar-assassin-wait">刺客正在开刀</view>
      </block>
    </block>

    <!-- gameEnd -->
    <block wx:if="{{currentPhase === 'gameEnd'}}">
      <!-- 房主放弃/异常结束：无胜负 -->
      <view class="bar-row" wx:if="{{gameResult && gameResult.abandoned}}">
        <text class="gameend-emoji">🏳️</text>
        <view class="gameend-title">游戏已放弃</view>
      </view>
      <!-- 正常结束：胜负 -->
      <block wx:else>
        <view class="bar-row">
          <image src="/images/{{gameWinner === 'good' ? 'avalon-blue.png' : 'avalon-red.png'}}" class="gameend-img" mode="aspectFit"></image>
          <view class="gameend-title">{{gameWinner === 'good' ? '蓝方获胜' : '红方获胜'}}</view>
        </view>
      </block>
      <!-- 统一返回首页 -->
      <view class="bar-row">
        <button size="mini" class="btn btn-primary" bindtap="goHome">返回首页</button>
      </view>
    </block>
  </view>

  <!-- 任务结果全屏弹窗 -->
  <view class="result-overlay" wx:if="{{currentPhase === 'missionResult'}}">
    <view class="result-card">
      <view class="result-emoji">{{lastMissionResult ? '👍' : '❌'}}</view>
      <view class="result-title">{{lastMissionResult ? '任务成功' : '任务失败'}}</view>
      <view class="result-sub">{{lastMissionResult ? '蓝方获得1分' : '红方获得1分'}}</view>
    </view>
  </view>

  <!-- 全屏 confirmReveal 页（roleReveal 阶段确认身份） -->
  <view class="role-page" wx:if="{{showRolePage}}">
    <view class="role-page-inner">
      <view class="role-card-badge">
        <image wx:if="{{roleCardImg}}" src="{{roleCardImg}}" class="role-card-img" mode="aspectFit"/>
        <text wx:else class="role-card-emoji">{{roleEmoji}}</text>
      </view>
      <view class="role-tags">
        <text class="role-tag role-tag-name">{{roleName}}</text>
        <text class="role-tag role-tag-side {{playerSide === 'evil' ? 'tag-evil' : 'tag-good'}}">{{playerSide === 'evil' ? '红方阵营' : '蓝方阵营'}}</text>
      </view>
      <view class="role-card-desc">{{roleDesc}}</view>
      <view class="role-vision" wx:if="{{visionList.length > 0}}">
        <view wx:for="{{visionList}}" wx:key="openId" class="role-vision-item">
          <view class="role-vision-seat" wx:if="{{item.seat}}">{{item.seat}}</view>
          <image src="{{item.avatar}}" class="role-vision-avatar"></image>
          <text class="role-vision-name">{{item.name}}</text>
          <view class="role-vision-tags">
            <text wx:if="{{item.roleText}}" class="role-vision-tag role-vision-tag-role">{{item.roleText}}</text>
            <text wx:if="{{item.campText}}" class="role-vision-tag {{item.side === 'evil' ? 'tag-evil' : 'tag-good'}}">{{item.campText}}</text>
          </view>
        </view>
      </view>
      <view class="role-cta">
        <block wx:if="{{roleWaiting}}">
          <view class="role-waiting">
            <view class="role-waiting-spinner"></view>
            <view class="role-waiting-text">等待其他玩家确认身份...</view>
          </view>
        </block>
        <button wx:else class="btn btn-primary role-card-btn" bindtap="closeRolePage">确认身份</button>
      </view>
    </view>
  </view>

  <!-- 标准查看身份弹窗（非 roleReveal，点"隐藏身份"关闭，不自动消失） -->
  <view class="role-modal" wx:if="{{showRoleModal}}">
    <view class="modal-mask" bindtap="closeRoleModal"></view>
    <view class="role-modal-body">
      <view class="role-card-badge">
        <image wx:if="{{roleCardImg}}" src="{{roleCardImg}}" class="role-card-img" mode="aspectFit"/>
        <text wx:else class="role-card-emoji">{{roleEmoji}}</text>
      </view>
      <view class="role-tags">
        <text class="role-tag role-tag-name">{{roleName}}</text>
        <text class="role-tag role-tag-side {{playerSide === 'evil' ? 'tag-evil' : 'tag-good'}}">{{playerSide === 'evil' ? '红方阵营' : '蓝方阵营'}}</text>
      </view>
      <view class="role-vision" wx:if="{{visionList.length > 0 || canAssassinateVar}}">
        <view wx:for="{{visionList}}" wx:key="openId" class="role-vision-item">
          <view class="role-vision-seat" wx:if="{{item.seat}}">{{item.seat}}</view>
          <view class="role-vision-spacer"></view>
          <view class="role-vision-tags">
            <text wx:if="{{item.roleText}}" class="role-vision-tag role-vision-tag-role">{{item.roleText}}</text>
            <text wx:if="{{item.campText}}" class="role-vision-tag {{item.side === 'evil' ? 'tag-evil' : 'tag-good'}}">{{item.campText}}</text>
          </view>
        </view>
        <!-- 开刀条目：左侧紫色座位牌 + 红色开刀块填满剩余行，点击开始刺杀；刺杀/gameEnd阶段隐藏 -->
        <view wx:if="{{canAssassinateVar && currentPhase !== 'assassination' && currentPhase !== 'gameEnd'}}" class="role-vision-knife-row" bindtap="startAssassination">
          <view class="role-vision-seat">?</view>
          <view class="role-vision-knife">
            <text class="role-vision-knife-text">开刀</text>
          </view>
        </view>
      </view>
      <button class="btn btn-primary role-card-btn" bindtap="closeRoleModal">隐藏身份</button>
    </view>
  </view>

  <!-- 历史弹窗 -->
  <view class="info-modal" wx:if="{{showInfoModal}}">
    <view class="modal-mask" bindtap="closeInfoModal"></view>
    <view class="info-modal-body">
      <view class="info-modal-title">游戏记录</view>
      <scroll-view scroll-y enable-flex class="info-modal-scroll">
        <view wx:for="{{recordTimeline}}" wx:key="index" class="info-section">
          <view class="info-section-title {{item.cls}}">{{item.title}}</view>
          <!-- 发车轮次：连续发车信息+任务信息 -->
          <block wx:if="{{item.type === 'car'}}">
            <view wx:for="{{item.details}}" wx:for-item="car" wx:key="index" class="info-car">
              <view class="info-car-line">{{car.forced ? '【强制车】' : ''}}第{{car.index}}车 · 车主<text class="{{car.leaderSeat.isMe ? 'seat-me' : ''}}"> {{car.leaderSeat.seat}}</text>号</view>
              <view class="info-car-line">发车：<text wx:for="{{car.sendSeats}}" wx:key="seat" wx:for-item="s" wx:for-index="si" class="{{s.isMe ? 'seat-me' : ''}}">{{si > 0 ? ' ' : ''}}{{s.seat}}</text></view>
              <view class="info-car-line" wx:if="{{car.approveSeats.length}}">同意：<text wx:for="{{car.approveSeats}}" wx:key="seat" wx:for-item="s" wx:for-index="si" class="{{s.isMe ? 'seat-me' : ''}}">{{si > 0 ? ' ' : ''}}{{s.seat}}</text></view>
              <view class="info-car-line" wx:if="{{car.rejectSeats.length}}">反对：<text wx:for="{{car.rejectSeats}}" wx:key="seat" wx:for-item="s" wx:for-index="si" class="{{s.isMe ? 'seat-me' : ''}}">{{si > 0 ? ' ' : ''}}{{s.seat}}</text></view>
              <view class="info-car-line info-car-result">结果：{{car.outcomeText}}</view>
            </view>
          </block>
          <!-- 湖仙验人 -->
          <block wx:elif="{{item.type === 'lake'}}">
            <view class="info-row">
              <text>第{{item.round}}轮 <text class="{{item.inspectorSeat.isMe ? 'seat-me' : ''}}">{{item.inspectorSeat.seat}}</text>号 → <text class="{{item.targetSeat.isMe ? 'seat-me' : ''}}">{{item.targetSeat.seat}}</text>号</text>
              <text wx:if="{{item.result}}" class="{{item.result === 'good' ? 'txt-good' : 'txt-evil'}}">{{item.result === 'good' ? '蓝方' : '红方'}}</text>
              <text wx:else class="txt-muted">保密</text>
            </view>
          </block>
          <!-- 兰斯洛特转换判定 -->
          <block wx:elif="{{item.type === 'lancelot'}}">
            <view class="info-row">第{{item.round}}轮 {{item.switched ? '身份转换' : '身份保持'}}</view>
          </block>
          <!-- 刺客开刀 -->
          <block wx:elif="{{item.type === 'assassination'}}">
            <view class="info-row">刺客刺杀 {{item.targetSeat}}号 · {{item.correct ? '刺杀成功' : '刺杀失败'}}</view>
          </block>
        </view>
      </scroll-view>
      <button class="btn btn-primary info-modal-close" bindtap="closeInfoModal">关闭</button>
    </view>
  </view>

  <!-- 湖仙查验结果弹窗（仅验人者，纯图片蓝方蓝/红方红；"知道了"= 本人确认，不可关闭） -->
  <view class="lake-result-modal" wx:if="{{showLakeResult}}">
    <view class="modal-mask" catchtap="noop"></view>
    <view class="lake-result-body">
      <image src="/images/{{lakeResult === 'evil' ? 'avalon-red.png' : 'avalon-blue.png'}}" class="lake-result-img" mode="aspectFit"/>
      <button class="btn btn-primary" bindtap="confirmLake">知道了</button>
    </view>
  </view>

  <!-- 湖仙查验确认弹窗（非验人者，结果保密；仅按钮触发确认提交，不可关闭） -->
  <view class="lake-info-modal" wx:if="{{showLakeInfo}}">
    <view class="modal-mask" catchtap="noop"></view>
    <view class="lake-info-body">
      <view class="lake-info-title">湖仙验人</view>
      <view class="lake-info-text">{{lakeInfoText}}</view>
      <button class="btn btn-primary" bindtap="confirmLake">确认</button>
    </view>
  </view>

  <!-- 兰斯洛特抽卡弹窗（全员可见抽卡结果，仅按钮触发确认提交，不可关闭；重连由后端 lancelotConfirmed 恢复） -->
  <view class="lancelot-modal" wx:if="{{currentPhase === 'lancelot' && isInGame && !playerLancelotConfirmed}}">
    <view class="modal-mask" catchtap="noop"></view>
    <view class="lancelot-body">
      <view class="lancelot-title">兰斯洛特抽卡</view>
      <!-- 转换：蓝图 紫色弧形双箭头(上凸→/下凸←) 红图；未转换：文字 -->
      <block wx:if="{{lancelotResult && lancelotResult.switched}}">
        <view class="lancelot-swap">
          <image src="/images/avalon-blue.png" class="lancelot-swap-img" mode="aspectFit"/>
          <view class="lancelot-swap-arrows">
            <view class="lancelot-arrow lancelot-arrow-up"></view>
            <view class="lancelot-arrow lancelot-arrow-down"></view>
          </view>
          <image src="/images/avalon-red.png" class="lancelot-swap-img" mode="aspectFit"/>
        </view>
      </block>
      <view wx:else class="lancelot-result">未转换</view>
      <button class="btn btn-primary" bindtap="confirmLancelot">确认</button>
    </view>
  </view>

  <!-- 发言顺序弹窗（仅车主，不可关闭，期间阻断其他操作） -->
  <view class="order-modal" wx:if="{{currentPhase === 'speakingOrder' && isTeamLeader}}">
    <view class="order-mask" catchtap="noop" catchtouchmove="noop"></view>
    <view class="order-body">
      <image src="/images/up-arrow.png" class="order-arrow" data-order="asc" bindtap="selectSpeakingDirection" mode="aspectFit"></image>
      <image src="/images/down-arrow.png" class="order-arrow" data-order="desc" bindtap="selectSpeakingDirection" mode="aspectFit"></image>
    </view>
  </view>

  <!-- 任务投票弹窗（仅任务队成员，不可关闭；投票前有 5s 票型倒计时） -->
  <view class="mission-modal" wx:if="{{currentPhase === 'missionVote' && isMissionTeamMember && missionVoteReady}}">
    <view class="mission-mask" catchtap="noop" catchtouchmove="noop"></view>
    <block wx:if="{{!hasMissionVoted}}">
      <view class="mission-split">
        <view class="mission-half mission-half-success" data-vote="success" bindtap="confirmMissionVote">
          <text class="mission-half-emoji">✨</text>
        </view>
        <view class="mission-half mission-half-fail" data-vote="fail" bindtap="confirmMissionVote">
          <text class="mission-half-emoji">💣</text>
        </view>
      </view>
    </block>
    <view wx:else class="mission-waiting">
      <view class="mission-waiting-spinner"></view>
      <text class="mission-waiting-text">等待其他队员完成任务...</text>
    </view>
  </view>

  <!-- socket 断链重连遮罩（mask 不拦 touchmove，保证下拉刷新可穿透触发） -->
  <view class="reconnect-overlay" wx:if="{{socketReconnecting}}">
    <view class="reconnect-mask" catchtap="noop"></view>
    <view class="reconnect-box">
      <view class="reconnect-spinner"></view>
      <view class="reconnect-text">连接中断，正在重连...</view>
    </view>
  </view>

  <!-- 刺杀结算全屏动画：阶段1 刀落下 → 阶段2 成功/失败 -->
  <view class="assassin-anim" wx:if="{{showAssassinationAnim}}">
    <view class="assassin-anim-bg {{assassinationSuccess ? 'anim-success' : 'anim-fail'}}"></view>
    <view class="assassin-anim-scene" wx:if="{{assassinationPhase === 'knife'}}">
      <text class="assassin-knife">🔪</text>
    </view>
    <view class="assassin-anim-scene" wx:if="{{assassinationPhase === 'result'}}">
      <view class="assassin-anim-ring r1"></view>
      <view class="assassin-anim-ring r2"></view>
      <view class="assassin-anim-ring r3"></view>
      <view class="assassin-anim-center">
        <text class="assassin-anim-emoji">{{assassinationSuccess ? '💀' : '🛡️'}}</text>
        <text class="assassin-anim-text">{{assassinationSuccess ? '刺杀成功' : '刺杀失败'}}</text>
      </view>
    </view>
  </view>

  <!-- 任务结果全屏动画（全员）：成功蓝图 / 失败红图 -->
  <view class="mission-anim" wx:if="{{showMissionAnim}}">
    <view class="mission-anim-bg {{missionAnimSuccess ? 'anim-mission-success' : 'anim-mission-fail'}}"></view>
    <view class="mission-anim-ring r1"></view>
    <view class="mission-anim-ring r2"></view>
    <view class="mission-anim-ring r3"></view>
    <view class="mission-anim-center">
      <image src="/images/{{missionAnimSuccess ? 'avalon-blue.png' : 'avalon-red.png'}}" class="mission-anim-img" mode="aspectFit"/>
      <text class="mission-anim-text">{{missionAnimSuccess ? '任务成功' : '任务失败'}}</text>
    </view>
  </view>
</view>
</view>
