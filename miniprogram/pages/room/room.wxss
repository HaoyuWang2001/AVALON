@import "../../styles/config.wxss";

/* pages/room/room.wxss */

button { margin: 0; padding: 0; width: auto; }
button::after { border: none; }

.container { padding: 24rpx; }
.container.with-start-bar { padding-bottom: calc(152rpx + env(safe-area-inset-bottom)); }

/* ─── 开始游戏（长按读条） ─── */
.start-game-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF; border-top: 1rpx solid var(--border-color);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.start-game-btn {
  position: relative; overflow: hidden;
  width: 100%; height: 88rpx; border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, var(--primary-deep), var(--primary-deeper));
  box-shadow: 0 4rpx 16rpx rgba(124, 58, 237, 0.35);
}
.start-game-btn.start-game-disabled { background: var(--gray-200); box-shadow: none; }
.start-game-btn.charging { transform: scale(0.97); filter: brightness(1.15); }
.start-game-btn.charged { animation: sg-breathe 0.45s ease-in-out infinite; }
@keyframes sg-breathe {
  0%, 100% { transform: scale(1);   filter: brightness(1); }
  50%      { transform: scale(0.9); filter: brightness(1.35); }
}
.start-game-btn.dissolving { animation: sg-dissolve 0.6s ease-in forwards; }
@keyframes sg-dissolve {
  0%   { transform: scale(1)     rotate(0deg) skewX(0deg);   opacity: 1; }
  30%  { transform: scale(1.06)  rotate(-5deg) skewX(9deg);  opacity: 0.9; }
  60%  { transform: scale(1.15)  rotate(4deg) skewX(-12deg); opacity: 0.45; }
  100% { transform: scale(1.35)  rotate(-7deg) skewX(15deg); opacity: 0; }
}
.start-game-progress {
  position: absolute; left: 0; top: 0; bottom: 0;
  background: rgba(255, 255, 255, 0.35); z-index: 1;
}
.start-game-content { position: relative; z-index: 2; display: flex; align-items: center; gap: 24rpx; }
.start-game-text { color: #fff; font-size: 28rpx; font-weight: 700; letter-spacing: 4rpx; }
.start-game-btn.start-game-disabled .start-game-text { color: var(--gray-400); }
.start-game-arrow {
  color: #fff; font-size: 28rpx; font-weight: 700; letter-spacing: 2rpx;
  animation: sg-blink 0.4s steps(2) infinite;
}
.start-game-btn.start-game-disabled .start-game-arrow { color: var(--gray-400); }
@keyframes sg-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.15; }
}

/* ─── 启动全屏动画遮罩（5s） ─── */
.start-launch {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 300;
  background: rgba(22, 16, 46, 0.94);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  overflow: hidden;
  animation: sl-fadein 0.4s ease-out;
}
@keyframes sl-fadein { from { opacity: 0; } to { opacity: 1; } }
.launch-title { font-size: 56rpx; font-weight: 800; color: #fff; letter-spacing: 12rpx; z-index: 5; }

/* A：能量聚能 → 爆裂 */
.launch-a-orb {
  position: absolute; width: 120rpx; height: 120rpx; border-radius: 50%;
  background: radial-gradient(circle, #fff, var(--primary-light) 40%, transparent 70%);
  box-shadow: 0 0 80rpx 20rpx rgba(167, 139, 250, 0.8);
  animation: la-orb 5s ease-in infinite;
}
@keyframes la-orb {
  0% { transform: scale(0.3); opacity: 0.2; }
  40% { transform: scale(1.1); opacity: 1; }
  70% { transform: scale(1.6); opacity: 1; }
  100% { transform: scale(3); opacity: 0; }
}
.launch-a-ring {
  position: absolute; width: 200rpx; height: 200rpx; border-radius: 50%;
  border: 6rpx solid var(--primary-light);
  opacity: 0; animation: la-ring 5s ease-out infinite;
}
.launch-a-ring-2 { animation-delay: 0.5s; }
.launch-a-ring-3 { animation-delay: 1s; }
@keyframes la-ring {
  0% { transform: scale(0.2); opacity: 0.9; }
  70% { transform: scale(2.4); opacity: 0.2; }
  100% { transform: scale(3); opacity: 0; }
}

/* B：红蓝阵营对撞 */
.launch-b-blue {
  position: absolute; left: 0; top: 0; bottom: 0; width: 50%;
  background: linear-gradient(90deg, rgba(59,130,246,0.15), rgba(37,99,235,0.5));
  animation: la-bpush 5s ease-in-out infinite;
}
.launch-b-red {
  position: absolute; right: 0; top: 0; bottom: 0; width: 50%;
  background: linear-gradient(270deg, rgba(239,68,68,0.15), rgba(220,38,38,0.5));
  animation: la-bpush-r 5s ease-in-out infinite;
}
@keyframes la-bpush {
  0%,100% { transform: translateX(-20rpx); opacity: 0.8; }
  50% { transform: translateX(20rpx); opacity: 1; }
}
@keyframes la-bpush-r {
  0%,100% { transform: translateX(20rpx); opacity: 0.8; }
  50% { transform: translateX(-20rpx); opacity: 1; }
}
.launch-b-emblem {
  position: relative; z-index: 3; font-size: 72rpx; font-weight: 800; color: #fff;
  letter-spacing: 10rpx; text-shadow: 0 0 40rpx var(--primary-light);
  animation: la-emblem 5s ease-in-out infinite;
}
@keyframes la-emblem {
  0%,100% { transform: scale(1); opacity: 0.75; }
  50% { transform: scale(1.15); opacity: 1; }
}

/* C：梅林之眼 */
.launch-c-top, .launch-c-bottom {
  position: absolute; width: 320rpx; height: 200rpx;
  border: 8rpx solid var(--primary-light);
  animation: la-eye 5s ease-in-out infinite;
}
.launch-c-top { border-bottom: none; border-radius: 320rpx 320rpx 0 0; top: 50%; margin-top: -200rpx; }
.launch-c-bottom { border-top: none; border-radius: 0 0 320rpx 320rpx; top: 50%; }
@keyframes la-eye {
  0% { transform: scaleY(0.08); opacity: 0.5; }
  50% { transform: scaleY(1); opacity: 1; }
  100% { transform: scaleY(0.15); opacity: 0.9; }
}
.launch-c-iris {
  position: absolute; width: 120rpx; height: 120rpx; border-radius: 50%;
  background: radial-gradient(circle, #fff, var(--primary-light) 45%, var(--primary) 100%);
  box-shadow: 0 0 60rpx 15rpx rgba(139,92,246,0.9);
  animation: la-iris 5s ease-in-out infinite;
}
@keyframes la-iris {
  0%,100% { transform: scale(0.4); opacity: 0.5; }
  50% { transform: scale(1); opacity: 1; }
}
.launch-c-text { position: absolute; bottom: 220rpx; font-size: 30rpx; color: var(--primary-light); letter-spacing: 8rpx; animation: la-fadein 5s ease-in-out infinite; }

/* D：卡牌风暴 */
.launch-d-card {
  position: absolute; width: 120rpx; height: 170rpx; border-radius: 16rpx;
  background: linear-gradient(160deg, var(--primary-light), var(--primary-deep));
  border: 2rpx solid rgba(255,255,255,0.35);
  animation: la-card 5s ease-in-out infinite;
}
.launch-d-c1 { left: 8%; top: 30%; }
.launch-d-c2 { right: 8%; top: 25%; animation-delay: 0.6s; }
.launch-d-c3 { left: 16%; bottom: 18%; animation-delay: 1.2s; }
.launch-d-c4 { right: 16%; bottom: 15%; animation-delay: 1.8s; }
.launch-d-c5 { left: 50%; top: 8%; animation-delay: 2.4s; }
.launch-d-c6 { left: 45%; bottom: 6%; animation-delay: 3s; }
@keyframes la-card {
  0% { transform: translate(0,0) rotate(0deg) scale(1); opacity: 0; }
  15% { opacity: 1; }
  60% { transform: translate(calc(50vw - 60rpx), calc(50vh - 85rpx)) rotate(0deg) scale(1); opacity: 1; }
  85% { transform: translate(calc(50vw - 60rpx), calc(50vh - 85rpx)) rotate(360deg) scale(1.1); opacity: 1; }
  100% { transform: translate(calc(50vw - 60rpx), calc(50vh - 85rpx)) rotate(360deg) scale(2.2); opacity: 0; }
}

/* E：简约脉冲光环 */
.launch-e-ring {
  position: absolute; width: 260rpx; height: 260rpx; border-radius: 50%;
  border: 6rpx solid var(--primary-light);
  animation: la-ering 5s ease-out infinite;
}
.launch-e-ring-2 { animation-delay: 1s; }
@keyframes la-ering {
  0% { transform: scale(0.3); opacity: 0.9; }
  80% { transform: scale(2.6); opacity: 0.1; }
  100% { transform: scale(3); opacity: 0; }
}
.launch-e-title { position: relative; font-size: 64rpx; font-weight: 800; color: #fff; letter-spacing: 10rpx; animation: la-etitle 5s ease-in-out infinite; }
@keyframes la-etitle {
  0%,100% { transform: scale(1); opacity: 0.75; }
  50% { transform: scale(1.12); opacity: 1; }
}

/* ─── 启动动画选择弹窗 ─── */
.launch-modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1200;
  display: flex; align-items: center; justify-content: center;
}
.launch-modal-mask {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55);
}
.launch-modal-panel {
  position: relative; width: 560rpx; border-radius: 24rpx;
  background: #fff; padding: 40rpx 32rpx 28rpx;
  display: flex; flex-direction: column; align-items: center;
}
.launch-modal-title { font-size: 30rpx; font-weight: 700; color: var(--gray-800); margin-bottom: 28rpx; text-align: center; }
.launch-modal-options { display: flex; flex-wrap: wrap; justify-content: center; gap: 20rpx; margin-bottom: 32rpx; }
.launch-modal-opt {
  width: 88rpx; height: 88rpx; border-radius: 16rpx;
  background: var(--gray-100); color: var(--gray-600);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 700;
  border: 2rpx solid transparent;
}
.launch-modal-opt.opt-active { background: var(--primary); color: #fff; border-color: var(--primary-dark); }
.launch-modal-confirm {
  width: 100%; padding: 22rpx 0; border-radius: 16rpx; text-align: center;
  background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
  color: #fff; font-size: 32rpx; font-weight: 700;
}

/* ─── Card 1: Room Info ─── */
.room-info-card { background: #fff; }
.info-top-row { display: flex; align-items: center; justify-content: space-between; }
.info-label { font-size: 26rpx; color: var(--gray-500); margin-left: 4rpx; }
.info-btns { display: flex; gap: 12rpx; }
.room-id-display {
  display: block; text-align: center; font-size: 56rpx; font-weight: 800;
  color: var(--primary); letter-spacing: 8rpx; margin: 20rpx 0;
  padding-bottom: 24rpx;
  border-bottom: 1rpx dashed var(--gray-300);
}
.info-stats-row {
  display: flex; align-items: center; justify-content: center; gap: 32rpx;
}
.info-stat-item {
  display: flex; flex-direction: column; align-items: center; gap: 4rpx;
}
.stat-label { font-size: 24rpx; color: var(--gray-400); }
.stat-value { font-size: 30rpx; color: var(--gray-900); font-weight: 700; }
.stat-divider { width: 1rpx; height: 48rpx; background: var(--gray-200); }

/* ─── Start hint (host bottom bar 上方) ─── */

/* ─── Card 3: Seats ─── */
.seats-section { display: flex; flex-direction: column; gap: 10rpx; }
.seat-row {
  display: flex; align-items: center; padding: 24rpx 16rpx;
  border-radius: 12rpx; gap: 12rpx;
}
.seat-filled { background: var(--gray-50); }
.seat-self { padding: 24rpx 16rpx; margin: 0 -4rpx; box-shadow: 0 2rpx 12rpx rgba(139, 92, 246, 0.1); border-radius: 12rpx; background: var(--primary-bg); }
.seat-self .seat-action { gap: 16rpx; }
.seat-empty { background: #FAFAFA; border: 2rpx dashed var(--gray-200); }

.seat-num {
  width: 52rpx; height: 52rpx; border-radius: 12rpx;
  background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
  color: #fff; font-size: 22rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.seat-empty .seat-num { opacity: 0.5; }

.seat-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; flex-shrink: 0; background: var(--gray-100); }
.seat-avatar-empty { border: 2rpx dashed var(--gray-300); }

.seat-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.seat-name { font-size: 28rpx; font-weight: 600; color: var(--gray-900); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.seat-name-empty { font-size: 26rpx; color: var(--gray-300); }
.seat-tags { display: flex; flex-wrap: wrap; gap: 6rpx; }
.tag { font-size: 20rpx; padding: 2rpx 8rpx; border-radius: 4rpx; }
.tag-host { background: #DBEAFE; color: var(--link); }

.seat-status { display: flex; align-items: center; gap: 6rpx; flex-shrink: 0; font-size: 28rpx; }
.status-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.dot-green { background: var(--success); }
.dot-yellow { background: var(--warning); }
.seat-status.ready { color: var(--success); }
.seat-status.not-ready { color: var(--warning); }

.seat-action { display: flex; flex-direction: column; gap: 8rpx; flex-shrink: 0; align-items: center; }

/* ─── Card 4: Waiting Area ─── */
.waiting-scroll { width: 100%; white-space: nowrap; }
.waiting-list { display: inline-flex; flex-wrap: nowrap; gap: 12rpx; }
.waiting-item {
  display: inline-flex; flex-direction: column; align-items: center; gap: 8rpx;
  background: var(--gray-50); padding: 14rpx 16rpx; border-radius: 10rpx; flex-shrink: 0;
}
.waiting-avatar { width: 60rpx; height: 60rpx; border-radius: 50%; background: var(--gray-100); }
.waiting-name { font-size: 22rpx; color: var(--gray-700); text-align: center; max-width: 120rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ─── Card 5: Spectator ─── */
.empty-hint { text-align: center; font-size: 24rpx; color: var(--gray-300); padding: 30rpx 0; }

/* ─── 只读配置缩略弹窗 ─── */
.config-view-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 999;
  display: flex; align-items: center; justify-content: center;
}
.config-view-panel {
  width: 640rpx;
  max-height: 82vh;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx 40rpx;
  box-sizing: border-box;
  display: flex; flex-direction: column;
}
.config-view-scroll {
  flex: 1; min-height: 0; max-height: 60vh;
}
.config-view-title {
  font-size: 36rpx; font-weight: 800; color: #111827;
  text-align: center; margin-bottom: 24rpx;
}
.config-view-sec {
  font-size: 28rpx; font-weight: 700; color: #6b7280;
  margin: 24rpx 0 12rpx;
}
.config-view-line {
  font-size: 28rpx; color: #374151;
  line-height: 1.7;
}
.cv-strong { font-weight: 700; color: #111827; }
.config-view-close { margin-top: 32rpx; }
.cv-close-btn { background: #e5e7eb; color: #374151; }
