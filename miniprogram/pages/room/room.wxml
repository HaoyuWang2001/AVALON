<!--pages/room/room.wxml-->
<view class="room-page">
  <!-- Top Bar (公共组件：左=暂回首页 右=破坏性操作) -->
  <top-bar>
    <text slot="left" class="btn-round btn-purple" bindtap="backToLobby">暂回首页</text>
    <text slot="right" class="btn-round {{isHost ? 'btn-disband' : 'btn-exit'}}" bindtap="{{isHost ? 'disbandRoom' : 'exitRoom'}}">{{isHost ? '解散房间' : '退出房间'}}</text>
  </top-bar>

  <view class="container">

  <!-- Card 1: Room Info -->
  <view class="card room-info-card">
    <view class="info-top-row">
      <text class="info-label">会议ID：</text>
      <view class="info-btns">
        <text class="btn-round btn-copy" bindtap="copyRoomId">复制</text>
        <button class="btn-round btn-share" style="width: fit-content; min-width: auto;" open-type="share">分享</button>
      </view>
    </view>
    <text class="room-id-display">{{roomId}}</text>
    <view class="info-stats-row">
      <view class="info-stat-item">
        <text class="stat-label">入座</text>
        <text class="stat-value">{{seatedPlayers.length}}/{{playerCount}}</text>
      </view>
      <view class="stat-divider"></view>
      <view class="info-stat-item">
        <text class="stat-label">观战</text>
        <text class="stat-value">{{spectatorAllowed ? (spectatorPlayers.length + (spectatorMax > 0 ? '/' + spectatorMax : '')) : '-/-'}}</text>
      </view>
    </view>
  </view>

  <!-- Card 3: Seating Area -->
  <view class="card seating-card">
    <view class="card-header">
      <text class="card-title">上座区</text>
      <text wx:if="{{currentUser && currentUser.seatNumber < 1}}" class="btn-round btn-purple btn-random-seat" bindtap="randomTakeSeat">随机入座</text>
    </view>
    <view class="seats-section" wx:if="{{seatedSeats && seatedSeats.length > 0}}">
      <view wx:for="{{seatedSeats}}" wx:key="number" class="seat-row {{item.occupied ? 'seat-filled' : 'seat-empty'}} {{item.isSelf ? 'seat-self' : ''}}" bindtap="onSeatRowTap" data-id="{{item.player ? item.player.openId : ''}}" data-seat="{{item.number}}">
        <view class="seat-num">{{item.number}}</view>
        <image wx:if="{{item.occupied}}" src="{{item.player.avatarUrl || '/images/default-avatar.png'}}" class="seat-avatar"></image>
        <view wx:else class="seat-avatar seat-avatar-empty"></view>
        <view wx:if="{{item.occupied}}" class="seat-info">
          <text class="seat-name">{{item.player.nickName || item.player.wxNickName || '玩家'}}</text>
          <view class="seat-tags">
            <text wx:if="{{item.player.isHost}}" class="tag tag-host">房主</text>
          </view>
        </view>
        <view wx:else class="seat-info">
          <text class="seat-name-empty">空位</text>
        </view>
        <view wx:if="{{item.isSelf && item.occupied}}" class="seat-action">
          <text class="btn-round {{item.isReady ? 'btn-cancel' : 'btn-purple'}}" catchtap="toggleReady">{{item.isReady ? '取消准备' : '准备游戏'}}</text>
        </view>
        <view wx:elif="{{item.occupied}}" class="seat-status {{item.isReady ? 'ready' : 'not-ready'}}">
          <view class="status-dot {{item.isReady ? 'dot-green' : 'dot-yellow'}}"></view>
          <text>{{item.isReady ? '已准备' : '未准备'}}</text>
        </view>
        <view wx:elif="{{!item.occupied}}" class="seat-action"></view>
      </view>
    </view>
    <view wx:else class="empty-hint">等待配置房间...</view>
  </view>

  <!-- Card 4: Waiting Area（等待区永远存在） -->
  <view class="card waiting-card">
    <view class="card-header">
      <text class="card-title">等待区 ({{unseatedPlayers.length}})</text>
      <text wx:if="{{currentUser && (currentUser.seatNumber > 0 && !currentUser.isReady || currentUser.seatNumber < 0)}}" class="btn-round btn-purple" bindtap="leaveSeat">进入等待区</text>
    </view>
    <scroll-view scroll-x class="waiting-scroll" wx:if="{{unseatedPlayers.length > 0}}">
      <view class="waiting-list">
      <view wx:for="{{unseatedPlayers}}" wx:key="openId" class="waiting-item" bindtap="onPlayerAction" data-id="{{item.openId}}">
        <image src="{{item.avatarUrl || '/images/default-avatar.png'}}" class="waiting-avatar"></image>
        <text class="waiting-name">{{item.nickName || item.wxNickName || '玩家'}}</text>
      </view>
    </view>
    </scroll-view>
    <view wx:else class="empty-hint">暂无等待玩家</view>
  </view>

  <!-- Card 5: Spectator Area -->
  <view class="card spectator-card" wx:if="{{spectatorAllowed}}">
    <view class="card-header">
      <text class="card-title">观战区 ({{spectatorPlayers.length}})</text>
      <text wx:if="{{currentUser && currentUser.seatNumber >= 0}}" class="btn-round btn-purple" bindtap="becomeSpectator">进入观战区</text>
    </view>
    <scroll-view scroll-x class="waiting-scroll" wx:if="{{spectatorPlayers.length > 0}}">
      <view class="waiting-list">
        <view wx:for="{{spectatorPlayers}}" wx:key="openId" class="waiting-item" bindtap="onPlayerAction" data-id="{{item.openId}}">
        <image src="{{item.avatarUrl || '/images/default-avatar.png'}}" class="waiting-avatar"></image>
        <text class="waiting-name">{{item.nickName || '玩家'}}</text>
      </view>
      </view>
    </scroll-view>
    <view wx:else class="empty-hint">暂无观战玩家</view>
  </view>

  <!-- Host Bottom Bar (公共组件) -->
  <bottom-bar wx:if="{{currentUser && isHost}}">
    <text class="bar-btn" bindtap="modifyConfig">修改配置</text>
    <text class="bar-btn bar-btn-primary {{canStartGame ? '' : 'btn-disabled'}}" bindtap="startGame">开始游戏</text>
    <text class="bar-btn {{seatsFull ? '' : 'btn-disabled'}}" bindtap="randomShuffleSeats">随机位置</text>
  </bottom-bar>

  <!-- Config Overlay -->
  <view class="config-overlay" wx:if="{{showConfig}}">
    <view class="config-panel">

      <!-- Top bar -->
      <view class="config-top-bar">
        <view class="config-close" bindtap="closeConfig">
          <text class="close-text">✕</text>
        </view>
      </view>

      <!-- Swiper -->
      <swiper class="config-swiper" current="{{swiperPage}}" bindchange="onSwiperChange" duration="300">
        
        <!-- Page 0: 人数+角色+湖仙 -->
        <swiper-item>
          <scroll-view scroll-y class="config-scroll" show-scrollbar="{{false}}">
            <view class="config-section">
              <view class="section-title">🙋 玩家总数</view>
              <scroll-view class="count-row" scroll-x show-scrollbar="{{false}}">
                <view wx:for="{{[5,6,7,8,9,10,11,12]}}" wx:key="*this"
                  class="count-item {{playerCount === item ? 'count-active' : ''}}"
                  data-count="{{item}}" bindtap="onPlayerCountChange">{{item}}</view>
              </scroll-view>

              <view class="team-sizes">
                <text class="team-sizes-label">每轮发车人数（固定）</text>
                <view class="team-sizes-row">
                  <view wx:for="{{teamSizes}}" wx:key="index" class="team-badge">
                    <text class="team-badge-note" style="color:transparent"> </text>
                    <text class="team-badge-count">{{item}}人</text>
                    <text class="team-badge-note">{{index === 3 && playerCount >= 7 ? '保护轮' : ' '}}</text>
                  </view>
                </view>
              </view>
            </view>

            <view class="config-section">
              <view class="section-title"><image src="/images/avalon-blue.png" class="section-icon"/>好人</view>
              <scroll-view class="role-scroll" scroll-x show-scrollbar="{{false}}">
              <view class="role-scroll-row">
                <view class="role-card role-loyal">
                  <view class="role-img-placeholder">
                    <image src="/images/avalon-blue.png" class="role-img"/>
                  </view>
                  <text class="role-name">忠臣</text>
                  <text class="loyal-count">×{{loyalCount}}</text>
                </view>
                <view wx:for="{{['merlin','percival','lancelotBlue']}}" wx:key="*this"
                  class="role-card {{selectedRoles[item] ? 'role-good' : ''}}"
                  data-role="{{item}}" bindtap="onRoleToggle">
                  <view class="role-img-placeholder">
                    <image src="/images/avalon-blue.png" class="role-img"/>
                  </view>
                  <text class="role-name">{{item === 'merlin' ? '梅林' : item === 'percival' ? '派西' : '蓝兰'}}</text>
                  <!-- 梅林/派西必选：固定 ×1，无选中框 -->
                  <text wx:if="{{item === 'merlin' || item === 'percival'}}" class="loyal-count">×1</text>
                  <view wx:else class="role-check {{selectedRoles[item] ? 'check-on' : ''}}">
                    <text wx:if="{{selectedRoles[item]}}">✓</text>
                  </view>
                </view>
              </view>
              </scroll-view>
            </view>

            <view class="config-section">
              <view class="section-title"><image src="/images/avalon-red.png" class="section-icon"/>坏人</view>
              <scroll-view class="role-scroll" scroll-x show-scrollbar="{{false}}">
              <view class="role-scroll-row">
                <view wx:for="{{['morgana','assassin','oberon','mordred','minion','lancelotRed']}}" wx:key="*this"
                  class="role-card {{selectedRoles[item] ? 'role-evil' : ''}}"
                  data-role="{{item}}" bindtap="onRoleToggle">
                  <view class="role-img-placeholder">
                    <image src="/images/avalon-red.png" class="role-img"/>
                  </view>
                  <text class="role-name">{{item === 'morgana' ? '莫甘娜' : item === 'assassin' ? '刺客' : item === 'oberon' ? '奥伯伦' : item === 'mordred' ? '莫德雷德' : item === 'minion' ? '爪牙' : '红兰'}}</text>
                  <!-- 莫甘娜必选：固定 ×1，无选中框 -->
                  <text wx:if="{{item === 'morgana'}}" class="role-count-evil">×1</text>
                  <view wx:else class="role-check {{selectedRoles[item] ? 'check-on' : ''}}">
                    <text wx:if="{{selectedRoles[item]}}">✓</text>
                  </view>
                </view>
              </view>
              </scroll-view>
            </view>

            <view class="role-summary" wx:if="{{roleWarning}}">
              <text class="role-warning">⚠️ {{roleWarning}}</text>
            </view>

            <view class="config-section">
              <view class="section-title">🏞️ 湖中仙女</view>
              <view class="rule-row">
                <text class="rule-label">启用湖中仙女</text>
                <switch checked="{{ladyOfTheLake}}" bindchange="onLadyToggle" color="#8B5CF6"/>
              </view>
              <view class="rule-row" wx:if="{{ladyOfTheLake}}">
                <text class="rule-label">生效轮次</text>
                <picker class="rule-picker" mode="selector" range="{{[1,2,3,4]}}" value="{{ladyOfTheLakeRound - 1}}" bindchange="onLadyRoundChange">
                  <text>第 {{ladyOfTheLakeRound}} 轮发车成功后可用</text>
                </picker>
              </view>
            </view>
            <view style="height:40rpx"></view>
          </scroll-view>
        </swiper-item>

        <!-- Page 1: 必须设置项 -->
        <swiper-item>
          <scroll-view scroll-y class="config-scroll" show-scrollbar="{{false}}">
            <view class="config-section">
              <view class="section-title">📋 基础规则</view>
              <view class="rule-row">
                <view class="rule-col">
                  <text class="rule-label">流车上限</text>
                  <text class="rule-desc">每轮最多流车 {{rules.maxFailedNominations}} 次，第 {{rules.maxFailedNominations + 1}} 辆车直接发出</text>
                </view>
                <picker class="rule-picker" mode="selector" range="{{[1,2,3,4,5]}}" value="{{rules.maxFailedNominations - 1}}" data-field="maxFailedNominations" data-range="{{[1,2,3,4,5]}}" bindchange="onRulePicker">
                  <text>{{rules.maxFailedNominations}} 次</text>
                </picker>
              </view>
              <view class="rule-row">
                <view class="rule-col">
                  <text class="rule-label">坏人互知身份</text>
                  <text class="rule-desc">除奥伯伦外，坏人互相知道对方具体身份</text>
                </view>
                <switch checked="{{rules.evilKnowsEachOther}}" data-field="evilKnowsEachOther" bindchange="onRuleToggle" color="#8B5CF6"/>
              </view>
              <view class="rule-row">
                <view class="rule-col">
                  <text class="rule-label">票型公开</text>
                  <text class="rule-desc">组队投票时是否展示每个人的投票结果</text>
                </view>
                <view class="segment">
                  <view class="segment-item {{rules.voteVisibility === 'public' ? 'segment-active' : ''}}" data-field="voteVisibility" data-val="public" bindtap="onRuleSegment">公开</view>
                  <view class="segment-item {{rules.voteVisibility === 'anonymous' ? 'segment-active' : ''}}" data-field="voteVisibility" data-val="anonymous" bindtap="onRuleSegment">匿名</view>
                </view>
              </view>
              <view class="rule-row">
                <view class="rule-col">
                  <text class="rule-label">失败详情</text>
                  <text class="rule-desc">任务失败时显示几票失败 or 仅知成败</text>
                </view>
                <view class="segment">
                  <view class="segment-item {{rules.missionFailDetail === 'count' ? 'segment-active' : ''}}" data-field="missionFailDetail" data-val="count" bindtap="onRuleSegment">票数</view>
                  <view class="segment-item {{rules.missionFailDetail === 'binary' ? 'segment-active' : ''}}" data-field="missionFailDetail" data-val="binary" bindtap="onRuleSegment">成败</view>
                </view>
              </view>
            </view>

            <view class="config-section" hidden="{{!selectedRoles.oberon && !selectedRoles.lancelotRed}}">
              <view class="section-title">💣 坏人强制任务失败</view>
              <view class="rule-row" hidden="{{!selectedRoles.oberon}}">
                <view class="rule-col">
                  <text class="rule-label">奥伯伦必须任务失败</text>
                  <text class="rule-desc">若被选入任务队伍，必须投失败票</text>
                </view>
                <switch checked="{{rules.oberonMustFailMission}}" data-field="oberonMustFailMission" bindchange="onRuleToggle" color="#8B5CF6"/>
              </view>
              <view class="rule-row" hidden="{{!selectedRoles.lancelotBlue && !selectedRoles.lancelotRed}}">
                <view class="rule-col">
                  <text class="rule-label">兰斯洛特必须任务失败</text>
                  <text class="rule-desc">当前为坏人阵营的兰斯洛特若被选入任务队伍，必须投失败票</text>
                </view>
                <switch checked="{{rules.lancelotMustFail}}" data-field="lancelotMustFail" bindchange="onRuleToggle" color="#8B5CF6"/>
              </view>
            </view>
          </scroll-view>
        </swiper-item>

        <!-- Page 2: 兰斯洛特配置 (conditional) -->
        <swiper-item hidden="{{!selectedRoles.lancelotBlue && !selectedRoles.lancelotRed}}">
          <scroll-view scroll-y class="config-scroll" show-scrollbar="{{false}}">
            <view class="config-section">
              <view class="section-title">⚔️ 兰斯洛特配置</view>
              <view class="rule-row" hidden="{{!selectedRoles.lancelotBlue || !selectedRoles.lancelotRed}}">
                <view class="rule-col">
                  <text class="rule-label">兰斯互认身份</text>
                  <text class="rule-desc">蓝兰与红兰在视野中知道对方身份</text>
                </view>
                <switch checked="{{rules.lancelotsKnowEachOther}}" data-field="lancelotsKnowEachOther" bindchange="onRuleToggle" color="#8B5CF6"/>
              </view>
              <view class="rule-row">
                <view class="rule-col">
                  <text class="rule-label">兰斯换身轮次</text>
                  <text class="rule-desc">第几轮结束、下一轮开始时抽取身份转换卡（1-4）</text>
                </view>
                <picker class="rule-picker" mode="selector" range="{{[1,2,3,4]}}" value="{{rules.lancelotSwapRound - 1}}" data-field="lancelotSwapRound" data-range="{{[1,2,3,4]}}" bindchange="onRulePicker">
                  <text>第 {{rules.lancelotSwapRound}} 轮</text>
                </picker>
              </view>
              <view class="rule-row" wx:if="{{selectedRoles.lancelotRed}}">
                <view class="rule-col">
                  <text class="rule-label">睁眼狼知红兰</text>
                  <text class="rule-desc">睁眼狼（莫甘娜/刺客/爪牙/莫德雷德）是否知道红兰身份</text>
                </view>
                <switch checked="{{rules.evilsKnowRedLancelot}}" data-field="evilsKnowRedLancelot" bindchange="onRuleToggle" color="#8B5CF6"/>
              </view>
              <view class="rule-row" wx:if="{{selectedRoles.oberon}}">
                <view class="rule-col">
                  <text class="rule-label">奥伯伦知红兰</text>
                  <text class="rule-desc">奥伯伦是否知道红兰身份</text>
                </view>
                <switch checked="{{rules.oberonKnowsRedLancelot}}" data-field="oberonKnowsRedLancelot" bindchange="onRuleToggle" color="#8B5CF6"/>
              </view>
              <view class="rule-row" wx:if="{{selectedRoles.lancelotBlue && selectedRoles.lancelotRed}}">
                <view class="rule-col">
                  <text class="rule-label">梅林辨兰阵营</text>
                  <text class="rule-desc">梅林能否分辨蓝/红兰各自阵营（仍能看到双兰）</text>
                </view>
                <switch checked="{{rules.merlinKnowsLancelotSide}}" data-field="merlinKnowsLancelotSide" bindchange="onRuleToggle" color="#8B5CF6"/>
              </view>
            </view>
          </scroll-view>
        </swiper-item>

        <!-- Page 3: 保留位 -->
        <swiper-item hidden="{{true}}"></swiper-item>


        <!-- Page 4: 时间+信息+创建 -->
        <swiper-item>
          <scroll-view scroll-y class="config-scroll" show-scrollbar="{{false}}">
            <view class="config-section">
              <view class="section-title">⏱️ 时间限制</view>
              <view class="rule-row">
                <text class="rule-label">发言限时</text>
                <picker class="rule-picker" mode="selector" range="{{speechOptions}}" value="{{speechTimeoutIndex}}" data-field="speechTimeoutIndex" bindchange="onLimitChange">
                  <text>{{speechOptions[speechTimeoutIndex]}}</text>
                </picker>
              </view>
              <view class="rule-row">
                <text class="rule-label">任务超时</text>
                <picker class="rule-picker" mode="selector" range="{{roundOptions}}" value="{{roundTimeoutIndex}}" data-field="roundTimeoutIndex" bindchange="onLimitChange">
                  <text>{{roundOptions[roundTimeoutIndex]}}</text>
                </picker>
              </view>
              <view class="rule-row">
                <text class="rule-label">投票超时</text>
                <picker class="rule-picker" mode="selector" range="{{voteOptions}}" value="{{voteTimeoutIndex}}" data-field="voteTimeoutIndex" bindchange="onLimitChange">
                  <text>{{voteOptions[voteTimeoutIndex]}}</text>
                </picker>
              </view>
              <view class="rule-hint">
                💡 若任务或投票超时，未行动视为投出成功票或赞成票（必须出失败票的角色仍会出失败票）。
              </view>
            </view>

            <view class="config-section">
              <view class="section-title">👁️ 观战设置</view>
              <view class="rule-row">
                <text class="rule-label">允许观战</text>
                <switch checked="{{allowSpectator}}" bindchange="onSpectatorToggle" color="#8B5CF6"/>
              </view>
              <view class="rule-row" wx:if="{{allowSpectator}}">
                <text class="rule-label">观战人数上限</text>
                <view class="segment">
                  <view class="segment-item {{!spectatorLimited ? 'segment-active' : ''}}" data-val="false" bindtap="onSpectatorLimitMode">不限</view>
                  <view class="segment-item {{spectatorLimited ? 'segment-active' : ''}}" data-val="true" bindtap="onSpectatorLimitMode">有限制</view>
                </view>
              </view>
              <view class="rule-row" wx:if="{{allowSpectator && spectatorLimited}}">
                <text class="rule-label">上限人数</text>
                <input class="spectator-input {{spectatorLimitInvalid ? 'input-invalid' : ''}}" type="number" maxlength="3" placeholder="1-100" value="{{maxSpectators || ''}}" bindinput="onSpectatorLimitInput"/>
              </view>
            </view>
            <view style="height:60rpx"></view>
          </scroll-view>
        </swiper-item>

        <!-- Page 6: 配置总结+会议信息+完成 -->
        <swiper-item>
          <scroll-view scroll-y class="config-scroll" show-scrollbar="{{false}}">
            <view class="config-section">
              <view class="section-title">📋 配置总结</view>
              <view class="summary-card">
                <view class="summary-row">
                  <text class="summary-label">玩家数</text>
                  <text class="summary-value">{{playerCount}}人</text>
                </view>
                <view class="summary-row">
                  <text class="summary-label">好人</text>
                  <text class="summary-value">{{goodRoleNames}}</text>
                </view>
                <view class="summary-row">
                  <text class="summary-label">坏人</text>
                  <text class="summary-value">{{evilRoleNames}}</text>
                </view>
                <view class="summary-row">
                  <text class="summary-label">湖中仙女</text>
                  <text class="summary-value">{{summaryLady}}</text>
                </view>
                <view class="summary-row">
                  <text class="summary-label">坏人互知</text>
                  <text class="summary-value">{{rules.evilKnowsEachOther ? '是' : '否'}}</text>
                </view>
              </view>
            </view>

            <view class="config-section">
              <view class="section-title">📝 会议信息</view>
              <view class="meta-row">
                <text class="rule-label">会议名</text>
                <input class="meta-input" placeholder="{{customNickName || '房主'}}的会议" value="{{roomName}}" data-field="roomName" bindinput="onMetaInput"/>
              </view>
              <view class="meta-row">
                <text class="rule-label">描述</text>
                <input class="meta-input" placeholder="欢迎所有玩家" value="{{roomDescription}}" data-field="roomDescription" bindinput="onMetaInput"/>
              </view>
            </view>

            <view class="create-section">
              <button class="create-btn" bindtap="finishConfig" disabled="{{roleWarning !== ''}}">完成</button>
            </view>
            <view style="height:60rpx"></view>
          </scroll-view>
        </swiper-item>

      </swiper>

      <!-- Navigation bar -->
      <view class="nav-bar">
        <view class="nav-btn btn-square {{logicalPage === 0 ? 'nav-disabled' : ''}}" bindtap="prevPage">◀ 上一步</view>
        <view class="nav-dots">
          <view wx:for="{{visiblePages}}" wx:key="*this" class="nav-dot {{index === logicalPage ? 'dot-active' : ''}}"></view>
        </view>
        <view class="nav-btn btn-square {{(logicalPage === visiblePages.length - 1) || (logicalPage === 0 && roleWarning) ? 'nav-disabled' : ''}}" bindtap="nextPage">下一步 ▶</view>
      </view>
    </view>
  </view>
</view>
</view>