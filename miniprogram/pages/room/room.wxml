<!--pages/room/room.wxml-->
<view class="container">
  <!-- Card 1: Room Info -->
  <view class="card room-info-card">
    <view class="info-row">
      <view class="room-id-area">
        <text class="label">会议ID</text>
        <text class="room-id">{{roomId}}</text>
      </view>
      <view class="info-btns">
        <view class="btn-round btn-copy" bindtap="copyRoomId">复制</view>
        <button class="btn-round btn-share" open-type="share">分享</button>
        <view class="btn-round btn-exit" bindtap="exitRoom">退出</view>
      </view>
    </view>
    <view class="info-row stats-row">
      <text class="stat">共 {{players.length}} 人</text>
      <text class="stat">入座 {{seatedPlayers.length}}/{{playerCount}}</text>
    </view>
  </view>

  <!-- Card 2: Control Area -->
  <view class="card control-card" wx:if="{{currentUser && currentUser.seatNumber >= 1}}">
    <view wx:if="{{isHost}}" class="host-controls">
      <view class="btn-round btn-start-game {{canStartGame ? '' : 'disabled'}}" bindtap="startGame">开始游戏</view>
      <text wx:if="{{!canStartGame && startHint}}" class="start-hint">{{startHint}}</text>
      <view class="host-actions">
        <view class="btn-round btn-disband" bindtap="disbandRoom">解散房间</view>
        <view class="btn-round btn-purple" bindtap="modifyConfig">修改配置</view>
        <view class="btn-round btn-purple" bindtap="randomShuffleSeats">随机位置</view>
      </view>
    </view>
    <view wx:else class="player-controls">
      <view class="btn-round {{readyPlayers.indexOf(currentUser.openId) > -1 ? 'btn-cancel' : 'btn-ready'}}" bindtap="toggleReady">
        {{readyPlayers.indexOf(currentUser.openId) > -1 ? '取消准备' : '准备游戏'}}
      </view>
    </view>
  </view>

  <!-- Card 3: Seating Area -->
  <view class="card seating-card">
    <view class="card-header">
      <text class="card-title">上座区</text>
      <view class="btn-round btn-random-seat {{currentUser && currentUser.seatNumber < 1 ? '' : 'disabled'}}" bindtap="randomTakeSeat">随机入座</view>
    </view>
    <view class="seats-section" wx:if="{{seatedSeats && seatedSeats.length > 0}}">
      <view wx:for="{{seatedSeats}}" wx:key="number" class="seat-row {{item.occupied ? 'seat-filled' : 'seat-empty'}}">
        <view class="seat-num">{{item.number}}</view>
        <image wx:if="{{item.occupied}}" src="{{item.player.avatarUrl || '/images/default-avatar.png'}}" class="seat-avatar"></image>
        <view wx:else class="seat-avatar seat-avatar-empty"></view>
        <view wx:if="{{item.occupied}}" class="seat-info">
          <text class="seat-name">{{item.player.nickName || item.player.wxNickName || '玩家'}}</text>
          <view class="seat-tags">
            <text wx:if="{{item.player.isHost}}" class="tag tag-host">房主</text>
          </view>
        </view>
        <view wx:else class="seat-info">
          <text class="seat-name-empty">空位</text>
          <view wx:if="{{currentUser && currentUser.seatNumber < 1}}" class="btn-take" bindtap="takeSeat" data-seat="{{item.number}}">入座</view>
        </view>
        <view wx:if="{{item.occupied}}" class="seat-status {{item.isReady ? 'ready' : 'not-ready'}}">
          <view class="status-dot {{item.isReady ? 'dot-green' : 'dot-yellow'}}"></view>
          <text>{{item.isReady ? '已准备' : '未准备'}}</text>
        </view>
        <view wx:elif="{{!item.occupied}}" class="seat-status"></view>
        <view wx:if="{{isHost && item.occupied && !item.isSelf}}" class="seat-kick" bindtap="kickPlayer" data-id="{{item.player.openId}}">×</view>
      </view>
    </view>
    <view wx:else class="empty-hint">等待配置房间...</view>
  </view>

  <!-- Card 4: Waiting Area -->
  <view class="card waiting-card" wx:if="{{unseatedPlayers.length > 0}}">
    <view class="card-header">
      <text class="card-title">等待区 ({{unseatedPlayers.length}})</text>
    </view>
    <view class="waiting-list">
      <view wx:for="{{unseatedPlayers}}" wx:key="openId" class="waiting-item">
        <image src="{{item.avatarUrl || '/images/default-avatar.png'}}" class="waiting-avatar"></image>
        <text class="waiting-name">{{item.nickName || item.wxNickName || '玩家'}}</text>
        <view wx:if="{{isHost}}" class="waiting-kick" bindtap="kickPlayer" data-id="{{item.openId}}">踢出</view>
      </view>
    </view>
  </view>

  <!-- Card 5: Spectator Area -->
  <view class="card spectator-card">
    <view class="card-header">
      <text class="card-title">观战区 ({{spectatorPlayers.length}})</text>
      <view class="btn-round btn-spectate" bindtap="becomeSpectator" wx:if="{{currentUser && currentUser.seatNumber >= 0}}">观战</view>
    </view>
    <view wx:if="{{spectatorPlayers.length > 0}}" class="spectator-list">
      <view wx:for="{{spectatorPlayers}}" wx:key="openId" class="spectator-item">
        <image src="{{item.avatarUrl || '/images/default-avatar.png'}}" class="spectator-avatar"></image>
        <text class="spectator-name">{{item.nickName || '玩家'}}</text>
      </view>
    </view>
    <view wx:else class="empty-hint">暂无观战玩家</view>
  </view>
</view>
