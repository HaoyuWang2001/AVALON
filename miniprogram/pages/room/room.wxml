<!--pages/room/room.wxml-->
<view class="container">
  <!-- Card 1: Room Info -->
  <view class="card room-info-card">
    <view class="info-row">
      <view class="room-id-area">
        <text class="label">会议ID</text>
        <text class="room-id">{{roomId}}</text>
      </view>
      <view class="info-btns">
        <button class="btn-small btn-outline" bindtap="copyRoomId">复制</button>
        <button class="btn-small btn-primary" open-type="share">分享</button>
        <button class="btn-small btn-danger" bindtap="exitRoom">退出房间</button>
      </view>
    </view>
    <view class="info-row stats-row">
      <text class="stat">房间总人数：{{players.length}}</text>
      <text class="stat">入座玩家：{{seatedPlayers.length}}/{{playerCount}}</text>
    </view>
  </view>

  <!-- Card 2: Control Area (only for seated players) -->
  <view class="card control-card" wx:if="{{currentUser && currentUser.seatNumber >= 1}}">
    <view wx:if="{{isHost}}" class="control-row host-controls">
      <button class="btn-action btn-start" bindtap="startGame">开始游戏</button>
      <button class="btn-action btn-danger" bindtap="disbandRoom">解散房间</button>
      <button class="btn-action btn-outline" bindtap="modifyConfig">修改配置</button>
      <button class="btn-action btn-outline" bindtap="randomShuffleSeats">随机位置</button>
    </view>
    <view wx:else class="control-row player-controls">
      <button class="btn-action {{readyPlayers.indexOf(currentUser.openId) > -1 ? 'btn-secondary' : 'btn-ready'}}" bindtap="toggleReady">
        {{readyPlayers.indexOf(currentUser.openId) > -1 ? '取消准备' : '准备游戏'}}
      </button>
      <view class="ready-status">{{readyPlayers.indexOf(currentUser.openId) > -1 ? '已准备' : '未准备'}}</view>
    </view>
  </view>

  <!-- Card 3: Seating Area -->
  <view class="card seating-card">
    <view class="card-header">
      <text class="card-title">上座区</text>
      <button class="btn-small btn-outline" bindtap="randomTakeSeat" disabled="{{!(currentUser && currentUser.seatNumber < 1)}}">随机入座</button>
    </view>

    <!-- Unseated Players -->
    <view wx:if="{{unseatedPlayers.length > 0}}" class="unseated-section">
      <text class="section-label">未入座 ({{unseatedPlayers.length}})</text>
      <view class="unseated-list">
        <view wx:for="{{unseatedPlayers}}" wx:key="openId" class="unseated-item">
          <image src="{{item.avatarUrl || '/images/default-avatar.png'}}" class="player-avatar-sm"></image>
          <text class="player-name-sm">{{item.nickName || '玩家'}}</text>
          <view wx:if="{{isHost}}" class="btn-kick" bindtap="kickPlayer" data-id="{{item.openId}}">踢出</view>
        </view>
      </view>
    </view>

    <!-- Game Seats -->
    <view class="seats-section">
      <view wx:for="{{seatedSeats}}" wx:key="number" class="seat-row {{item.occupied ? 'seat-occupied' : 'seat-empty'}}">
        <view class="seat-number">{{item.number}}</view>
        <view wx:if="{{item.occupied}}" class="seat-player">
          <image src="{{item.player.avatarUrl || '/images/default-avatar.png'}}" class="player-avatar"></image>
          <view class="seat-player-info">
            <text class="seat-player-name">{{item.player.nickName || item.player.wxNickName || '玩家'}}</text>
            <text class="seat-player-status {{item.isReady ? 'ready' : 'not-ready'}}">
              {{item.isReady ? '已准备' : '未准备'}}
              <text wx:if="{{item.player.isHost}}" class="host-tag">房主</text>
            </text>
          </view>
          <view wx:if="{{isHost && !item.isSelf}}" class="btn-kick" bindtap="kickPlayer" data-id="{{item.player.openId}}">踢出</view>
          <view wx:elif="{{item.isSelf && item.isReady}}" class="seat-locked">🔒</view>
          <view wx:elif="{{item.isSelf && !item.isReady}}" class="btn-leave-seat" bindtap="leaveSeat">离开</view>
        </view>
        <view wx:else class="seat-placeholder">
          <text class="seat-empty-text">空位</text>
          <button wx:if="{{currentUser && currentUser.seatNumber < 1}}" class="btn-seat-take" bindtap="takeSeat" data-seat="{{item.number}}">入座</button>
        </view>
      </view>
      <view wx:if="{{!seatedSeats || seatedSeats.length === 0}}" class="empty-hint">等待配置房间...</view>
    </view>
  </view>

  <!-- Card 4: Spectator Area -->
  <view class="card spectator-card">
    <view class="card-header">
      <text class="card-title">观战区 ({{spectatorPlayers.length}})</text>
      <button class="btn-small btn-outline" bindtap="becomeSpectator" wx:if="{{currentUser && currentUser.seatNumber >= 0}}">观战</button>
    </view>
    <view wx:if="{{spectatorPlayers.length > 0}}" class="spectator-list">
      <view wx:for="{{spectatorPlayers}}" wx:key="openId" class="spectator-item">
        <image src="{{item.avatarUrl || '/images/default-avatar.png'}}" class="spectator-avatar"></image>
        <text class="spectator-name">{{item.nickName || '玩家'}}</text>
      </view>
    </view>
    <view wx:else class="empty-hint">暂无观战玩家</view>
  </view>
</view>
