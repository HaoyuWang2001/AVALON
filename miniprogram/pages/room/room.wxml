<!--pages/room/room.wxml-->
<view class="container">
  <!-- Top Bar (always visible) -->
  <view class="top-bar">
    <text class="btn-topbar btn-topbar-left {{isHost ? 'btn-disband' : 'btn-exit'}}" bindtap="{{isHost ? 'disbandRoom' : 'exitRoom'}}">{{isHost ? '解散房间' : '退出房间'}}</text>
    <text class="btn-topbar btn-topbar-right btn-purple" bindtap="toggleInfoCard">{{infoCollapsed ? '展开' : '收起房间'}}</text>
  </view>

  <!-- Card 1: Room Info (collapsible) -->
  <view class="card room-info-card" wx:if="{{!infoCollapsed}}">
    <view class="info-top-row">
      <text class="info-label">会议ID：</text>
      <view class="info-btns">
        <text class="btn-round btn-copy" bindtap="copyRoomId">复制</text>
        <button class="btn-round btn-share" open-type="share">分享</button>
      </view>
    </view>
    <text class="room-id-display">{{roomId}}</text>
    <view class="info-stats-row">
      <view class="info-stat-item">
        <text class="stat-label">入座</text>
        <text class="stat-value">{{seatedPlayers.length}}/{{playerCount}}</text>
      </view>
      <view class="stat-divider"></view>
      <view class="info-stat-item">
        <text class="stat-label">观战</text>
        <text class="stat-value">{{spectatorPlayers.length}}{{spectatorMax > 0 ? '/' + spectatorMax : ''}}</text>
      </view>
    </view>
  </view>

  <!-- Card 2: Host Control -->
  <view class="card host-card" wx:if="{{currentUser && currentUser.seatNumber >= 1 && isHost}}">
    <view class="card-header">
      <text class="card-title">🎮 房主控制台</text>
    </view>
    <text class="btn-host-start {{canStartGame ? '' : 'disabled'}}" bindtap="startGame">开始游戏</text>
    <text wx:if="{{!canStartGame && startHint}}" class="start-hint">{{startHint}}</text>
    <view class="host-divider"></view>
    <view class="host-actions">
      <text class="btn-round btn-purple" bindtap="modifyConfig">修改配置</text>
      <text class="btn-round btn-purple" bindtap="randomShuffleSeats">随机位置</text>
    </view>
  </view>

  <!-- Card 3: Seating Area -->
  <view class="card seating-card">
    <view class="card-header">
      <text class="card-title">上座区</text>
      <text wx:if="{{currentUser && currentUser.seatNumber < 1}}" class="btn-round btn-purple btn-random-seat" bindtap="randomTakeSeat">随机入座</text>
    </view>
    <view class="seats-section" wx:if="{{seatedSeats && seatedSeats.length > 0}}">
      <view wx:for="{{seatedSeats}}" wx:key="number" class="seat-row {{item.occupied ? 'seat-filled' : 'seat-empty'}} {{item.isSelf ? 'seat-self' : ''}}">
        <view class="seat-num">{{item.number}}</view>
        <image wx:if="{{item.occupied}}" src="{{item.player.avatarUrl || '/images/default-avatar.png'}}" class="seat-avatar"></image>
        <view wx:else class="seat-avatar seat-avatar-empty"></view>
        <view wx:if="{{item.occupied}}" class="seat-info">
          <text class="seat-name">{{item.player.nickName || item.player.wxNickName || '玩家'}}</text>
          <view class="seat-tags">
            <text wx:if="{{item.player.isHost}}" class="tag tag-host">房主</text>
          </view>
        </view>
        <view wx:else class="seat-info">
          <text class="seat-name-empty">空位</text>
        </view>
        <view wx:if="{{item.isSelf && item.occupied}}" class="seat-action">
          <text class="btn-seat-action {{item.isReady ? 'btn-cancel' : 'btn-ready'}}" bindtap="toggleReady">{{item.isReady ? '取消准备' : '准备游戏'}}</text>
        </view>
        <view wx:elif="{{item.occupied}}" class="seat-status {{item.isReady ? 'ready' : 'not-ready'}}">
          <view class="status-dot {{item.isReady ? 'dot-green' : 'dot-yellow'}}"></view>
          <text>{{item.isReady ? '已准备' : '未准备'}}</text>
        </view>
        <view wx:elif="{{!item.occupied}}" class="seat-action">
          <text wx:if="{{currentUser && currentUser.seatNumber < 1}}" class="btn-seat-action btn-take" bindtap="takeSeat" data-seat="{{item.number}}">入座</text>
        </view>
        <text wx:if="{{isHost && item.occupied && !item.isSelf}}" class="seat-kick" bindtap="onPlayerAction" data-id="{{item.player.openId}}">⋯</text>
      </view>
    </view>
    <view wx:else class="empty-hint">等待配置房间...</view>
  </view>

  <!-- Card 4: Waiting Area -->
  <view class="card waiting-card" wx:if="{{unseatedPlayers.length > 0}}">
    <view class="card-header">
      <text class="card-title">等待区 ({{unseatedPlayers.length}})</text>
      <text wx:if="{{currentUser && currentUser.seatNumber != 0}}" class="btn-round btn-purple btn-enter-waiting" bindtap="leaveSeat">进入等待区</text>
    </view>
    <view class="waiting-list">
      <view wx:for="{{unseatedPlayers}}" wx:key="openId" class="waiting-item" bindtap="onPlayerAction" data-id="{{item.openId}}">
        <image src="{{item.avatarUrl || '/images/default-avatar.png'}}" class="waiting-avatar"></image>
        <text class="waiting-name">{{item.nickName || item.wxNickName || '玩家'}}</text>
      </view>
    </view>
  </view>

  <!-- Card 5: Spectator Area -->
  <view class="card spectator-card">
    <view class="card-header">
      <text class="card-title">观战区 ({{spectatorPlayers.length}})</text>
      <text wx:if="{{currentUser && currentUser.seatNumber >= 0}}" class="btn-round btn-purple btn-spectate" bindtap="becomeSpectator">进入观战区</text>
    </view>
    <view wx:if="{{spectatorPlayers.length > 0}}" class="spectator-list">
        <view wx:for="{{spectatorPlayers}}" wx:key="openId" class="spectator-item" bindtap="onPlayerAction" data-id="{{item.openId}}">
        <image src="{{item.avatarUrl || '/images/default-avatar.png'}}" class="spectator-avatar"></image>
        <text class="spectator-name">{{item.nickName || '玩家'}}</text>
      </view>
    </view>
    <view wx:else class="empty-hint">暂无观战玩家</view>
  </view>
</view>
