<!--pages/me/me.wxml-->
<view class="page {{themeClass ? 'theme-' + themeClass : ''}}">
  <!-- 基本信息 + 数据（合并卡） -->
  <view class="card me-card">
    <view class="me-head">
      <image class="me-avatar" src="{{me.avatarUrl || '/images/default-avatar.png'}}"/>
      <view class="me-info">
        <view class="me-name-row">
          <text class="me-name">{{me.nickName || '未设置昵称'}}</text>
          <text wx:if="{{rank}}" class="me-rank">#{{rank}}</text>
        </view>
        <view wx:if="{{stats.titles && stats.titles.length > 0}}" class="me-titles">
          <title-badge titles="{{stats.titles}}"></title-badge>
        </view>
        <view class="me-sub">
          <text wx:if="{{me.uniqueId}}" class="me-uid">ID：{{me.uniqueId}}</text>
        </view>
      </view>
      <view class="me-edit-btn" bindtap="openEditProfile">编辑</view>
    </view>

    <view class="me-stats-row">
      <view class="me-stat"><text class="me-stat-num">{{stats.totalGames}}</text><text class="me-stat-label">场次</text></view>
      <view class="me-stat">
        <text class="me-stat-num me-score">{{stats.score}}</text>
        <view class="me-stat-label-row">
          <text class="me-stat-label">积分</text>
          <view class="score-help-btn" catchtap="openScoreDetail">?</view>
        </view>
      </view>
    </view>

    <view class="me-stats-row me-stats-row-2">
      <view class="me-stat"><text class="me-stat-num">{{stats.mvpCount}}</text><text class="me-stat-label">MVP</text></view>
      <view class="me-stat"><text class="me-stat-num">{{stats.svpCount}}</text><text class="me-stat-label">SVP</text></view>
    </view>
  </view>

  <!-- 角色胜率（公共组件，角色卡可点开对局弹窗） -->
  <role-stats-card wx:if="{{roleStats.length > 0}}" roles="{{roleStats}}" summary="{{summary}}" games="{{historyList}}" />

  <!-- 历史对局（公共组件） -->
  <view class="card history-card" wx:if="{{historyList.length > 0}}">
    <history-card title="历史对局" games="{{historyList}}" />
  </view>

  <view class="footer"><view class="footer-version">AVALON v1.4.2</view></view>

  <!-- 编辑个人信息弹窗（每行独立保存） -->
  <view class="me-edit-mask" wx:if="{{showEditProfile}}" bindtap="closeEditProfile" catchtouchmove="noop">
    <view class="me-edit-panel" catchtap="noop">
      <view class="me-edit-head">
        <text class="me-edit-title">编辑信息</text>
        <text class="me-edit-close" bindtap="closeEditProfile">✕</text>
      </view>

      <view class="me-edit-row">
        <text class="me-edit-label">头像</text>
        <button class="me-edit-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" bindtap="onAvatarTap">
          <image class="me-edit-avatar" src="{{editAvatarUrl || me.avatarUrl || '/images/default-avatar.png'}}"/>
        </button>
      </view>

      <view class="me-edit-row">
        <text class="me-edit-label">昵称</text>
        <input class="me-edit-input" type="text" maxlength="10" value="{{editNickName}}" bindinput="onEditNickInput" placeholder="请输入昵称（≤10字）"/>
        <view class="me-edit-save {{editNickSaving ? 'me-edit-save-busy' : ''}}" catchtap="saveEditNickName">保存</view>
      </view>

      <view class="me-edit-row me-edit-row-id">
        <text class="me-edit-label">ID</text>
        <view class="me-edit-field">
          <input class="me-edit-input" type="text" maxlength="16" value="{{editUniqueId}}" bindinput="onEditIdInput" placeholder="1-16位"/>
          <text class="me-edit-hint">1-16位，支持中文/字母/数字/-/_，每天仅可修改一次</text>
        </view>
        <view class="me-edit-save {{editIdSaving ? 'me-edit-save-busy' : ''}}" catchtap="saveEditUniqueId">保存</view>
      </view>
    </view>
  </view>

  <score-detail id="scoreDetail"/>
</view>
