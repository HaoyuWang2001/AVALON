<!--pages/record-detail/record-detail.wxml-->
<!-- 游戏内一律以座位号标识；昵称仅用于座位/身份（对人）区 -->
<view class="page {{themeClass ? 'theme-' + themeClass : ''}}">

  <view wx:if="{{loading}}" class="rd-loading">加载中...</view>
  <view wx:elif="{{loadErr}}" class="rd-loading">{{loadErr}}</view>

  <block wx:if="{{rec}}">
    <!-- 头部 -->
    <view class="card rd-head">
      <view class="rd-head-main">
        <text class="rd-title">{{rec.playerCount}}人局 · {{boardLabel}}</text>
        <text class="rd-sub">{{recording ? '记录中' : '已完成'}}{{rec.me ? ' · 我的座位 ' + meSeatLabel : ''}}</text>
      </view>
      <button wx:if="{{recording && isOwner}}" class="rd-share-btn" size="mini" open-type="share">分享记录</button>
    </view>

    <!-- 已完成：结果摘要（所有人可见） -->
    <view wx:if="{{!recording}}" class="card rd-result-card {{winnerIsGood ? 'rd-result-good' : 'rd-result-evil'}}">
      <text class="rd-result-text">{{resultText}}</text>
      <view class="rd-btn-row">
        <view class="rd-mini-btn rd-mini-primary" bindtap="viewReplay">查看回放</view>
        <block wx:if="{{isOwner}}">
          <view class="rd-mini-btn rd-mini-plain" bindtap="reopenRecord">编辑</view>
          <view class="rd-mini-btn rd-mini-evil" bindtap="deleteRecord">删除</view>
        </block>
      </view>
    </view>

    <!-- 参与者：待房主同意 -->
    <view wx:if="{{recording && mePending}}" class="card rd-wait-card">
      <text class="rd-wait-title">⏳ 已申请 {{meSeatLabel}}，等待房主同意</text>
      <text class="rd-wait-sub">同意后将自动入座，可继续选择身份</text>
      <view class="rd-btn-row"><view class="rd-mini-btn rd-mini-plain" bindtap="leaveRecord">取消申请</view></view>
    </view>

    <!-- 待审批（房主） -->
    <view wx:if="{{recording && isOwner && pending.length > 0}}" class="card">
      <view class="rd-card-title">待审批入座（{{pending.length}}）</view>
      <view wx:for="{{pending}}" wx:key="openId" class="rd-pending-row">
        <image class="rd-pending-avatar" src="{{item.avatarUrl || '/images/default-avatar.png'}}"/>
        <text class="rd-pending-name">{{item.nickName}} → 申请 {{item.seatNumber}}</text>
        <view class="rd-pending-ops">
          <text class="rd-op rd-op-agree" bindtap="onRespond" data-id="{{item.openId}}" data-ok="1">同意</text>
          <text class="rd-op rd-op-refuse" bindtap="onRespond" data-id="{{item.openId}}" data-ok="0">拒绝</text>
        </view>
      </view>
    </view>

    <!-- 座位 -->
    <view class="card">
      <view class="rd-card-title">座位（{{approved.length}}/{{rec.playerCount}}）<text class="rd-card-tip">长按有人座位可移除</text></view>
      <view class="rd-seat-grid">
        <view wx:for="{{seats}}" wx:key="seat" class="rd-seat {{item.player ? '' : 'rd-seat-empty'}} {{item.pendingName ? 'rd-seat-pending' : ''}}"
          bindtap="onSeatTap" bindlongpress="onSeatLongPress" data-seat="{{item.seat}}">
          <block wx:if="{{item.player}}">
            <text class="rd-seat-badge">{{item.seat}}</text>
            <image class="rd-seat-avatar" src="{{item.player.avatarUrl || '/images/default-avatar.png'}}"/>
            <text class="rd-seat-name">{{item.player.nickName}}</text>
            <text wx:if="{{item.player.role}}" class="rd-seat-role">{{item.player.roleSource === 'host' ? '' : '🔒'}}{{item.player.roleLabel}}</text>
          </block>
          <block wx:else>
            <text class="rd-seat-badge rd-seat-badge-empty">{{item.seat}}</text>
            <view class="rd-seat-ring"></view>
            <text wx:if="{{item.pendingName}}" class="rd-seat-waitmark">⏳{{item.pendingName}}</text>
            <text wx:elif="{{recording && !rec.me && !isOwner}}" class="rd-seat-hint">点我入座</text>
          </block>
        </view>
      </view>
    </view>

    <!-- 身份 -->
    <view class="card">
      <view class="rd-card-title">身份（{{configRoleCount - remainingRoles.length}}/{{configRoleCount}}）</view>
      <view wx:if="{{remainingRoles.length > 0}}" class="rd-role-chips">
        <text wx:for="{{remainingRoles}}" wx:key="role" class="rd-role-chip">{{item.label}}</text>
      </view>

      <!-- 参与者：自选身份 -->
      <block wx:if="{{!isOwner && rec.me && !mePending}}">
        <view wx:if="{{rec.me.role}}" class="rd-role-card">
          <text class="rd-role-emoji">{{myRoleEmoji}}</text>
          <text class="rd-role-name">{{myRoleLabel}}</text>
        </view>
        <picker wx:elif="{{recording && remainingRoles.length > 0}}" range="{{remainingRoles}}" range-key="label" bindchange="onMyRoleChange">
          <view class="rd-role-pick">🂠 选择我的身份（剩 {{remainingRoles.length}} 个）</view>
        </picker>
        <view wx:else class="rd-role-wait">身份待分配或已分完</view>
        <view wx:if="{{recording}}" class="rd-leave" bindtap="leaveRecord">退出记录</view>
      </block>

      <!-- 房主：逐人指定（座位号为主，小字昵称对人） -->
      <block wx:if="{{isOwner && recording}}">
        <view wx:for="{{approved}}" wx:key="openId" class="rd-assign-row">
          <text class="rd-assign-seat">{{item.seatNumber}}号</text>
          <text class="rd-assign-name">{{item.nickName}}</text>
          <block wx:if="{{item.role}}">
            <text class="rd-assign-role">{{item.roleSource === 'host' ? item.roleLabel : '🔒 已自选'}}</text>
            <text class="rd-op rd-op-refuse" bindtap="clearOwnerRole" data-id="{{item.openId}}">清除</text>
          </block>
          <picker wx:else range="{{remainingRoles}}" range-key="label" bindchange="onOwnerRoleChange" data-id="{{item.openId}}">
            <text class="rd-op rd-op-agree">分配</text>
          </picker>
        </view>
        <view wx:if="{{remainingRoles.length > 0}}" class="rd-role-note">剩 {{remainingRoles.length}} 个身份未分配</view>
      </block>
    </view>

    <!-- 轮次记录（房主 + 记录中） -->
    <block wx:if="{{isOwner && recording}}">
      <!-- 进度总览 -->
      <view class="rd-progress">
        <text class="rd-progress-text">{{progressText}}</text>
      </view>

      <!-- 已录车辆：每车一卡，位于发车卡上方（点击展开编辑/删除） -->
      <view wx:for="{{carList}}" wx:key="idx"
        class="card rd-car-card {{item.outcome === 'send' ? 'rd-car-send' : 'rd-car-reject'}}">
        <view class="rd-car-line {{item.editing ? 'rd-car-editing' : ''}}" bindtap="toggleCarExpand" data-idx="{{item.idx}}">
          <text class="rd-car-tag">R{{item.round}}C{{item.carIndex}}</text>
          <text class="rd-car-main">队长{{item.leaderLabel}} · {{item.teamLabels}}</text>
          <text class="rd-car-votes">{{item.voteText}}</text>
          <text wx:if="{{item.missionText}}" class="rd-car-mission {{item.missionOk ? 'rd-mission-ok' : 'rd-mission-bad'}}">{{item.missionText}}</text>
        </view>
        <view wx:if="{{item.expanded}}" class="rd-car-detail">
          <view class="rd-car-ops">
            <view class="rd-mini-btn rd-mini-plain" bindtap="editCar" data-idx="{{item.idx}}">编辑</view>
            <view class="rd-mini-btn rd-mini-evil" bindtap="removeCar" data-idx="{{item.idx}}">删除</view>
          </view>
        </view>
      </view>

      <view class="card">
        <view class="rd-card-title">
          第{{carForm.round}}轮 · 第{{carForm.carIndex}}车 · {{teamSize}}人车
          <text class="rd-card-tip">{{editingCarIdx >= 0 ? '修改中' : ''}}</text>
        </view>

        <view class="rd-form-row">
          <text class="rd-form-label">队长</text>
          <picker range="{{allSeats}}" range-key="seatLabel" bindchange="onCarLeaderChange">
            <text class="rd-form-value">{{carLeaderLabel}}</text>
          </picker>
        </view>

        <view class="rd-form-block">
          <text class="rd-form-label">车队（{{teamCount}}/{{teamSize}}）</text>
          <view class="rd-tiles">
            <view wx:for="{{allSeats}}" wx:key="seat" wx:for-item="p"
              class="rd-tile {{carForm.teamSel[p.seat] ? 'rd-tile-on' : ''}}"
              bindtap="onToggleTeam" data-seat="{{p.seat}}">{{p.seatLabel}}</view>
          </view>
        </view>

        <view class="rd-form-row">
          <text class="rd-form-label">强制车</text>
          <switch checked="{{carForm.forced}}" bindchange="onForcedToggle" color="#8B5CF6"/>
        </view>

        <view class="rd-form-block" wx:if="{{!carForm.forced}}">
          <text class="rd-form-label">票型（点击号码：灰 → 绿 → 红 循环）</text>
          <view class="rd-tiles">
            <view wx:for="{{allSeats}}" wx:key="seat" wx:for-item="p"
              class="rd-tile {{carForm.votes[p.seat] === 'approve' ? 'rd-tile-agree' : carForm.votes[p.seat] === 'reject' ? 'rd-tile-reject' : ''}}"
              bindtap="onVoteChipTap" data-seat="{{p.seat}}">{{p.seatLabel}}</view>
          </view>
          <view class="rd-btn-row">
            <view class="rd-mini-btn rd-vote-agree" bindtap="applyVotes" data-val="all-approve">全员同意</view>
            <view class="rd-mini-btn rd-vote-reject" bindtap="applyVotes" data-val="all-reject">全员反对</view>
            <view class="rd-mini-btn rd-mini-plain" bindtap="applyVotes" data-val="clear">全部清空</view>
          </view>
          <text class="rd-vote-preview">{{votePreview}}</text>
        </view>

        <view class="rd-form-block" wx:if="{{teamCount === teamSize && (carForm.forced || carWillSend)}}">
          <text class="rd-form-label">任务票{{failThreshold > 1 ? '（保护轮：2坏才失败）' : ''}}</text>
          <view class="rd-btn-row">
            <view class="rd-mini-btn {{carForm.mission.outcome === 'success' ? 'rd-mn-green' : 'rd-mini-plain'}}" bindtap="setMissionOutcome" data-val="success">任务成功</view>
            <view class="rd-mini-btn {{carForm.mission.outcome === 'fail' ? 'rd-mn-red' : 'rd-mini-plain'}}" bindtap="setMissionOutcome" data-val="fail">任务失败</view>
          </view>
          <view wx:if="{{carForm.mission.outcome === 'fail'}}" class="rd-chips">
            <view wx:for="{{failCountOptions}}" wx:key="*this"
              class="rd-chip rd-failchip {{carForm.mission.failCount === item ? 'rd-failchip-on' : ''}}"
              bindtap="setFailCount" data-n="{{item}}">{{item}}坏</view>
          </view>
          <view wx:if="{{carForm.mission.outcome === 'success' && failThreshold > 1}}" class="rd-chips">
            <view wx:for="{{failCountOptions}}" wx:key="*this"
              class="rd-chip rd-failchip {{carForm.mission.failCount === item ? 'rd-failchip-on' : ''}}"
              bindtap="setFailCount" data-n="{{item}}">{{item}}坏</view>
          </view>
        </view>

        <view class="rd-btn-row">
          <view class="rd-mini-btn rd-mini-primary" bindtap="submitCar">{{editingCarIdx >= 0 ? '保存本车修改' : '＋ 添加本车'}}</view>
          <view wx:if="{{editingCarIdx >= 0}}" class="rd-mini-btn rd-mini-plain" bindtap="cancelEditCar">取消修改</view>
        </view>
      </view>

      <!-- 湖仙（启用轮后显示） -->
      <view wx:if="{{showLake && lakeForm}}" class="card">
        <view class="rd-card-title">湖仙验人</view>
        <view class="rd-form-row">
          <text class="rd-form-label">轮次</text>
          <picker range="{{[1,2,3,4,5]}}" bindchange="onLakeField" data-field="round">
            <text class="rd-form-value">第 {{lakeForm.round}} 轮</text>
          </picker>
        </view>
        <view class="rd-form-row">
          <text class="rd-form-label">验人者</text>
          <picker range="{{lakeForm.candidates}}" range-key="seatLabel" bindchange="onLakeField" data-field="inspector">
            <text class="rd-form-value">{{lakeInspectorLabel}}</text>
          </picker>
        </view>
        <view class="rd-form-row">
          <text class="rd-form-label">目标</text>
          <picker range="{{lakeForm.candidates}}" range-key="seatLabel" bindchange="onLakeField" data-field="target">
            <text class="rd-form-value">{{lakeTargetLabel}}</text>
          </picker>
        </view>
        <view class="rd-form-row">
          <text class="rd-form-label">结果</text>
          <view class="rd-btn-row">
            <view class="rd-mini-btn {{lakeForm.result === 'good' ? 'rd-mini-good' : 'rd-mini-plain'}}" bindtap="onLakeField" data-field="result" data-val="good">蓝方</view>
            <view class="rd-mini-btn {{lakeForm.result === 'evil' ? 'rd-mini-evil' : 'rd-mini-plain'}}" bindtap="onLakeField" data-field="result" data-val="evil">红方</view>
          </view>
        </view>
        <view class="rd-btn-row"><view class="rd-mini-btn rd-mini-primary" bindtap="addLake">＋ 添加验人</view></view>
        <view wx:for="{{lakeList}}" wx:key="idx" class="rd-car-line">
          <text class="rd-car-tag">R{{item.round}}</text>
          <text class="rd-car-main">{{item.text}}</text>
          <text class="rd-car-mission {{item.result === 'good' ? 'rd-mission-ok' : 'rd-mission-bad'}}">{{item.result === 'good' ? '蓝方' : '红方'}}</text>
          <text class="rd-op rd-op-refuse" bindtap="removeLake" data-idx="{{item.idx}}">删</text>
        </view>
      </view>

      <!-- 兰斯洛特（触发轮后显示） -->
      <view wx:if="{{showLance}}" class="card">
        <view class="rd-card-title">兰斯洛特转换</view>
        <view class="rd-form-row">
          <text class="rd-form-label">轮次</text>
          <picker range="{{[1,2,3,4,5]}}" bindchange="onLanceField" data-field="round">
            <text class="rd-form-value">第 {{lanceForm.round}} 轮</text>
          </picker>
        </view>
        <view class="rd-form-row">
          <text class="rd-form-label">是否转换</text>
          <switch checked="{{lanceForm.switched}}" bindchange="onLanceField" data-field="switched" color="#8B5CF6"/>
        </view>
        <view class="rd-btn-row"><view class="rd-mini-btn rd-mini-primary" bindtap="addLance">＋ 添加记录</view></view>
        <view wx:for="{{lanceList}}" wx:key="idx" class="rd-car-line">
          <text class="rd-car-tag">R{{item.round}}</text>
          <text class="rd-car-main">{{item.switched ? '转换' : '未转换'}}</text>
          <text class="rd-op rd-op-refuse" bindtap="removeLance" data-idx="{{item.idx}}">删</text>
        </view>
      </view>

      <!-- 刺杀（3 成后） -->
      <view wx:if="{{asnForm.need}}" class="card">
        <view class="rd-card-title">刺杀（好人三成后）</view>
        <view class="rd-form-row">
          <text class="rd-form-label">开刀者</text>
          <picker range="{{allSeats}}" range-key="seatLabel" bindchange="onAsnField" data-field="killer">
            <text class="rd-form-value">{{asnKillerLabel}}</text>
          </picker>
        </view>
        <view class="rd-form-row">
          <text class="rd-form-label">目标</text>
          <picker range="{{allSeats}}" range-key="seatLabel" bindchange="onAsnField" data-field="target">
            <text class="rd-form-value">{{asnTargetLabel}}</text>
          </picker>
        </view>
        <view class="rd-btn-row">
          <view class="rd-mini-btn rd-mini-primary" bindtap="saveAsn">{{roundsDraft.assassination ? '更新刺杀记录' : '填入刺杀记录'}}</view>
          <view wx:if="{{roundsDraft.assassination}}" class="rd-mini-btn rd-mini-evil" bindtap="clearAsn">清除</view>
        </view>
      </view>

      <!-- 完成 checklist（inline，随底部完成按钮联动） -->
      <view class="card rd-check-card">
        <view class="rd-card-title">完成条件</view>
        <view class="rd-check-row"><text class="rd-check {{checklist.seats.ok ? 'ok' : 'no'}}">{{checklist.seats.ok ? '✓' : '✗'}}</text><text class="rd-check-label">座位 {{checklist.seats.text}}</text></view>
        <view class="rd-check-row"><text class="rd-check {{checklist.roles.ok ? 'ok' : 'no'}}">{{checklist.roles.ok ? '✓' : '✗'}}</text><text class="rd-check-label">身份 {{checklist.roles.text}}</text></view>
        <view class="rd-check-row"><text class="rd-check {{checklist.outcome.ok ? 'ok' : 'no'}}">{{checklist.outcome.ok ? '✓' : '✗'}}</text><text class="rd-check-label">胜负：{{checklist.outcome.text}}</text></view>
      </view>

      <view class="rd-bottom-pad"></view>
    </block>
  </block>

  <!-- 底部固定操作条（房主+记录中）：自动保存状态 + 完成 -->
  <view wx:if="{{isOwner && recording && rec}}" class="rd-bottombar">
    <button class="rd-finish-btn {{canFinish ? '' : 'rd-finish-disabled'}}" bindtap="finishRecord">记录完成</button>
  </view>

  <!-- 空座位底部弹层（房主）：自己上座 / 指定好友 / 微信邀请 -->
  <view wx:if="{{showSeatSheet}}" class="rd-assign-mask" bindtap="closeSeatSheet" catchtouchmove="noop">
    <view class="rd-assign-panel" catchtap="noop">
      <view class="rd-sheet-head">
        <text class="rd-sheet-title">{{seatSheetSeat}} 号位</text>
      </view>
      <view wx:if="{{seatSheetPendingName}}" class="rd-role-note">⏳ {{seatSheetPendingName}} 正在申请此座位（可在待审批区同意）</view>
      <view class="rd-sheet-actions">
        <view class="rd-sheet-btn" bindtap="seatSheetSit">自己上座</view>
        <view class="rd-sheet-btn" bindtap="seatSheetAssign">指定好友</view>
        <button class="rd-sheet-btn" size="mini" open-type="share" bindtap="setShareSeat" data-seat="{{seatSheetSeat}}">微信邀请</button>
      </view>
    </view>
  </view>

  <!-- 指定玩家弹层 -->
  <view wx:if="{{showAssign}}" class="rd-assign-mask" bindtap="closeAssign" catchtouchmove="noop">
    <view class="rd-assign-panel" catchtap="noop">
      <view class="rd-card-title">指定玩家入 {{assignSeat}} 号位</view>
      <view class="rd-search-row">
        <input class="rd-search-input" placeholder="按唯一 ID 搜索" value="{{searchKey}}" bindinput="onSearchInput"/>
        <view class="rd-mini-btn rd-mini-primary" bindtap="doSearch">搜索</view>
      </view>
      <view wx:if="{{friendLoading}}" class="rd-role-note">好友加载中...</view>
      <scroll-view scroll-y class="rd-assign-scroll">
        <view wx:for="{{searchResults}}" wx:key="openId" class="rd-assign-row" bindtap="onAssignTap" data-id="{{item.openId}}">
          <image class="rd-pending-avatar" src="{{item.avatarUrl || '/images/default-avatar.png'}}"/>
          <text class="rd-assign-name">{{item.nickName}}</text>
          <text class="rd-op rd-op-agree">指定</text>
        </view>
        <view class="rd-role-note" wx:if="{{searchResults.length > 0}}">— 好友列表 —</view>
        <view wx:for="{{friends}}" wx:key="openId" class="rd-assign-row {{item.inRecord ? 'rd-assign-dup' : ''}}" bindtap="onAssignTap" data-id="{{item.openId}}">
          <image class="rd-pending-avatar" src="{{item.avatarUrl || '/images/default-avatar.png'}}"/>
          <text class="rd-assign-name">{{item.nickName}}</text>
          <text wx:if="{{item.inRecord}}" class="rd-role-note">已在记录中</text>
          <text wx:else class="rd-op rd-op-agree">指定</text>
        </view>
        <view wx:if="{{!friendLoading && friends.length === 0 && searchResults.length === 0}}" class="rd-role-note">暂无好友，可用唯一 ID 搜索</view>
      </scroll-view>
    </view>
  </view>
</view>
