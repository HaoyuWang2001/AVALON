/* pages/record-detail/record-detail.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 60rpx;
  box-sizing: border-box;
  color: var(--text-body);
  background: var(--bg-page);
}

.card {
  background: var(--bg-card);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-md);
}

.rd-loading { text-align: center; color: var(--text-muted); padding: 80rpx 0; font-size: 28rpx; }

.rd-head { display: flex; align-items: center; justify-content: space-between; }
.rd-head-main { display: flex; flex-direction: column; gap: 6rpx; }
.rd-title { font-size: 36rpx; font-weight: 800; color: var(--text-title); }
.rd-sub { font-size: 24rpx; color: var(--text-muted); }
.rd-share-btn {
  background: var(--label-violet-bg); color: var(--label-violet);
  font-size: 24rpx; font-weight: 700; border-radius: 999rpx; padding: 0 24rpx;
}

.rd-card-title {
  font-size: 30rpx; font-weight: 800; color: var(--text-title); margin-bottom: 20rpx;
  display: flex; align-items: baseline; gap: 12rpx;
}
.rd-card-tip { font-size: 20rpx; color: var(--text-muted); font-weight: 400; }

/* 已完成结果摘要 */
.rd-result-card { display: flex; flex-direction: column; gap: 20rpx; align-items: flex-start; }
.rd-result-good { border-left: 10rpx solid var(--label-good); }
.rd-result-evil { border-left: 10rpx solid var(--label-evil); }
.rd-result-text { font-size: 34rpx; font-weight: 800; color: var(--text-title); }
.rd-result-card .rd-btn-row { margin: 0; }

/* 参与者待审批 */
.rd-wait-card { display: flex; flex-direction: column; gap: 10rpx; }
.rd-wait-title { font-size: 30rpx; font-weight: 700; color: var(--text-title); }
.rd-wait-sub { font-size: 24rpx; color: var(--text-muted); margin-bottom: 8rpx; }

/* 待审批行 */
.rd-pending-row { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 0; }
.rd-pending-avatar { width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--gray-100); flex-shrink: 0; }
.rd-pending-name { flex: 1; font-size: 26rpx; color: var(--text-body); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rd-pending-ops { display: flex; gap: 24rpx; flex-shrink: 0; }
.rd-op { font-size: 26rpx; font-weight: 700; }
.rd-op-agree { color: var(--label-good); }
.rd-op-refuse { color: var(--danger); }

/* 座位 */
.rd-seat-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.rd-seat {
  width: calc((100% - 32rpx) / 3);
  box-sizing: border-box; min-height: 150rpx;
  border-radius: 20rpx; padding: 14rpx 10rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx;
  background: var(--bg-page);
  position: relative;
}
.rd-seat-empty { border: 2rpx dashed var(--divider-strong); }
.rd-seat-pending { border: 2rpx solid var(--gold); }
.rd-seat-badge {
  position: absolute; top: 8rpx; left: 12rpx;
  min-width: 36rpx; height: 36rpx; border-radius: 10rpx; padding: 0 6rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 800; color: var(--on-primary);
  background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
}
.rd-seat-badge-empty { opacity: 0.5; }
.rd-seat-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--gray-100); margin-top: 8rpx; }
/* 空位：头像大小的空虚线圈 */
.rd-seat-ring {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  border: 3rpx dashed var(--divider-strong);
  box-sizing: border-box; margin-top: 8rpx;
}
.rd-seat-name { font-size: 22rpx; color: var(--text-body); max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rd-seat-role { font-size: 20rpx; color: var(--label-violet); }
.rd-seat-waitmark { font-size: 20rpx; color: var(--gold); max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rd-seat-hint { font-size: 20rpx; color: var(--text-muted); }

/* 身份 */
.rd-role-chips { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 18rpx; }
.rd-role-chip {
  font-size: 22rpx; font-weight: 700; padding: 6rpx 18rpx; border-radius: 999rpx;
  background: var(--label-grey-bg); color: var(--label-grey);
}
.rd-role-card {
  display: flex; flex-direction: column; align-items: center; gap: 10rpx;
  padding: 36rpx 0; border-radius: 20rpx;
  background: var(--role-card-badge-bg);
}
.rd-role-emoji { font-size: 96rpx; line-height: 1; }
.rd-role-name { font-size: 34rpx; font-weight: 800; color: var(--text-title); }
.rd-role-pick {
  margin-top: 8rpx; padding: 22rpx; border-radius: 20rpx; text-align: center;
  background: var(--bg-page); color: var(--label-violet); font-size: 28rpx; font-weight: 700;
}
.rd-role-wait { margin-top: 8rpx; text-align: center; color: var(--text-muted); font-size: 26rpx; padding: 22rpx 0; }
.rd-role-note { margin-top: 12rpx; font-size: 24rpx; color: var(--text-muted); }
.rd-leave { margin-top: 16rpx; text-align: center; font-size: 24rpx; color: var(--danger); padding: 10rpx 0; }

.rd-assign-row { display: flex; align-items: center; gap: 16rpx; padding: 12rpx 0; }
.rd-assign-dup { opacity: 0.45; }
.rd-assign-seat { font-size: 24rpx; font-weight: 700; color: var(--text-muted); width: 56rpx; flex-shrink: 0; }
.rd-assign-name { flex: 1; font-size: 26rpx; color: var(--text-body); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rd-assign-role { font-size: 24rpx; color: var(--label-violet); flex-shrink: 0; }

/* 进度总览 */
.rd-progress {
  background: var(--bg-card); border-radius: 20rpx; padding: 18rpx 28rpx;
  margin-bottom: 24rpx; box-shadow: var(--shadow-md);
}
.rd-progress-text { font-size: 27rpx; font-weight: 700; color: var(--text-title); }

/* 表单 */
.rd-form-row { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 0; }
.rd-form-label { font-size: 26rpx; color: var(--text-body); }
.rd-form-value { font-size: 26rpx; font-weight: 700; color: var(--label-violet); }
.rd-form-block { padding: 14rpx 0; display: flex; flex-direction: column; gap: 14rpx; }

.rd-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
/* 号码牌初始灰（label-grey 对） */
.rd-chip {
  min-width: 72rpx; text-align: center;
  padding: 10rpx 20rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 700;
  background: var(--label-grey-bg); color: var(--label-grey);
  border: 2rpx solid transparent;
}
/* 中性选中（车队/人数）：label-violet 对 */
.rd-chip-on { background: var(--label-violet-bg); color: var(--label-violet); border-color: var(--label-violet); }
/* 同意/成功：既有「投赞成」状态绿（state-approve 底 + agree 字） */
.rd-vote-agree { background: var(--state-approve); color: var(--agree); }
/* 反对/失败：既有「投反对」状态红（state-reject 底 + disagree 字） */
.rd-vote-reject { background: var(--state-reject); color: var(--disagree); }
.rd-vote-preview { font-size: 24rpx; font-weight: 700; color: var(--text-muted); }

.rd-btn-row { display: flex; gap: 14rpx; flex-wrap: wrap; }
.rd-mini-btn {
  padding: 12rpx 26rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 700;
  background: var(--bg-page); color: var(--text-body);
}
.rd-mini-primary { background: var(--label-violet-bg); color: var(--label-violet); }
.rd-mini-good { background: var(--label-good-bg); color: var(--label-good); }
.rd-mini-evil { background: var(--label-evil-bg); color: var(--label-evil); }
.rd-mini-plain { background: var(--bg-page); color: var(--text-muted); }

/* 已录车辆 */
.rd-car-item { border-bottom: 1rpx solid var(--divider); padding: 6rpx 0; }
.rd-car-item:last-child { border-bottom: none; }
.rd-car-item.rd-car-send .rd-car-tag { background: var(--label-violet-bg); color: var(--label-violet); }
.rd-car-item.rd-car-reject { opacity: 0.62; }
.rd-car-item.rd-car-reject .rd-car-tag { background: var(--label-grey-bg); color: var(--label-grey); }
.rd-car-line { display: flex; align-items: center; gap: 12rpx; padding: 14rpx 0; flex-wrap: wrap; }
.rd-car-editing { outline: 2rpx dashed var(--primary); outline-offset: -6rpx; border-radius: 12rpx; padding-left: 12rpx; padding-right: 12rpx; }
.rd-car-tag {
  flex-shrink: 0; font-size: 20rpx; font-weight: 800; padding: 4rpx 12rpx; border-radius: 8rpx;
}
.rd-car-main { flex: 1; min-width: 200rpx; font-size: 24rpx; color: var(--text-body); }
.rd-car-votes { font-size: 22rpx; color: var(--text-muted); flex-shrink: 0; }
.rd-car-mission { font-size: 22rpx; font-weight: 800; flex-shrink: 0; }
.rd-mission-ok { color: var(--label-good); }
.rd-mission-bad { color: var(--label-evil); }
.rd-car-detail { padding: 0 0 16rpx; }
.rd-car-ops { display: flex; gap: 14rpx; }

/* 完成条件 */
.rd-check-card { padding-bottom: 20rpx; }
.rd-check-row { display: flex; align-items: center; gap: 14rpx; padding: 8rpx 0; }
.rd-check {
  width: 36rpx; height: 36rpx; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 800; color: var(--on-primary);
}
.rd-check.ok { background: var(--label-good); }
.rd-check.no { background: var(--label-grey); }
.rd-check-label { font-size: 26rpx; color: var(--text-body); }

/* 底部固定操作条 */
.rd-bottom-pad { height: 160rpx; }
.rd-bottombar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 900;
  display: flex; align-items: center; gap: 20rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.08);
}
.rd-finish-btn {
  flex: 1; margin: 0;
  border-radius: 999rpx; font-size: 30rpx; font-weight: 700; color: var(--on-primary);
  background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
}
.rd-finish-disabled { opacity: 0.4; }

/* 指定玩家弹层 */
.rd-assign-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1200;
  background: var(--mask); display: flex; align-items: flex-end;
}
.rd-assign-panel {
  width: 100%; max-height: 70vh; box-sizing: border-box;
  background: var(--bg-card); border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex; flex-direction: column;
}
.rd-assign-scroll { flex: 1; min-height: 200rpx; max-height: 46vh; }
.rd-search-row { display: flex; align-items: center; gap: 16rpx; margin: 16rpx 0; }
.rd-search-input {
  flex: 1; height: 72rpx; border-radius: 16rpx; padding: 0 24rpx;
  background: var(--bg-page); font-size: 26rpx; color: var(--text-body);
}

/* 空座位底部弹层：三个纵向按钮（自己上座/指定好友/微信邀请） */
.rd-sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.rd-sheet-title { font-size: 34rpx; font-weight: 800; color: var(--text-title); }
.rd-sheet-actions { display: flex; flex-direction: column; gap: 16rpx; margin-top: 16rpx; }
.rd-sheet-btn {
  width: 100%; box-sizing: border-box; text-align: center; margin: 0;
  padding: 24rpx 0; border-radius: 999rpx; line-height: 1.4;
  font-size: 28rpx; font-weight: 700;
  background: var(--label-violet-bg); color: var(--label-violet);
}
