/* styles/themes.wxss — 主题配色（可插拔）：把任意页面根 <view class="page {{themeClass}}"> 加上主题类即可整体换肤
 * 复用方式：
 *   1) 本文件已在 app.wxss 全局 @import
 *   2) 目标页面根 view 加 {{themeClass}}（页面 js 里用 utils/theme.js 初始化/切换）
 *   3) 主题类覆盖全部 token（灰阶反转 + bg/text/border/shadow），组件用 var(--xxx) 自动适配
 * 默认（无主题类）= 亮色，沿用 tokens.wxss。
 */

/* 根容器：铺满视口并承载页面背景（theme 类覆盖 --bg-page 后此处自动换色） */
.page,
.room-page,
.game-page {
  min-height: 100vh;
  box-sizing: border-box;
  background-color: var(--bg-page);
}

/* ─────────── 主题 1：烛光殿堂（暖炭墨 + 纹章金 + 羊皮纸） ─────────── */
.theme-torch {
  --bg-page: #14110E;
  --bg-card: #2E281F;
  --bg-card-solid: #2E281F;
  --primary-bg: #2A241C;
  --gold: #D4A052;

  --text-title: #F7F1E8;
  --text-body: #E0D5C7;
  --text-muted: #9C8F80;
  --link: #60A5FA;
  --status-inroom: #7C8FB8;
  --btn-emoji-bg: #40382D;
  --state-team: #5A4720;
  --state-voted: #493056;
  --state-approve: #2B4530;
  --state-reject: #573026;
  --state-good: #2B3A57;
  --state-evil: #573026;

  /* 统一语义文字色（记录/荣誉/状态）——烛光(暖) */
  --c-good: #8FB4E8;
  --c-evil: #E89A86;
  --c-win: #7FC8A0;
  --c-team: #DDB56A;
  --c-violet: #B49CE0;
  --c-online: #7FC8A0;
  --c-offline: #8F8475;
  --c-inroom: #8FB4E8;
  --c-ingame: #E89A86;
  --c-good-pill: #A6C6F0;
  --c-evil-pill: #EEB0A0;
  --c-good-bg: rgba(143, 180, 232, 0.16);
  --c-evil-bg: rgba(232, 154, 134, 0.16);

  /* 头部三段三色/辉光/故障 + 彩蛋卡面 + 玻璃色系 + 角色卡/冠军卡 —— 烛光(暖) */
  --brand-1: #D4A052;
  --brand-2: #E0B45A;
  --brand-3: #F0C060;
  --brand-glow-a: #D4A052;
  --brand-glow-b: #B45309;
  --brand-g1: #F0C060;
  --brand-g2: #E0533B;
  --func-face: #2E281F;
  --glass-bg: linear-gradient(135deg, rgba(58, 51, 42, 0.94), rgba(28, 24, 19, 0.94));
  --glass-border: rgba(212, 160, 82, 0.5);
  --glass-glow: rgba(212, 160, 82, 0.26);
  --glass-sheen: rgba(255, 255, 255, 0.22);
  --role-card-border: #D4A052;
  --role-card-bg: #2E281F;
  --role-card-rate: #DDB56A;
  --champion-border: #D4A052;
  --champion-bg: #2E281F;
  --profile-bg: #2E281F;
  --hc-good: #8FB4E8;
  --hc-evil: #E89A86;
  --champion-fg: #F7F1E8;
  --profile-fg: #F7F1E8;
  --profile-name: #B49CE0;
  --profile-divider: #D4A052;
  --profile-ring-glow: rgba(212, 160, 82, 0.35);
  --section-bar-from: #E0B45A;
  --section-bar-to: #B45309;

  --gray-50: #2E281F;
  --gray-100: #3A332A;
  --gray-200: #362F24;
  --gray-300: #4B4134;
  --gray-400: #6D6254;
  --gray-500: #8F8475;
  --gray-600: #B8AC9C;
  --gray-700: #D9CEC0;
  --gray-800: #EAE2D6;
  --gray-900: #F7F1E8;

  --border-color: rgba(212, 160, 82, 0.12);
  --danger-soft-bg: rgba(239, 68, 68, 0.12);
  --danger-soft-text: #F87171;

  --shadow-sm: 0 8rpx 24rpx rgba(0, 0, 0, 0.36), inset 0 1rpx 0 rgba(212, 160, 82, 0.08);
  --shadow-md: 0 12rpx 32rpx rgba(0, 0, 0, 0.4), inset 0 1rpx 0 rgba(212, 160, 82, 0.10);
  --shadow-lg: 0 20rpx 48rpx rgba(0, 0, 0, 0.4);
  --shadow-primary: 0 8rpx 24rpx rgba(124, 58, 237, 0.3);
}
/* 签名：火炬光晕从顶部照亮 */
.page.theme-torch::before {
  content: ''; position: fixed; top: 0; left: 0; right: 0; height: 640rpx;
  background: radial-gradient(ellipse at 50% 0%, rgba(212, 160, 82, 0.06), transparent 60%);
  pointer-events: none; z-index: 0;
}

/* ─────────── 主题 2：暗夜圆桌（冷靛蓝 + 彩玻璃 + 秘银紫） ─────────── */
.theme-aurora {
  --bg-page: #0F0B1A;
  --bg-card: #29223E;
  --bg-card-solid: #29223E;
  --primary-bg: #241E36;
  --gold: #A78BFA;

  --text-title: #D8D2EE;
  --text-body: #B6B0D9;
  --text-muted: #8B85A7;
  --link: #93C5FD;
  --status-inroom: #7C8FB8;
  --btn-emoji-bg: #2E2745;
  --state-team: #55492E;
  --state-voted: #3E2E6E;
  --state-approve: #1E4A46;
  --state-reject: #55243E;
  --state-good: #26325E;
  --state-evil: #55243E;

  /* 统一语义文字色（记录/荣誉/状态）——暗夜(冷) */
  --c-good: #93B4F5;
  --c-evil: #F09AA8;
  --c-win: #6FD3C7;
  --c-team: #C9B27A;
  --c-violet: #B4A6F0;
  --c-online: #6FD3C7;
  --c-offline: #8B85A7;
  --c-inroom: #93B4F5;
  --c-ingame: #F09AA8;
  --c-good-pill: #ABC6F8;
  --c-evil-pill: #F4B2BE;
  --c-good-bg: rgba(147, 180, 245, 0.16);
  --c-evil-bg: rgba(240, 154, 168, 0.16);

  /* 头部三段三色/辉光/故障 + 彩蛋卡面 + 玻璃色系 + 角色卡/冠军卡 —— 暗夜(冷) */
  --brand-1: #A78BFA;
  --brand-2: #818CF8;
  --brand-3: #22D3EE;
  --brand-glow-a: #A78BFA;
  --brand-glow-b: #22D3EE;
  --brand-g1: #22D3EE;
  --brand-g2: #F43F5E;
  --func-face: #29223E;
  --glass-bg: linear-gradient(135deg, rgba(46, 39, 69, 0.94), rgba(22, 18, 34, 0.94));
  --glass-border: rgba(167, 139, 250, 0.55);
  --glass-glow: rgba(167, 139, 250, 0.3);
  --glass-sheen: rgba(255, 255, 255, 0.26);
  --role-card-border: #A78BFA;
  --role-card-bg: #29223E;
  --role-card-rate: #C9B27A;
  --champion-border: #A78BFA;
  --champion-bg: #29223E;
  --profile-bg: #29223E;
  --hc-good: #93B4F5;
  --hc-evil: #F09AA8;
  --champion-fg: #D8D2EE;
  --profile-fg: #D8D2EE;
  --profile-name: #B4A6F0;
  --profile-divider: #A78BFA;
  --profile-ring-glow: rgba(167, 139, 250, 0.35);
  --section-bar-from: #A78BFA;
  --section-bar-to: #22D3EE;

  --gray-50: #29223E;
  --gray-100: #322A4B;
  --gray-200: #322A4B;
  --gray-300: #413958;
  --gray-400: #5C5472;
  --gray-500: #756F8C;
  --gray-600: #8B85A7;
  --gray-700: #B6B0D9;
  --gray-800: #C9C3E4;
  --gray-900: #D8D2EE;

  --border-color: rgba(167, 139, 250, 0.14);
  --danger-soft-bg: rgba(239, 68, 68, 0.14);
  --danger-soft-text: #F87171;

  --shadow-sm: 0 8rpx 24rpx rgba(0, 0, 0, 0.35), inset 0 1rpx 0 rgba(167, 139, 250, 0.08);
  --shadow-md: 0 12rpx 32rpx rgba(0, 0, 0, 0.4), inset 0 1rpx 0 rgba(167, 139, 250, 0.10);
  --shadow-lg: 0 20rpx 48rpx rgba(0, 0, 0, 0.45);
  --shadow-primary: 0 8rpx 24rpx rgba(139, 92, 246, 0.35);
}
/* 签名：彩玻璃光晕（靛蓝+紫） */
.page.theme-aurora::before {
  content: ''; position: fixed; top: 0; left: 0; right: 0; height: 640rpx;
  background: radial-gradient(ellipse at 50% 0%, rgba(139, 92, 246, 0.07), transparent 60%);
  pointer-events: none; z-index: 0;
}

/* ─────────── 主题 3：锻造钢铁（冷枪铁 + 金属拉丝 + 银） ─────────── */
.theme-steel {
  --bg-page: #171A1F;
  --bg-card: linear-gradient(160deg, #2C333B, #242A31);
  --bg-card-solid: #262B33;
  --primary-bg: #262B32;
  --gold: #D4A052;

  --text-title: #C7D2DD;
  --text-body: #A7B4C0;
  --text-muted: #8A959F;
  --link: #93C5FD;
  --status-inroom: #7C8FB8;
  --btn-emoji-bg: #3B444E;
  --state-team: #574826;
  --state-voted: #43336B;
  --state-approve: #1D4A37;
  --state-reject: #572828;
  --state-good: #1D3A6B;
  --state-evil: #572828;

  /* 统一语义文字色（记录/荣誉/状态）——锻造钢铁 */
  --c-good: #8FB6E0;
  --c-evil: #E08A8A;
  --c-win: #6FC79A;
  --c-team: #D4B060;
  --c-violet: #9C90D8;
  --c-online: #6FC79A;
  --c-offline: #8A959F;
  --c-inroom: #8FB6E0;
  --c-ingame: #E08A8A;
  --c-good-pill: #A6C4EA;
  --c-evil-pill: #E8A4A4;
  --c-good-bg: rgba(143, 182, 224, 0.16);
  --c-evil-bg: rgba(224, 138, 138, 0.16);

  /* 头部三段三色/辉光/故障 + 彩蛋卡面 + 玻璃色系 + 角色卡/冠军卡 —— 锻造钢铁 */
  --brand-1: #C7D2DD;
  --brand-2: #94A3B8;
  --brand-3: #64748B;
  --brand-glow-a: #C7D2DD;
  --brand-glow-b: #64748B;
  --brand-g1: #7DD3FC;
  --brand-g2: #F87171;
  --func-face: #262B33;
  --glass-bg: linear-gradient(135deg, rgba(44, 51, 59, 0.94), rgba(26, 31, 37, 0.94));
  --glass-border: rgba(159, 180, 200, 0.5);
  --glass-glow: rgba(159, 180, 200, 0.24);
  --glass-sheen: rgba(255, 255, 255, 0.22);
  --role-card-border: #AFC0D0;
  --role-card-bg: #262B33;
  --role-card-rate: #D4B060;
  --champion-border: #D4A052;
  --champion-bg: #262B33;
  --profile-bg: #262B33;
  --hc-good: #8FB6E0;
  --hc-evil: #E08A8A;
  --champion-fg: #C7D2DD;
  --profile-fg: #C7D2DD;
  --profile-name: #9C90D8;
  --profile-divider: #94A3B8;
  --profile-ring-glow: rgba(148, 163, 184, 0.35);
  --section-bar-from: #94A3B8;
  --section-bar-to: #64748B;

  --gray-50: #20252C;
  --gray-100: #292F37;
  --gray-200: #343B44;
  --gray-300: #48505A;
  --gray-400: #5F6873;
  --gray-500: #7A848F;
  --gray-600: #8A959F;
  --gray-700: #A7B4C0;
  --gray-800: #B9C5CF;
  --gray-900: #C7D2DD;

  --border-color: rgba(226, 232, 240, 0.08);
  --danger-soft-bg: rgba(239, 68, 68, 0.12);
  --danger-soft-text: #F87171;

  --shadow-sm: 0 8rpx 24rpx rgba(0, 0, 0, 0.35), inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
  --shadow-md: 0 12rpx 32rpx rgba(0, 0, 0, 0.4), inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
  --shadow-lg: 0 20rpx 48rpx rgba(0, 0, 0, 0.45);
  --shadow-primary: 0 8rpx 24rpx rgba(124, 58, 237, 0.3);
}
/* 签名：冷光从顶部投下 */
.page.theme-steel::before {
  content: ''; position: fixed; top: 0; left: 0; right: 0; height: 560rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), transparent 70%);
  pointer-events: none; z-index: 0;
}
/* ─────────── 页面根背景（前缀类确保高于页面本地 .page/.room-page/.game-page 背景规则） ─────────── */
.page.theme-torch, .room-page.theme-torch, .game-page.theme-torch { background-color: #14110E; }
.page.theme-aurora, .room-page.theme-aurora, .game-page.theme-aurora { background-color: #0F0B1A; }
.page.theme-steel, .room-page.theme-steel, .game-page.theme-steel { background-color: #171A1F; }

/* ─────────── configs 阵营角色卡暗色适配（浅蓝/浅红 → 深色调） ─────────── */
.theme-torch .role-good, .theme-torch .role-loyal { background: rgba(59,130,246,0.16); border-color: rgba(59,130,246,0.4); }
.theme-torch .role-evil { background: rgba(239,68,68,0.14); border-color: rgba(239,68,68,0.4); }
.theme-torch .role-img-placeholder { background: linear-gradient(135deg, rgba(139,92,246,0.2), rgba(109,40,217,0.16)); }
.theme-torch .role-loyal .role-img-placeholder, .theme-torch .role-good .role-img-placeholder { background: linear-gradient(135deg, rgba(59,130,246,0.22), rgba(37,99,235,0.16)); }
.theme-torch .role-evil .role-img-placeholder { background: linear-gradient(135deg, rgba(239,68,68,0.2), rgba(220,38,38,0.14)); }

.theme-aurora .role-good, .theme-aurora .role-loyal { background: rgba(59,130,246,0.15); border-color: rgba(59,130,246,0.38); }
.theme-aurora .role-evil { background: rgba(239,68,68,0.13); border-color: rgba(239,68,68,0.38); }
.theme-aurora .role-img-placeholder { background: linear-gradient(135deg, rgba(139,92,246,0.2), rgba(109,40,217,0.16)); }
.theme-aurora .role-loyal .role-img-placeholder, .theme-aurora .role-good .role-img-placeholder { background: linear-gradient(135deg, rgba(59,130,246,0.22), rgba(37,99,235,0.16)); }
.theme-aurora .role-evil .role-img-placeholder { background: linear-gradient(135deg, rgba(239,68,68,0.2), rgba(220,38,38,0.14)); }

.theme-steel .role-good, .theme-steel .role-loyal { background: rgba(59,130,246,0.16); border-color: rgba(59,130,246,0.4); }
.theme-steel .role-evil { background: rgba(239,68,68,0.14); border-color: rgba(239,68,68,0.4); }
.theme-steel .role-img-placeholder { background: linear-gradient(135deg, rgba(139,92,246,0.2), rgba(109,40,217,0.16)); }
.theme-steel .role-loyal .role-img-placeholder, .theme-steel .role-good .role-img-placeholder { background: linear-gradient(135deg, rgba(59,130,246,0.22), rgba(37,99,235,0.16)); }
.theme-steel .role-evil .role-img-placeholder { background: linear-gradient(135deg, rgba(239,68,68,0.2), rgba(220,38,38,0.14)); }

/* ─────────── 主页"您当前处于房间"卡片暗色适配（浅琥珀 → 深琥珀） ─────────── */
.theme-torch .current-room-card { background: var(--bg-card); }
.theme-torch .current-room-label,
.theme-torch .current-room-id { color: #D97706; }

.theme-aurora .current-room-card { background: var(--bg-card); border-left-color: #A78BFA; }
.theme-aurora .current-room-label,
.theme-aurora .current-room-id { color: #D8D2EE; }

.theme-steel .current-room-card { background: var(--bg-card); border-left-color: #D4A052; }
.theme-steel .current-room-label,
.theme-steel .current-room-id { color: #C7D2DD; }

/* ─────────── 当前房间卡片按钮（暗色下：回到房间 紫→琥珀；禁用态 灰→琥珀可辨禁用） ─────────── */
.theme-torch .current-room-card .btn-primary { background: linear-gradient(135deg, #D97706, #92400E); box-shadow: 0 4rpx 16rpx rgba(146, 64, 14, 0.35); }
.theme-torch .current-room-card .btn-primary::after { border: none; }
.theme-torch .current-room-card .btn-danger { background: linear-gradient(135deg, #DC2626, #991B1B); box-shadow: 0 4rpx 16rpx rgba(153, 27, 27, 0.35); }
.theme-torch .current-room-card .btn-danger::after { border: none; }
.theme-torch .current-room-card .btn-danger.btn-disabled,
.theme-torch .current-room-card .btn-danger[disabled] { background: rgba(245, 158, 11, 0.15); color: rgba(251, 191, 36, 0.45); box-shadow: none; }

.theme-aurora .current-room-card .btn-primary { background: linear-gradient(135deg, #5C5485, #433C68); color: #D8D2EE; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3); }
.theme-aurora .current-room-card .btn-primary::after { border: none; }
.theme-aurora .current-room-card .btn-danger { background: linear-gradient(135deg, #DC2626, #991B1B); box-shadow: 0 4rpx 16rpx rgba(153, 27, 27, 0.35); }
.theme-aurora .current-room-card .btn-danger::after { border: none; }
.theme-aurora .current-room-card .btn-danger.btn-disabled,
.theme-aurora .current-room-card .btn-danger[disabled] { background: rgba(245, 158, 11, 0.15); color: rgba(251, 191, 36, 0.45); box-shadow: none; }

.theme-steel .current-room-card .btn-primary { background: linear-gradient(135deg, #4A535E, #333A43); color: #C7D2DD; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3); }
.theme-steel .current-room-card .btn-primary::after { border: none; }
.theme-steel .current-room-card .btn-danger { background: linear-gradient(135deg, #DC2626, #991B1B); box-shadow: 0 4rpx 16rpx rgba(153, 27, 27, 0.35); }
.theme-steel .current-room-card .btn-danger::after { border: none; }
.theme-steel .current-room-card .btn-danger.btn-disabled,
.theme-steel .current-room-card .btn-danger[disabled] { background: rgba(245, 158, 11, 0.15); color: rgba(251, 191, 36, 0.45); box-shadow: none; }
