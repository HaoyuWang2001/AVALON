  --primary-bg: #241E36;
  --gold: #A78BFA;

  --text-title: #D8D2EE;
  --text-body: #B6B0D9;
  --text-muted: #A29BC0;
  --link: #93C5FD;
  --btn-emoji-bg: #2E2745;
  --state-team: #55492E;
  --state-voted: #3E2E6E;
  --state-approve: #1E4A46;
  --state-reject: #55243E;
  --state-lake: #48265A;
  --state-good: #26325E;
  --state-evil: #55243E;

  /* 领域语义色（非标签） */
  --c-violet: #B4A6F0;
  /* label 系列（good/evil 随主题独立配色） */
  --label-good: #93B4F5;
  --label-good-bg: #26325E;
  --label-evil: #F09AA8;
  --label-evil-bg: #55243E;
  /* 通用语义色（随主题） */
  --agree: #6FD3C7;
  --disagree: #F09AA8;
  --success: #6FD3C7;
  --fail: #F4B2BE;
  --danger: #F09AA8;

  /* 头部三段三色/辉光/故障 + 彩蛋卡面 + 玻璃色系 + 角色卡/冠军卡 —— 暗夜(冷) */
  --brand-1: #A78BFA;
  --brand-2: #818CF8;
  --brand-3: #22D3EE;
  --brand-glow-a: #A78BFA;
  --brand-glow-b: #22D3EE;
  --brand-g1: #22D3EE;
  --brand-g2: #F43F5E;
  --func-face: #29223E;
  --glass-bg: linear-gradient(135deg, rgba(46, 39, 69, 0.94), rgba(22, 18, 34, 0.94));
  --glass-border: rgba(167, 139, 250, 0.55);
  --glass-glow: rgba(167, 139, 250, 0.3);
  --glass-sheen: rgba(255, 255, 255, 0.26);
  --card-border: #A78BFA;
  --role-card-bg: #29223E;
  --role-card-rate: #B4A6F0;
  --champion-border: #A78BFA;
  --champion-bg: #29223E;
  --profile-bg: #29223E;
  --mission-mid: #29223E;
  --mission-ok: #93B4F5;
  --mission-fail: #F4B2BE;
  --champion-fg: #D8D2EE;
  --profile-fg: #D8D2EE;
  --profile-name: #B4A6F0;
  --divider-strong: #A78BFA;
  --divider: rgba(167, 139, 250, 0.40);
  --profile-ring-glow: rgba(167, 139, 250, 0.35);
  --section-bar-from: #A78BFA;
  --section-bar-to: #22D3EE;

  --gray-50: #29223E;
  --gray-100: #322A4B;
  --gray-200: #322A4B;
  --gray-300: #413958;
  --gray-400: #A29BC0;
  --gray-500: #A29BC0;
  --gray-600: #8B85A7;
  --gray-700: #B6B0D9;
  --gray-800: #C9C3E4;
  --gray-900: #D8D2EE;

  --danger-soft-bg: rgba(239, 68, 68, 0.14);
  --danger-soft-text: #F87171;

  --shadow-sm: 0 8rpx 24rpx rgba(0, 0, 0, 0.35), inset 0 1rpx 0 rgba(167, 139, 250, 0.08);
  --shadow-md: 0 12rpx 32rpx rgba(0, 0, 0, 0.4), inset 0 1rpx 0 rgba(167, 139, 250, 0.10);
  --shadow-lg: 0 20rpx 48rpx rgba(0, 0, 0, 0.45);
  --shadow-primary: 0 8rpx 24rpx rgba(139, 92, 246, 0.35);
}
/* 签名：彩玻璃光晕（靛蓝+紫） */
.page.theme-aurora::before {
  content: ''; position: fixed; top: 0; left: 0; right: 0; height: 640rpx;
  background: radial-gradient(ellipse at 50% 0%, rgba(139, 92, 246, 0.07), transparent 60%);
  pointer-events: none; z-index: 0;
}

/* ─────────── 主题 3：锻造钢铁（冷枪铁 + 金属拉丝 + 银） ─────────── */
.theme-steel {
  --bg-page: #171A1F;
  --bg-card: linear-gradient(160deg, #2C333B, #242A31);
  --bg-card-solid: #262B33;
  --primary-bg: #262B32;
  --gold: #D4A052;

  --text-title: #C7D2DD;
  --text-body: #A7B4C0;
  --text-muted: #9EA9B5;
  --link: #93C5FD;
  --btn-emoji-bg: #3B444E;
  --state-team: #574826;
  --state-voted: #43336B;
  --state-approve: #1D4A37;
  --state-reject: #572828;
  --state-lake: #542F49;
  --state-good: #1D3A6B;
  --state-evil: #572828;

  /* 领域语义色（非标签） */
  --c-violet: #9C90D8;
  /* label 系列（good/evil 随主题独立配色） */
  --label-good: #8FB6E0;
  --label-good-bg: #1D3A6B;
  --label-evil: #E08A8A;
  --label-evil-bg: #572828;
  /* 通用语义色（随主题） */
  --agree: #6FC79A;
  --disagree: #E08A8A;
  --success: #6FC79A;
  --fail: #E8A4A4;
  --danger: #E08A8A;

  /* 头部三段三色/辉光/故障 + 彩蛋卡面 + 玻璃色系 + 角色卡/冠军卡 —— 锻造钢铁 */
  --brand-1: #C7D2DD;
  --brand-2: #94A3B8;
  --brand-3: #64748B;
  --brand-glow-a: #C7D2DD;
  --brand-glow-b: #64748B;
  --brand-g1: #7DD3FC;
  --brand-g2: #F87171;
  --func-face: #262B33;
  --glass-bg: linear-gradient(135deg, rgba(44, 51, 59, 0.94), rgba(26, 31, 37, 0.94));
  --glass-border: rgba(159, 180, 200, 0.5);
  --glass-glow: rgba(159, 180, 200, 0.24);
  --glass-sheen: rgba(255, 255, 255, 0.22);
  --card-border: #AFC0D0;
  --role-card-bg: #262B33;
  --role-card-rate: #C7D2DD;
  --champion-border: #D4A052;
  --champion-bg: #262B33;
  --profile-bg: #262B33;
  --mission-mid: #262B33;
  --mission-ok: #8FB6E0;
  --mission-fail: #E8A4A4;
  --champion-fg: #C7D2DD;
  --profile-fg: #C7D2DD;
  --profile-name: #9C90D8;
  --divider-strong: #94A3B8;
  --divider: rgba(148, 163, 184, 0.40);
  --profile-ring-glow: rgba(148, 163, 184, 0.35);
  --section-bar-from: #94A3B8;
  --section-bar-to: #64748B;

  --gray-50: #20252C;
  --gray-100: #292F37;
  --gray-200: #343B44;
  --gray-300: #48505A;
  --gray-400: #9EA9B5;
  --gray-500: #9EA9B5;
  --gray-600: #8A959F;
  --gray-700: #A7B4C0;
  --gray-800: #B9C5CF;
  --gray-900: #C7D2DD;

  --danger-soft-bg: rgba(239, 68, 68, 0.12);
  --danger-soft-text: #F87171;

  --shadow-sm: 0 8rpx 24rpx rgba(0, 0, 0, 0.35), inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
  --shadow-md: 0 12rpx 32rpx rgba(0, 0, 0, 0.4), inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
  --shadow-lg: 0 20rpx 48rpx rgba(0, 0, 0, 0.45);
  --shadow-primary: 0 8rpx 24rpx rgba(124, 58, 237, 0.3);
}
/* 签名：冷光从顶部投下 */
.page.theme-steel::before {
  content: ''; position: fixed; top: 0; left: 0; right: 0; height: 560rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), transparent 70%);
  pointer-events: none; z-index: 0;
}
/* ─────────── 页面根背景（前缀类确保高于页面本地 .page/.room-page/.game-page 背景规则） ─────────── */
.page.theme-torch, .room-page.theme-torch, .game-page.theme-torch { background-color: #14110E; }
.page.theme-aurora, .room-page.theme-aurora, .game-page.theme-aurora { background-color: #0F0B1A; }
.page.theme-steel, .room-page.theme-steel, .game-page.theme-steel { background-color: #171A1F; }


