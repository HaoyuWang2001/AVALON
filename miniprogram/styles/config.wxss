/* styles/config.wxss — 房间配置向导样式（创建房间 / 修改配置共用） */

/* ─────── Config Modal ─────── */
.config-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: var(--primary-bg); z-index: 1000;
}
.config-panel { display: flex; flex-direction: column; height: 100%; }
.config-top-bar {
  height: 100rpx; background: #FFFFFF;
  display: flex; align-items: center; padding: 0 24rpx;
  flex-shrink: 0; border-bottom: 1rpx solid var(--gray-100);
}
.config-close {
  width: 56rpx; height: 56rpx; border-radius: 12rpx;
  background: var(--primary-deep); display: flex; align-items: center; justify-content: center;
}
.close-text { color: white; font-size: 32rpx; font-weight: 700; }
.config-swiper { flex: 1; overflow: hidden; }
.config-scroll { height: 100%; padding: 24rpx 32rpx 0; box-sizing: border-box; overflow-x: hidden; }
.config-scroll::-webkit-scrollbar { display: none; width: 0; height: 0; }
.config-section { background: #FFFFFF; border-radius: 24rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04); }
.section-title { font-size: 30rpx; font-weight: 700; color: var(--gray-900); margin-bottom: 20rpx; display: flex; align-items: center; }
.section-title::before { content: ''; width: 6rpx; height: 24rpx; background: linear-gradient(180deg, var(--gradient-start), var(--gradient-end)); border-radius: 3rpx; margin-right: 12rpx; }

/* ─────── Count selector ─────── */
.count-row { white-space: nowrap; padding: 8rpx 0; }
.count-item {
  display: inline-flex; align-items: center; justify-content: center;
  width: 72rpx; height: 72rpx; border-radius: 20rpx;
  background: var(--gray-100); margin-right: 12rpx;
  font-size: 32rpx; font-weight: 700; color: var(--gray-500);
  transition: all 0.2s;
}
.count-active { background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end)); color: white; transform: scale(1.1); box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.3); }

/* ─────── Team sizes badge ─────── */
.team-sizes { padding: 12rpx 0 0; }
.team-sizes-label { font-size: 24rpx; color: var(--gray-400); display: block; margin-bottom: 12rpx; }
.team-sizes-row { display: flex; gap: 12rpx; }
.team-badge {
  flex: 1; text-align: center; padding: 12rpx 4rpx;
  background: var(--gray-50); border-radius: 12rpx; border: 1rpx solid var(--gray-200);
}
.team-badge-count { font-size: 28rpx; font-weight: 700; color: var(--gray-700); display: block; }
.team-badge-note { font-size: 18rpx; color: var(--primary); display: block; line-height: 1.4; min-height: 30rpx; }

/* ─────── Role scroll ─────── */
.role-scroll { width: 100%; white-space: nowrap; }
.role-scroll-row { display: inline-flex; gap: 16rpx; padding: 4rpx 0; }
.role-card {
  flex-shrink: 0; box-sizing: border-box;
  width: 168rpx; margin: 0; padding: 16rpx 10rpx 14rpx; border-radius: 20rpx;
  background: var(--gray-50); border: 2rpx solid var(--gray-200);
  display: flex; flex-direction: column; align-items: center;
  transition: all 0.2s;
}
/* 选中态：好人卡浅蓝 / 坏人卡浅红；未选中保持灰色 */
.role-good { background: #DBEAFE; border-color: #93C5FD; }
.role-evil { background: #FEE2E2; border-color: #FCA5A5; }
.role-loyal { background: #DBEAFE; border-color: #93C5FD; }
.role-img-placeholder {
  width: 80rpx; height: 80rpx; border-radius: 16rpx;
  background: linear-gradient(135deg, #EDE9FE, #DDD6FE);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 10rpx;
}
.role-loyal .role-img-placeholder { background: linear-gradient(135deg, #BFDBFE, #93C5FD); }
.role-good .role-img-placeholder { background: linear-gradient(135deg, #BFDBFE, #93C5FD); }
.role-evil .role-img-placeholder { background: linear-gradient(135deg, #FECACA, #FCA5A5); }
.role-img-text { font-size: 36rpx; }
.role-name { font-size: 24rpx; font-weight: 600; color: var(--gray-700); margin-bottom: 4rpx; }
.role-check {
  width: 32rpx; height: 32rpx; border-radius: 50%;
  border: 2rpx solid var(--gray-300); display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; color: transparent; margin-top: 4rpx;
}
.check-on { background: var(--primary); border-color: var(--primary); color: white; }
/* 选中框随阵营配色：好人蓝 / 坏人红 */
.role-good .check-on { background: #2563EB; border-color: #2563EB; color: white; }
.role-evil .check-on { background: #DC2626; border-color: #DC2626; color: white; }
.loyal-count { font-size: 28rpx; font-weight: 800; color: #2563EB; margin-top: 2rpx; }
.role-count-evil { font-size: 28rpx; font-weight: 800; color: #DC2626; margin-top: 2rpx; }

/* ─────── Role summary ─────── */
.role-summary { padding: 12rpx 28rpx; text-align: center; }
.role-warning { font-size: 26rpx; color: var(--danger); font-weight: 600; }

/* ─────── Rules ─────── */
.rule-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0; border-bottom: 1rpx solid var(--gray-100);
  position: relative;
}
.rule-row:last-child { border-bottom: none; }
.rule-picker-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; opacity: 0; }
.rule-col { flex: 1; margin-right: 20rpx; }
.rule-label { font-size: 28rpx; font-weight: 600; color: var(--gray-800); }
.rule-desc { font-size: 22rpx; color: var(--gray-400); margin-top: 4rpx; display: block; }
.rule-picker { font-size: 28rpx; color: var(--primary); font-weight: 600; }
.rule-hint {
  margin-top: 20rpx; padding: 20rpx; background: #FFFBEB; border-radius: 16rpx;
  font-size: 24rpx; color: #92400E; line-height: 1.6;
}

/* ─────── Segment control ─────── */
.segment { display: flex; background: var(--gray-100); border-radius: 12rpx; overflow: hidden; }
.segment-item {
  padding: 12rpx 28rpx; font-size: 26rpx; font-weight: 600; color: var(--gray-500);
  transition: all 0.2s;
}
.segment-active { background: var(--primary); color: white; }

/* ─────── Meta ─────── */
.meta-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid var(--gray-100); }
.meta-row:last-child { border-bottom: none; }
.meta-input { flex: 1; margin-left: 20rpx; font-size: 28rpx; color: var(--gray-800); }
.spectator-input { width: 120rpx; margin-left: 20rpx; font-size: 28rpx; color: var(--gray-800); text-align: center; }
.spectator-input.input-invalid { border-color: #EF4444; color: #EF4444; }
.section-icon { width: 36rpx; height: 36rpx; margin-right: 10rpx; vertical-align: middle; }
.role-img { width: 60rpx; height: 60rpx; }

/* ─────── Config Summary ─────── */
.summary-card {
  background: var(--gray-50); border-radius: 16rpx; padding: 20rpx;
}
.summary-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14rpx 0; border-bottom: 1rpx solid var(--gray-200);
}
.summary-row:last-child { border-bottom: none; }
.summary-label { font-size: 26rpx; color: var(--gray-500); flex-shrink: 0; }
.summary-value { font-size: 26rpx; color: var(--gray-900); font-weight: 600; text-align: right; }

/* ─────── Create button ─────── */
.create-section { padding: 30rpx 0; }
.create-btn {
  width: 100%; padding: 28rpx; border-radius: 20rpx;
  background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end)); color: white;
  font-size: 34rpx; font-weight: 700; text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(124, 58, 237, 0.35);
}
.create-btn::after { border: none; }
.create-btn-disabled { background: var(--gray-300); color: var(--gray-400); box-shadow: none; }

/* ─────── Nav bar ─────── */
.nav-bar {
  height: 100rpx; background: #FFFFFF; border-top: 1rpx solid var(--gray-100);
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 32rpx; flex-shrink: 0;
}
.nav-btn { display: inline-flex; align-items: center; justify-content: center; }
.nav-disabled { background: var(--gray-200) !important; color: var(--gray-400) !important; }
.nav-dots { display: flex; gap: 12rpx; }
.nav-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--gray-200); transition: all 0.2s; }
.dot-active { background: var(--primary); width: 24rpx; border-radius: 6rpx; }
