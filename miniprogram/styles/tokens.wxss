/* styles/tokens.wxss — 公共设计 token（颜色 / 圆角 / 阴影 / 基础排版） */
page {
  /* 品牌紫 */
  --primary: #8B5CF6;
  --primary-dark: #6D28D9;
  --primary-deep: #7C3AED;
  --primary-deeper: #5B21B6;
  --primary-light: #A78BFA;
  --primary-bg: #F5F3FF;
  --gradient-start: #8B5CF6;
  --gradient-end: #6D28D9;

  /* 语义色（随主题；颜色可相同，按语义取用） */
  --danger: #EF4444;
  --danger-soft-bg: #FEE2E2;
  --danger-soft-text: #DC2626;
  --success: #10B981;
  --fail: #EF4444;
  --agree: #10B981;
  --disagree: #EF4444;
  --confirm: #8B5CF6;
  --warning: #F59E0B;
  --info: #17A2B8;
  --link: #2563EB;
  --btn-emoji-bg: #F3F4F6;

  /* 玩家卡片状态标识（车队/已投/确认/赞成/反对）渐变端色 */
  --state-team: #FEF3C7;
  --state-voted: #DDD6FE;
  --state-approve: #D1FAE5;
  --state-reject: #FEE2E2;
  /* 湖仙验人本地选中（右半渐变），亮色同湖仙标签底色 */
  --state-lake: #FCE7F3;
  --state-good: #DBEAFE;
  --state-evil: #FEE2E2;
  /* 状态渐变中间停靠实色（--bg-card 可能为渐变，作停靠点需实色防嵌套失效） */
  --bg-card-solid: #FFFFFF;

  /* 领域语义色（非标签）：仅保留紫，用于信息标题/座位号等强调文字 */
  --c-violet: #6D28D9;

  /* 领域语义前景色（非标签）：阵营 good/evil、荣誉 gold */
  --good: #3B82F6;
  --evil: #EF4444;
  --gold: #B8860B;
  --gold-bg: #FEF3C7;

  /* label 系列（标签：浅色底 + 同色系文字） */
  /* 语义色（随主题，与 --good/--evil 同值） */
  --label-good: var(--good);
  --label-good-bg: #DBEAFE;
  --label-evil: var(--evil);
  --label-evil-bg: #FEE2E2;
  /* 固定色 */
  --label-blue: #2563EB;
  --label-blue-bg: #DBEAFE;
  --label-red: #EF4444;
  --label-red-bg: #FEE2E2;
  --label-gold: #B8860B;
  --label-gold-bg: #FEF3C7;
  --label-violet: #6D28D9;
  --label-violet-bg: #EDE9FE;
  --label-pink: #BE185D;
  --label-pink-bg: #FCE7F3;
  --label-orange: #C2410C;
  --label-orange-bg: #FFEDD5;
  --label-grey: #6B7280;
  --label-grey-bg: #F3F4F6;
  --label-green: #22C55E;
  --label-green-bg: #DCFCE7;

  /* 主页头部：三段三色 + 辉光 + 故障分层色（黎明初现：深紫·皇家） */
  --brand-1: #2E1065;
  --brand-2: #4C1D95;
  --brand-3: #6D28D9;
  --brand-glow-a: rgba(76, 29, 149, 0.28);
  --brand-glow-b: rgba(109, 40, 217, 0.20);
  --brand-g1: #A855F7;
  --brand-g2: #4C1D95;
  /* 彩蛋功能卡卡面（亮色：深紫渐变，白图标可读） */
  --func-face: #1F2937;
  /* 玻璃色系（亮色：紫色半透明玻璃） */
  --glass-bg: linear-gradient(135deg, rgba(139, 92, 246, 0.72), rgba(91, 33, 182, 0.66));
  --glass-border: rgba(167, 139, 250, 0.8);
  --glass-glow: rgba(139, 92, 246, 0.35);
  --glass-sheen: rgba(255, 255, 255, 0.45);
  /* 角色胜率卡牌 + 胜率冠军卡 + 个人信息卡 + 历史角色名 */
  --card-border: #8B5CF6;
  --role-card-bg: linear-gradient(160deg, #4C1D95, #1E1B4B);
  --role-card-rate: #C4B5FD;
  --champion-border: #8B5CF6;
  --champion-bg: linear-gradient(160deg, #4C1D95, #2E1065);
  --champion-fg: #FFFFFF;
  --profile-bg: linear-gradient(135deg, #2E1065 0%, #3B0764 45%, #5B21B6 100%);
  --profile-fg: #FFFFFF;
  --profile-name: #C4B5FD;
  --divider-strong: #C4B5FD;
  --divider: rgba(196, 181, 253, 0.45);
  --profile-ring-glow: rgba(196, 181, 253, 0.35);
  /* 任务投票页渐变中间过渡色（各主题中性色） */
  --mission-mid: #E6EAED;
  /* 任务成功蒙版中心蓝（比 --hc-good 更浅） */
  --mission-ok: #2563EB;
  /* 任务失败蒙版中心红（比 --hc-evil 更浅） */
  --mission-fail: #EF4444;
  /* 小节竖线（角色胜率 / 历史对局 / 配置弹窗） */
  --section-bar-from: #8B5CF6;
  --section-bar-to: #6D28D9;

  /* 中性灰阶 */
  --gray-50: #F9FAFB;
  --gray-100: #F3F4F6;
  --gray-200: #E5E7EB;
  --gray-300: #D1D5DB;
  --gray-400: #9CA3AF;
  --gray-500: #6B7280;
  --gray-600: #4B5563;
  --gray-700: #374151;
  --gray-800: #1F2937;
  --gray-900: #111827;

  /* 页面/卡片背景 */
  --bg-page: #F5F5F5;
  --bg-card: #FFFFFF;

  /* 文字色（兼容历史命名） */
  --text-title: #111827;
  --text-body: #374151;
  --text-muted: #6B7280;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;

  /* 阴影 */
  --shadow-sm: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 12rpx 32rpx rgba(0, 0, 0, 0.15);
  --shadow-primary: 0 8rpx 24rpx rgba(124, 58, 237, 0.15);

  font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: var(--bg-page);
  color: var(--text-body);
  line-height: 1.5;
}
