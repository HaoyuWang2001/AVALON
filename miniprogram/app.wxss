@import "styles/tokens.wxss";
@import "styles/buttons.wxss";
@import "styles/cards.wxss";

/* app.wxss 全局样式 */

button {
  margin: 0;
  background: transparent;
}

button::after {
  border: none;
}

.container {
  padding: 24rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-title);
}

.subtitle {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-title);
}

.text-muted {
  color: var(--text-muted);
  font-size: 28rpx;
}

.text-center {
  text-align: center;
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.mt-1 { margin-top: 8rpx; }
.mt-2 { margin-top: 16rpx; }
.mt-3 { margin-top: 24rpx; }
.mt-4 { margin-top: 32rpx; }

.mb-1 { margin-bottom: 8rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mb-4 { margin-bottom: 32rpx; }

.avatar {
  border-radius: 50%;
  border: 3rpx solid var(--primary);
}

.avatar-lg {
  width: 100rpx;
  height: 100rpx;
}

.avatar-md {
  width: 100rpx;
  height: 100rpx;
}

.avatar-sm {
  width: 72rpx;
  height: 72rpx;
}

.theme-primary {
  color: var(--primary);
}

.theme-secondary {
  color: var(--primary-light);
}

.theme-accent {
  color: var(--danger);
}
