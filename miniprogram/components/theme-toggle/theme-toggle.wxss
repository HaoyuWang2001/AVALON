/* components/theme-toggle/theme-toggle.wxss */
.theme-toggle {
  width: 60rpx; height: 60rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; flex-shrink: 0;
  background: var(--gray-100, #F3F4F6);
  border: 2rpx solid var(--border-color, #E5E7EB);
  transition: transform 0.12s ease;
}
.theme-toggle-hover { transform: scale(0.9); opacity: 0.8; }
