/* components/role-stats-card/role-stats-card.wxss */
.rsc { position: relative; background: var(--bg-card); border-radius: 24rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); }
.rsc-title { font-size: 34rpx; font-weight: 700; color: var(--gray-900); margin-bottom: 12rpx; display: flex; align-items: center; }
.rsc-title::before { content: ''; width: 8rpx; height: 30rpx; background: linear-gradient(180deg, var(--section-bar-from), var(--section-bar-to)); border-radius: 4rpx; margin-right: 14rpx; }
.rsc-summary { font-size: 28rpx; color: var(--text-muted); margin-bottom: 12rpx; }
.rsc-summary-rate, .rsc-summary-good, .rsc-summary-evil { font-weight: 700; }
.rsc-summary-rate { color: var(--c-violet); }
.rsc-summary-good { color: var(--hc-good); }
.rsc-summary-evil { color: var(--hc-evil); }
.rsc-empty { text-align: center; color: var(--gray-400); font-size: 26rpx; padding: 40rpx 0; }

.rsc-swiper { width: 100%; height: 620rpx; }
.rsc-item { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
.rsc-card {
  position: relative; overflow: hidden;
  width: 400rpx; height: 500rpx; border-radius: 32rpx;
  background: var(--role-card-bg, var(--bg-card-solid));
  box-shadow: 0 22rpx 52rpx rgba(0, 0, 0, 0.30), 0 0 0 4rpx var(--role-card-border), inset 0 2rpx 0 rgba(255, 255, 255, 0.16);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  box-sizing: border-box; padding: 40rpx;
}
/* 内层细框（卡牌双框感） */
.rsc-card::before {
  content: ''; position: absolute; top: 14rpx; left: 14rpx; right: 14rpx; bottom: 14rpx;
  border-radius: 22rpx; border: 2rpx solid rgba(255, 255, 255, 0.12); pointer-events: none;
}
/* 对角光泽（卡牌质感） */
.rsc-card::after {
  content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none;
  background: linear-gradient(150deg, rgba(255, 255, 255, 0.14) 0%, transparent 38%, transparent 62%, rgba(0, 0, 0, 0.10) 100%);
}
.rsc-card:active { transform: scale(0.97); }
.rsc-emoji { font-size: 180rpx; line-height: 1.2; position: relative; z-index: 1; }
.rsc-name { font-size: 28rpx; font-weight: 700; padding: 8rpx 28rpx; border-radius: 28rpx; margin-top: 24rpx; position: relative; z-index: 1; }
.rsc-name-good { background: var(--c-good-bg); color: var(--c-good-pill); }
.rsc-name-evil { background: var(--c-evil-bg); color: var(--c-evil-pill); }
.rsc-meta { margin-top: 32rpx; position: relative; z-index: 1; }
.rsc-rate { font-size: 36rpx; font-weight: 800; color: var(--role-card-rate, var(--c-team)); }

/* 自定义 swiper 指示点（token 化，替代硬编码的内置指示器） */
.rsc-dots { position: absolute; left: 0; right: 0; bottom: 30rpx; display: flex; align-items: center; justify-content: center; }
.rsc-dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin: 0 7rpx; background: var(--gradient-start); opacity: 0.25; transition: opacity 0.2s ease; }
.rsc-dot.on { opacity: 1; }

/* 角色对局弹窗 */
.rsc-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55); z-index: 1200;
  display: flex; align-items: flex-end; justify-content: center;
}
.rsc-modal {
  width: 100%; max-width: 720rpx; box-sizing: border-box;
  background: var(--bg-card); border-radius: 28rpx 28rpx 0 0;
  padding: 40rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  position: relative; animation: rsc-up 0.25s ease-out;
}
@keyframes rsc-up { from { transform: translateY(40rpx); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
.rsc-modal-close { position: absolute; top: 24rpx; right: 28rpx; font-size: 34rpx; color: var(--text-muted); }
