/* components/history-card/history-card.wxss */
.hc-title { font-size: 34rpx; font-weight: 700; color: var(--text-title); margin-bottom: 12rpx; display: flex; align-items: center; }
.hc-title::before { content: ''; width: 8rpx; height: 30rpx; background: linear-gradient(180deg, var(--section-bar-from), var(--section-bar-to)); border-radius: 4rpx; margin-right: 14rpx; }
.hc-empty { text-align: center; color: var(--text-muted); font-size: 26rpx; padding: 40rpx 0; }
.hc-scroll { max-height: 760rpx; }
.hc-scroll::-webkit-scrollbar, .hc-scroll ::-webkit-scrollbar { width: 0 !important; height: 0 !important; display: none !important; background: transparent; }
.hc-item { padding: 18rpx 0; border-bottom: 1rpx solid var(--divider); }
.hc-item:last-child { border-bottom: none; }
.hc-item:active { opacity: 0.7; }
.hc-line { display: flex; align-items: center; justify-content: space-between; }
.hc-role { font-size: 28rpx; font-weight: 700; flex-shrink: 0; }
.hc-good { color: var(--good); }
.hc-evil { color: var(--evil); }
.hc-right { display: flex; align-items: center; flex-shrink: 0; margin-left: 16rpx; }
.hc-duration { font-size: 24rpx; color: var(--text-muted); margin-right: 16rpx; }
.hc-result { font-size: 24rpx; font-weight: 700; padding: 2rpx 18rpx; border-radius: 8rpx; }
.hc-result.win { color: var(--success); background: var(--state-approve); }
.hc-result.lose { color: var(--fail); background: var(--state-reject); }
.hc-meta { font-size: 22rpx; color: var(--text-muted); margin-top: 6rpx; display: block; }
