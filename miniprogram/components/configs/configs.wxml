<view class="config-overlay {{themeClass ? 'theme-' + themeClass : ''}}" wx:if="{{showConfig}}">
    <view class="config-panel">

      <!-- Top bar -->
      <view class="config-top-bar">
        <view class="config-close" bindtap="close">
          <text class="close-text">✕</text>
        </view>
      </view>

      <!-- Swiper -->
      <swiper class="config-swiper" current="{{swiperPage}}" bindchange="onSwiperChange" duration="300">
        
        <!-- Page 0: 人数+角色+湖仙 -->
        <swiper-item>
          <scroll-view scroll-y class="config-scroll" show-scrollbar="{{false}}">
            <view class="config-section">
              <view class="section-title">🙋 玩家总数</view>
              <scroll-view class="count-row" scroll-x show-scrollbar="{{false}}">
                <view wx:for="{{[5,6,7,8,9,10,11,12]}}" wx:key="*this"
                  class="count-item {{playerCount === item ? 'count-active' : ''}}"
                  data-count="{{item}}" bindtap="onPlayerCountChange">{{item}}</view>
              </scroll-view>

              <view class="team-sizes">
                <text class="team-sizes-label">每轮发车人数（固定）</text>
                <view class="team-sizes-row">
                  <view wx:for="{{teamSizes}}" wx:key="index" class="team-badge">
                    <text class="team-badge-note" style="color:transparent"> </text>
                    <text class="team-badge-count">{{item}}人</text>
                    <text class="team-badge-note">{{index === 3 && playerCount >= 7 ? '保护轮' : ' '}}</text>
                  </view>
                </view>
              </view>
            </view>

            <view class="config-section">
              <view class="section-title"><image src="/images/avalon-blue.png" class="section-icon"/>蓝方</view>
              <scroll-view class="role-scroll" scroll-x show-scrollbar="{{false}}">
              <view class="role-scroll-row">
                <view class="role-card role-loyal">
                  <view class="role-img-placeholder">
                    <image src="/images/avalon-blue.png" class="role-img"/>
                  </view>
                  <text class="role-name">忠臣</text>
                  <text class="loyal-count">×{{loyalCount}}</text>
                </view>
                <view wx:for="{{['merlin','percival','lancelotBlue']}}" wx:key="*this"
                  class="role-card {{selectedRoles[item] ? 'role-good' : ''}}"
                  data-role="{{item}}" bindtap="onRoleToggle">
                  <view class="role-img-placeholder">
                    <image src="/images/avalon-blue.png" class="role-img"/>
                  </view>
                  <text class="role-name">{{item === 'merlin' ? '梅林' : item === 'percival' ? '派西' : '蓝兰'}}</text>
                  <!-- 梅林/派西必选：固定 ×1，无选中框 -->
                  <text wx:if="{{item === 'merlin' || item === 'percival'}}" class="loyal-count">×1</text>
                  <view wx:else class="role-check {{selectedRoles[item] ? 'check-on' : ''}}">
                    <text wx:if="{{selectedRoles[item]}}">✓</text>
                  </view>
                </view>
              </view>
              </scroll-view>
            </view>

            <view class="config-section">
              <view class="section-title"><image src="/images/avalon-red.png" class="section-icon"/>红方</view>
              <scroll-view class="role-scroll" scroll-x show-scrollbar="{{false}}">
              <view class="role-scroll-row">
                <view wx:for="{{['morgana','assassin','oberon','mordred','minion','lancelotRed']}}" wx:key="*this"
                  class="role-card {{selectedRoles[item] ? 'role-evil' : ''}}"
                  data-role="{{item}}" bindtap="onRoleToggle">
                  <view class="role-img-placeholder">
                    <image src="/images/avalon-red.png" class="role-img"/>
                  </view>
                  <text class="role-name">{{item === 'morgana' ? '莫甘娜' : item === 'assassin' ? '刺客' : item === 'oberon' ? '奥伯伦' : item === 'mordred' ? '莫德雷德' : item === 'minion' ? '爪牙' : '红兰'}}</text>
                  <!-- 莫甘娜必选：固定 ×1，无选中框 -->
                  <text wx:if="{{item === 'morgana'}}" class="role-count-evil">×1</text>
                  <view wx:else class="role-check {{selectedRoles[item] ? 'check-on' : ''}}">
                    <text wx:if="{{selectedRoles[item]}}">✓</text>
                  </view>
                </view>
              </view>
              </scroll-view>
            </view>

            <view class="role-summary" wx:if="{{roleWarning}}">
              <text class="role-warning">⚠️ {{roleWarning}}</text>
            </view>

            <view class="config-section">
              <view class="section-title">🏞️ 湖中仙女</view>
              <view class="rule-row">
                <text class="rule-label">启用湖中仙女</text>
                <switch checked="{{ladyOfTheLake}}" bindchange="onLadyToggle" color="#8B5CF6"/>
              </view>
              <view class="rule-row" wx:if="{{ladyOfTheLake}}">
                <text class="rule-label">生效轮次</text>
                <picker class="rule-picker-overlay" mode="selector" range="{{[1,2,3,4]}}" value="{{ladyOfTheLakeRound - 1}}" bindchange="onLadyRoundChange">
                  <view class="rule-picker-fill">
                    <text class="rule-picker">第 {{ladyOfTheLakeRound}} 轮发车成功后可用</text>
                  </view>
                </picker>
              </view>
            </view>
            <view style="height:40rpx"></view>
          </scroll-view>
        </swiper-item>

        <!-- Page 1: 必须设置项 -->
        <swiper-item>
          <scroll-view scroll-y class="config-scroll" show-scrollbar="{{false}}">
            <view class="config-section">
              <view class="section-title">📋 基础规则</view>
              <view class="rule-row">
                <view class="rule-col">
                  <text class="rule-label">流车上限</text>
                  <text class="rule-desc">每轮最多流车 {{rules.maxFailedNominations}} 次，第 {{rules.maxFailedNominations + 1}} 辆车直接发出</text>
                </view>
                <picker class="rule-picker-overlay" mode="selector" range="{{[1,2,3,4,5]}}" value="{{rules.maxFailedNominations - 1}}" data-field="maxFailedNominations" data-range="{{[1,2,3,4,5]}}" bindchange="onRulePicker">
                  <view class="rule-picker-fill">
                    <text class="rule-picker">{{rules.maxFailedNominations}} 次</text>
                  </view>
                </picker>
              </view>
              <view class="rule-row">
                <view class="rule-col">
                  <text class="rule-label">红方互知身份</text>
                  <text class="rule-desc">除奥伯伦外，红方互相知道对方具体身份</text>
                </view>
                <switch checked="{{rules.evilKnowsEachOther}}" data-field="evilKnowsEachOther" bindchange="onRuleToggle" color="#8B5CF6"/>
              </view>
              <view class="rule-row">
                <view class="rule-col">
                  <text class="rule-label">票型公开</text>
                  <text class="rule-desc">组队投票时是否展示每个人的投票结果</text>
                </view>
                <view class="segment">
                  <view class="segment-item {{rules.voteVisibility === 'public' ? 'segment-active' : ''}}" data-field="voteVisibility" data-val="public" bindtap="onRuleSegment">公开</view>
                  <view class="segment-item {{rules.voteVisibility === 'anonymous' ? 'segment-active' : ''}}" data-field="voteVisibility" data-val="anonymous" bindtap="onRuleSegment">匿名</view>
                </view>
              </view>
              <view class="rule-row">
                <view class="rule-col">
                  <text class="rule-label">失败详情</text>
                  <text class="rule-desc">任务失败时显示几票失败 or 仅知成败</text>
                </view>
                <view class="segment">
                  <view class="segment-item {{rules.missionFailDetail === 'count' ? 'segment-active' : ''}}" data-field="missionFailDetail" data-val="count" bindtap="onRuleSegment">票数</view>
                  <view class="segment-item {{rules.missionFailDetail === 'binary' ? 'segment-active' : ''}}" data-field="missionFailDetail" data-val="binary" bindtap="onRuleSegment">成败</view>
                </view>
              </view>
            </view>

            <view class="config-section" hidden="{{!selectedRoles.oberon && !selectedRoles.lancelotRed && !selectedRoles.lancelotBlue}}">
              <view class="section-title">💣 红方强制任务失败</view>
              <view class="rule-row" hidden="{{!selectedRoles.oberon}}">
                <view class="rule-col">
                  <text class="rule-label">奥伯伦必须任务失败</text>
                  <text class="rule-desc">若被选入任务队伍，必须投失败票</text>
                </view>
                <switch checked="{{rules.oberonMustFailMission}}" data-field="oberonMustFailMission" bindchange="onRuleToggle" color="#8B5CF6"/>
              </view>
              <view class="rule-row" hidden="{{!selectedRoles.lancelotBlue && !selectedRoles.lancelotRed}}">
                <view class="rule-col">
                  <text class="rule-label">兰斯洛特必须任务失败</text>
                  <text class="rule-desc">当前为红方阵营的兰斯洛特若被选入任务队伍，必须投失败票</text>
                </view>
                <switch checked="{{rules.lancelotMustFail}}" data-field="lancelotMustFail" bindchange="onRuleToggle" color="#8B5CF6"/>
              </view>
            </view>
          </scroll-view>
        </swiper-item>

        <!-- Page 2: 兰斯洛特配置 (conditional) -->
        <swiper-item wx:if="{{selectedRoles.lancelotBlue || selectedRoles.lancelotRed}}">
          <scroll-view scroll-y class="config-scroll" show-scrollbar="{{false}}">
            <view class="config-section">
              <view class="section-title">⚔️ 兰斯洛特配置</view>
              <view class="rule-row" hidden="{{!selectedRoles.lancelotBlue || !selectedRoles.lancelotRed}}">
                <view class="rule-col">
                  <text class="rule-label">兰斯互认身份</text>
                  <text class="rule-desc">蓝兰与红兰在视野中知道对方身份</text>
                </view>
                <switch checked="{{rules.lancelotsKnowEachOther}}" data-field="lancelotsKnowEachOther" bindchange="onRuleToggle" color="#8B5CF6"/>
              </view>
              <view class="rule-row">
                <view class="rule-col">
                  <text class="rule-label">兰斯换身轮次</text>
                  <text class="rule-desc">第几轮结束、下一轮开始时抽取身份转换卡（1-4）</text>
                </view>
                <picker class="rule-picker-overlay" mode="selector" range="{{[1,2,3,4]}}" value="{{rules.lancelotSwapRound - 1}}" data-field="lancelotSwapRound" data-range="{{[1,2,3,4]}}" bindchange="onRulePicker">
                  <view class="rule-picker-fill">
                    <text class="rule-picker">第 {{rules.lancelotSwapRound}} 轮</text>
                  </view>
                </picker>
              </view>
              <view class="rule-row">
                <view class="rule-col">
                  <text class="rule-label">转换卡数量</text>
                  <text class="rule-desc">卡组中"身份转换"卡张数（抽中则蓝红兰互换阵营）</text>
                </view>
                <picker class="rule-picker-overlay" mode="selector" range="{{[1,2,3,4,5]}}" value="{{rules.lancelotSwitchCards - 1}}" data-field="lancelotSwitchCards" data-range="{{[1,2,3,4,5]}}" bindchange="onRulePicker">
                  <view class="rule-picker-fill">
                    <text class="rule-picker">{{rules.lancelotSwitchCards}} 张</text>
                  </view>
                </picker>
              </view>
              <view class="rule-row">
                <view class="rule-col">
                  <text class="rule-label">不转换卡数量</text>
                  <text class="rule-desc">卡组中"身份保持"卡张数（抽中则不转换）</text>
                </view>
                <picker class="rule-picker-overlay" mode="selector" range="{{[1,2,3,4,5]}}" value="{{rules.lancelotKeepCards - 1}}" data-field="lancelotKeepCards" data-range="{{[1,2,3,4,5]}}" bindchange="onRulePicker">
                  <view class="rule-picker-fill">
                    <text class="rule-picker">{{rules.lancelotKeepCards}} 张</text>
                  </view>
                </picker>
              </view>
              <view class="rule-row" wx:if="{{selectedRoles.lancelotRed}}">
                <view class="rule-col">
                  <text class="rule-label">睁眼狼知红兰</text>
                  <text class="rule-desc">睁眼狼（莫甘娜/刺客/爪牙/莫德雷德）是否知道红兰身份</text>
                </view>
                <switch checked="{{rules.evilsKnowRedLancelot}}" data-field="evilsKnowRedLancelot" bindchange="onRuleToggle" color="#8B5CF6"/>
              </view>
              <view class="rule-row" wx:if="{{selectedRoles.oberon}}">
                <view class="rule-col">
                  <text class="rule-label">奥伯伦知红兰</text>
                  <text class="rule-desc">奥伯伦是否知道红兰身份</text>
                </view>
                <switch checked="{{rules.oberonKnowsRedLancelot}}" data-field="oberonKnowsRedLancelot" bindchange="onRuleToggle" color="#8B5CF6"/>
              </view>
              <view class="rule-row" wx:if="{{selectedRoles.lancelotBlue && selectedRoles.lancelotRed}}">
                <view class="rule-col">
                  <text class="rule-label">梅林辨兰阵营</text>
                  <text class="rule-desc">梅林能否分辨蓝/红兰各自阵营（仍能看到双兰）</text>
                </view>
                <switch checked="{{rules.merlinKnowsLancelotSide}}" data-field="merlinKnowsLancelotSide" bindchange="onRuleToggle" color="#8B5CF6"/>
              </view>
            </view>
          </scroll-view>
        </swiper-item>

        <!-- Page 4: 时间+信息+创建 -->
        <swiper-item>
          <scroll-view scroll-y class="config-scroll" show-scrollbar="{{false}}">
            <view class="config-section">
              <view class="section-title">⏱️ 时间限制</view>
              <view class="rule-row">
                <text class="rule-label">发言限时</text>
                <picker class="rule-picker-overlay" mode="selector" range="{{speechOptions}}" value="{{speechTimeoutIndex}}" data-field="speechTimeoutIndex" bindchange="onLimitChange">
                  <view class="rule-picker-fill">
                    <text class="rule-picker">{{speechOptions[speechTimeoutIndex]}}</text>
                  </view>
                </picker>
              </view>
              <view class="rule-row">
                <text class="rule-label" style="color:#B0B0B0;">任务超时</text>
                <picker class="rule-picker" mode="selector" range="{{roundOptions}}" value="{{roundTimeoutIndex}}" data-field="roundTimeoutIndex" bindchange="onLimitChange" disabled>
                  <text style="color:#B0B0B0;">{{roundOptions[roundTimeoutIndex]}}</text>
                </picker>
              </view>
              <view class="rule-row">
                <text class="rule-label" style="color:#B0B0B0;">投票超时</text>
                <picker class="rule-picker" mode="selector" range="{{voteOptions}}" value="{{voteTimeoutIndex}}" data-field="voteTimeoutIndex" bindchange="onLimitChange" disabled>
                  <text style="color:#B0B0B0;">{{voteOptions[voteTimeoutIndex]}}</text>
                </picker>
              </view>
              <view class="rule-row">
                <text class="rule-label">票型展示时长</text>
                <picker class="rule-picker-overlay" mode="selector" range="{{voteRevealOptions}}" value="{{voteRevealDurationIndex}}" data-field="voteRevealDurationIndex" bindchange="onLimitChange">
                  <view class="rule-picker-fill">
                    <text class="rule-picker">{{voteRevealOptions[voteRevealDurationIndex]}}</text>
                  </view>
                </picker>
              </view>
              <view class="rule-hint">
                💡 若任务或投票超时，未行动视为投出成功票或赞成票（必须出失败票的角色仍会出失败票）。
              </view>
            </view>

            <view class="config-section">
              <view class="section-title">👁️ 观战设置</view>
              <view class="rule-row">
                <text class="rule-label">允许观战</text>
                <switch checked="{{allowSpectator}}" bindchange="onSpectatorToggle" color="#8B5CF6"/>
              </view>
              <view class="rule-row" wx:if="{{allowSpectator}}">
                <text class="rule-label">观战人数上限</text>
                <view class="segment">
                  <view class="segment-item {{!spectatorLimited ? 'segment-active' : ''}}" data-val="false" bindtap="onSpectatorLimitMode">不限</view>
                  <view class="segment-item {{spectatorLimited ? 'segment-active' : ''}}" data-val="true" bindtap="onSpectatorLimitMode">有限制</view>
                </view>
              </view>
              <view class="rule-row" wx:if="{{allowSpectator && spectatorLimited}}">
                <text class="rule-label">上限人数</text>
                <input class="spectator-input {{spectatorLimitInvalid ? 'input-invalid' : ''}}" type="number" maxlength="3" placeholder="1-100" value="{{maxSpectators || ''}}" bindinput="onSpectatorLimitInput"/>
              </view>
            </view>
            <view style="height:60rpx"></view>
          </scroll-view>
        </swiper-item>

        <!-- Page 6: 配置总结+会议信息+完成 -->
        <swiper-item>
          <scroll-view scroll-y class="config-scroll" show-scrollbar="{{false}}">
            <view class="config-section">
              <view class="section-title">📋 配置总结</view>
              <view class="summary-card">
                <view class="summary-row">
                  <text class="summary-label">玩家数</text>
                  <text class="summary-value">{{playerCount}}人</text>
                </view>
                <view class="summary-row">
                  <text class="summary-label">蓝方</text>
                  <text class="summary-value">{{goodRoleNames}}</text>
                </view>
                <view class="summary-row">
                  <text class="summary-label">红方</text>
                  <text class="summary-value">{{evilRoleNames}}</text>
                </view>
                <view class="summary-row">
                  <text class="summary-label">湖中仙女</text>
                  <text class="summary-value">{{summaryLady}}</text>
                </view>
                <view class="summary-row">
                  <text class="summary-label">红方互知</text>
                  <text class="summary-value">{{rules.evilKnowsEachOther ? '是' : '否'}}</text>
                </view>
              </view>
            </view>

            <view class="config-section">
              <view class="section-title">📝 会议信息</view>
              <view class="meta-row">
                <text class="rule-label">会议名</text>
                <input class="meta-input" placeholder="{{userInfo.customNickName || userInfo.nickName || '房主'}}的会议" value="{{roomName}}" data-field="roomName" bindinput="onMetaInput"/>
              </view>
              <view class="meta-row">
                <text class="rule-label">描述</text>
                <input class="meta-input" placeholder="欢迎所有玩家" value="{{roomDescription}}" data-field="roomDescription" bindinput="onMetaInput"/>
              </view>
            </view>

            <view class="create-section">
              <button class="create-btn {{roleWarning ? 'create-btn-disabled' : ''}}" bindtap="submit" disabled="{{roleWarning !== ''}}">{{confirmText}}</button>
            </view>
            <view style="height:60rpx"></view>
          </scroll-view>
        </swiper-item>

      </swiper>

      <!-- Navigation bar -->
      <view class="nav-bar">
        <view class="nav-btn btn-square {{logicalPage === 0 ? 'nav-disabled' : ''}}" bindtap="prevPage">◀ 上一步</view>
        <view class="nav-dots">
          <view wx:for="{{visiblePages}}" wx:key="*this" class="nav-dot {{index === logicalPage ? 'dot-active' : ''}}"></view>
        </view>
        <view class="nav-btn btn-square {{(logicalPage === visiblePages.length - 1) || (logicalPage === 0 && roleWarning) ? 'nav-disabled' : ''}}" bindtap="nextPage">下一步 ▶</view>
      </view>
    </view>
  </view>